page {
  height: 100%;
  box-sizing: border-box;
}

.page {
  min-height: 100%;
  display: flex;
  flex-direction: column;
  transition: background 0.8s ease;
  overflow-x: hidden;
  box-sizing: border-box;
}

.status-bar {
  height: 88rpx;
}

/* 顶部导航 */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx 20rpx;
  box-sizing: border-box;
}

.back-btn, .refresh-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255,255,255,0.2);
  border-radius: 50%;
  backdrop-filter: blur(10px);
  transition: transform 0.3s ease, background 0.3s ease;
}

.back-btn:active, .refresh-btn:active {
  transform: scale(0.95);
  background: rgba(255,255,255,0.3);
}

.back-icon, .refresh-icon {
  font-size: 36rpx;
  color: #fff;
}

.refresh-icon {
  font-size: 40rpx;
}

.city-info {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.city-name {
  font-size: 34rpx;
  color: #fff;
  font-weight: 600;
}

.city-arrow {
  font-size: 20rpx;
  color: rgba(255,255,255,0.7);
}

/* 搜索面板 */
.search-panel {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  animation: fadeIn 0.3s ease;
}

.search-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.4);
  backdrop-filter: blur(5px);
}

.search-box {
  position: absolute;
  top: 140rpx;
  left: 20rpx;
  right: 20rpx;
  background: rgba(255,255,255,0.95);
  border-radius: 32rpx;
  padding: 24rpx;
  backdrop-filter: blur(20px);
  box-shadow: 0 16rpx 48rpx rgba(0,0,0,0.15);
  animation: slideDown 0.3s ease;
  box-sizing: border-box;
}

@keyframes slideDown {
  from { opacity: 0; transform: translateY(-20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.search-input {
  background: rgba(0,0,0,0.05);
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  font-size: 30rpx;
}

.search-results {
  margin-top: 16rpx;
  max-height: 400rpx;
  overflow-y: auto;
}

.search-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(0,0,0,0.06);
  display: flex;
  justify-content: space-between;
  align-items: center;
  transition: background 0.2s ease;
}

.search-item:active {
  background: rgba(0,0,0,0.03);
}

.search-item-name {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

.search-item-adm {
  font-size: 24rpx;
  color: #999;
}

/* 加载状态 */
.loading-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 4rpx solid rgba(255,255,255,0.3);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  color: rgba(255,255,255,0.8);
  font-size: 28rpx;
}

/* 主内容区 */
.content {
  flex: 1;
  padding: 0 20rpx 40rpx;
  box-sizing: border-box;
  overflow-x: hidden;
}

.fade-in {
  animation: fadeIn 0.6s ease;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* 毛玻璃效果 */
.glass {
  background: rgba(255,255,255,0.18);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1rpx solid rgba(255,255,255,0.25);
  border-radius: 32rpx;
}

/* 预警条 */
.warning-bar {
  background: rgba(255,100,100,0.25);
  backdrop-filter: blur(10px);
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.warning-icon {
  font-size: 28rpx;
  margin-top: 4rpx;
}

.warning-content {
  flex: 1;
}

.warning-title {
  font-size: 26rpx;
  color: #fff;
  font-weight: 600;
  display: block;
  margin-bottom: 4rpx;
}

.warning-text {
  font-size: 24rpx;
  color: rgba(255,255,255,0.85);
  line-height: 1.4;
}

/* 实时天气卡片 */
.now-card {
  padding: 32rpx 24rpx;
  margin-bottom: 20rpx;
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
}

.now-main {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.now-temp-wrap {
  display: flex;
  align-items: flex-start;
}

.now-temp {
  font-size: 100rpx;
  color: #fff;
  font-weight: 200;
  line-height: 1;
  text-shadow: 0 4rpx 8rpx rgba(0,0,0,0.1);
}

.now-unit {
  font-size: 36rpx;
  color: rgba(255,255,255,0.7);
  margin-top: 16rpx;
}

.now-icon {
  font-size: 80rpx;
  line-height: 1;
  filter: drop-shadow(0 4rpx 8rpx rgba(0,0,0,0.1));
}

.now-info {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.now-text {
  font-size: 34rpx;
  color: #fff;
  font-weight: 500;
}

.now-divider {
  color: rgba(255,255,255,0.4);
}

.now-feels {
  font-size: 26rpx;
  color: rgba(255,255,255,0.65);
}

.now-detail {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 0;
}

.now-detail-item {
  width: 50%;
  padding: 10rpx 0;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.detail-icon {
  font-size: 32rpx;
}

.detail-info {
  display: flex;
  flex-direction: column;
}

.detail-label {
  font-size: 22rpx;
  color: rgba(255,255,255,0.55);
}

.detail-value {
  font-size: 28rpx;
  color: #fff;
  font-weight: 500;
}

.update-time {
  position: absolute;
  bottom: 12rpx;
  right: 16rpx;
}

.update-time text {
  font-size: 20rpx;
  color: rgba(255,255,255,0.4);
}

/* 分区标题 */
.section-title {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin: 28rpx 0 14rpx;
  padding-left: 4rpx;
}

.section-icon {
  font-size: 28rpx;
}

.section-title text:nth-child(2) {
  font-size: 30rpx;
  color: #fff;
  font-weight: 600;
}

/* 24小时预报 */
.hourly-scroll {
  white-space: nowrap;
  overflow: hidden;
}

.hourly-list {
  display: inline-flex;
  gap: 12rpx;
  padding: 8rpx 4rpx;
}

.hourly-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 20rpx;
  min-width: 90rpx;
  transition: transform 0.2s ease;
  box-sizing: border-box;
}

.hourly-item:active {
  transform: scale(0.95);
}

.hourly-time {
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
}

.hourly-icon {
  font-size: 40rpx;
}

.hourly-temp {
  font-size: 30rpx;
  color: #fff;
  font-weight: 500;
}

.hourly-text {
  font-size: 20rpx;
  color: rgba(255,255,255,0.6);
  max-width: 80rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 7天预报 */
.daily-card {
  padding: 8rpx 16rpx;
  box-sizing: border-box;
}

.daily-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(255,255,255,0.1);
}

.daily-item:last-child {
  border-bottom: none;
}

.daily-date-wrap {
  width: 100rpx;
  flex-shrink: 0;
}

.daily-date {
  font-size: 28rpx;
  color: #fff;
  display: block;
}

.daily-text {
  font-size: 20rpx;
  color: rgba(255,255,255,0.5);
  display: block;
  margin-top: 4rpx;
}

.daily-icons {
  display: flex;
  gap: 6rpx;
  width: 80rpx;
  justify-content: center;
  flex-shrink: 0;
}

.daily-icon {
  font-size: 32rpx;
}

.daily-icon-night {
  font-size: 28rpx;
  opacity: 0.7;
}

.daily-temp-bar {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-left: 8rpx;
  min-width: 0;
}

.daily-temp-min {
  font-size: 24rpx;
  color: rgba(255,255,255,0.55);
  width: 48rpx;
  text-align: right;
  flex-shrink: 0;
}

.daily-temp-max {
  font-size: 24rpx;
  color: #fff;
  width: 48rpx;
  flex-shrink: 0;
}

.temp-bar {
  flex: 1;
  height: 8rpx;
  background: rgba(255,255,255,0.15);
  border-radius: 4rpx;
  position: relative;
  overflow: hidden;
}

.temp-bar-fill {
  position: absolute;
  top: 0;
  height: 100%;
  background: linear-gradient(90deg, #74b9ff, #fdcb6e);
  border-radius: 4rpx;
  transition: all 0.3s ease;
}

/* 空气质量 */
.aqi-card {
  padding: 24rpx;
  box-sizing: border-box;
}

.aqi-main {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.aqi-circle {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.15);
  flex-shrink: 0;
}

.aqi-value {
  font-size: 40rpx;
  color: #fff;
  font-weight: 700;
}

.aqi-label-small {
  font-size: 18rpx;
  color: rgba(255,255,255,0.8);
}

.aqi-info {
  flex: 1;
}

.aqi-level {
  font-size: 34rpx;
  color: #fff;
  font-weight: 600;
  display: block;
  margin-bottom: 8rpx;
}

.aqi-primary {
  font-size: 24rpx;
  color: rgba(255,255,255,0.6);
  display: block;
  margin-bottom: 8rpx;
}

.aqi-us-epa {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.aqi-us-label {
  font-size: 22rpx;
  color: rgba(255,255,255,0.5);
}

.aqi-us-value {
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
}

/* 污染物网格 */
.pollutants-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 24rpx;
  padding: 16rpx;
  background: rgba(255,255,255,0.08);
  border-radius: 20rpx;
  box-sizing: border-box;
}

.pollutant-item {
  width: calc(33.33% - 8rpx);
  text-align: center;
  padding: 12rpx 0;
  box-sizing: border-box;
}

.pollutant-name {
  font-size: 22rpx;
  color: rgba(255,255,255,0.5);
  display: block;
  margin-bottom: 6rpx;
}

.pollutant-value {
  font-size: 32rpx;
  color: #fff;
  font-weight: 600;
  display: block;
}

.pollutant-unit {
  font-size: 18rpx;
  color: rgba(255,255,255,0.4);
}

/* 健康建议 */
.health-advice {
  margin-bottom: 20rpx;
  padding: 16rpx;
  background: rgba(255,255,255,0.08);
  border-radius: 20rpx;
  box-sizing: border-box;
}

.advice-item {
  margin-bottom: 16rpx;
}

.advice-item:last-child {
  margin-bottom: 0;
}

.advice-label {
  font-size: 22rpx;
  color: rgba(255,255,255,0.5);
  display: block;
  margin-bottom: 6rpx;
}

.advice-text {
  font-size: 24rpx;
  color: rgba(255,255,255,0.85);
  line-height: 1.5;
}

/* 24小时空气质量 */
.aqi-hourly {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(255,255,255,0.1);
}

.aqi-hourly-title {
  margin-bottom: 16rpx;
}

.aqi-hourly-title text {
  font-size: 26rpx;
  color: rgba(255,255,255,0.7);
}

.aqi-hourly-scroll {
  white-space: nowrap;
  overflow: hidden;
}

.aqi-hourly-list {
  display: inline-flex;
  gap: 8rpx;
  padding: 8rpx 0;
}

.aqi-hourly-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  min-width: 50rpx;
}

.aqi-hourly-time {
  font-size: 20rpx;
  color: rgba(255,255,255,0.5);
}

.aqi-hourly-bar {
  width: 28rpx;
  border-radius: 14rpx;
  min-height: 16rpx;
  max-height: 120rpx;
  transition: height 0.3s ease;
}

.aqi-hourly-value {
  font-size: 20rpx;
  color: rgba(255,255,255,0.7);
}

/* 生活指数 */
.life-expand-btn {
  margin-left: auto;
  padding: 8rpx 20rpx;
  background: rgba(255,255,255,0.15);
  border-radius: 24rpx;
}

.life-expand-btn text {
  font-size: 22rpx;
  color: rgba(255,255,255,0.8);
}

.life-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.life-item {
  width: calc(33.33% - 8rpx);
  padding: 24rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  transition: transform 0.2s ease;
  box-sizing: border-box;
}

.life-item:active {
  transform: scale(0.95);
}

.life-icon-wrap {
  width: 68rpx;
  height: 68rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 4rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.15);
}

.life-icon {
  font-size: 36rpx;
}

.life-name {
  font-size: 22rpx;
  color: rgba(255,255,255,0.7);
}

.life-level {
  font-size: 24rpx;
  color: #fff;
  font-weight: 500;
  text-align: center;
}

.life-level-bar {
  width: 100%;
  height: 8rpx;
  background: rgba(255,255,255,0.15);
  border-radius: 4rpx;
  overflow: hidden;
  margin-top: 4rpx;
}

.life-level-fill {
  height: 100%;
  border-radius: 4rpx;
  transition: width 0.3s ease;
}

/* 底部 */
.footer {
  text-align: center;
  padding: 32rpx 16rpx 20rpx;
  box-sizing: border-box;
}

.footer-text {
  font-size: 22rpx;
  color: rgba(255,255,255,0.4);
}
