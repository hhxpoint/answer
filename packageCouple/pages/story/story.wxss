@import "../../styles/boundary.wxss";

page {
  background: #fff8f3;
  min-height: 100%;
}

.story {
  padding-bottom: 40rpx;
}

/* 封面 */
.hero {
  position: relative;
  width: 100%;
  height: 900rpx;
  overflow: hidden;
}
.hero-img {
  width: 100%;
  height: 100%;
  display: block;
}
.hero-mask {
  position: absolute;
  left: 0; right: 0; top: 0; bottom: 0;
  background: linear-gradient(180deg, rgba(30, 20, 26, 0.10) 0%, rgba(30, 20, 26, 0.05) 42%, rgba(30, 20, 26, 0.55) 100%);
}
.hero-text {
  position: absolute;
  left: 64rpx;
  right: 64rpx;
  bottom: 78rpx;
  color: #fff;
}
.hero-text .eyebrow {
  font-size: 20rpx;
  letter-spacing: 8rpx;
  color: rgba(255, 246, 238, 0.72);
}
.hero-text .h1 {
  margin-top: 18rpx;
  font-family: "Songti SC", "STSong", serif;
  font-size: 62rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  text-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.35);
}
.hero-text .h2 {
  margin-top: 16rpx;
  font-size: 25rpx;
  line-height: 1.7;
  color: rgba(255, 246, 238, 0.86);
  letter-spacing: 1rpx;
}

/* 开篇 */
.intro {
  margin: 72rpx 64rpx 0;
  padding-left: 24rpx;
  border-left: 2rpx solid rgba(201, 162, 39, 0.45);
}
.intro-line {
  font-family: "Songti SC", "STSong", serif;
  font-size: 31rpx;
  line-height: 2;
  color: #4a352e;
  letter-spacing: 1rpx;
}

/* 章节 */
.chapter {
  margin-top: 88rpx;
}
.ch-head {
  display: flex;
  align-items: baseline;
  gap: 18rpx;
  margin: 0 64rpx 26rpx;
}
.ch-no {
  font-family: "Songti SC", serif;
  font-size: 22rpx;
  color: #c9a227;
  letter-spacing: 2rpx;
}
.ch-title {
  font-family: "Songti SC", "STSong", serif;
  font-size: 42rpx;
  font-weight: 600;
  color: #3d2b22;
  letter-spacing: 6rpx;
}
.ch-line {
  flex: 1;
  height: 1rpx;
  background: linear-gradient(90deg, rgba(201, 162, 39, 0.35), rgba(201, 162, 39, 0));
}
.ch-img {
  display: block;
  width: 100%;
  height: auto;
}
.ch-body {
  margin: 34rpx 64rpx 0;
}
.ch-p {
  font-size: 29rpx;
  line-height: 2.05;
  color: #5a453c;
  letter-spacing: 0.5rpx;
  margin-bottom: 14rpx;
}

/* 引语 */
.quote {
  margin: 96rpx 56rpx 0;
  padding: 48rpx 40rpx;
  background: rgba(255, 240, 230, 0.7);
  border-radius: 18rpx;
  position: relative;
}
.q-mark {
  position: absolute;
  top: 4rpx;
  left: 26rpx;
  font-family: "Songti SC", serif;
  font-size: 76rpx;
  color: rgba(201, 162, 39, 0.35);
  line-height: 1;
}
.q-text {
  font-family: "Songti SC", "STSong", serif;
  font-size: 30rpx;
  line-height: 2;
  color: #6b4a3c;
  text-align: center;
  letter-spacing: 1rpx;
}

/* 收束 */
.closing {
  margin: 76rpx 64rpx 0;
  text-align: center;
}
.cl-line {
  font-size: 27rpx;
  line-height: 2.1;
  color: #7a6156;
  letter-spacing: 1rpx;
}

.back-link {
  margin: 64rpx auto 0;
  width: 260rpx;
  text-align: center;
  font-size: 24rpx;
  color: #a1857a;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(161, 133, 122, 0.3);
}
