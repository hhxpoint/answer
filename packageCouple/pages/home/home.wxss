page {
  background: linear-gradient(180deg, #fff7f2 0%, #ffece4 55%, #ffe3dd 100%);
  min-height: 100%;
}

button {
  margin: 0;
  padding: 0;
  background: none;
  line-height: normal;
  font-size: inherit;
}
button::after {
  border: none;
}

.page {
  position: relative;
  padding: 30rpx 32rpx 80rpx;
  overflow: hidden;
}

.deco {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
  filter: blur(2rpx);
}
.deco-a {
  top: -120rpx;
  right: -100rpx;
  width: 380rpx;
  height: 380rpx;
  background: radial-gradient(closest-side, rgba(255, 205, 170, 0.55), rgba(255, 205, 170, 0));
}
.deco-b {
  top: 520rpx;
  left: -160rpx;
  width: 400rpx;
  height: 400rpx;
  background: radial-gradient(closest-side, rgba(255, 178, 190, 0.4), rgba(255, 178, 190, 0));
}

.state {
  text-align: center;
  margin-top: 180rpx;
  font-size: 28rpx;
  color: #9a715c;
}
.state.err {
  color: #c9584f;
}

.hero {
  text-align: center;
  padding: 8rpx 0 6rpx;
}
.avatar-pair {
  display: flex;
  justify-content: center;
  margin-bottom: 8rpx;
}
.avatar-sm {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.95);
  box-shadow: 0 6rpx 16rpx rgba(214, 122, 78, 0.18);
  background: linear-gradient(135deg, #ffd0a8, #ff9f9f);
  color: #ffffff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.avatar-sm.me {
  margin-right: -16rpx;
  z-index: 2;
}
.avatar-sm.ta {
  margin-left: -16rpx;
}
.hero-title {
  font-size: 42rpx;
  font-weight: 800;
  color: #4a342b;
  letter-spacing: 3rpx;
}
.hero-sub {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: #a78c7e;
}

.pet-card {
  position: relative;
  margin-top: 26rpx;
  padding: 26rpx 30rpx 30rpx;
  border-radius: 40rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.96), rgba(255, 249, 245, 0.92));
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  box-shadow: 0 20rpx 48rpx rgba(214, 122, 78, 0.1);
  overflow: hidden;
}
.pet-glow {
  position: absolute;
  left: 50%;
  top: 40rpx;
  width: 420rpx;
  height: 300rpx;
  margin-left: -210rpx;
  border-radius: 50%;
  background: radial-gradient(closest-side, rgba(255, 190, 120, 0.35), rgba(255, 190, 120, 0));
  pointer-events: none;
}

.pet-name {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 4rpx;
}
.pet-name-text {
  font-size: 30rpx;
  font-weight: 700;
  color: #4a342b;
  letter-spacing: 1rpx;
}
.pet-name-edit {
  margin-left: 8rpx;
  font-size: 22rpx;
  color: #c9a08c;
}
.pet-name-tip {
  text-align: center;
  font-size: 19rpx;
  color: #c2a08c;
  margin-bottom: 2rpx;
}

.pet {
  position: relative;
  height: 330rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.pet-ambient {
  position: absolute;
  left: 50%;
  bottom: 46rpx;
  width: 540rpx;
  height: 430rpx;
  margin-left: -270rpx;
  border-radius: 50%;
  background: radial-gradient(closest-side, rgba(255, 176, 112, 0.42), rgba(255, 176, 112, 0));
  animation: ambientPulse 3.8s ease-in-out infinite;
}
.flame {
  position: relative;
  width: 230rpx;
  height: 300rpx;
  animation: breathe 2.6s ease-in-out infinite;
  transform-origin: 50% 100%;
  z-index: 2;
}
.flame-aura {
  position: absolute;
  left: 50%;
  bottom: 6rpx;
  width: 268rpx;
  height: 338rpx;
  margin-left: -134rpx;
  border-radius: 50% 50% 44% 44% / 64% 64% 36% 36%;
  background: radial-gradient(58% 62% at 50% 62%, rgba(255, 158, 96, 0.5), rgba(255, 120, 80, 0) 74%);
  animation: auraFlicker 1.9s ease-in-out infinite alternate;
}
.flame-body {
  position: absolute;
  left: 50%;
  bottom: 20rpx;
  width: 196rpx;
  height: 262rpx;
  margin-left: -98rpx;
  border-radius: 50% 50% 45% 45% / 64% 64% 36% 36%;
  background:
    radial-gradient(56% 44% at 35% 25%, rgba(255, 255, 255, 0.9), rgba(255, 255, 255, 0) 65%),
    radial-gradient(92% 74% at 50% 90%, #ff5c4c 0%, rgba(255, 92, 76, 0) 70%),
    radial-gradient(132% 112% at 50% 100%, #ffdf82 0%, #ffb45e 40%, #ff7d55 72%, #ef4a5e 100%);
  box-shadow:
    inset 14rpx 18rpx 30rpx rgba(255, 249, 214, 0.5),
    inset -18rpx -26rpx 42rpx rgba(212, 54, 64, 0.36),
    inset 0 -30rpx 52rpx rgba(255, 160, 90, 0.32),
    0 28rpx 64rpx rgba(255, 118, 78, 0.32);
  overflow: hidden;
}
.flame-mood {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  border-radius: inherit;
  background: transparent;
  transition: background 0.4s ease;
}
.flame.mood-sick .flame-mood {
  background: rgba(116, 136, 158, 0.28);
}
.flame.mood-miss .flame-mood {
  background: rgba(150, 158, 214, 0.14);
}
.flame-shine {
  position: absolute;
  left: 32rpx;
  top: 42rpx;
  width: 76rpx;
  height: 122rpx;
  border-radius: 50%;
  transform: rotate(-16deg);
  background: radial-gradient(58% 58% at 40% 32%, rgba(255, 255, 255, 0.95), rgba(255, 255, 255, 0) 72%);
  opacity: 0.92;
}
.flame-inner {
  position: absolute;
  left: 50%;
  bottom: 46rpx;
  width: 104rpx;
  height: 152rpx;
  margin-left: -52rpx;
  border-radius: 50% 50% 46% 46% / 62% 62% 38% 38%;
  background:
    radial-gradient(58% 48% at 42% 28%, rgba(255, 255, 255, 0.92), rgba(255, 255, 255, 0) 70%),
    radial-gradient(118% 100% at 50% 100%, #fffce2 0%, #ffeaa2 42%, #ffcf72 78%, rgba(255, 190, 100, 0) 100%);
  opacity: 0.95;
  animation: flicker 1.5s ease-in-out infinite alternate;
}
.flame-core {
  position: absolute;
  left: 50%;
  bottom: 84rpx;
  width: 52rpx;
  height: 74rpx;
  margin-left: -26rpx;
  border-radius: 50%;
  background: radial-gradient(58% 58% at 46% 34%, rgba(255, 255, 255, 0.96), rgba(255, 245, 190, 0.5) 60%, rgba(255, 245, 190, 0) 100%);
  animation: coreGlow 1.9s ease-in-out infinite alternate;
}
.face {
  position: absolute;
  left: 50%;
  bottom: 112rpx;
  width: 128rpx;
  margin-left: -64rpx;
  z-index: 3;
}
.eye {
  position: absolute;
  top: 0;
  width: 20rpx;
  height: 26rpx;
  border-radius: 50%;
  background: radial-gradient(62% 62% at 38% 30%, #7a3a1c, #3f1d0b 78%);
  box-shadow: 0 2rpx 4rpx rgba(110, 45, 20, 0.25);
  animation: blink 4.6s infinite;
}
.eye.left { left: 10rpx; }
.eye.right { right: 10rpx; }
.eye-shine {
  position: absolute;
  left: 4rpx;
  top: 4rpx;
  width: 7rpx;
  height: 7rpx;
  border-radius: 50%;
  background: #ffffff;
  opacity: 0.95;
}
.mouth {
  position: absolute;
  left: 50%;
  top: 34rpx;
  margin-left: -17rpx;
  width: 34rpx;
  height: 18rpx;
  border-bottom: 7rpx solid #5a2a12;
  border-radius: 0 0 50% 50%;
}
.blush {
  position: absolute;
  top: 24rpx;
  width: 26rpx;
  height: 14rpx;
  border-radius: 50%;
  background: radial-gradient(closest-side, rgba(255, 108, 108, 0.55), rgba(255, 108, 108, 0));
}
.blush.left { left: -12rpx; }
.blush.right { right: -12rpx; }

.flame.mood-sick .mouth {
  border-bottom: none;
  border-top: 6rpx solid #5a2a12;
  border-radius: 50% 50% 0 0;
  top: 36rpx;
}
.flame.mood-sick .eye {
  height: 18rpx;
}
.flame.mood-miss .eye {
  height: 16rpx;
}

.spark {
  position: absolute;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: radial-gradient(closest-side, #fff3c0, rgba(255, 190, 110, 0));
  opacity: 0;
  animation: sparkRise 3.6s linear infinite;
}
.spark.s1 { left: 20rpx; bottom: 132rpx; }
.spark.s2 { right: 28rpx; bottom: 112rpx; width: 7rpx; height: 7rpx; animation-delay: 1.3s; }
.spark.s3 { left: 64rpx; bottom: 96rpx; width: 6rpx; height: 6rpx; animation-delay: 2.4s; }

.pet-shadow {
  position: absolute;
  bottom: 2rpx;
  left: 50%;
  width: 250rpx;
  height: 28rpx;
  margin-left: -125rpx;
  background: radial-gradient(closest-side, rgba(160, 80, 60, 0.28), rgba(160, 80, 60, 0));
  border-radius: 50%;
}

.float-exp {
  position: absolute;
  top: 20rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 42rpx;
  font-weight: 800;
  color: #ff7d5c;
  text-shadow: 0 4rpx 12rpx rgba(255, 140, 100, 0.35);
  animation: rise 0.95s ease-out forwards;
  z-index: 5;
}

.level-pill {
  margin: 4rpx auto 0;
  display: table;
  padding: 6rpx 24rpx;
  border-radius: 999rpx;
  background: #fff1e8;
  color: #cf6240;
  font-size: 23rpx;
  font-weight: 600;
}

.bar {
  margin: 22rpx 8rpx 8rpx;
  height: 16rpx;
  background: #ffe9e0;
  border-radius: 16rpx;
  overflow: hidden;
}
.bar-fill {
  height: 100%;
  border-radius: 16rpx;
  background: linear-gradient(90deg, #ffd28a, #ff9b7a, #ff7a8a);
  transition: width 0.45s ease;
}
.bar-text {
  text-align: center;
  font-size: 20rpx;
  color: #b08e80;
}

.chips {
  display: flex;
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #fbe9e0;
}
.chip {
  flex: 1;
  text-align: center;
}
.chip-num {
  font-size: 34rpx;
  font-weight: 800;
  color: #e06a4a;
}
.chip-label {
  margin-top: 2rpx;
  font-size: 20rpx;
  color: #b08e80;
}

.actions {
  display: flex;
  margin-top: 24rpx;
}
.action {
  flex: 1;
  margin: 0 7rpx;
  padding: 20rpx 6rpx 14rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 10rpx 24rpx rgba(214, 122, 78, 0.09);
  text-align: center;
  transition: transform 0.12s ease;
}
.action:active {
  transform: scale(0.94);
}
.action.done {
  opacity: 0.45;
}
.action-emoji {
  font-size: 40rpx;
  line-height: 1.1;
}
.action-name {
  margin-top: 4rpx;
  font-size: 23rpx;
  color: #5a3a2c;
  font-weight: 600;
}
.action-count {
  margin-top: 2rpx;
  font-size: 19rpx;
  color: #b08e80;
}

.partner-bar {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.85);
  box-shadow: 0 10rpx 24rpx rgba(214, 122, 78, 0.08);
}
.avatar {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ffd0a8, #ff9f9f);
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}
.avatar-img {
  display: block;
}

.partner-text {
  flex: 1;
  margin-left: 18rpx;
}
.partner-name {
  font-size: 27rpx;
  font-weight: 700;
  color: #4a342b;
}
.partner-sub {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #a78c7e;
}
.partner-tag {
  flex-shrink: 0;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  background: #fff3e6;
  color: #c98a2e;
}
.partner-tag.ok {
  background: #eaf7ee;
  color: #2f9e5b;
}

.invite-card {
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #fff5ee, #ffe6df);
  border: 1rpx dashed rgba(255, 150, 120, 0.45);
}
.invite-head {
  text-align: center;
}
.invite-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #4a342b;
}
.invite-sub {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: #a78c7e;
}
.invite-code {
  margin: 18rpx 0;
  text-align: center;
  font-size: 58rpx;
  font-weight: 800;
  letter-spacing: 14rpx;
  color: #e06a4a;
}
.invite-actions {
  display: flex;
}
.share-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 42rpx;
  background: linear-gradient(135deg, #ffb27a, #ff8a7a);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
  box-shadow: 0 10rpx 24rpx rgba(255, 140, 110, 0.3);
  margin-right: 16rpx;
}
.copy-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 42rpx;
  background: #ffffff;
  color: #cf6240;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
  border: 1rpx solid rgba(255, 150, 120, 0.4);
}

.entries {
  margin-top: 24rpx;
}
.entry {
  display: flex;
  align-items: center;
  padding: 24rpx 26rpx;
  margin-bottom: 18rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 10rpx 26rpx rgba(214, 122, 78, 0.08);
}
.entry:active {
  transform: scale(0.98);
}
.entry-emoji {
  width: 70rpx;
  height: 70rpx;
  border-radius: 22rpx;
  background: #fff3ea;
  font-size: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}
.entry-text {
  flex: 1;
}
.entry-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #4a342b;
}
.entry-sub {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #a78c7e;
}
.entry-arrow {
  font-size: 38rpx;
  color: #d3b3a3;
}

.footer {
  margin-top: 32rpx;
  text-align: center;
  font-size: 21rpx;
  color: #c2a08c;
}

@keyframes breathe {
  0%, 100% { transform: scale(1, 1); }
  50% { transform: scale(1.035, 0.965); }
}
@keyframes flicker {
  0% { transform: scale(0.96, 1); opacity: 0.88; }
  100% { transform: scale(1.04, 0.97); opacity: 1; }
}
@keyframes blink {
  0%, 92%, 100% { transform: scaleY(1); }
  95% { transform: scaleY(0.1); }
}
@keyframes rise {
  0% { opacity: 0; transform: translate(-50%, 20rpx) scale(0.85); }
  30% { opacity: 1; }
  100% { opacity: 0; transform: translate(-50%, -70rpx) scale(1.1); }
}
@keyframes ambientPulse {
  0%, 100% { opacity: 0.75; transform: scale(1); }
  50% { opacity: 1; transform: scale(1.06); }
}
@keyframes auraFlicker {
  0% { opacity: 0.8; transform: scale(0.97, 1); }
  100% { opacity: 1; transform: scale(1.03, 0.98); }
}
@keyframes coreGlow {
  0% { opacity: 0.75; transform: scale(0.94); }
  100% { opacity: 1; transform: scale(1.06); }
}
@keyframes sparkRise {
  0% { opacity: 0; transform: translate(0, 0) scale(0.6); }
  12% { opacity: 0.9; }
  70% { opacity: 0.5; }
  100% { opacity: 0; transform: translate(6rpx, -150rpx) scale(0.2); }
}
