@import "../../styles/boundary.wxss";
page {
  background:
    radial-gradient(circle at 12% 4%, rgba(255, 218, 185, 0.55), transparent 34%),
    radial-gradient(circle at 92% 18%, rgba(255, 196, 202, 0.42), transparent 36%),
    linear-gradient(180deg, #fff9f4 0%, #ffefe6 52%, #ffe7e0 100%);
  min-height: 100%;
}
.page { position: relative; padding: 26rpx 32rpx 70rpx; overflow: hidden; color: #4a342b; }

.deco { position: absolute; border-radius: 50%; pointer-events: none; filter: blur(2rpx); }
.deco-a { top: -140rpx; right: -110rpx; width: 420rpx; height: 420rpx; background: radial-gradient(closest-side, rgba(255, 199, 155, .5), transparent); }
.deco-b { top: 700rpx; left: -180rpx; width: 460rpx; height: 460rpx; background: radial-gradient(closest-side, rgba(255, 172, 180, .32), transparent); }
.deco-c { bottom: -160rpx; right: -120rpx; width: 400rpx; height: 400rpx; background: radial-gradient(closest-side, rgba(255, 214, 170, .35), transparent); }

.hero { position: relative; padding: 24rpx 6rpx 30rpx; }
.eyebrow { font-size: 18rpx; letter-spacing: 5rpx; color: #c39a80; font-weight: 600; }
.hero-title { margin-top: 14rpx; font-size: 52rpx; line-height: 1.2; font-weight: 800; letter-spacing: 2rpx; color: #3f2b22; }
.hero-sub { margin-top: 14rpx; font-size: 24rpx; color: #a5836f; }
.hero-meta { display: flex; align-items: center; gap: 18rpx; margin-top: 22rpx; }
.count-pill { display: flex; align-items: baseline; gap: 6rpx; padding: 8rpx 20rpx; border-radius: 999rpx; background: rgba(255,255,255,.72); border: 1rpx solid rgba(255,255,255,.9); box-shadow: 0 8rpx 22rpx rgba(196,125,82,.08); }
.count-num { font-size: 28rpx; font-weight: 800; color: #b96f45; }
.count-label { font-size: 20rpx; color: #a5836f; }
.limit-text { font-size: 20rpx; color: #c0a793; }

/* 骨架 */
.skeleton-wrap { margin-top: 8rpx; }
.skeleton-card { display: flex; align-items: center; gap: 22rpx; padding: 30rpx; border-radius: 32rpx; background: rgba(255,255,255,.6); margin-bottom: 20rpx; }
.sk-avatar { width: 96rpx; height: 96rpx; border-radius: 50%; background: rgba(255,230,214,.8); }
.sk-lines { flex: 1; }
.sk-line { height: 20rpx; border-radius: 12rpx; background: rgba(255,230,214,.8); margin-bottom: 14rpx; }
.sk-line.w40 { width: 40%; } .sk-line.w60 { width: 60%; } .sk-line.w80 { width: 80%; }

/* 错误 */
.error-card { margin-top: 30rpx; padding: 36rpx; border-radius: 30rpx; background: rgba(255,255,255,.86); text-align: center; }
.error-title { font-size: 30rpx; font-weight: 700; }
.error-desc { margin-top: 12rpx; font-size: 23rpx; color: #a5836f; line-height: 1.6; }
.error-card .ghost-btn { margin-top: 22rpx; }

/* 空状态 */
.empty { margin-top: 30rpx; padding: 46rpx 30rpx 40rpx; border-radius: 38rpx; background: rgba(255,255,255,.7); border: 1rpx solid rgba(255,255,255,.9); box-shadow: 0 20rpx 50rpx rgba(196,125,82,.09); text-align: center; }
.empty-flame { position: relative; width: 150rpx; height: 150rpx; margin: 0 auto 22rpx; }
.ef-glow { position: absolute; inset: -20rpx; border-radius: 50%; background: radial-gradient(closest-side, rgba(255,190,120,.5), transparent); }
.ef-body { position: absolute; left: 50%; bottom: 8rpx; width: 84rpx; height: 112rpx; margin-left: -42rpx; border-radius: 50% 50% 46% 46% / 64% 64% 36% 36%; background: radial-gradient(130% 110% at 50% 100%, #ffd97a 0%, #ffb15c 45%, #ff7d55 78%, #ef4c5e 100%); box-shadow: 0 16rpx 34rpx rgba(239,92,94,.25); }
.ef-core { position: absolute; left: 50%; bottom: 26rpx; width: 28rpx; height: 38rpx; margin-left: -14rpx; border-radius: 50%; background: radial-gradient(closest-side, #fffbe6, rgba(255,245,190,.15)); }
.empty-title { font-size: 33rpx; font-weight: 800; }
.empty-desc { margin-top: 14rpx; font-size: 23rpx; color: #a5836f; line-height: 1.7; }
.empty-actions { display: flex; gap: 16rpx; margin-top: 30rpx; }
.empty-actions .primary-btn, .empty-actions .ghost-btn { flex: 1; }

/* 卡片 */
.space-list { margin-top: 6rpx; }
.space-card {
  position: relative; margin-bottom: 22rpx; padding: 24rpx 26rpx 22rpx; border-radius: 34rpx;
  background: linear-gradient(145deg, rgba(255,255,255,.96), rgba(255,251,247,.9));
  border: 1rpx solid rgba(255,255,255,.95);
  box-shadow: 0 18rpx 40rpx rgba(190,120,80,.10);
  overflow: hidden;
}
.space-card::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 8rpx; background: #d8b49b; opacity: .8; }
.space-card.is-current { box-shadow: 0 20rpx 44rpx rgba(210,120,80,.18); }
.rel-family::before { background: #86a08a; }
.rel-partner::before { background: #e19696; }
.rel-friend::before { background: #d0ac6a; }
.rel-custom::before { background: #a49ac4; }
.rel-unset::before { background: #c3b3a6; }

.card-top { display: flex; align-items: center; justify-content: space-between; }
.relation-badge { display: inline-flex; align-items: center; gap: 8rpx; padding: 6rpx 16rpx; border-radius: 999rpx; background: #f7f0e9; }
.relation-icon { font-size: 20rpx; color: #8a6a55; }
.relation-name { font-size: 20rpx; color: #8a6a55; letter-spacing: 1rpx; }
.rel-family .relation-badge { background: #eef5ee; } .rel-family .relation-icon, .rel-family .relation-name { color: #5f7d65; }
.rel-partner .relation-badge { background: #fdeeee; } .rel-partner .relation-icon, .rel-partner .relation-name { color: #b35f5f; }
.rel-friend .relation-badge { background: #fbf3e2; } .rel-friend .relation-icon, .rel-friend .relation-name { color: #92713a; }
.rel-custom .relation-badge { background: #f1eef8; } .rel-custom .relation-icon, .rel-custom .relation-name { color: #6f638f; }

.card-tools { display: flex; align-items: center; gap: 12rpx; }
.unread { min-width: 32rpx; height: 32rpx; padding: 0 10rpx; border-radius: 999rpx; background: #d9785f; color: #fff; font-size: 18rpx; display: flex; align-items: center; justify-content: center; }
.more { font-size: 32rpx; color: #c7b2a2; padding: 0 6rpx; letter-spacing: 2rpx; }

.card-main { display: flex; align-items: center; gap: 20rpx; margin-top: 18rpx; }
.avatar-shell { position: relative; width: 96rpx; height: 96rpx; flex-shrink: 0; }
.avatar { width: 96rpx; height: 96rpx; border-radius: 50%; border: 4rpx solid rgba(255,255,255,.95); box-shadow: 0 8rpx 20rpx rgba(190,120,80,.14); background: linear-gradient(135deg, #ffd6b4, #ffb5b5); }
.avatar-letter { display: flex; align-items: center; justify-content: center; color: #fff; font-size: 32rpx; font-weight: 700; }
.flame-dot { position: absolute; right: -4rpx; bottom: -4rpx; width: 34rpx; height: 34rpx; border-radius: 50%; background: #fff; display: flex; align-items: center; justify-content: center; box-shadow: 0 4rpx 10rpx rgba(190,120,80,.16); }
.flame-dot-text { font-size: 18rpx; }

.card-info { flex: 1; min-width: 0; }
.card-title { font-size: 32rpx; font-weight: 800; letter-spacing: .5rpx; color: #3f2b22; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.card-sub { margin-top: 8rpx; font-size: 21rpx; color: #a5836f; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.enter-arrow { font-size: 40rpx; color: #d1b29e; padding-left: 6rpx; }

.card-foot { margin-top: 18rpx; padding-top: 16rpx; border-top: 1rpx solid rgba(240,220,205,.7); display: flex; align-items: center; justify-content: space-between; }
.pet-line { display: flex; align-items: center; gap: 6rpx; }
.pet-flame { font-size: 18rpx; }
.pet-name { font-size: 20rpx; color: #8a6a55; max-width: 150rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.pet-lv { font-size: 18rpx; color: #c08a5e; background: #fff2e2; border-radius: 8rpx; padding: 2rpx 8rpx; }
.last-line { display: flex; align-items: center; gap: 10rpx; max-width: 55%; }
.last-text { font-size: 20rpx; color: #b49a88; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.last-time { font-size: 18rpx; color: #c8b4a4; flex-shrink: 0; }

/* 新建卡 */
.add-card { display: flex; align-items: center; gap: 20rpx; padding: 28rpx; border-radius: 32rpx; border: 2rpx dashed #e4c9b6; background: rgba(255,255,255,.45); }
.add-plus { width: 64rpx; height: 64rpx; border-radius: 50%; background: rgba(255,255,255,.9); color: #c08a5e; font-size: 38rpx; display: flex; align-items: center; justify-content: center; }
.add-title { font-size: 27rpx; font-weight: 700; color: #6b4c3a; }
.add-sub { margin-top: 6rpx; font-size: 20rpx; color: #b49a88; }

/* 底部 */
.bottom-actions { display: flex; gap: 16rpx; margin-top: 30rpx; }
.bottom-primary { flex: 1; height: 88rpx; border-radius: 999rpx; background: linear-gradient(135deg, #f5a05f, #e97b3e); color: #fff; font-size: 26rpx; font-weight: 700; display: flex; align-items: center; justify-content: center; box-shadow: 0 14rpx 30rpx rgba(233,123,62,.22); }
.bottom-ghost { width: 220rpx; height: 88rpx; border-radius: 999rpx; background: rgba(255,255,255,.78); border: 1rpx solid rgba(220,190,168,.6); color: #8a6a55; font-size: 24rpx; display: flex; align-items: center; justify-content: center; }

.primary-btn { height: 84rpx; border-radius: 999rpx; background: linear-gradient(135deg, #f5a05f, #e97b3e); color: #fff; font-size: 26rpx; font-weight: 700; display: flex; align-items: center; justify-content: center; box-shadow: 0 12rpx 26rpx rgba(233,123,62,.2); }
.ghost-btn { height: 84rpx; border-radius: 999rpx; background: rgba(255,255,255,.8); border: 1rpx solid rgba(220,190,168,.6); color: #8a6a55; font-size: 24rpx; display: flex; align-items: center; justify-content: center; }

.footer { text-align: center; margin-top: 40rpx; font-size: 19rpx; color: #c3ac9b; line-height: 1.6; }

/* 新建关系空间前的密码弹窗 */
.pass-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(32, 24, 20, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
  padding: 0 48rpx;
}
.pass-card {
  width: 100%;
  background: #fffdfb;
  border-radius: 28rpx;
  padding: 40rpx 36rpx 32rpx;
  box-shadow: 0 30rpx 80rpx rgba(60, 40, 30, 0.25);
}
.pass-title { font-size: 32rpx; font-weight: 700; color: #3d2b22; text-align: center; }
.pass-sub { margin-top: 10rpx; font-size: 22rpx; color: #a08b80; text-align: center; }
.pass-input {
  margin-top: 28rpx;
  height: 92rpx;
  padding: 0 24rpx;
  background: #faf5f1;
  border: 1rpx solid #eadfd7;
  border-radius: 18rpx;
  font-size: 32rpx;
  letter-spacing: 8rpx;
  text-align: center;
  color: #3d2b22;
}
.pass-err { margin-top: 14rpx; font-size: 22rpx; color: #d9584a; text-align: center; }
.pass-actions { display: flex; gap: 18rpx; margin-top: 30rpx; }
.pass-btn { flex: 1; height: 84rpx; line-height: 84rpx; text-align: center; border-radius: 18rpx; font-size: 28rpx; }
.pass-btn.ghost { background: #f6f0ea; color: #8a7365; }
.pass-btn.primary { background: linear-gradient(135deg, #f7a072, #f2795b); color: #fff; font-weight: 600; }
