page {
  background: #f6f1ec;
  height: 100%;
  overflow: hidden;
}

.page {
  position: relative;
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
}

.bg-glow {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}
.glow-a {
  top: -160rpx;
  right: -140rpx;
  width: 420rpx;
  height: 420rpx;
  background: radial-gradient(closest-side, rgba(255, 200, 170, 0.35), rgba(255, 200, 170, 0));
}
.glow-b {
  bottom: 160rpx;
  left: -180rpx;
  width: 400rpx;
  height: 400rpx;
  background: radial-gradient(closest-side, rgba(255, 185, 195, 0.28), rgba(255, 185, 195, 0));
}

.tip {
  text-align: center;
  margin-top: 200rpx;
  color: #9a715c;
  font-size: 28rpx;
}
.tip.error {
  color: #c9584f;
}

/* ===== 顶栏 ===== */
.topbar {
  position: relative;
  z-index: 2;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  padding: 20rpx 28rpx 16rpx;
  background: rgba(255, 250, 246, 0.94);
  border-bottom: 1rpx solid #f0e4da;
}
.top-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 18rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
  overflow: hidden;
  background: linear-gradient(135deg, #ffd0a8, #ff9f9f);
  color: #ffffff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 16rpx rgba(255, 150, 120, 0.22);
}
.topbar-main {
  flex: 1;
  min-width: 0;
}
.title {
  font-size: 34rpx;
  font-weight: 800;
  color: #4a342b;
  letter-spacing: 1rpx;
}
.sub {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #a78c7e;
}
.conn {
  flex-shrink: 0;
  margin-left: 14rpx;
  padding: 5rpx 16rpx;
  border-radius: 999rpx;
  font-size: 19rpx;
  background: #fff3e6;
  color: #c98a2e;
}
.conn.ok {
  background: #e8f7ee;
  color: #2f9e5b;
}

/* ===== 消息列表 ===== */
.msg-list {
  position: relative;
  z-index: 1;
  flex: 1 1 0;
  height: 0;
  min-height: 0;
  padding: 0 24rpx;
  box-sizing: border-box;
  -webkit-overflow-scrolling: touch;
  overscroll-behavior: contain;
}
/* 滚动条（支持 WebView 的设备上显示细金色滑条） */
.msg-list ::-webkit-scrollbar {
  width: 8rpx;
}
.msg-list ::-webkit-scrollbar-track {
  background: transparent;
}
.msg-list ::-webkit-scrollbar-thumb {
  background: rgba(190, 160, 140, 0.35);
  border-radius: 8rpx;
}
.list-top {
  height: 16rpx;
}
.list-bottom {
  height: 30rpx;
}

.time-row {
  text-align: center;
  margin: 22rpx 0 12rpx;
  font-size: 20rpx;
  color: #b8a99b;
}

.system-row {
  display: table;
  margin: 14rpx auto;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(120, 100, 90, 0.08);
  font-size: 21rpx;
  color: #a08f82;
}

.msg-row {
  display: flex;
  align-items: flex-start;
  margin: 16rpx 0;
}
.msg-row.them {
  flex-direction: row;
}
.msg-row.mine {
  flex-direction: row-reverse;
}

.msg-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 18rpx;
  flex-shrink: 0;
  overflow: hidden;
  background: linear-gradient(135deg, #ffd0a8, #ff9f9f);
  color: #ffffff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 14rpx rgba(214, 122, 78, 0.16);
}
.msg-row.them .msg-avatar {
  margin-right: 16rpx;
}
.msg-row.mine .msg-avatar {
  margin-left: 16rpx;
}

.bubble {
  position: relative;
  max-width: 66%;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  font-size: 30rpx;
  line-height: 1.5;
  word-break: break-all;
}
.bubble-mine {
  background: linear-gradient(135deg, #ffb08a, #ff8e9e);
  color: #ffffff;
  border-top-right-radius: 6rpx;
  box-shadow: 0 10rpx 22rpx rgba(255, 140, 130, 0.22);
}
.bubble-them {
  background: #ffffff;
  color: #3b2f2a;
  border-top-left-radius: 6rpx;
  box-shadow: 0 8rpx 20rpx rgba(120, 90, 70, 0.08);
}
.bubble-text {
  font-size: 30rpx;
  line-height: 1.5;
}

.tail {
  position: absolute;
  top: 22rpx;
  width: 0;
  height: 0;
  border-style: solid;
}
.bubble-them .tail {
  left: -10rpx;
  border-width: 9rpx 12rpx 9rpx 0;
  border-color: transparent #ffffff transparent transparent;
}
.bubble-mine .tail {
  right: -10rpx;
  border-width: 9rpx 0 9rpx 12rpx;
  border-color: transparent transparent transparent #ff9a92;
}

.reply-box {
  margin-bottom: 10rpx;
  padding: 10rpx 14rpx;
  border-radius: 8rpx;
  border-left: 5rpx solid rgba(0, 0, 0, 0.14);
  background: rgba(0, 0, 0, 0.06);
}
.bubble-mine .reply-box {
  border-left-color: rgba(255, 255, 255, 0.5);
  background: rgba(255, 255, 255, 0.18);
}
.reply-name {
  font-size: 20rpx;
  opacity: 0.72;
}
.reply-text {
  margin-top: 2rpx;
  font-size: 22rpx;
  opacity: 0.85;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* ===== 新消息提示 ===== */
.new-msg {
  position: absolute;
  right: 30rpx;
  bottom: 220rpx;
  z-index: 5;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.97);
  color: #d2694a;
  font-size: 23rpx;
  box-shadow: 0 10rpx 24rpx rgba(140, 100, 80, 0.18);
  opacity: 0;
  transform: translateY(12rpx);
  pointer-events: none;
  transition: opacity 0.2s ease, transform 0.2s ease;
}
.new-msg.show {
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}

/* ===== 输入区 ===== */
.input-area {
  position: relative;
  z-index: 3;
  flex-shrink: 0;
  padding: 14rpx 24rpx 22rpx;
  padding-bottom: calc(22rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(22rpx + env(safe-area-inset-bottom));
  background: rgba(255, 250, 246, 0.97);
  border-top: 1rpx solid #f0e4da;
}

.quote-bar {
  display: flex;
  align-items: center;
  padding: 12rpx 16rpx;
  margin-bottom: 12rpx;
  border-radius: 14rpx;
  background: #f7f0e9;
}
.quote-line {
  width: 6rpx;
  height: 52rpx;
  border-radius: 6rpx;
  background: #ffb08a;
  margin-right: 14rpx;
  flex-shrink: 0;
}
.quote-info {
  flex: 1;
  min-width: 0;
}
.quote-name {
  font-size: 20rpx;
  color: #b08974;
}
.quote-text {
  margin-top: 2rpx;
  font-size: 23rpx;
  color: #7d6a5d;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.quote-close {
  flex-shrink: 0;
  margin-left: 12rpx;
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  border-radius: 50%;
  color: #a78c7e;
  font-size: 30rpx;
}

.input-row {
  display: flex;
  align-items: center;
}
.chat-input {
  flex: 1;
  height: 80rpx;
  padding: 0 24rpx;
  background: #f5efe9;
  border-radius: 16rpx;
  font-size: 29rpx;
  color: #3b2f2a;
}
.send-btn {
  margin-left: 16rpx;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 34rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #ffb27a, #ff8a7a);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 18rpx rgba(255, 140, 110, 0.26);
  transition: opacity 0.15s ease;
}
.send-btn.disabled {
  opacity: 0.6;
}

/* ===== 长按操作菜单（仿微信样式） ===== */
.action-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  background: rgba(0, 0, 0, 0.12);
}
.action-menu {
  position: fixed;
  width: 236rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: rgba(64, 64, 64, 0.97);
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.28);
}
.action-item {
  padding: 24rpx 0;
  text-align: center;
  color: #ffffff;
  font-size: 28rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
}
.action-item:last-child {
  border-bottom: none;
}
.action-item:active {
  background: rgba(255, 255, 255, 0.12);
}

/* 乐观发送状态 */
.send-status {
  max-width: 240rpx;
  margin: 0 12rpx 10rpx;
  font-size: 20rpx;
  color: #b49a88;
  text-align: right;
  line-height: 1.4;
}
.msg-row.them .send-status { text-align: left; }
.send-status.send-failed {
  color: #c25b4e;
  text-decoration: underline;
}
