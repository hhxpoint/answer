page {
  background: #0d1117;
  color: #f0eee6;
  height: 100vh;
  overflow-y: auto;
}

.gomoku-page {
  position: relative;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 28rpx 30rpx 44rpx;
  background:
    radial-gradient(120% 60% at 100% -10%, rgba(212, 175, 55, 0.10), transparent 56%),
    radial-gradient(90% 50% at -10% 30%, rgba(125, 86, 42, 0.12), transparent 60%),
    #0d1117;
  overflow-x: hidden;
}

.deco {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
  filter: blur(2rpx);
}
.deco-a {
  width: 360rpx;
  height: 360rpx;
  right: -160rpx;
  top: 90rpx;
  border: 1rpx solid rgba(212, 175, 55, 0.10);
}
.deco-b {
  width: 220rpx;
  height: 220rpx;
  left: -120rpx;
  bottom: 80rpx;
  border: 1rpx solid rgba(212, 175, 55, 0.08);
}

.state {
  padding: 160rpx 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: #a69b8f;
}
.state.err { color: #d99b82; }

.topline {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}
.kicker {
  font-family: "SF Mono", Menlo, Consolas, monospace;
  font-size: 15rpx;
  letter-spacing: 2.2rpx;
  color: #8f7d5e;
}
.page-title {
  margin-top: 8rpx;
  font-family: "Songti SC", "STSong", "Noto Serif SC", serif;
  font-size: 54rpx;
  line-height: 1.1;
  letter-spacing: 2rpx;
  color: #e9ddc7;
}
.conn-pill {
  margin-top: 12rpx;
  padding: 7rpx 14rpx;
  border: 1rpx solid rgba(212, 175, 55, 0.35);
  border-radius: 999rpx;
  font-family: "SF Mono", Menlo, monospace;
  font-size: 14rpx;
  letter-spacing: 0.8rpx;
  color: #d4af37;
}
.conn-pill.bad { color: #c98269; border-color: rgba(201, 130, 105, 0.4); }

.players {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  margin-top: 30rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid rgba(212, 175, 55, 0.15);
  border-radius: 8rpx;
  background: rgba(22, 26, 35, 0.72);
}
.player {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-width: 0;
}
.player.right { justify-content: flex-end; }
.player.active .player-name { color: #ffd77a; }
.player.active .avatar-wrap { box-shadow: 0 0 0 2rpx #ffd15c, 0 0 24rpx rgba(255, 207, 86, 0.35); }
.avatar-wrap {
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  padding: 3rpx;
  box-sizing: border-box;
  background: #2b241b;
  flex-shrink: 0;
}
.avatar-wrap.black { background: #050505; }
.avatar-wrap.white { background: #d5c8b3; }
.avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  display: block;
}
.avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #1b202a;
  color: #d4af37;
  font-size: 24rpx;
  font-family: "Songti SC", serif;
}
.player-info { min-width: 0; }
.player-info.right { text-align: right; }
.player-name {
  font-family: "Songti SC", "STSong", serif;
  font-size: 25rpx;
  color: #e6dcc9;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.player-side {
  margin-top: 4rpx;
  font-family: "SF Mono", Menlo, monospace;
  font-size: 14rpx;
  color: #8d7a5d;
}
.vs {
  padding: 0 14rpx;
  font-family: Georgia, serif;
  font-size: 22rpx;
  font-style: italic;
  color: #a58a52;
}

.turn-strip {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 22rpx 2rpx 12rpx;
  min-height: 38rpx;
}
.turn-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(255, 255, 255, 0.22);
}
.turn-dot.black { background: #090909; box-shadow: inset 0 2rpx 4rpx rgba(255,255,255,.16); }
.turn-dot.white { background: #f0e6d2; box-shadow: inset 0 -2rpx 4rpx rgba(0,0,0,.16); }
.turn-text {
  flex: 1;
  font-size: 21rpx;
  letter-spacing: 0.6rpx;
  color: #cbbd9f;
}
.turn-strip.live .turn-text { color: #f2dfb0; }
.move-count {
  font-family: "SF Mono", Menlo, monospace;
  font-size: 14rpx;
  color: #7f6d51;
}

.board-wrap {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: center;
  margin-top: 4rpx;
}
.board-frame {
  position: relative;
  padding: 7rpx;
  border: 1rpx solid rgba(244, 211, 139, 0.38);
  border-radius: 8rpx;
  background: linear-gradient(135deg, #8f6632, #d2aa6d 46%, #765027);
  box-shadow:
    0 22rpx 46rpx rgba(0, 0, 0, 0.62),
    0 0 0 1rpx rgba(255, 226, 166, 0.15);
}
.board-canvas {
  display: block;
  border-radius: 3rpx;
  background: #d5b076;
}
.board-loading {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(13, 17, 23, 0.7);
  color: #d5c29a;
  font-size: 18rpx;
}
.board-cover {
  position: absolute;
  top: 7rpx;
  right: 7rpx;
  bottom: 7rpx;
  left: 7rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 30rpx;
  text-align: center;
  background: rgba(11, 14, 19, 0.78);
  backdrop-filter: blur(3rpx);
  border-radius: 3rpx;
}
.cover-kicker {
  font-family: "SF Mono", Menlo, monospace;
  font-size: 14rpx;
  letter-spacing: 2.4rpx;
  color: #d4af37;
}
.cover-title {
  margin-top: 16rpx;
  font-family: "Songti SC", "STSong", serif;
  font-size: 44rpx;
  color: #f4e5c4;
}
.cover-copy {
  margin-top: 12rpx;
  font-size: 18rpx;
  line-height: 1.8;
  color: #9e8f78;
}
.start-btn {
  margin-top: 26rpx;
  padding: 18rpx 52rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #f0d286, #c79a45);
  color: #22180c;
  font-family: "Songti SC", serif;
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  box-shadow: 0 10rpx 22rpx rgba(198, 150, 66, 0.3);
}
.start-btn.disabled { opacity: 0.45; box-shadow: none; }
.cover-hint {
  margin-top: 14rpx;
  font-size: 16rpx;
  color: #887657;
}

.controls {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: center;
  gap: 34rpx;
  margin-top: 20rpx;
}
.control-link {
  padding: 8rpx 0;
  font-size: 18rpx;
  color: #d4af37;
  letter-spacing: 0.6rpx;
}
.control-link.muted { color: #85745a; }
.rules-note {
  position: relative;
  z-index: 1;
  margin: 20rpx 8rpx 0;
  font-size: 16rpx;
  line-height: 1.8;
  color: #6f614f;
  text-align: center;
}

.result-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 30;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  background: rgba(5, 7, 10, 0.72);
}
.result-card {
  width: 100%;
  max-width: 560rpx;
  padding: 34rpx 32rpx 28rpx;
  border: 1rpx solid rgba(212, 175, 55, 0.38);
  border-radius: 12rpx;
  background: #151a22;
  text-align: center;
  box-shadow: 0 26rpx 60rpx rgba(0,0,0,.55);
}
.result-kicker {
  font-family: "SF Mono", Menlo, monospace;
  font-size: 14rpx;
  letter-spacing: 2rpx;
  color: #a58a52;
}
.result-seal {
  width: 86rpx;
  height: 86rpx;
  margin: 20rpx auto 12rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: "Songti SC", "STSong", serif;
  font-size: 38rpx;
}
.result-seal.black { background: #080808; color: #e6d8bf; border: 1rpx solid rgba(255,255,255,.22); }
.result-seal.white { background: #efe4cf; color: #5b4328; border: 1rpx solid rgba(255,255,255,.65); }
.result-seal.draw { background: #2a2e36; color: #c7b48e; border: 1rpx solid rgba(212,175,55,.3); }
.result-title {
  font-family: "Songti SC", "STSong", serif;
  font-size: 42rpx;
  color: #f1e1bf;
}
.result-sub {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #9f8f74;
}
.result-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 28rpx;
}
.result-btn {
  flex: 1;
  padding: 16rpx 0;
  border: 1rpx solid rgba(212, 175, 55, 0.35);
  border-radius: 999rpx;
  font-size: 21rpx;
  color: #d4af37;
}
.result-btn.primary {
  background: #d4af37;
  color: #20180d;
  border-color: #d4af37;
  font-weight: 600;
}
.pressed { opacity: 0.7; }
