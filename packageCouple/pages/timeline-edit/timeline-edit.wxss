page {
  background: linear-gradient(180deg, #fff9f4 0%, #ffefe6 100%);
  min-height: 100%;
}

.page {
  position: relative;
  min-height: 100vh;
  padding: 0 36rpx 220rpx;
  box-sizing: border-box;
  overflow: hidden;
}
.bg-a {
  position: absolute;
  top: -140rpx;
  right: -140rpx;
  width: 420rpx;
  height: 420rpx;
  border-radius: 50%;
  background: radial-gradient(closest-side, rgba(255, 205, 170, 0.42), rgba(255, 205, 170, 0));
  pointer-events: none;
}

.hero {
  position: relative;
  padding: 40rpx 4rpx 24rpx;
}
.hero-sub {
  font-size: 22rpx;
  color: #a78c7e;
}
.hero-title {
  margin-top: 8rpx;
  font-size: 46rpx;
  font-weight: 800;
  color: #4a342b;
  letter-spacing: 3rpx;
}

.card {
  position: relative;
  padding: 30rpx 28rpx 28rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.97);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  box-shadow: 0 16rpx 40rpx rgba(214, 122, 78, 0.08);
}

.editor {
  width: 100%;
  min-height: 260rpx;
  font-size: 30rpx;
  line-height: 1.7;
  color: #4a342b;
  box-sizing: border-box;
}
.ph {
  color: #c4ada0;
}

.divider {
  margin: 24rpx 0 20rpx;
  height: 1rpx;
  background: linear-gradient(90deg, rgba(240, 226, 214, 0.2), rgba(240, 226, 214, 0.95), rgba(240, 226, 214, 0.2));
}

.img-grid {
  display: flex;
  flex-wrap: wrap;
}
.img-cell {
  position: relative;
  width: calc(33.333% - 10rpx);
  height: 200rpx;
  margin: 0 15rpx 15rpx 0;
  border-radius: 18rpx;
  overflow: hidden;
}
.img-cell:nth-child(3n) {
  margin-right: 0;
}
.thumb {
  width: 100%;
  height: 100%;
  display: block;
}
.del {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(30, 20, 16, 0.55);
  color: #ffffff;
  font-size: 28rpx;
}
.img-add {
  width: calc(33.333% - 10rpx);
  height: 200rpx;
  border-radius: 18rpx;
  border: 2rpx dashed #f0d9c9;
  background: #fffaf6;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.plus {
  font-size: 48rpx;
  font-weight: 300;
  color: #e0b49a;
  line-height: 1;
}
.add-text {
  margin-top: 10rpx;
  font-size: 20rpx;
  color: #c4a795;
}

.tips {
  margin: 26rpx 8rpx 0;
  text-align: center;
  font-size: 21rpx;
  color: #b89f90;
  line-height: 1.6;
}

.publish-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx 36rpx 22rpx;
  padding-bottom: calc(22rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(22rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(255, 249, 244, 0), rgba(255, 249, 244, 0.96) 40%);
}
.publish-btn {
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  border-radius: 26rpx;
  background: linear-gradient(135deg, #ffb27a, #ff8a7a);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 12rpx 28rpx rgba(255, 140, 110, 0.3);
  transition: transform 0.15s ease, opacity 0.15s ease;
}
.publish-btn:active {
  transform: scale(0.98);
}
.publish-btn.disabled {
  opacity: 0.6;
}
