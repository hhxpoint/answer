page {
  background: linear-gradient(180deg, #fff9f4 0%, #ffefe6 100%);
  min-height: 100%;
}

.page {
  position: relative;
  min-height: 100vh;
  padding-bottom: 180rpx;
  overflow: hidden;
}

.bg-a {
  position: absolute;
  top: -120rpx;
  right: -140rpx;
  width: 420rpx;
  height: 420rpx;
  border-radius: 50%;
  background: radial-gradient(closest-side, rgba(255, 205, 170, 0.42), rgba(255, 205, 170, 0));
  pointer-events: none;
}
.bg-b {
  position: absolute;
  top: 520rpx;
  left: -180rpx;
  width: 420rpx;
  height: 420rpx;
  border-radius: 50%;
  background: radial-gradient(closest-side, rgba(255, 178, 190, 0.3), rgba(255, 178, 190, 0));
  pointer-events: none;
}

/* ===== 顶部 ===== */
.hero {
  position: relative;
  padding: 44rpx 40rpx 8rpx;
  text-align: center;
}
.hero-avatars {
  display: flex;
  justify-content: center;
  margin-bottom: 14rpx;
}
.h-avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.95);
  box-shadow: 0 8rpx 20rpx rgba(214, 122, 78, 0.18);
  background: linear-gradient(135deg, #ffd0a8, #ff9f9f);
  color: #ffffff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.h-avatar.me {
  margin-right: -18rpx;
  z-index: 2;
}
.h-avatar.ta {
  margin-left: -18rpx;
}
.hero-title {
  font-size: 46rpx;
  font-weight: 800;
  color: #4a342b;
  letter-spacing: 4rpx;
}
.hero-sub {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #a78c7e;
}

.state {
  text-align: center;
  margin-top: 120rpx;
  color: #9a715c;
  font-size: 26rpx;
}
.state.err {
  color: #c9584f;
}

/* ===== 空状态 ===== */
.empty {
  margin: 90rpx 60rpx 0;
  text-align: center;
}
.empty-flame {
  position: relative;
  width: 140rpx;
  height: 170rpx;
  margin: 0 auto 20rpx;
}
.ef-aura {
  position: absolute;
  left: 50%;
  bottom: 4rpx;
  width: 160rpx;
  height: 190rpx;
  margin-left: -80rpx;
  border-radius: 50% 50% 44% 44% / 64% 64% 36% 36%;
  background: radial-gradient(58% 62% at 50% 62%, rgba(255, 158, 96, 0.4), rgba(255, 120, 80, 0) 74%);
}
.ef-body {
  position: absolute;
  left: 50%;
  bottom: 10rpx;
  width: 110rpx;
  height: 148rpx;
  margin-left: -55rpx;
  border-radius: 50% 50% 45% 45% / 64% 64% 36% 36%;
  background:
    radial-gradient(56% 44% at 35% 25%, rgba(255, 255, 255, 0.9), rgba(255, 255, 255, 0) 65%),
    radial-gradient(132% 112% at 50% 100%, #ffdf82 0%, #ffb45e 40%, #ff7d55 72%, #ef4a5e 100%);
  box-shadow: 0 16rpx 38rpx rgba(255, 118, 78, 0.28);
}
.ef-core {
  position: absolute;
  left: 50%;
  bottom: 52rpx;
  width: 30rpx;
  height: 44rpx;
  margin-left: -15rpx;
  border-radius: 50%;
  background: radial-gradient(closest-side, rgba(255, 255, 255, 0.95), rgba(255, 245, 190, 0.2));
}
.empty-title {
  margin-top: 12rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #4a342b;
}
.empty-sub {
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #a78c7e;
}
.empty-btn {
  display: inline-block;
  margin-top: 36rpx;
  padding: 20rpx 48rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ffb27a, #ff8a7a);
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 600;
  box-shadow: 0 12rpx 26rpx rgba(255, 140, 110, 0.3);
}

/* ===== 时光卡片 ===== */
.list {
  position: relative;
  padding: 24rpx 32rpx 0;
}
.card {
  position: relative;
  margin-bottom: 24rpx;
  padding: 28rpx 28rpx 24rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  box-shadow: 0 16rpx 40rpx rgba(214, 122, 78, 0.08);
}
.card-head {
  display: flex;
  align-items: center;
}
.author-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  flex-shrink: 0;
  overflow: hidden;
  background: linear-gradient(135deg, #ffd0a8, #ff9f9f);
  color: #ffffff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.head-text {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
}
.author-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #4a342b;
}
.time-text {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #b09a8c;
}
.day-chip {
  flex-shrink: 0;
  margin-left: 12rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: #fff1e8;
  color: #cf6240;
  font-size: 20rpx;
  font-weight: 600;
}

.content {
  margin-top: 18rpx;
  font-size: 30rpx;
  line-height: 1.68;
  color: #4a342b;
  white-space: pre-wrap;
  word-break: break-word;
}

.img-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 18rpx;
}
.img {
  border-radius: 18rpx;
  overflow: hidden;
  background: #f3e7dd;
  display: block;
}
.images-one .img {
  width: 100%;
  height: 420rpx;
}
.images-two .img {
  width: calc(50% - 8rpx);
  height: 300rpx;
}
.images-two .img:nth-child(1) {
  margin-right: 16rpx;
}
.images-many .img {
  width: calc(33.333% - 8rpx);
  height: 208rpx;
  margin: 0 12rpx 12rpx 0;
}
.images-many .img:nth-child(3n) {
  margin-right: 0;
}

.card-more {
  position: absolute;
  right: 18rpx;
  bottom: 14rpx;
  padding: 6rpx 14rpx;
  font-size: 26rpx;
  color: #cbb3a3;
  letter-spacing: 2rpx;
}

.list-foot {
  padding: 22rpx 0 40rpx;
  text-align: center;
  font-size: 22rpx;
  color: #b9a292;
}
.list-foot.end {
  color: #c9b6a8;
}

/* ===== 悬浮按钮 ===== */
.fab {
  position: fixed;
  right: 36rpx;
  bottom: calc(56rpx + constant(safe-area-inset-bottom));
  bottom: calc(56rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  height: 92rpx;
  padding: 0 36rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ffb27a, #ff8a7a);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 16rpx 34rpx rgba(255, 140, 110, 0.36);
  transition: transform 0.15s ease;
}
.fab:active {
  transform: scale(0.95);
}
.fab-icon {
  margin-right: 8rpx;
  font-size: 30rpx;
}
