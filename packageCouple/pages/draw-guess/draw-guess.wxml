<view class="page">
  <view class="ambient a1"></view>
  <view class="ambient a2"></view>

  <!-- 大厅 -->
  <view wx:if="{{stage === 'lobby'}}" class="lobby">
    <view class="kicker">ONLY FOR TWO · 只属于我们俩</view>
    <view class="hero-title">你画我猜</view>
    <view class="hero-sub">一个人画，一个人猜<br/>画得笨拙一点也没关系，反正是画给 TA 的</view>

    <view class="duo-card">
      <view class="duo-side">
        <image wx:if="{{myAvatar}}" class="duo-avatar" src="{{myAvatar}}" mode="aspectFill"></image>
        <view wx:else class="duo-avatar fallback">{{myInitial}}</view>
        <view class="duo-name">{{myName}}</view>
      </view>
      <view class="duo-flame">🔥</view>
      <view class="duo-side">
        <image wx:if="{{partnerAvatar}}" class="duo-avatar" src="{{partnerAvatar}}" mode="aspectFill"></image>
        <view wx:else class="duo-avatar fallback">{{partnerInitial}}</view>
        <view class="duo-name">{{partnerName}}</view>
      </view>
    </view>

    <view class="status-pill {{partnerOnline ? 'online' : ''}}">
      <view class="status-dot"></view>
      <text>{{partnerOnline ? partnerName + ' 在线，可以开局' : '等 ' + partnerName + ' 上线'}}</text>
    </view>

    <view class="round-picker">
      <view class="round-label">这一局画几轮？</view>
      <view class="round-options">
        <view
          wx:for="{{totalOptions}}"
          wx:key="*this"
          class="round-option {{totalRounds === item ? 'active' : ''}}"
          data-rounds="{{item}}"
          bindtap="selectRounds"
        >{{item}} 轮</view>
      </view>
    </view>

    <view class="lobby-actions">
      <view class="start-btn {{partnerOnline ? 'is-ready' : 'is-waiting'}}" bindtap="startGame">
        <view class="start-btn-main">{{partnerOnline ? '开始画画' : '等 TA 一起'}}</view>
        <view class="start-btn-sub">
          {{partnerOnline ? '画给 TA 看，猜猜你画的是什么' : 'TA 上线后就能开局'}}
        </view>
        <view wx:if="{{!partnerOnline}}" class="waiting-dots"><text></text><text></text><text></text></view>
      </view>
      <view class="share-pill" bindtap="openShare">
        <text class="share-pill-icon">↗</text>
        <text>分享这块小画板</text>
      </view>
    </view>

    <view wx:if="{{errorText}}" class="error-text">{{errorText}}</view>

    <view class="how-card">
      <view class="how-title">怎么玩</view>
      <view class="how-row"><text class="how-num">1</text>画手看到词语，用画笔把它画出来</view>
      <view class="how-row"><text class="how-num">2</text>另一个人看着画板，输入答案</view>
      <view class="how-row"><text class="how-num">3</text>猜对得分，下一轮交换画手</view>
      <view class="how-note">没有房间号、没有陌生人，只有你们两个人。</view>
    </view>
  </view>

  <!-- 游戏 -->
  <view wx:if="{{stage === 'playing'}}" class="game">
    <view class="game-top">
      <view class="top-left">
        <view class="round-badge">ROUND {{round}} / {{totalRounds}}</view>
        <view class="top-names">{{isDrawer ? '你来画 · ' + partnerName + ' 来猜' : partnerName + ' 画 · 你来猜'}}</view>
      </view>
      <view class="timer {{timeUrgent ? 'urgent' : ''}}">
        <view class="timer-num">{{timeText}}</view>
        <view class="timer-label">剩余</view>
      </view>
    </view>

    <view class="score-row">
      <view class="score-item mine">
        <view class="score-name">我</view>
        <view class="score-num">{{myScore}}</view>
      </view>
      <view class="score-vs">·</view>
      <view class="score-item">
        <view class="score-name">{{partnerName}}</view>
        <view class="score-num">{{partnerScore}}</view>
      </view>
    </view>

    <view class="word-card {{isDrawer ? 'drawer' : 'guesser'}}">
      <block wx:if="{{isDrawer}}">
        <view class="word-kicker">你来画</view>
        <view class="word-main">{{word}}</view>
        <view class="word-meta">{{category}} · 让 TA 猜出来</view>
      </block>
      <block wx:else>
        <view class="word-kicker">猜猜看</view>
        <view class="word-main mask">{{mask}}</view>
        <view class="word-meta">{{category}}<text wx:if="{{hintText}}" class="hint-inline"> · {{hintText}}</text></view>
      </block>
    </view>

    <view class="canvas-card">
      <canvas
        type="2d"
        id="board"
        class="board"
        disable-scroll="{{true}}"
        bindtouchstart="onTouchStart"
        bindtouchmove="onTouchMove"
        bindtouchend="onTouchEnd"
        bindtouchcancel="onTouchEnd"
      ></canvas>
      <view wx:if="{{!isDrawer}}" class="board-tip">看 TA 画，在下面输入答案</view>
      <view wx:if="{{!boardReady}}" class="board-loading">画板准备中…</view>
      <view wx:if="{{roundReveal}}" class="reveal-layer">
        <view class="reveal-kicker">本回合答案</view>
        <view class="reveal-word">{{roundReveal}}</view>
        <view class="reveal-sub">{{roundRevealSub}}</view>
      </view>
    </view>

    <view wx:if="{{isDrawer}}" class="tools">
      <view class="tool-row colors">
        <view
          wx:for="{{palette}}"
          wx:key="*this"
          class="color-dot {{currentColor === item ? 'selected' : ''}}"
          style="background: {{item}};"
          data-color="{{item}}"
          bindtap="selectColor"
        ></view>
      </view>
      <view class="tool-row">
        <view class="size-group">
          <view
            wx:for="{{sizes}}"
            wx:key="*this"
            class="size-dot {{currentSize === item ? 'selected' : ''}}"
            data-size="{{item}}"
            bindtap="selectSize"
          >
            <view class="size-core" style="width: {{item}}px; height: {{item}}px;"></view>
          </view>
        </view>
        <view class="tool-btn {{isEraser ? 'active' : ''}}" bindtap="toggleEraser">橡皮</view>
        <view class="tool-btn" bindtap="undoStroke">撤销</view>
        <view class="tool-btn" bindtap="clearBoard">清空</view>
        <view class="tool-btn hint" bindtap="sendHint">提示</view>
      </view>
    </view>

    <view wx:if="{{!isDrawer}}" class="guess-bar">
      <input
        class="guess-input"
        value="{{guessText}}"
        placeholder="输入你猜的词…"
        confirm-type="send"
        bindinput="onGuessInput"
        bindconfirm="submitGuess"
      />
      <view class="guess-btn" bindtap="submitGuess">发送</view>
    </view>

    <scroll-view class="feed" scroll-y scroll-into-view="{{scrollTo}}" scroll-with-animation>
      <view
        wx:for="{{feed}}"
        wx:key="id"
        id="feed-{{item.id}}"
        class="feed-item {{item.kind}}"
      >{{item.text}}</view>
    </scroll-view>
  </view>

  <!-- 结算 -->
  <view wx:if="{{showResult}}" class="result-mask" catchtap="noop">
    <view class="result-card">
      <view class="result-flame">🔥</view>
      <view class="result-kicker">THIS ROUND IS A MEMORY</view>
      <view class="result-title">{{resultTitle}}</view>
      <view class="result-sub">{{resultSub}}</view>
      <view class="result-scores">
        <view class="result-side">
          <view class="result-name">我</view>
          <view class="result-num">{{myScore}}</view>
        </view>
        <view class="result-dash">—</view>
        <view class="result-side">
          <view class="result-name">{{partnerName}}</view>
          <view class="result-num">{{partnerScore}}</view>
        </view>
      </view>
      <view class="result-share" bindtap="openShare">
        <text class="result-share-icon">↗</text>
        <text>把这张小画板分享给 TA</text>
      </view>
      <view class="result-actions">
        <button class="result-btn primary" bindtap="again">再画一局</button>
        <button class="result-btn ghost" bindtap="backHome">回到小火苗</button>
      </view>
    </view>
  </view>

  <!-- 分享画面：高级版小画板邀请卡 -->
  <view wx:if="{{shareVisible}}" class="share-mask" catchtap="closeShare">
    <view class="share-card" catchtap="noop">
      <view class="share-kicker">A LITTLE GAME FOR TWO</view>
      <view class="share-title">把这幅画<br/>递给 {{partnerName}}</view>
      <view class="share-sub">只属于你们两个人的小画板，画得笨拙也算数。</view>
      <image class="share-preview" src="/assets/draw-guess-share.png" mode="widthFix"></image>
      <view class="share-meta">
        <view class="share-meta-avatar">
          <image wx:if="{{myAvatar}}" src="{{myAvatar}}" mode="aspectFill"></image>
          <text wx:else>{{myInitial}}</text>
        </view>
        <view class="share-meta-heart">♡</view>
        <view class="share-meta-avatar">
          <image wx:if="{{partnerAvatar}}" src="{{partnerAvatar}}" mode="aspectFill"></image>
          <text wx:else>{{partnerInitial}}</text>
        </view>
        <view class="share-meta-text">只给你们俩看</view>
      </view>
      <button class="share-btn" open-type="share" bindtap="onShareTap">分享给 TA</button>
      <view class="share-cancel" bindtap="closeShare">先不分享</view>
    </view>
  </view>
</view>
