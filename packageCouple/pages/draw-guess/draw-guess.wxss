page {
  background: #f7efe4;
  color: #3f3a34;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", sans-serif;
}

.page {
  min-height: 100vh;
  padding: 28rpx 28rpx 60rpx;
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
  background:
    radial-gradient(circle at 10% 0%, rgba(255, 220, 196, 0.75), transparent 42%),
    radial-gradient(circle at 92% 18%, rgba(205, 224, 210, 0.7), transparent 38%),
    linear-gradient(180deg, #fbf4ea 0%, #f4e9db 100%);
}

.ambient {
  position: absolute;
  border-radius: 50%;
  filter: blur(10rpx);
  pointer-events: none;
}
.ambient.a1 {
  width: 360rpx;
  height: 360rpx;
  left: -160rpx;
  bottom: 120rpx;
  background: rgba(240, 186, 150, 0.22);
}
.ambient.a2 {
  width: 280rpx;
  height: 280rpx;
  right: -120rpx;
  top: 420rpx;
  background: rgba(158, 192, 170, 0.18);
}

/* ===== 大厅 ===== */
.lobby {
  position: relative;
  z-index: 2;
  padding: 36rpx 16rpx 20rpx;
}
.kicker {
  font-size: 20rpx;
  letter-spacing: 5rpx;
  color: #b38b6d;
  text-align: center;
  margin-bottom: 18rpx;
}
.hero-title {
  font-size: 68rpx;
  line-height: 1.15;
  font-weight: 800;
  color: #3f3a34;
  text-align: center;
  letter-spacing: 4rpx;
}
.hero-sub {
  margin-top: 18rpx;
  text-align: center;
  font-size: 25rpx;
  line-height: 1.8;
  color: #8c7a68;
}

.duo-card {
  margin: 52rpx auto 28rpx;
  width: 82%;
  padding: 30rpx 20rpx;
  border-radius: 40rpx;
  background: rgba(255, 250, 243, 0.9);
  box-shadow: 0 18rpx 50rpx rgba(135, 103, 75, 0.12);
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.duo-side {
  width: 34%;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.duo-avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 34rpx;
  border: 4rpx solid #fff;
  box-shadow: 0 8rpx 20rpx rgba(120, 90, 65, 0.15);
}
.duo-avatar.fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #e8d5c1;
  color: #8b6b4f;
  font-size: 42rpx;
  font-weight: 700;
}
.duo-name {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #6e5c4b;
  max-width: 160rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.duo-flame {
  font-size: 52rpx;
  filter: drop-shadow(0 8rpx 10rpx rgba(240, 150, 95, 0.3));
}

.status-pill {
  width: fit-content;
  margin: 0 auto;
  padding: 14rpx 26rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: rgba(255, 250, 243, 0.85);
  color: #a58c76;
  font-size: 23rpx;
}
.status-pill.online {
  color: #5d8a70;
  background: rgba(232, 244, 235, 0.9);
}
.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #c7b09b;
}
.status-pill.online .status-dot {
  background: #72b08b;
  box-shadow: 0 0 0 6rpx rgba(114, 176, 139, 0.14);
}

.round-picker {
  margin: 38rpx auto 0;
  width: 100%;
  padding: 24rpx 26rpx;
  box-sizing: border-box;
  border-radius: 28rpx;
  background: rgba(255, 250, 243, 0.7);
}
.round-label {
  font-size: 23rpx;
  color: #8b7562;
  margin-bottom: 16rpx;
}
.round-options {
  display: flex;
  gap: 14rpx;
}
.round-option {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 18rpx;
  font-size: 24rpx;
  color: #927f6c;
  background: #f3e9dc;
}
.round-option.active {
  color: #5f4b3b;
  background: #f3c8a8;
  box-shadow: inset 0 0 0 2rpx rgba(191, 129, 85, 0.25);
}

.lobby-actions {
  margin: 32rpx auto 0;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}
.start-btn {
  width: 86%;
  min-height: 108rpx;
  padding: 20rpx 34rpx 18rpx;
  box-sizing: border-box;
  border-radius: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
  transition: transform 0.16s ease, box-shadow 0.2s ease;
}
.start-btn.is-ready {
  background: linear-gradient(135deg, #e9a17d 0%, #dc846d 55%, #d27160 100%);
  color: #fffaf4;
  box-shadow: 0 18rpx 34rpx rgba(190, 106, 82, 0.28), inset 0 1rpx 0 rgba(255, 255, 255, 0.32);
}
.start-btn.is-ready:active {
  transform: scale(0.975);
  box-shadow: 0 8rpx 18rpx rgba(190, 106, 82, 0.24);
}
.start-btn.is-ready::after {
  content: '';
  position: absolute;
  top: -70%;
  left: -30%;
  width: 46%;
  height: 240%;
  background: linear-gradient(105deg, transparent, rgba(255, 255, 255, 0.28), transparent);
  transform: rotate(18deg);
  animation: btnShimmer 3.4s ease-in-out infinite;
}
@keyframes btnShimmer {
  0%, 62% { transform: translateX(-80%) rotate(18deg); }
  100% { transform: translateX(420%) rotate(18deg); }
}
.start-btn-main {
  position: relative;
  z-index: 1;
  font-size: 31rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}
.start-btn-sub {
  position: relative;
  z-index: 1;
  margin-top: 6rpx;
  font-size: 20rpx;
  letter-spacing: 0.5rpx;
  opacity: 0.82;
}
.start-btn.is-waiting {
  background: rgba(255, 250, 243, 0.78);
  border: 1rpx dashed rgba(177, 142, 111, 0.48);
  color: #a58b75;
  box-shadow: 0 10rpx 26rpx rgba(135, 103, 75, 0.08);
}
.start-btn.is-waiting .start-btn-main {
  font-size: 29rpx;
  font-weight: 700;
}
.start-btn.is-waiting .start-btn-sub {
  opacity: 0.68;
}
.waiting-dots {
  position: absolute;
  right: 30rpx;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  gap: 7rpx;
  z-index: 1;
}
.waiting-dots text {
  width: 9rpx;
  height: 9rpx;
  border-radius: 50%;
  background: #c7ab94;
  animation: waitingPulse 1.35s ease-in-out infinite;
}
.waiting-dots text:nth-child(2) { animation-delay: 0.18s; }
.waiting-dots text:nth-child(3) { animation-delay: 0.36s; }
@keyframes waitingPulse {
  0%, 100% { opacity: 0.35; transform: translateY(0); }
  50% { opacity: 1; transform: translateY(-4rpx); }
}

.share-pill {
  height: 60rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #9b7d64;
  font-size: 22rpx;
  background: rgba(255, 250, 243, 0.66);
  border: 1rpx solid rgba(190, 160, 130, 0.22);
}
.share-pill-icon {
  font-size: 25rpx;
  color: #c98763;
  font-weight: 700;
}
.error-text {
  margin-top: 18rpx;
  text-align: center;
  font-size: 23rpx;
  color: #b56255;
}

.how-card {
  margin: 44rpx auto 0;
  width: 100%;
  padding: 26rpx 28rpx;
  box-sizing: border-box;
  border-radius: 28rpx;
  background: rgba(255, 250, 243, 0.68);
}
.how-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #6d5948;
  margin-bottom: 16rpx;
}
.how-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  font-size: 23rpx;
  line-height: 1.7;
  color: #8a7765;
  margin-bottom: 10rpx;
}
.how-num {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: #f1d8c2;
  color: #a27658;
  font-size: 19rpx;
  line-height: 32rpx;
  text-align: center;
  flex-shrink: 0;
}
.how-note {
  margin-top: 14rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed rgba(160, 130, 105, 0.22);
  font-size: 21rpx;
  color: #b39d89;
}

/* ===== 游戏 ===== */
.game {
  position: relative;
  z-index: 2;
  padding-top: 14rpx;
}
.game-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 8rpx 18rpx;
}
.round-badge {
  display: inline-block;
  font-size: 19rpx;
  letter-spacing: 2rpx;
  color: #a77c5e;
  background: rgba(255, 250, 243, 0.8);
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
}
.top-names {
  margin-top: 10rpx;
  font-size: 25rpx;
  color: #6d5948;
  font-weight: 600;
}
.top-conn {
  margin-top: 8rpx;
  font-size: 18rpx;
  color: #a08a75;
}
.top-conn.ok {
  color: #6f9a7d;
}
.top-conn.bad {
  color: #c77e63;
}
.timer {
  width: 120rpx;
  height: 108rpx;
  border-radius: 30rpx;
  background: rgba(255, 250, 243, 0.92);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 24rpx rgba(135, 103, 75, 0.1);
}
.timer.urgent {
  background: #ffe7df;
  animation: breathe 1s ease-in-out infinite;
}
.timer-num {
  font-size: 38rpx;
  font-weight: 800;
  color: #5e4b3b;
  line-height: 1.1;
}
.timer-label {
  font-size: 18rpx;
  color: #a9917d;
}
@keyframes breathe {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.04); }
}

.score-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  margin: 4rpx 0 22rpx;
}
.score-item {
  min-width: 150rpx;
  padding: 14rpx 22rpx;
  border-radius: 24rpx;
  background: rgba(255, 250, 243, 0.8);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}
.score-name {
  font-size: 22rpx;
  color: #8b7562;
  max-width: 150rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.score-num {
  font-size: 32rpx;
  font-weight: 800;
  color: #d37e63;
}
.score-vs {
  color: #c4ae99;
  font-size: 30rpx;
}

.word-card {
  margin: 0 4rpx 20rpx;
  padding: 22rpx 28rpx;
  border-radius: 28rpx;
  background: rgba(255, 250, 243, 0.9);
  box-shadow: 0 12rpx 30rpx rgba(135, 103, 75, 0.08);
}
.word-card.drawer {
  background: linear-gradient(135deg, rgba(255, 246, 234, 0.98), rgba(250, 228, 209, 0.95));
}
.word-card.guesser {
  background: linear-gradient(135deg, rgba(245, 250, 243, 0.98), rgba(230, 240, 228, 0.95));
}
.word-kicker {
  font-size: 19rpx;
  letter-spacing: 2rpx;
  color: #a9917d;
}
.word-main {
  margin-top: 8rpx;
  font-size: 40rpx;
  font-weight: 800;
  color: #4d3d30;
  letter-spacing: 4rpx;
}
.word-main.mask {
  letter-spacing: 10rpx;
}
.word-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #a08a75;
}
.hint-inline {
  color: #c6805e;
}

.canvas-card {
  position: relative;
  border-radius: 34rpx;
  overflow: hidden;
  background: #fffaf5;
  box-shadow: 0 18rpx 50rpx rgba(135, 103, 75, 0.14);
  border: 1rpx solid rgba(191, 160, 132, 0.18);
}
.board {
  width: 100%;
  height: 520rpx;
  display: block;
}
.board-tip {
  position: absolute;
  left: 24rpx;
  bottom: 18rpx;
  font-size: 19rpx;
  color: #b19a86;
  background: rgba(255, 250, 243, 0.8);
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
}
.board-loading {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  padding: 14rpx 26rpx;
  border-radius: 999rpx;
  background: rgba(255, 250, 243, 0.9);
  color: #a8917b;
  font-size: 21rpx;
  box-shadow: 0 6rpx 18rpx rgba(135, 103, 75, 0.08);
}
.reveal-layer {
  position: absolute;
  top: 0; right: 0; bottom: 0; left: 0;
  background: rgba(255, 247, 238, 0.94);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 30rpx;
  box-sizing: border-box;
}
.reveal-kicker {
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: #b18d70;
}
.reveal-word {
  margin-top: 16rpx;
  font-size: 58rpx;
  font-weight: 800;
  color: #4d3d30;
}
.reveal-sub {
  margin-top: 16rpx;
  font-size: 23rpx;
  color: #8b7562;
  text-align: center;
}

.tools {
  margin-top: 20rpx;
  padding: 20rpx 22rpx;
  border-radius: 28rpx;
  background: rgba(255, 250, 243, 0.85);
}
.tool-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}
.tool-row.colors {
  justify-content: space-between;
  margin-bottom: 18rpx;
}
.color-dot {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  box-sizing: border-box;
  border: 3rpx solid transparent;
}
.color-dot.selected {
  border-color: #fff;
  box-shadow: 0 0 0 3rpx #c79472;
}
.size-group {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-right: 8rpx;
}
.size-dot {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #f2e4d5;
  display: flex;
  align-items: center;
  justify-content: center;
}
.size-dot.selected {
  background: #f0c8ab;
}
.size-core {
  border-radius: 50%;
  background: #5b4a3c;
}
.tool-btn {
  padding: 10rpx 16rpx;
  border-radius: 16rpx;
  font-size: 21rpx;
  color: #8b7562;
  background: #f5eadd;
}
.tool-btn.active {
  background: #f0c8ab;
  color: #6d4f3a;
}
.tool-btn.hint {
  color: #b57a58;
  background: #f8e3d3;
}

.guess-bar {
  margin-top: 20rpx;
  display: flex;
  gap: 14rpx;
  align-items: center;
}
.guess-input {
  flex: 1;
  height: 82rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  background: rgba(255, 250, 243, 0.95);
  font-size: 26rpx;
  color: #4d3d30;
  box-shadow: inset 0 0 0 1rpx rgba(180, 148, 120, 0.2);
}
.guess-btn {
  width: 122rpx;
  height: 82rpx;
  line-height: 82rpx;
  text-align: center;
  border-radius: 999rpx;
  background: #e6a47d;
  color: #fffaf4;
  font-size: 25rpx;
  font-weight: 700;
}

.feed {
  margin-top: 20rpx;
  max-height: 220rpx;
  padding: 4rpx 8rpx;
  box-sizing: border-box;
}
.feed-item {
  width: fit-content;
  max-width: 86%;
  margin-bottom: 10rpx;
  padding: 12rpx 18rpx;
  border-radius: 18rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #6d5948;
  background: rgba(255, 250, 243, 0.8);
}
.feed-item.system {
  margin-left: auto;
  margin-right: auto;
  background: transparent;
  color: #b39d89;
  font-size: 20rpx;
  max-width: 100%;
}
.feed-item.me {
  margin-left: auto;
  background: #f3d6c2;
  color: #6f4e39;
}
.feed-item.them {
  background: #e7f0e5;
  color: #4f6b58;
}

/* ===== 结算 ===== */
.result-mask {
  position: fixed;
  top: 0; right: 0; bottom: 0; left: 0;
  z-index: 20;
  background: rgba(60, 47, 37, 0.34);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
}
.result-card {
  width: 100%;
  max-width: 620rpx;
  padding: 44rpx 36rpx 36rpx;
  border-radius: 44rpx;
  background: linear-gradient(180deg, #fffaf3 0%, #fdf1e4 100%);
  box-shadow: 0 30rpx 80rpx rgba(73, 53, 37, 0.25);
  text-align: center;
}
.result-flame {
  font-size: 64rpx;
  margin-bottom: 10rpx;
}
.result-kicker {
  font-size: 19rpx;
  letter-spacing: 4rpx;
  color: #b18d70;
}
.result-title {
  margin-top: 14rpx;
  font-size: 52rpx;
  font-weight: 800;
  color: #4d3d30;
}
.result-sub {
  margin-top: 14rpx;
  font-size: 23rpx;
  color: #927b67;
  line-height: 1.6;
}
.result-scores {
  margin: 30rpx auto;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
}
.result-side {
  min-width: 130rpx;
}
.result-name {
  font-size: 21rpx;
  color: #9b846f;
}
.result-num {
  margin-top: 4rpx;
  font-size: 44rpx;
  font-weight: 800;
  color: #d37e63;
}
.result-dash {
  color: #c4ae99;
}
.result-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 12rpx;
}
.result-btn {
  flex: 1;
  height: 86rpx;
  line-height: 86rpx;
  border-radius: 999rpx;
  font-size: 25rpx;
  border: 0;
  padding: 0;
}
.result-btn.primary {
  background: linear-gradient(135deg, #e79b78, #d97d69);
  color: #fffaf4;
  font-weight: 700;
}
.result-btn.ghost {
  background: #f3e5d8;
  color: #7d6552;
}
.result-share {
  margin: 22rpx auto 8rpx;
  width: fit-content;
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: #c78361;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 247, 237, 0.9);
}
.result-share-icon {
  font-size: 24rpx;
  font-weight: 700;
}

/* ===== 分享画面 ===== */
.share-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 60;
  background: rgba(58, 45, 35, 0.42);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 44rpx 38rpx;
  box-sizing: border-box;
  backdrop-filter: blur(8rpx);
}
.share-card {
  width: 100%;
  max-width: 640rpx;
  max-height: 92vh;
  overflow-y: auto;
  padding: 36rpx 30rpx 28rpx;
  box-sizing: border-box;
  border-radius: 40rpx;
  background: linear-gradient(180deg, #fffaf3 0%, #fdf0e3 100%);
  box-shadow: 0 36rpx 90rpx rgba(48, 35, 25, 0.28);
  text-align: center;
}
.share-kicker {
  font-size: 18rpx;
  letter-spacing: 4rpx;
  color: #b18d70;
}
.share-title {
  margin-top: 12rpx;
  font-size: 44rpx;
  line-height: 1.3;
  font-weight: 800;
  color: #4b3b2e;
  letter-spacing: 1rpx;
}
.share-sub {
  margin: 12rpx auto 22rpx;
  max-width: 470rpx;
  font-size: 22rpx;
  line-height: 1.65;
  color: #9b806a;
}
.share-preview {
  width: 100%;
  border-radius: 22rpx;
  box-shadow: 0 12rpx 28rpx rgba(135, 103, 75, 0.12);
}
.share-meta {
  margin: 20rpx auto 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}
.share-meta-avatar {
  width: 54rpx;
  height: 54rpx;
  border-radius: 18rpx;
  overflow: hidden;
  background: #ecd6c2;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8b6b50;
  font-size: 23rpx;
  font-weight: 700;
}
.share-meta-avatar image {
  width: 100%;
  height: 100%;
}
.share-meta-heart {
  color: #d58b79;
  font-size: 30rpx;
}
.share-meta-text {
  margin-left: 8rpx;
  font-size: 21rpx;
  color: #a48a74;
}
.share-btn {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
