page {
  background: #ffefe6;
  height: 100%;
  min-height: 100%;
}

.page {
  position: relative;
  min-height: 100vh;
  padding: 0 32rpx 240rpx;
  box-sizing: border-box;
  overflow: hidden;
  background: linear-gradient(180deg, #fff9f4 0%, #ffefe6 100%);
}
.bg-a {
  position: absolute;
  top: -140rpx;
  right: -140rpx;
  width: 420rpx;
  height: 420rpx;
  border-radius: 50%;
  background: radial-gradient(closest-side, rgba(255, 205, 170, 0.42), rgba(255, 205, 170, 0));
  pointer-events: none;
}

.hero {
  position: relative;
  padding: 36rpx 6rpx 22rpx;
}
.hero-sub {
  font-size: 22rpx;
  color: #a78c7e;
}
.hero-title {
  margin-top: 8rpx;
  font-size: 44rpx;
  font-weight: 800;
  color: #4a342b;
  letter-spacing: 3rpx;
}

.state {
  text-align: center;
  margin-top: 120rpx;
  color: #9a715c;
  font-size: 26rpx;
}
.state.err {
  color: #c9584f;
}

.card {
  position: relative;
  margin-bottom: 20rpx;
  padding: 26rpx 24rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.97);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  box-shadow: 0 14rpx 36rpx rgba(214, 122, 78, 0.08);
}

.label {
  font-size: 22rpx;
  color: #a78c7e;
}
.title-input {
  margin-top: 12rpx;
  height: 88rpx;
  padding: 0 26rpx;
  border-radius: 22rpx;
  background: #fff4ee;
  font-size: 30rpx;
  color: #4a342b;
}
.chips {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}
.chip {
  margin: 0 14rpx 10rpx 0;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  background: #fff6f0;
  border: 1rpx solid #ffeadf;
  color: #c98a6a;
  font-size: 21rpx;
}
.chip:active {
  background: #fff1e8;
}

.cal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 4rpx 6rpx;
}
.cal-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #4a342b;
}
.cal-nav {
  width: 56rpx;
  height: 56rpx;
  line-height: 52rpx;
  text-align: center;
  border-radius: 50%;
  background: #fff3ea;
  color: #cf6240;
  font-size: 32rpx;
}
.cal-nav:active {
  transform: scale(0.9);
}
.week-row {
  display: flex;
  padding-top: 10rpx;
}
.week-cell {
  width: 14.285%;
  text-align: center;
  padding: 8rpx 0;
  font-size: 20rpx;
  color: #b0937f;
}
.day-grid {
  display: flex;
  flex-wrap: wrap;
}
.day-cell {
  width: 14.285%;
  height: 100rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  transition: background 0.18s ease, box-shadow 0.18s ease, transform 0.12s ease;
}
.day-cell:active {
  transform: scale(0.94);
}
.day-num {
  font-size: 26rpx;
  color: #4a342b;
}
.day-holiday {
  margin-top: 2rpx;
  max-width: 100%;
  padding: 0 2rpx;
  font-family: "Songti SC", "STSong", "SimSun", "Noto Serif SC", serif;
  font-size: 15rpx;
  line-height: 1.25;
  letter-spacing: 0.5rpx;
  color: #c08a6a;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.day-cell.muted .day-num {
  color: #d9c6b8;
}
.day-cell.today {
  box-shadow: inset 0 0 0 2rpx #ffc4a8;
}
.day-cell.today .day-num {
  color: #cf6240;
  font-weight: 700;
}
.day-cell.selected {
  background: linear-gradient(135deg, #ffb27a, #ff8a9a);
  box-shadow: 0 8rpx 18rpx rgba(255, 140, 120, 0.3);
}
.day-cell.selected .day-num {
  color: #ffffff;
  font-weight: 700;
}
.day-cell.selected .day-holiday {
  color: rgba(255, 255, 255, 0.94);
}
.cal-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #f6ece4;
}
.chosen {
  font-size: 22rpx;
  color: #c96f4d;
  font-weight: 600;
}
.chosen-holiday {
  font-family: "Songti SC", "STSong", "SimSun", "Noto Serif SC", serif;
  font-size: 21rpx;
  font-weight: 400;
  color: #c08a6a;
  letter-spacing: 0.5rpx;
}
.today-btn {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: #fff3ea;
  color: #cf6240;
  font-size: 21rpx;
}

.switch-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.switch-main {
  margin-right: 16rpx;
}
.switch-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #4a342b;
}
.switch-sub {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #b0937f;
}

.tips {
  margin: 4rpx 10rpx 0;
  text-align: center;
  font-size: 21rpx;
  line-height: 1.7;
  color: #b89f90;
}

.publish-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 36rpx 22rpx;
  padding-bottom: calc(22rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(22rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(255, 249, 244, 0), rgba(255, 249, 244, 0.97) 40%);
}
.save-btn {
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  border-radius: 26rpx;
  background: linear-gradient(135deg, #ffb27a, #ff8a7a);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 12rpx 28rpx rgba(255, 140, 110, 0.3);
}
.save-btn.disabled {
  opacity: 0.6;
}
.del-btn {
  margin-top: 14rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: 20rpx;
  color: #c9584f;
  font-size: 24rpx;
  background: rgba(255, 255, 255, 0.8);
}
