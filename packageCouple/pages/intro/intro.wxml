<view class="story">
  <!-- 封面 -->
  <view class="hero">
    <image class="hero-img" src="/packageCouple/assets/story/cover.jpg" mode="aspectFill"></image>
    <view class="hero-mask"></view>
    <view class="hero-text">
      <view class="eyebrow">F O R &nbsp; T W O</view>
      <view class="h1">两个人的空间</view>
      <view class="h2">只属于你和他的，一小段慢慢过的时光</view>
    </view>
  </view>

  <!-- 开篇 -->
  <view class="intro">
    <view class="intro-line">世界很大，</view>
    <view class="intro-line">大到我们绕了很多路才遇见；</view>
    <view class="intro-line">世界又很小，</view>
    <view class="intro-line">小到一个眼神，就够把往后的日子照亮。</view>
  </view>

  <!-- 三章 -->
  <block wx:for="{{chapters}}" wx:key="no" wx:for-item="c">
    <view class="chapter">
      <view class="ch-head">
        <text class="ch-no">{{c.no}}</text>
        <text class="ch-title">{{c.title}}</text>
        <view class="ch-line"></view>
      </view>
      <image class="ch-img" src="{{c.img}}" mode="widthFix"></image>
      <view class="ch-body">
        <view class="ch-p" wx:for="{{c.paras}}" wx:key="*this" wx:for-item="p">{{p}}</view>
      </view>
    </view>
  </block>

  <!-- 引语 -->
  <view class="quote">
    <view class="q-mark">“</view>
    <view class="q-text">所谓亲密关系，不过是两个人愿意把同一段时光，过成彼此心里最好的样子。</view>
  </view>

  <!-- 收束 -->
  <view class="closing">
    <view class="cl-line">这个空间，只有两个人。</view>
    <view class="cl-line">没有广场，没有推荐，没有陌生人。</view>
    <view class="cl-line">你们说的话、记下的事，只留在你们之间。</view>
  </view>

  <view class="back-link" bindtap="back">返回上一页</view>

  <view class="boundary-note">
    <text class="bn-line">仅限两人私密互动工具 · 内容仅你们双方可见</text>
    <text class="bn-line">不提供公开发布 / 广场 / 推荐 / 关注 / 评论 / 内容转发</text>
  </view>
</view>
