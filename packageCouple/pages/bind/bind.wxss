@import "../../styles/boundary.wxss";
page {
  background: linear-gradient(180deg, #fff7f2 0%, #ffece4 55%, #ffe3dd 100%);
  min-height: 100%;
}

button {
  margin: 0;
  padding: 0;
  background: none;
  line-height: normal;
  font-size: inherit;
}
button::after {
  border: none;
}

.page {
  position: relative;
  padding: 40rpx 40rpx 80rpx;
  overflow: hidden;
}

.deco {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}
.deco-a {
  top: -140rpx;
  right: -120rpx;
  width: 400rpx;
  height: 400rpx;
  background: radial-gradient(closest-side, rgba(255, 205, 170, 0.5), rgba(255, 205, 170, 0));
}
.deco-b {
  top: 640rpx;
  left: -180rpx;
  width: 420rpx;
  height: 420rpx;
  background: radial-gradient(closest-side, rgba(255, 178, 190, 0.38), rgba(255, 178, 190, 0));
}

.hero {
  position: relative;
  text-align: center;
  padding: 24rpx 0 10rpx;
}
.hero-flame {
  height: 190rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.flame {
  position: relative;
  width: 132rpx;
  height: 172rpx;
  animation: breathe 2.4s ease-in-out infinite;
  transform-origin: 50% 100%;
}
.flame-aura {
  position: absolute;
  left: 50%;
  bottom: 2rpx;
  width: 160rpx;
  height: 200rpx;
  margin-left: -80rpx;
  border-radius: 50% 50% 44% 44% / 64% 64% 36% 36%;
  background: radial-gradient(58% 62% at 50% 62%, rgba(255, 158, 96, 0.5), rgba(255, 120, 80, 0) 74%);
  animation: auraFlicker 1.9s ease-in-out infinite alternate;
}
.flame-body {
  position: absolute;
  left: 50%;
  bottom: 8rpx;
  width: 112rpx;
  height: 150rpx;
  margin-left: -56rpx;
  border-radius: 50% 50% 45% 45% / 64% 64% 36% 36%;
  background:
    radial-gradient(56% 44% at 35% 25%, rgba(255, 255, 255, 0.9), rgba(255, 255, 255, 0) 65%),
    radial-gradient(92% 74% at 50% 90%, #ff5c4c 0%, rgba(255, 92, 76, 0) 70%),
    radial-gradient(132% 112% at 50% 100%, #ffdf82 0%, #ffb45e 40%, #ff7d55 72%, #ef4a5e 100%);
  box-shadow:
    inset 8rpx 10rpx 18rpx rgba(255, 249, 214, 0.5),
    inset -10rpx -16rpx 26rpx rgba(212, 54, 64, 0.36),
    inset 0 -18rpx 32rpx rgba(255, 160, 90, 0.32),
    0 16rpx 38rpx rgba(255, 118, 78, 0.3);
  overflow: hidden;
}
.flame-shine {
  position: absolute;
  left: 18rpx;
  top: 24rpx;
  width: 44rpx;
  height: 70rpx;
  border-radius: 50%;
  transform: rotate(-16deg);
  background: radial-gradient(58% 58% at 40% 32%, rgba(255, 255, 255, 0.95), rgba(255, 255, 255, 0) 72%);
  opacity: 0.92;
}
.flame-inner {
  position: absolute;
  left: 50%;
  bottom: 26rpx;
  width: 60rpx;
  height: 88rpx;
  margin-left: -30rpx;
  border-radius: 50% 50% 46% 46% / 62% 62% 38% 38%;
  background:
    radial-gradient(58% 48% at 42% 28%, rgba(255, 255, 255, 0.92), rgba(255, 255, 255, 0) 70%),
    radial-gradient(118% 100% at 50% 100%, #fffce2 0%, #ffeaa2 42%, #ffcf72 78%, rgba(255, 190, 100, 0) 100%);
  opacity: 0.95;
  animation: flicker 1.5s ease-in-out infinite alternate;
}
.flame-core {
  position: absolute;
  left: 50%;
  bottom: 48rpx;
  width: 30rpx;
  height: 44rpx;
  margin-left: -15rpx;
  border-radius: 50%;
  background: radial-gradient(58% 58% at 46% 34%, rgba(255, 255, 255, 0.96), rgba(255, 245, 190, 0.5) 60%, rgba(255, 245, 190, 0) 100%);
  animation: coreGlow 1.9s ease-in-out infinite alternate;
}
.face {
  position: absolute;
  left: 50%;
  bottom: 64rpx;
  width: 76rpx;
  margin-left: -38rpx;
  z-index: 3;
}
.eye {
  position: absolute;
  top: 0;
  width: 12rpx;
  height: 16rpx;
  border-radius: 50%;
  background: radial-gradient(62% 62% at 38% 30%, #7a3a1c, #3f1d0b 78%);
  animation: blink 4.6s infinite;
}
.eye.left { left: 6rpx; }
.eye.right { right: 6rpx; }
.eye-shine {
  position: absolute;
  left: 2rpx;
  top: 2rpx;
  width: 4rpx;
  height: 4rpx;
  border-radius: 50%;
  background: #ffffff;
  opacity: 0.95;
}
.mouth {
  position: absolute;
  left: 50%;
  top: 20rpx;
  margin-left: -10rpx;
  width: 20rpx;
  height: 10rpx;
  border-bottom: 4rpx solid #5a2a12;
  border-radius: 0 0 50% 50%;
}
.spark {
  position: absolute;
  width: 7rpx;
  height: 7rpx;
  border-radius: 50%;
  background: radial-gradient(closest-side, #fff3c0, rgba(255, 190, 110, 0));
  opacity: 0;
  animation: sparkRise 3.6s linear infinite;
}
.spark.s1 { left: 12rpx; bottom: 78rpx; }
.spark.s2 { right: 14rpx; bottom: 64rpx; width: 5rpx; height: 5rpx; animation-delay: 1.6s; }

.hero-title {
  margin-top: 10rpx;
  font-size: 42rpx;
  font-weight: 800;
  color: #4a342b;
  letter-spacing: 3rpx;
}
.hero-sub {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: #a78c7e;
  line-height: 1.6;
}

.state {
  text-align: center;
  margin-top: 90rpx;
  color: #9a715c;
  font-size: 26rpx;
}
.state.err {
  color: #c9584f;
}

.card {
  position: relative;
  margin-top: 24rpx;
  padding: 30rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  box-shadow: 0 14rpx 34rpx rgba(214, 122, 78, 0.08);
}
.card.center {
  text-align: center;
}
.hello-card {
  display: flex;
  align-items: center;
}
.hello-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-right: 20rpx;
  background: linear-gradient(135deg, #ffd0a8, #ff9f9f);
  color: #ffffff;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  box-shadow: 0 8rpx 20rpx rgba(255, 150, 120, 0.25);
}
.hello-text {
  flex: 1;
}
.hello-title {
  font-size: 31rpx;
  font-weight: 700;
  color: #4a342b;
}
.hello-sub {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: #a78c7e;
  line-height: 1.5;
}
.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #4a342b;
}
.card-title.center {
  text-align: center;
}
.card-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #a78c7e;
}
.card-sub.center {
  text-align: center;
}

.row {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
}
.input {
  flex: 1;
  height: 84rpx;
  padding: 0 26rpx;
  background: #fff4ee;
  border-radius: 24rpx;
  font-size: 29rpx;
  color: #4a342b;
}
.input.code {
  letter-spacing: 6rpx;
  text-transform: uppercase;
}
.hint {
  margin-top: 14rpx;
  font-size: 21rpx;
  color: #b08e80;
}

.btn {
  height: 84rpx;
  line-height: 84rpx;
  padding: 0 32rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  text-align: center;
  flex-shrink: 0;
}
.btn.primary {
  background: linear-gradient(135deg, #ffb27a, #ff8a7a);
  color: #ffffff;
  font-weight: 600;
  box-shadow: 0 10rpx 24rpx rgba(255, 140, 110, 0.28);
}
.btn.primary.block {
  margin-top: 22rpx;
  width: 100%;
  box-sizing: border-box;
}
.btn.primary.small {
  margin-left: 14rpx;
  padding: 0 26rpx;
}
.btn.ghost {
  margin-left: 14rpx;
  background: #fff2ea;
  color: #cf6240;
  font-weight: 600;
}
.btn:active {
  transform: scale(0.97);
}

.invite-banner {
  margin-top: 20rpx;
  padding: 30rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #fff3e8, #ffe2da);
  border: 1rpx solid rgba(255, 160, 130, 0.5);
  box-shadow: 0 14rpx 34rpx rgba(255, 150, 120, 0.16);
}
.invite-banner-title {
  font-size: 31rpx;
  font-weight: 800;
  color: #c4552e;
  text-align: center;
}
.invite-banner-code {
  margin-top: 8rpx;
  text-align: center;
  font-size: 23rpx;
  color: #a78c7e;
  letter-spacing: 2rpx;
}
.invite-banner-tip {
  margin-top: 14rpx;
  text-align: center;
  font-size: 21rpx;
  color: #b08e80;
}

.invite-card {
  padding: 36rpx 30rpx;
}
.invite-badge {
  width: 96rpx;
  margin: 0 auto 12rpx;
  padding: 4rpx 0;
  border-radius: 999rpx;
  background: #fff1e6;
  color: #cf6240;
  font-size: 20rpx;
  text-align: center;
}
.invite-code {
  margin: 26rpx 0 8rpx;
  text-align: center;
  font-size: 64rpx;
  font-weight: 800;
  letter-spacing: 16rpx;
  color: #e06a4a;
}
.invite-actions {
  display: flex;
  margin-top: 22rpx;
}
.share-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  background: linear-gradient(135deg, #ffb27a, #ff8a7a);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
  box-shadow: 0 12rpx 26rpx rgba(255, 140, 110, 0.3);
  margin-right: 16rpx;
}
.copy-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  background: #ffffff;
  color: #cf6240;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
  border: 1rpx solid rgba(255, 150, 120, 0.4);
}

.waiting {
  margin-top: 26rpx;
  text-align: center;
  font-size: 22rpx;
  color: #b08e80;
}
.dot {
  display: inline-block;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #f0a98c;
  margin: 0 4rpx;
  animation: dotBlink 1.2s infinite;
}
.dot:nth-child(2) { animation-delay: 0.2s; }
.dot:nth-child(3) { animation-delay: 0.4s; }

.footer {
  margin-top: 46rpx;
  text-align: center;
  font-size: 21rpx;
  color: #c2a08c;
}

@keyframes breathe {
  0%, 100% { transform: scale(1, 1); }
  50% { transform: scale(1.04, 0.96); }
}
@keyframes blink {
  0%, 92%, 100% { transform: scaleY(1); }
  95% { transform: scaleY(0.1); }
}
@keyframes dotBlink {
  0%, 100% { opacity: 0.3; }
  50% { opacity: 1; }
}
@keyframes auraFlicker {
  0% { opacity: 0.8; transform: scale(0.97, 1); }
  100% { opacity: 1; transform: scale(1.03, 0.98); }
}
@keyframes flicker {
  0% { transform: scale(0.97, 1); opacity: 0.88; }
  100% { transform: scale(1.03, 0.97); opacity: 1; }
}
@keyframes coreGlow {
  0% { opacity: 0.75; transform: scale(0.94); }
  100% { opacity: 1; transform: scale(1.06); }
}
@keyframes sparkRise {
  0% { opacity: 0; transform: translate(0, 0) scale(0.6); }
  12% { opacity: 0.9; }
  70% { opacity: 0.5; }
  100% { opacity: 0; transform: translate(4rpx, -80rpx) scale(0.2); }
}
