<view class="page">
  <view class="deco deco-a"></view>
  <view class="deco deco-b"></view>

  <view class="hero">
    <view class="hero-flame">
      <view class="flame small">
        <view class="flame-aura"></view>
        <view class="flame-body">
          <view class="flame-shine"></view>
          <view class="flame-inner"></view>
          <view class="flame-core"></view>
          <view class="face">
            <view class="eye left"><view class="eye-shine"></view></view>
            <view class="eye right"><view class="eye-shine"></view></view>
            <view class="mouth"></view>
          </view>
          <view class="spark s1"></view>
          <view class="spark s2"></view>
        </view>
      </view>
    </view>
    <view class="hero-title">我们的小火苗</view>
    <view class="hero-sub">和 TA 一起养一只小火苗，记录只属于两个人的时光</view>
  </view>

  <view wx:if="{{loading}}" class="state">加载中…</view>
  <view wx:elif="{{errorText}}" class="state err">{{errorText}}</view>

  <block wx:elif="{{step === 'ready'}}">
    <view class="invite-banner" wx:if="{{invited}}">
      <view class="invite-banner-title">TA 邀请你一起养小火苗</view>
      <view class="invite-banner-code">邀请码 {{invitedCode}}</view>
      <view class="btn primary block" bindtap="acceptInvite">{{joining ? '正在连接…' : '接受邀请，一起养'}}</view>
      <view class="invite-banner-tip">接受后就会直接和 TA 绑在一起</view>
    </view>

    <view class="card hello-card">
      <image wx:if="{{myAvatar}}" class="hello-avatar" src="{{myAvatar}}" mode="aspectFill"></image>
      <view wx:else class="hello-avatar">{{nickname}}</view>
      <view class="hello-text">
        <view class="hello-title">你好，{{nickname}}</view>
        <view class="hello-sub">头像和昵称来自微信，之后进来不用再填啦</view>
      </view>
    </view>

    <view class="card">
      <view class="card-title">创建我们的小家</view>
      <view class="card-sub">创建后把邀请卡分享给 TA，对方一点就能加入</view>
      <view class="btn primary block" bindtap="onCreate">{{saving ? '创建中…' : '创建我们的小家'}}</view>
    </view>

    <view class="card">
      <view class="card-title">或者用邀请码加入</view>
      <view class="row">
        <input class="input code" placeholder="6 位邀请码" value="{{joinCode}}" bindinput="onJoinInput" maxlength="10" />
        <view class="btn primary small" bindtap="onJoin">{{joining ? '连接中' : '加入'}}</view>
      </view>
    </view>
  </block>

  <block wx:elif="{{step === 'created'}}">
    <view class="card invite-card">
      <view class="invite-badge">邀请卡</view>
      <view class="card-title center">把这张卡发给 TA</view>
      <view class="card-sub center">对方点一下就能和你一起养这只小火苗</view>
      <view class="invite-code" bindtap="copyCode">{{inviteCode}}</view>
      <view class="invite-actions">
        <button class="share-btn" open-type="share">分享邀请卡给 TA</button>
        <view class="copy-btn" bindtap="copyCode">复制邀请码</view>
      </view>
      <view class="waiting">
        <text class="dot"></text><text class="dot"></text><text class="dot"></text>
        正在等 TA 过来…
      </view>
    </view>
  </block>

  
  <view class="boundary-note">
    <text class="bn-line">仅限两人私密互动工具 · 内容仅你们双方可见</text>
    <text class="bn-line">不提供公开发布 / 广场 / 推荐 / 关注 / 评论 / 内容转发</text>
  </view>
</view>
