page {
  background: #0d1122;
  height: 100%;
  overflow: hidden;
}

.page {
  position: relative;
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  background: linear-gradient(180deg, #0c1020 0%, #141a33 55%, #1b2140 100%);
}

/* ===== 夜间氛围 ===== */
.bg-glow {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}
.glow-a {
  top: -180rpx;
  right: -140rpx;
  width: 560rpx;
  height: 560rpx;
  background: radial-gradient(closest-side, rgba(126, 120, 255, 0.22), rgba(126, 120, 255, 0));
}
.glow-b {
  bottom: 180rpx;
  left: -220rpx;
  width: 600rpx;
  height: 600rpx;
  background: radial-gradient(closest-side, rgba(255, 154, 122, 0.12), rgba(255, 154, 122, 0));
}
.bg-star {
  position: absolute;
  width: 5rpx;
  height: 5rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.55);
  box-shadow: 0 0 12rpx rgba(200, 210, 255, 0.7);
  animation: twinkle 3.2s ease-in-out infinite;
}
.star-a { top: 190rpx; left: 120rpx; }
.star-b { top: 330rpx; right: 150rpx; animation-delay: 1.1s; }
.star-c { top: 560rpx; left: 90rpx; width: 4rpx; height: 4rpx; animation-delay: 2.1s; }

/* ===== 顶栏 ===== */
.topbar {
  position: relative;
  z-index: 2;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  padding: 20rpx 28rpx 16rpx;
  background: rgba(14, 18, 36, 0.88);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}
.top-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 18rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
  overflow: hidden;
  background: linear-gradient(135deg, #7d7bff, #b47bff);
  color: #ffffff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 18rpx rgba(90, 100, 255, 0.3);
}
.topbar-main {
  flex: 1;
  min-width: 0;
}
.title {
  font-size: 34rpx;
  font-weight: 800;
  color: #eeeaff;
  letter-spacing: 2rpx;
}
.sub {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #8f97b8;
}
.conn {
  flex-shrink: 0;
  margin-left: 14rpx;
  padding: 5rpx 16rpx;
  border-radius: 999rpx;
  font-size: 19rpx;
  background: rgba(255, 196, 120, 0.14);
  color: #ffc478;
}
.conn.ok {
  background: rgba(110, 231, 183, 0.14);
  color: #6ee7b7;
}

.state {
  text-align: center;
  margin-top: 200rpx;
  color: #8f97b8;
  font-size: 26rpx;
}
.state.err {
  color: #ff9aa8;
}

/* ===== 语音列表 ===== */
.voice-list {
  position: relative;
  z-index: 1;
  flex: 1 1 0;
  height: 0;
  min-height: 0;
  padding: 0 24rpx;
  box-sizing: border-box;
}
.list-top {
  height: 20rpx;
}
.list-bottom {
  height: 30rpx;
}

.time-row {
  text-align: center;
  margin: 22rpx 0 12rpx;
  font-size: 20rpx;
  color: #6f7898;
}

.system-row {
  display: table;
  margin: 14rpx auto;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.05);
  font-size: 21rpx;
  color: #8f97b8;
}

.voice-row {
  display: flex;
  align-items: flex-start;
  margin: 18rpx 0;
}
.voice-row.them {
  flex-direction: row;
}
.voice-row.mine {
  flex-direction: row-reverse;
}
.voice-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 18rpx;
  flex-shrink: 0;
  overflow: hidden;
  background: linear-gradient(135deg, #7d7bff, #b47bff);
  color: #ffffff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 16rpx rgba(20, 24, 50, 0.45);
}
.voice-row.them .voice-avatar {
  margin-right: 16rpx;
}
.voice-row.mine .voice-avatar {
  margin-left: 16rpx;
}

.voice-bubble {
  display: flex;
  align-items: center;
  min-width: 250rpx;
  max-width: 66%;
  padding: 16rpx 20rpx;
  border-radius: 24rpx;
  transition: transform 0.12s ease, box-shadow 0.2s ease;
}
.voice-bubble:active {
  transform: scale(0.985);
}
.voice-bubble.them {
  background: rgba(255, 255, 255, 0.07);
  border: 1rpx solid rgba(255, 255, 255, 0.09);
  border-top-left-radius: 8rpx;
  box-shadow: 0 10rpx 26rpx rgba(6, 8, 20, 0.35);
}
.voice-bubble.mine {
  background: linear-gradient(135deg, #ff9a7a, #ff7a9a);
  border-top-right-radius: 8rpx;
  box-shadow: 0 10rpx 26rpx rgba(255, 120, 140, 0.25);
}
.voice-bubble.playing.them {
  box-shadow: 0 0 0 2rpx rgba(160, 170, 255, 0.35), 0 10rpx 26rpx rgba(6, 8, 20, 0.35);
}
.voice-bubble.playing.mine {
  box-shadow: 0 0 0 2rpx rgba(255, 226, 160, 0.5), 0 10rpx 26rpx rgba(255, 120, 140, 0.3);
}

.play-dot {
  width: 46rpx;
  height: 46rpx;
  border-radius: 50%;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  line-height: 1;
  background: rgba(255, 255, 255, 0.16);
  color: #dfe4ff;
}
.voice-bubble.mine .play-dot {
  background: rgba(255, 255, 255, 0.28);
  color: #ffffff;
}

.wave {
  flex: 1;
  display: flex;
  align-items: center;
  height: 52rpx;
  margin: 0 16rpx;
  min-width: 120rpx;
}
.wave-bar {
  width: 5rpx;
  margin: 0 2rpx;
  border-radius: 4rpx;
  background: rgba(255, 255, 255, 0.42);
  transition: background 0.15s ease;
}
.voice-bubble.mine .wave-bar {
  background: rgba(255, 255, 255, 0.62);
}
.wave-bar.active {
  background: #ffe29a;
}
.voice-bubble.mine .wave-bar.active {
  background: #fff3c4;
}

.voice-dur {
  flex-shrink: 0;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.72);
  letter-spacing: 0.5rpx;
}

/* ===== 空状态 ===== */
.empty {
  margin-top: 120rpx;
  text-align: center;
}
.moon {
  width: 150rpx;
  height: 150rpx;
  margin: 0 auto 26rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 36% 32%, #fff8e6 0%, #ffe9b8 46%, #f3cf8e 100%);
  box-shadow: 0 0 60rpx rgba(255, 226, 154, 0.4), 0 0 140rpx rgba(255, 226, 154, 0.18);
  animation: moonFloat 4.2s ease-in-out infinite;
}
.empty-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #e4e1f5;
}
.empty-sub {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #8f97b8;
}
.list-foot {
  margin-top: 20rpx;
  text-align: center;
  font-size: 20rpx;
  color: #5d6684;
}

/* ===== 新语音提示 ===== */
.new-msg {
  position: absolute;
  right: 30rpx;
  bottom: 250rpx;
  z-index: 5;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(30, 36, 66, 0.96);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  color: #cfd6ff;
  font-size: 23rpx;
  box-shadow: 0 10rpx 24rpx rgba(0, 0, 0, 0.35);
  opacity: 0;
  transform: translateY(12rpx);
  pointer-events: none;
  transition: opacity 0.2s ease, transform 0.2s ease;
}
.new-msg.show {
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}

/* ===== 录音栏 ===== */
.record-bar {
  position: relative;
  z-index: 3;
  flex-shrink: 0;
  padding: 16rpx 28rpx 20rpx;
  padding-bottom: calc(20rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(14, 18, 36, 0.92);
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
}
.hold-btn {
  height: 96rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #ffb27a, #ff8a7a);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  box-shadow: 0 12rpx 28rpx rgba(255, 140, 110, 0.3);
  transition: transform 0.12s ease, box-shadow 0.2s ease;
}
.hold-btn:active {
  transform: scale(0.985);
}
.hold-btn.recording {
  background: linear-gradient(135deg, #ff7a8a, #ff5f7a);
  box-shadow: 0 0 0 6rpx rgba(255, 120, 140, 0.18), 0 12rpx 28rpx rgba(255, 90, 120, 0.3);
}
.mic {
  margin-right: 10rpx;
  font-size: 30rpx;
}
.record-tip {
  margin-top: 10rpx;
  text-align: center;
  font-size: 19rpx;
  color: #5d6684;
}

/* ===== 录音浮层 ===== */
.rec-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  background: rgba(4, 6, 14, 0.72);
  display: flex;
  align-items: center;
  justify-content: center;
}
.rec-card {
  width: 520rpx;
  padding: 48rpx 36rpx 36rpx;
  border-radius: 40rpx;
  background: rgba(28, 34, 64, 0.97);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  text-align: center;
  box-shadow: 0 30rpx 80rpx rgba(0, 0, 0, 0.5);
}
.rec-rings {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  margin: 0 auto;
}
.ring {
  position: absolute;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 154, 122, 0.5);
  animation: ringPulse 1.8s ease-out infinite;
}
.r1 { left: 60rpx; top: 60rpx; width: 80rpx; height: 80rpx; animation-delay: 0s; }
.r2 { left: 40rpx; top: 40rpx; width: 120rpx; height: 120rpx; animation-delay: 0.3s; }
.r3 { left: 20rpx; top: 20rpx; width: 160rpx; height: 160rpx; animation-delay: 0.6s; }
.rec-mic {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 104rpx;
  height: 104rpx;
  margin-left: -52rpx;
  margin-top: -52rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ffb27a, #ff8a7a);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  box-shadow: 0 10rpx 26rpx rgba(255, 120, 110, 0.4);
}
.rec-time {
  margin-top: 18rpx;
  font-size: 52rpx;
  font-weight: 800;
  color: #f1eeff;
  letter-spacing: 2rpx;
}
.rec-hint {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #9aa3c7;
}
.rec-hint.cancel {
  color: #ff8fa3;
}
.rec-progress {
  margin: 26rpx 10rpx 0;
  height: 8rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.1);
  overflow: hidden;
}
.rec-progress-fill {
  height: 100%;
  border-radius: 8rpx;
  background: linear-gradient(90deg, #ffc478, #ff8a7a);
  transition: width 0.2s linear;
}
.rec-limit {
  margin-top: 14rpx;
  font-size: 20rpx;
  color: #5d6684;
}

@keyframes twinkle {
  0%, 100% { opacity: 0.25; transform: scale(0.8); }
  50% { opacity: 0.9; transform: scale(1.2); }
}
@keyframes moonFloat {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10rpx); }
}
@keyframes ringPulse {
  0% { transform: scale(0.6); opacity: 0.9; }
  100% { transform: scale(1.25); opacity: 0; }
}
