page {
  background: linear-gradient(180deg, #fff7f2 0%, #ffece4 55%, #ffe3dd 100%);
  min-height: 100%;
}

button {
  margin: 0;
  padding: 0;
  background: none;
  line-height: normal;
}
button::after {
  border: none;
}

.page {
  position: relative;
  padding: 50rpx 44rpx 80rpx;
  overflow: hidden;
}

.deco {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}
.deco-a {
  top: -140rpx;
  right: -120rpx;
  width: 400rpx;
  height: 400rpx;
  background: radial-gradient(closest-side, rgba(255, 205, 170, 0.5), rgba(255, 205, 170, 0));
}
.deco-b {
  top: 620rpx;
  left: -180rpx;
  width: 420rpx;
  height: 420rpx;
  background: radial-gradient(closest-side, rgba(255, 178, 190, 0.38), rgba(255, 178, 190, 0));
}

.hero {
  position: relative;
  text-align: center;
  padding: 20rpx 0 14rpx;
}
.hero-title {
  font-size: 42rpx;
  font-weight: 800;
  color: #4a342b;
  letter-spacing: 3rpx;
}
.hero-sub {
  margin-top: 12rpx;
  font-size: 23rpx;
  color: #a78c7e;
}

.state {
  text-align: center;
  margin-top: 100rpx;
  color: #9a715c;
  font-size: 26rpx;
}
.state.err {
  color: #c9584f;
}

.card {
  position: relative;
  margin-top: 28rpx;
  padding: 44rpx 34rpx 36rpx;
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.95);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  box-shadow: 0 18rpx 44rpx rgba(214, 122, 78, 0.1);
}

.avatar-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.avatar-btn {
  width: 168rpx;
  height: 168rpx;
  border-radius: 50%;
  overflow: hidden;
  background: linear-gradient(135deg, #ffe3c9, #ffc2b8);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 30rpx rgba(255, 150, 120, 0.32);
}
.avatar-img {
  width: 168rpx;
  height: 168rpx;
  border-radius: 50%;
}
.avatar-placeholder {
  width: 168rpx;
  height: 168rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 68rpx;
  font-weight: 300;
}
.avatar-tip {
  margin-top: 16rpx;
  font-size: 21rpx;
  color: #b08e80;
}

.field {
  margin-top: 38rpx;
}
.field-label {
  font-size: 24rpx;
  color: #a78c7e;
  margin-bottom: 12rpx;
}
.input {
  height: 92rpx;
  padding: 0 30rpx;
  background: #fff4ee;
  border-radius: 26rpx;
  font-size: 30rpx;
  color: #4a342b;
}

.btn {
  height: 92rpx;
  line-height: 92rpx;
  padding: 0 32rpx;
  border-radius: 26rpx;
  font-size: 29rpx;
  text-align: center;
  flex-shrink: 0;
}
.btn.primary {
  background: linear-gradient(135deg, #ffb27a, #ff8a7a);
  color: #ffffff;
  font-weight: 600;
  box-shadow: 0 12rpx 26rpx rgba(255, 140, 110, 0.3);
}
.btn.primary.block {
  margin-top: 36rpx;
  width: 100%;
  box-sizing: border-box;
}
.btn:active {
  transform: scale(0.97);
}

.hint {
  margin-top: 22rpx;
  text-align: center;
  font-size: 21rpx;
  color: #b08e80;
  line-height: 1.6;
}

.footer {
  margin-top: 48rpx;
  text-align: center;
  font-size: 21rpx;
  color: #c2a08c;
}
