@import "../../styles/boundary.wxss";
page { background: linear-gradient(180deg, #fff9f4 0%, #fff0e7 58%, #ffe8e2 100%); min-height: 100%; }
.page { position: relative; padding: 28rpx 34rpx 80rpx; overflow: hidden; color: #4a342b; }
.deco { position: absolute; border-radius: 50%; pointer-events: none; filter: blur(2rpx); }
.deco-a { top: -120rpx; right: -100rpx; width: 380rpx; height: 380rpx; background: radial-gradient(closest-side, rgba(255,205,170,.5), transparent); }
.deco-b { top: 720rpx; left: -150rpx; width: 380rpx; height: 380rpx; background: radial-gradient(closest-side, rgba(255,175,185,.28), transparent); }

.head { padding: 12rpx 4rpx 26rpx; }
.eyebrow { font-size: 18rpx; letter-spacing: 4rpx; color: #c39a80; font-weight: 600; }
.title { margin-top: 14rpx; font-size: 46rpx; font-weight: 800; color: #3f2b22; }
.sub { margin-top: 12rpx; font-size: 23rpx; color: #a5836f; }

.section { margin-top: 30rpx; }
.section-label { font-size: 22rpx; letter-spacing: 1rpx; color: #b08c75; margin-bottom: 16rpx; }

.type-grid { display: flex; flex-wrap: wrap; justify-content: space-between; }
.type-card { position: relative; width: 48.5%; box-sizing: border-box; margin-bottom: 16rpx; padding: 22rpx 20rpx 20rpx; border-radius: 26rpx; background: rgba(255,255,255,.82); border: 1rpx solid rgba(255,255,255,.9); box-shadow: 0 12rpx 26rpx rgba(190,120,80,.07); }
.type-mark { width: 54rpx; height: 54rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 22rpx; font-weight: 700; letter-spacing: 0; background: #f7f0e9; color: #8a6a55; }
.type-name { margin-top: 12rpx; font-size: 28rpx; font-weight: 800; color: #4a342b; }
.type-desc { margin-top: 6rpx; font-size: 19rpx; color: #ac927f; line-height: 1.5; }
.type-check { position: absolute; right: 16rpx; top: 16rpx; width: 30rpx; height: 30rpx; border-radius: 50%; background: #e97b3e; color: #fff; font-size: 18rpx; display: flex; align-items: center; justify-content: center; }
.type-on { border-color: rgba(233,123,62,.45); box-shadow: 0 14rpx 30rpx rgba(233,123,62,.14); transform: translateY(-2rpx); }
.t-family .type-mark { background: #eef5ee; color: #5f7d65; }
.t-partner .type-mark { background: #fdeeee; color: #b35f5f; }
.t-friend .type-mark { background: #fbf3e2; color: #92713a; }
.t-custom .type-mark { background: #f1eef8; color: #6f638f; }

.chips { display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 16rpx; }
.chip { padding: 10rpx 22rpx; border-radius: 999rpx; background: rgba(255,255,255,.8); border: 1rpx solid rgba(225,200,180,.7); font-size: 22rpx; color: #8a6a55; }
.chip-on { background: linear-gradient(135deg, #f5a05f, #e97b3e); border-color: transparent; color: #fff; font-weight: 600; }
.text-input { width: 100%; box-sizing: border-box; height: 86rpx; padding: 0 24rpx; border-radius: 22rpx; background: rgba(255,255,255,.86); border: 1rpx solid rgba(230,205,185,.7); font-size: 25rpx; color: #4a342b; }
.hint { margin-top: 12rpx; font-size: 19rpx; color: #b49a88; line-height: 1.6; }

.actions { margin-top: 40rpx; }
.primary-btn { height: 88rpx; border-radius: 999rpx; background: linear-gradient(135deg, #f5a05f, #e97b3e); color: #fff; font-size: 27rpx; font-weight: 700; display: flex; align-items: center; justify-content: center; box-shadow: 0 14rpx 30rpx rgba(233,123,62,.22); }
.primary-btn.disabled { opacity: .6; }
.sub-note { text-align: center; margin-top: 16rpx; font-size: 19rpx; color: #c0a793; }

/* 完成态 */
.done { text-align: center; padding-top: 40rpx; }
.done-ring { position: relative; width: 190rpx; height: 190rpx; margin: 0 auto 24rpx; border-radius: 50%; background: radial-gradient(closest-side, rgba(255,230,200,.9), rgba(255,230,200,.1)); display: flex; align-items: center; justify-content: center; }
.done-flame { width: 90rpx; height: 120rpx; border-radius: 50% 50% 46% 46% / 64% 64% 36% 36%; background: radial-gradient(130% 110% at 50% 100%, #ffd97a 0%, #ffb15c 45%, #ff7d55 78%, #ef4c5e 100%); box-shadow: 0 16rpx 34rpx rgba(239,92,94,.25); }
.done-title { font-size: 40rpx; font-weight: 800; color: #3f2b22; }
.done-sub { margin: 14rpx auto 0; max-width: 520rpx; font-size: 22rpx; color: #a5836f; line-height: 1.7; }
.invite-card { margin-top: 34rpx; padding: 30rpx 26rpx; border-radius: 30rpx; background: rgba(255,255,255,.9); border: 1rpx solid rgba(255,255,255,.95); box-shadow: 0 18rpx 40rpx rgba(190,120,80,.1); }
.invite-label { font-size: 21rpx; color: #b08c75; }
.invite-code { margin-top: 12rpx; font-size: 64rpx; letter-spacing: 10rpx; font-weight: 800; color: #b96f45; }
.invite-actions { display: flex; gap: 16rpx; margin-top: 26rpx; }
.invite-actions .ghost-btn, .invite-actions .primary-btn { flex: 1; }
.ghost-btn { height: 84rpx; border-radius: 999rpx; background: rgba(255,255,255,.8); border: 1rpx solid rgba(220,190,168,.7); color: #8a6a55; font-size: 24rpx; display: flex; align-items: center; justify-content: center; }
.share-btn { margin: 0; padding: 0; line-height: 84rpx; }
.share-btn::after { border: none; }
.done-actions { margin-top: 28rpx; }
.text-link { font-size: 23rpx; color: #b96f45; }

/* 创建密码弹窗 */
.pass-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(32, 24, 20, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
  padding: 0 48rpx;
}
.pass-card {
  width: 100%;
  background: #fffdfb;
  border-radius: 28rpx;
  padding: 40rpx 36rpx 32rpx;
  box-shadow: 0 30rpx 80rpx rgba(60, 40, 30, 0.25);
}
.pass-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #3d2b22;
  text-align: center;
}
.pass-sub {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #a08b80;
  text-align: center;
}
.pass-input {
  margin-top: 28rpx;
  height: 92rpx;
  padding: 0 24rpx;
  background: #faf5f1;
  border: 1rpx solid #eadfd7;
  border-radius: 18rpx;
  font-size: 32rpx;
  letter-spacing: 8rpx;
  text-align: center;
  color: #3d2b22;
}
.pass-err {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #d9584a;
  text-align: center;
}
.pass-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 30rpx;
}
.pass-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 18rpx;
  font-size: 28rpx;
}
.pass-btn.ghost {
  background: #f6f0ea;
  color: #8a7365;
}
.pass-btn.primary {
  background: linear-gradient(135deg, #f7a072, #f2795b);
  color: #fff;
  font-weight: 600;
}
