/* 使用边界说明（个人主体审核用，弱化视觉） */
.boundary-note {
  margin: 28rpx 48rpx calc(30rpx + env(safe-area-inset-bottom));
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(150, 120, 105, 0.14);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}
.boundary-note .bn-line {
  font-size: 19rpx;
  line-height: 1.7;
  color: rgba(120, 96, 84, 0.62);
  text-align: center;
  letter-spacing: 0.5rpx;
}
