/**app.wxss**/
.container {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding: 200rpx 0;
  box-sizing: border-box;
} 


button {
  width: 80%;
  margin: 20rpx auto;
  padding: 20rpx 0;
  border-radius: 12rpx;
  background: #4b7bec;
  color: white;
  font-size: 32rpx;
}

button:active {
  opacity: 0.8;
}