.page-container {
  min-height: 100vh;
  background: #f4f7fc;
  padding: 20rpx 30rpx 60rpx;
}

/* 进度条 */
.progress-bar-area {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.pb-bg {
  flex: 1;
  height: 12rpx;
  background: #e0e0e0;
  border-radius: 20rpx;
  overflow: hidden;
  margin-right: 20rpx;
}

.pb-inner {
  height: 100%;
  background: #4b7bec;
  transition: 0.3s;
}

.count-txt {
  font-size: 24rpx;
  color: #999;
}

/* 卡片 */
.main-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.q-tag {
  font-size: 22rpx;
  color: #4b7bec;
  background: #eef2ff;
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  margin-bottom: 20rpx;
}

.q-title {
  font-size: 34rpx;
  color: #333;
  line-height: 1.6;
  margin-bottom: 40rpx;
  font-weight: 500;
}

/* 选项 */
.opt-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border: 2rpx solid #f0f0f0;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  transition: 0.2s;
}

.opt-idx {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #f5f5f5;
  text-align: center;
  line-height: 44rpx;
  margin-right: 20rpx;
  font-size: 24rpx;
}

.opt-item.active {
  border-color: #4b7bec;
  background: #f0f5ff;
}

.opt-item.success {
  border-color: #07c160;
  background: #f6ffed;
}

.opt-item.error {
  border-color: #ff4d4f;
  background: #fff1f0;
}

/* 填空题输入框 */
.input-section {
  margin: 60rpx 0;
}

.underline-input {
  border-bottom: 4rpx solid #4b7bec;
  height: 100rpx;
  text-align: center;
  font-size: 36rpx;
}

.input-success {
  border-bottom-color: #07c160;
  color: #07c160;
}

.input-error {
  border-bottom-color: #ff4d4f;
  color: #ff4d4f;
}

/* 按钮 */
.action-btn-box {
  margin-top: 40rpx;
  display: flex;
  justify-content: center;
}

.action-btn {
  width: 100%;
  height: 96rpx;
  border-radius: 48rpx;
  display: flex !important;
  justify-content: center !important;
  align-items: center !important;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  margin: 0 !important;
  padding: 0 !important;
  line-height: normal !important;
  box-sizing: border-box; /* 防止边框撑大 */
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

.action-btn::after {
  border: none;
}

.action-primary {
  background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
  color: #fff;
  box-shadow: 0 8rpx 20rpx -4rpx rgba(79, 70, 229, 0.4);
}

.action-primary:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(79, 70, 229, 0.3);
}

.action-next {
  background: #ffffff;
  color: #4f46e5;
  border: 2rpx solid #e0e7ff;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.03);
}

.action-next:active {
  background: #f8fafc;
  transform: scale(0.98);
}

.sub-action-row {
  margin-top: 24rpx;
  display: flex;
  justify-content: center;
}

.sub-action-btn {
  width: 100%;
  height: 80rpx;
  border-radius: 40rpx;
  display: flex !important;
  justify-content: center !important;
  align-items: center !important;
  font-size: 28rpx;
  font-weight: 500;
  color: #64748b;
  background: #f1f5f9;
  border: none;
  line-height: normal !important;
  margin: 0 !important;
  padding: 0 !important;
}

.sub-action-btn::after {
  border: none;
}

.sub-action-btn-active {
  color: #4f46e5;
  background: #e0e7ff;
  font-weight: 600;
}

/* 解析区 */
.result-analysis {
  margin-top: 60rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #fafafa;
}

.status-banner {
  padding: 30rpx;
  display: flex;
  justify-content: space-between;
  font-weight: bold;
  font-size: 30rpx;
}

.banner-success {
  background: #f6ffed;
  color: #07c160;
}

.banner-error {
  background: #fff1f0;
  color: #ff4d4f;
}

.analysis-body {
  padding: 30rpx;
}

.ana-title {
  font-size: 26rpx;
  color: #888;
  margin-bottom: 16rpx;
}

.ana-text {
  font-size: 28rpx;
  color: #444;
  line-height: 1.8;
  display: block;
}


/* 确保所有公式图片正确缩放 */
rich-text image {
  max-width: 100% !important;
  height: auto !important;
  /* 内联样式会覆盖，但保留 */
}






/* --- 新增：标签栏与科目标签样式 --- */
.tag-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.tag-bar .q-tag {
  margin-bottom: 0;
}

/* 科目标签：高级紫 */
.subject-tag {
  color: #7c3aed;
  /* 优雅的深紫色 */
  background: #ede9fe;
  /* 极浅的柔和紫背景 */
}



/* --- 覆盖 towxml 默认样式，保护原有 UI 不被撑破 --- */
.q-title towxml,
.opt-val towxml,
.ana-text towxml {
  display: inline;
  /* 强制转为行内元素，避免换行问题 */
}

/* 强行去掉 towxml 里面所有 p 标签自带的上下外边距 */
.opt-val .h2w__p,
.q-title .h2w__p,
.ana-text .h2w__p {
  margin: 0 !important;
  padding: 0 !important;
  display: inline-block;
  /* 保证居中对齐 */
  vertical-align: middle;
}

/* 微调数学公式的垂直对齐，使其和周围文字完美在一条线上 */
.h2w__equation {
  vertical-align: middle !important;
  margin: 0 4rpx !important;
  /* 公式左右稍微留一点空隙 */
}