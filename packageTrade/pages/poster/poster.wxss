@import "../../common.wxss";

.topline { display: flex; justify-content: space-between; padding-top: 8rpx; }
.poster-head { padding: 28rpx 0 20rpx; }
.poster-title {
  font-family: "Songti SC", "STSong", serif;
  font-size: 54rpx;
  font-weight: 600;
  color: #211b16;
}
.title-it { color: #8f5338; font-style: italic; }
.poster-sub { margin-top: 8rpx; font-size: 19rpx; color: #9a836c; }

.poster-frame {
  position: relative;
  width: 100%;
  padding: 12rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(74, 56, 39, 0.16);
  border-radius: 10rpx;
  background: rgba(255, 251, 245, 0.7);
}
.poster-canvas {
  display: block;
  width: 100%;
  height: 950rpx;
  background: #f5f0e7;
}
.poster-loading {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 251, 245, 0.92);
  font-size: 20rpx;
  color: #8f7a65;
}

.direct-share {
  margin-top: 22rpx;
}
.direct-share-btn {
  width: 100%;
  height: 90rpx;
  margin: 0;
  padding: 0;
  line-height: 90rpx;
  border: 0;
  border-radius: 8rpx;
  font-size: 25rpx;
}
.direct-share-btn::after {
  border: 0;
}
.direct-share-note {
  margin-top: 10rpx;
  font-size: 17rpx;
  line-height: 1.6;
  color: #a18b74;
  text-align: center;
}
.poster-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 14rpx;
}
.poster-actions .btn { flex: 1; height: 76rpx; font-size: 21rpx; }
.share-card {
  margin-top: 26rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid rgba(74, 56, 39, 0.13);
  border-radius: 8rpx;
  background: rgba(232, 238, 229, 0.56);
}
.share-title { font-size: 24rpx; color: #33281e; }
.share-copy { margin-top: 8rpx; font-size: 19rpx; line-height: 1.75; color: #7d6a57; }
.share-guide { margin-top: 12rpx; font-size: 18rpx; color: #5d735f; }
.poster-note { margin-top: 24rpx; font-size: 18rpx; line-height: 1.8; color: #9a836c; }
