@import "../../common.wxss";

.topline { display: flex; justify-content: space-between; padding-top: 8rpx; }
.listing-head { padding: 30rpx 0 20rpx; }
.listing-title-big { font-family: "Songti SC", "STSong", serif; font-size: 44rpx; line-height: 1.3; font-weight: 600; color: #211b16; }
.listing-model-big { margin-top: 8rpx; font-size: 20rpx; color: #806d5a; }
.listing-price-big { margin-top: 12rpx; font-family: "Songti SC", "STSong", serif; font-size: 48rpx; color: #8f5338; }
.gallery { white-space: nowrap; width: 100%; }
.gallery-img { display: inline-block; width: 520rpx; height: 390rpx; margin-right: 10rpx; border-radius: 8rpx; background: #e8e2d7; }
.facts { margin-top: 20rpx; border-top: 1rpx solid rgba(74,56,39,.15); }
.fact { display: flex; justify-content: space-between; padding: 15rpx 2rpx; border-bottom: 1rpx solid rgba(74,56,39,.12); }
.fact-k { font-family: "SF Mono", Menlo, monospace; font-size: 15rpx; color: #a28a73; }
.fact-v { font-size: 20rpx; color: #33281e; }
.desc { margin-top: 22rpx; font-size: 21rpx; line-height: 1.85; white-space: pre-wrap; color: #4d3c2e; }
.trade-note { margin-top: 24rpx; padding: 18rpx 20rpx; border: 1rpx solid rgba(74,56,39,.14); border-radius: 8rpx; background: rgba(232,238,229,.45); font-size: 17rpx; line-height: 1.8; color: #756451; }
.listing-actions { display: flex; gap: 12rpx; margin-top: 24rpx; }
.listing-actions .btn { flex: 1; height: 82rpx; font-size: 22rpx; }
.empty { padding: 90rpx 20rpx; text-align: center; }
.empty-title { font-family: "Songti SC", serif; font-size: 32rpx; color: #3a2e24; }
.empty-copy { margin-top: 12rpx; font-size: 21rpx; color: #9a836c; }
.empty .btn { margin-top: 22rpx; }
