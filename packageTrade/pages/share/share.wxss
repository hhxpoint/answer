@import "../../common.wxss";

.topline { display: flex; justify-content: space-between; padding-top: 8rpx; }
.share-head { padding: 38rpx 0 20rpx; }
.share-eyebrow { font-family: "SF Mono", Menlo, monospace; font-size: 16rpx; letter-spacing: 2rpx; color: #9c836d; }
.share-title { margin-top: 14rpx; font-family: "Songti SC", "STSong", serif; font-size: 52rpx; line-height: 1.2; font-weight: 600; color: #211b16; }
.share-sub { margin-top: 8rpx; font-size: 21rpx; color: #806d5a; }
.share-image-wrap { margin-top: 10rpx; padding: 12rpx; border: 1rpx solid rgba(74,56,39,.12); border-radius: 10rpx; background: rgba(255,251,245,.55); }
.share-image { width: 100%; height: 360rpx; }
.share-price-card { margin-top: 22rpx; padding: 24rpx; border: 1rpx solid rgba(74,56,39,.16); border-radius: 10rpx; background: rgba(255,251,245,.74); }
.share-kicker { font-family: "SF Mono", Menlo, monospace; font-size: 15rpx; letter-spacing: 1.4rpx; color: #9c836d; }
.share-range { margin-top: 8rpx; font-size: 46rpx; }
.share-price-row { display: flex; margin-top: 18rpx; padding-top: 16rpx; border-top: 1rpx solid rgba(74,56,39,.13); }
.share-price-col { flex: 1; }
.share-label { font-size: 17rpx; color: #9a836c; }
.share-num { margin-top: 5rpx; font-size: 24rpx; color: #33281e; }
.share-accent { color: #8f5338; font-weight: 600; }
.share-meta { margin-top: 16rpx; font-size: 17rpx; line-height: 1.6; color: #a18b74; }
.share-specs { margin-top: 22rpx; border-top: 1rpx solid rgba(74,56,39,.14); }
.share-spec { display: flex; align-items: baseline; justify-content: space-between; gap: 20rpx; padding: 14rpx 2rpx; border-bottom: 1rpx solid rgba(74,56,39,.12); }
.share-k { font-family: "SF Mono", Menlo, monospace; font-size: 15rpx; color: #a28a73; letter-spacing: 1rpx; flex-shrink: 0; }
.share-v { font-size: 20rpx; color: #33281e; text-align: right; }
.share-cta { display: flex; flex-direction: column; gap: 10rpx; margin-top: 28rpx; }
.share-cta .btn { height: 84rpx; font-size: 23rpx; }
.share-tip { margin-top: 22rpx; font-size: 18rpx; line-height: 1.8; color: #9a836c; }
.share-tip-link { margin-top: 8rpx; color: #8f5338; }
.invalid-box { padding: 100rpx 20rpx; text-align: center; }
.invalid-mark { font-family: Georgia, serif; font-size: 50rpx; color: #b39b83; }
.invalid-title { margin-top: 14rpx; font-family: "Songti SC", serif; font-size: 34rpx; color: #3a2e24; }
.invalid-copy { margin-top: 10rpx; font-size: 21rpx; color: #9a836c; }
.invalid-box .btn { margin-top: 28rpx; }
