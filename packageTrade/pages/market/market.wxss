@import "../../common.wxss";

.topline { display: flex; justify-content: space-between; padding-top: 8rpx; }
.market-head { padding: 36rpx 0 22rpx; }
.market-title { font-family: "Songti SC", "STSong", serif; font-size: 54rpx; font-weight: 600; color: #211b16; }
.title-it { color: #8f5338; font-style: italic; }
.market-sub { margin-top: 8rpx; font-size: 19rpx; color: #9a836c; }
.category-row { display: flex; gap: 8rpx; margin-bottom: 20rpx; }
.category-tab { flex: 1; text-align: center; padding: 10rpx 0; font-size: 20rpx; color: #806d5a; border-bottom: 1rpx solid rgba(74,56,39,.16); }
.category-tab.on { color: #8f5338; border-bottom-color: #8f5338; font-weight: 500; }
.market-empty { padding: 60rpx 20rpx; text-align: center; font-size: 21rpx; line-height: 1.8; color: #9a836c; }
.market-empty-link { margin-top: 10rpx; color: #8f5338; }
.listing-grid { display: flex; flex-wrap: wrap; gap: 12rpx; }
.listing-card { width: calc(50% - 6rpx); box-sizing: border-box; overflow: hidden; }
.listing-cover { width: 100%; height: 230rpx; background: #e8e2d7; }
.listing-body { padding: 14rpx 16rpx 16rpx; }
.listing-category { font-family: "SF Mono", Menlo, monospace; font-size: 14rpx; color: #a08a73; }
.listing-title { margin-top: 6rpx; font-size: 23rpx; line-height: 1.4; color: #2d251d; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
.listing-model { margin-top: 6rpx; font-size: 16rpx; color: #9a836c; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.listing-foot { display: flex; justify-content: space-between; align-items: baseline; margin-top: 12rpx; }
.listing-price { font-family: "Songti SC", "STSong", serif; font-size: 25rpx; color: #8f5338; }
.listing-city { font-size: 15rpx; color: #a18b74; }
.market-tip { margin-top: 26rpx; font-size: 18rpx; line-height: 1.8; color: #9a836c; }
.market-actions { margin-top: 22rpx; }
.market-actions .btn { height: 78rpx; font-size: 22rpx; }
