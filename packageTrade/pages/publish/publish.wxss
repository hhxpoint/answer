@import "../../common.wxss";

.topline { display: flex; justify-content: space-between; padding-top: 8rpx; }
.publish-head { padding: 34rpx 0 20rpx; }
.publish-title { font-family: "Songti SC", "STSong", serif; font-size: 52rpx; font-weight: 600; color: #211b16; }
.title-it { color: #8f5338; font-style: italic; }
.publish-sub { margin-top: 8rpx; font-size: 20rpx; color: #806d5a; }
.notice { padding: 18rpx 20rpx; border: 1rpx solid rgba(74,56,39,.14); border-radius: 8rpx; background: rgba(232,238,229,.5); font-size: 18rpx; line-height: 1.7; color: #6f614f; }
.photo-row { display: flex; flex-wrap: wrap; gap: 10rpx; }
.photo-item, .photo-add { position: relative; width: calc(33.33% - 7rpx); height: 180rpx; border-radius: 6rpx; overflow: hidden; border: 1rpx solid rgba(74,56,39,.14); background: rgba(255,251,245,.5); }
.photo-img { width: 100%; height: 100%; }
.photo-status { position: absolute; left: 8rpx; bottom: 8rpx; padding: 3rpx 8rpx; border-radius: 4rpx; background: rgba(35,28,22,.7); color: #fff; font-size: 15rpx; }
.photo-status.error { background: #a54f3a; }
.photo-del { position: absolute; top: 2rpx; right: 6rpx; color: #fff; font-size: 30rpx; text-shadow: 0 1rpx 3rpx rgba(0,0,0,.5); }
.photo-add { display: flex; flex-direction: column; align-items: center; justify-content: center; border-style: dashed; }
.photo-plus { font-size: 36rpx; color: #a58b73; }
.photo-add-text { margin-top: 4rpx; font-size: 16rpx; color: #9a836c; }
.field { margin-top: 20rpx; }
.field-label { margin-bottom: 8rpx; font-size: 18rpx; color: #8a7660; }
.field-input { height: 76rpx; padding: 0 16rpx; border: 1rpx solid rgba(74,56,39,.16); border-radius: 6rpx; background: rgba(255,251,245,.55); font-size: 23rpx; color: #2c231b; }
.field-textarea { width: 100%; height: 170rpx; padding: 14rpx 16rpx; box-sizing: border-box; border: 1rpx solid rgba(74,56,39,.16); border-radius: 6rpx; background: rgba(255,251,245,.55); font-size: 22rpx; color: #2c231b; }
.publish-meta { display: flex; justify-content: space-between; margin-top: 22rpx; font-size: 18rpx; color: #9a836c; }
.error-text { margin-top: 16rpx; font-size: 18rpx; color: #a54f3a; }
.submit-btn { margin-top: 24rpx; height: 90rpx; }
.publish-foot { display: flex; justify-content: space-between; margin-top: 18rpx; font-size: 18rpx; color: #8f5338; }
.link { padding: 8rpx 0; }
.empty { padding: 90rpx 20rpx; text-align: center; }
.empty-title { font-family: "Songti SC", serif; font-size: 32rpx; color: #3a2e24; }
.empty-copy { margin-top: 12rpx; font-size: 22rpx; color: #9a836c; }
