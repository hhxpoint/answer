/* Paper Geek 骨架屏样式 */

.skeleton-wrap {
  padding: 0 24rpx;
}

/* 抬头骨架 */
.skeleton-masthead {
  background-color: #FFFFFF;
  padding: 40rpx 32rpx;
  text-align: center;
  margin: 0 -24rpx 20rpx;
  border-bottom: 4rpx double #DDDDDD;
}

.skeleton-rule {
  height: 6rpx;
  background: linear-gradient(90deg,
    transparent 0%, #E8E8E8 10%, #E8E8E8 45%,
    transparent 45%, transparent 55%,
    #E8E8E8 55%, #E8E8E8 90%, transparent 100%
  );
  margin: 16rpx 0;
}

.skeleton-title-block {
  width: 60%;
  height: 64rpx;
  margin: 24rpx auto;
  background: linear-gradient(90deg, #E8E8E8 25%, #F0F0F0 50%, #E8E8E8 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
}

.skeleton-divider {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 0 40rpx;
  margin: 16rpx 0;
}

.skeleton-line {
  flex: 1;
  height: 2rpx;
  background: linear-gradient(90deg, #E8E8E8 25%, #F0F0F0 50%, #E8E8E8 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
}

.skeleton-line.long { width: 100%; flex: none; }
.skeleton-line.medium { width: 70%; flex: none; margin-top: 12rpx; }

.skeleton-dot {
  width: 16rpx;
  height: 16rpx;
  background: linear-gradient(90deg, #E8E8E8 25%, #F0F0F0 50%, #E8E8E8 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
}

.skeleton-subtitle {
  width: 40%;
  height: 28rpx;
  margin: 16rpx auto;
  background: linear-gradient(90deg, #E8E8E8 25%, #F0F0F0 50%, #E8E8E8 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
}

.skeleton-meta {
  width: 50%;
  height: 24rpx;
  margin: 20rpx auto;
  background: linear-gradient(90deg, #E8E8E8 25%, #F0F0F0 50%, #E8E8E8 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
}

/* 头条骨架 */
.skeleton-headline {
  background-color: #FFFFFF;
  border: 2rpx solid #DDDDDD;
  margin-bottom: 32rpx;
  overflow: hidden;
}

.skeleton-venue-block {
  width: 100%;
  height: 200rpx;
  background: linear-gradient(90deg, #E8E8E8 25%, #F0F0F0 50%, #E8E8E8 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
}

.skeleton-headline-content {
  padding: 24rpx;
}

.skeleton-citation {
  width: 160rpx;
  height: 36rpx;
  background: linear-gradient(90deg, #E8E8E8 25%, #F0F0F0 50%, #E8E8E8 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
  margin-bottom: 16rpx;
}

.skeleton-authors {
  width: 50%;
  height: 24rpx;
  background: linear-gradient(90deg, #E8E8E8 25%, #F0F0F0 50%, #E8E8E8 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
  margin: 12rpx 0;
}

/* 论文列表骨架 */
.skeleton-papers {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.skeleton-paper {
  display: flex;
  background-color: #FFFFFF;
  border: 1rpx solid #DDDDDD;
  overflow: hidden;
}

.skeleton-paper-venue {
  width: 80rpx;
  height: 200rpx;
  flex-shrink: 0;
  background: linear-gradient(90deg, #E8E8E8 25%, #F0F0F0 50%, #E8E8E8 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
}

.skeleton-paper-content {
  flex: 1;
  padding: 20rpx;
}

.skeleton-citation-small {
  width: 100rpx;
  height: 28rpx;
  background: linear-gradient(90deg, #E8E8E8 25%, #F0F0F0 50%, #E8E8E8 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
  margin-bottom: 12rpx;
}

.skeleton-authors-small {
  width: 40%;
  height: 22rpx;
  background: linear-gradient(90deg, #E8E8E8 25%, #F0F0F0 50%, #E8E8E8 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
  margin: 8rpx 0;
}

@keyframes shimmer {
  0% { background-position: -200% 0; }
  100% { background-position: 200% 0; }
}
