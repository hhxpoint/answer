/* translate.wxss */
/* Paper Geek - 翻译工具页样式 */

.translate-page {
  min-height: 100vh;
  background-color: #F4F1EA;
  padding-bottom: 40rpx;
}

/* ===== 导航栏 ===== */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx;
  background-color: #FFFFFF;
  border-bottom: 2rpx solid #333333;
  position: sticky;
  top: 0;
  z-index: 100;
}

.nav-back {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  font-size: 36rpx;
  font-weight: bold;
  color: #333333;
}

.nav-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333333;
  letter-spacing: 2rpx;
}

.nav-placeholder {
  width: 60rpx;
}

/* ===== 模式切换 ===== */
.mode-tabs {
  display: flex;
  background-color: #FFFFFF;
  border-bottom: 1rpx solid #DDDDDD;
}

.mode-tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 24rpx;
  border-bottom: 4rpx solid transparent;
  transition: all 0.3s;
}

.mode-tab.active {
  border-bottom-color: #333333;
}

.tab-icon {
  font-size: 28rpx;
}

.tab-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.mode-tab:not(.active) .tab-text {
  color: #888888;
}

/* ===== 语言选择栏 ===== */
.lang-bar {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  background-color: #FFFFFF;
  margin-bottom: 24rpx;
  border-bottom: 1rpx solid #EEEEEE;
}

.lang-selector {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.lang-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  padding: 12rpx 24rpx;
  background-color: #F4F1EA;
  border-radius: 8rpx;
}

.lang-swap {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 24rpx;
  background-color: #1a1a1a;
  border-radius: 50%;
}

.swap-icon {
  font-size: 32rpx;
  color: #FFFFFF;
}

/* ===== 输入区域 ===== */
.input-section {
  background-color: #FFFFFF;
  margin: 0 24rpx 24rpx;
  border: 1rpx solid #DDDDDD;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #EEEEEE;
}

.section-label {
  font-size: 26rpx;
  font-weight: 700;
  color: #333333;
  letter-spacing: 2rpx;
}

.section-actions {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  padding: 8rpx 16rpx;
  background-color: #F4F1EA;
  border: 1rpx solid #DDDDDD;
}

.action-btn.small text {
  font-size: 22rpx;
  color: #666666;
}

.play-icon {
  font-size: 24rpx;
}

.text-input {
  width: 100%;
  min-height: 240rpx;
  padding: 24rpx;
  font-size: 30rpx;
  line-height: 1.8;
  color: #333333;
  box-sizing: border-box;
}

.char-count {
  padding: 12rpx 24rpx;
  font-size: 22rpx;
  color: #999999;
  text-align: right;
  border-top: 1rpx solid #EEEEEE;
}

/* ===== 翻译按钮 ===== */
.translate-btn-wrapper {
  padding: 0 24rpx;
  margin-bottom: 24rpx;
}

.translate-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  background-color: #1a1a1a;
  border: 3rpx solid #333333;
  transition: all 0.3s;
}

.translate-btn:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.translate-btn.loading {
  background-color: #666666;
}

.btn-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: 4rpx;
}

/* ===== 结果区域 ===== */
.result-section {
  background-color: #FFFFFF;
  margin: 0 24rpx 24rpx;
  border: 1rpx solid #DDDDDD;
}

.text-output {
  padding: 24rpx;
  font-size: 30rpx;
  line-height: 1.8;
  color: #333333;
  min-height: 160rpx;
}

/* ===== 图片翻译区域 ===== */
.image-section {
  margin: 0 24rpx 24rpx;
}

.image-upload {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 320rpx;
  background-color: #FFFFFF;
  border: 2rpx dashed #CCCCCC;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
}

.upload-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.upload-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 8rpx;
}

.upload-hint {
  font-size: 24rpx;
  color: #999999;
}

.image-tips {
  background-color: #FFFFFF;
  padding: 24rpx;
  border: 1rpx solid #DDDDDD;
}

.tips-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #333333;
  display: block;
  margin-bottom: 16rpx;
}

.tips-item {
  font-size: 24rpx;
  color: #666666;
  line-height: 2;
  display: block;
}

/* ===== 历史记录 ===== */
.history-section {
  background-color: #FFFFFF;
  margin: 0 24rpx 24rpx;
  border: 1rpx solid #DDDDDD;
}

.history-list {
  max-height: 600rpx;
  overflow-y: auto;
}

.history-item {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.history-item:last-child {
  border-bottom: none;
}

.history-content {
  flex: 1;
  overflow: hidden;
}

.history-content:active {
  background-color: #F8F8F8;
}

.history-delete {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 16rpx;
  background-color: #ffc0e7;
  border-radius: 50%;
  flex-shrink: 0;
}

.history-delete:active {
  opacity: 0.7;
}

.delete-icon {
  font-size: 32rpx;
  color: #FFFFFF;
  font-weight: bold;
}

.history-text {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.history-source {
  flex: 1;
  font-size: 26rpx;
  color: #333333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.history-arrow {
  padding: 0 16rpx;
  font-size: 24rpx;
  color: #999999;
}

.history-target {
  flex: 1;
  font-size: 26rpx;
  color: #666666;
  text-align: right;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.history-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.history-lang {
  font-size: 22rpx;
  color: #999999;
}

.history-time {
  font-size: 22rpx;
  color: #999999;
}

/* ===== 底部品牌 ===== */
.footer {
  padding: 40rpx 32rpx;
  text-align: center;
  margin: 0 24rpx;
  border-top: 2rpx solid #333333;
}

.footer-text {
  font-size: 22rpx;
  color: #888888;
  letter-spacing: 2rpx;
}

/* ===== 响应式 ===== */
@media screen and (max-width: 375px) {
  .text-input {
    font-size: 28rpx;
    min-height: 200rpx;
  }
  
  .lang-name {
    font-size: 26rpx;
  }
}
