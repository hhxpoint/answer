/* packageTech/pages/conference/conference.wxss */
/* Paper Geek - 顶会荟萃样式 */

.conference-page {
  min-height: 100vh;
  background-color: #F4F1EA;
  position: relative;
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
}

.paper-bg {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, #F4F1EA 0%, #FBFBFB 50%, #F4F1EA 100%);
  z-index: -1;
}

/* ===== 页面标题 ===== */
.page-header {
  background-color: #FFFFFF;
  padding: 40rpx 32rpx;
  text-align: center;
  border-bottom: 4rpx double #333333;
  margin-bottom: 20rpx;
}

.header-title {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.title-icon {
  font-size: 48rpx;
}

.title-text {
  font-size: 48rpx;
  font-weight: 900;
  color: #1a1a1a;
  letter-spacing: 8rpx;
  font-family: 'Georgia', serif;
}

.header-subtitle {
  font-size: 24rpx;
  color: #888888;
  letter-spacing: 4rpx;
}

/* ===== 方向筛选 ===== */
.area-scroll {
  background-color: #FFFFFF;
  padding: 20rpx 0;
  white-space: nowrap;
  border-bottom: 1rpx solid #DDDDDD;
}

.area-list {
  display: inline-flex;
  padding: 0 20rpx;
  gap: 16rpx;
}

.area-item {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  background-color: #F4F1EA;
  border: 1rpx solid #DDDDDD;
  border-radius: 24rpx;
  transition: all 0.2s;
}

.area-item:active {
  transform: scale(0.95);
}

.area-item.active {
  background-color: #1a1a1a;
  border-color: #1a1a1a;
}

.area-item.active .area-name {
  color: #FFFFFF;
}

.area-icon {
  font-size: 24rpx;
}

.area-name {
  font-size: 24rpx;
  color: #333333;
  font-weight: 500;
}

/* ===== 年份筛选 ===== */
.year-scroll {
  background-color: #FFFFFF;
  padding: 16rpx 0;
  white-space: nowrap;
  border-bottom: 1rpx solid #DDDDDD;
}

.year-list {
  display: inline-flex;
  padding: 0 20rpx;
  gap: 12rpx;
}

.year-item {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 100rpx;
  padding: 10rpx 20rpx;
  background-color: #F4F1EA;
  border: 1rpx solid #DDDDDD;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #666666;
  font-weight: 600;
  transition: all 0.2s;
}

.year-item:active {
  transform: scale(0.95);
}

.year-item.active {
  background-color: #333333;
  border-color: #333333;
  color: #FFFFFF;
}

/* ===== 顶会列表 ===== */
.conference-grid {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.conference-card {
  display: flex;
  background-color: #FFFFFF;
  border: 1rpx solid #DDDDDD;
  overflow: hidden;
  transition: transform 0.2s;
}

.conference-card:active {
  transform: scale(0.98);
}

.card-header {
  width: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.conference-abbr {
  font-size: 28rpx;
  font-weight: 900;
  color: #FFFFFF;
  text-align: center;
  font-family: 'Georgia', serif;
}

.card-body {
  flex: 1;
  padding: 20rpx;
}

.conference-name {
  font-size: 24rpx;
  color: #333333;
  font-weight: 600;
  display: block;
  margin-bottom: 12rpx;
  line-height: 1.4;
}

.conference-meta {
  display: flex;
  gap: 12rpx;
}

.meta-category,
.meta-year {
  font-size: 20rpx;
  color: #888888;
  background-color: #F4F1EA;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
}

.card-arrow {
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  font-size: 32rpx;
  color: #CCCCCC;
}

/* ===== 提示 ===== */
.tips {
  padding: 40rpx;
  text-align: center;
}

.tips-text {
  font-size: 24rpx;
  color: #AAAAAA;
}

/* ===== 论文视图 ===== */
.paper-header {
  background-color: #FFFFFF;
  padding: 24rpx;
  border-bottom: 4rpx double #333333;
}

.back-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 20rpx;
}

.back-arrow {
  font-size: 32rpx;
  color: #333333;
}

.back-text {
  font-size: 28rpx;
  color: #333333;
  font-weight: 600;
}

.conference-info {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.info-badge {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
}

.badge-abbr {
  font-size: 24rpx;
  font-weight: 900;
  color: #FFFFFF;
  font-family: 'Georgia', serif;
}

.info-text {
  flex: 1;
}

.info-name {
  font-size: 28rpx;
  color: #333333;
  font-weight: 700;
  display: block;
}

.info-year {
  font-size: 24rpx;
  color: #888888;
  display: block;
  margin-top: 4rpx;
}

/* ===== 加载提示 ===== */
.loading-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  gap: 20rpx;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #DDDDDD;
  border-top-color: #333333;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #888888;
}

/* ===== 论文列表 ===== */
.paper-list {
  padding: 48rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.paper-item {
  display: flex;
  background-color: #FFFFFF;
  border: 1rpx solid #DDDDDD;
  overflow: hidden;
  transition: transform 0.2s;
}

.paper-item:active {
  transform: scale(0.98);
}

.paper-venue-block {
  width: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.venue-letter {
  font-size: 32rpx;
  font-weight: 900;
  color: #FFFFFF;
  font-family: 'Georgia', serif;
}

.paper-info {
  flex: 1;
  padding: 22rpx;
}

.paper-badges {
  display: flex;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.citation-badge {
  background-color: #F4F1EA;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
}

.citation-text {
  font-size: 20rpx;
  color: #666666;
  font-weight: 600;
}

.pdf-badge {
  background-color: #E8F5E9;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
}

.pdf-text {
  font-size: 20rpx;
  color: #2E7D32;
  font-weight: 600;
}

.paper-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1a1a;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-bottom: 8rpx;
}

.paper-authors {
  font-size: 22rpx;
  color: #888888;
  font-style: italic;
  margin-bottom: 12rpx;
  display: block;
}

.paper-abstract {
  font-size: 24rpx;
  color: #666666;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* ===== 加载更多 ===== */
.load-more {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
  gap: 16rpx;
}

.loading-dots {
  display: flex;
  gap: 8rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  background-color: #333333;
  border-radius: 50%;
  animation: dotPulse 1.2s infinite;
}

.dot:nth-child(2) { animation-delay: 0.2s; }
.dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes dotPulse {
  0%, 100% { opacity: 0.3; transform: scale(0.8); }
  50% { opacity: 1; transform: scale(1); }
}

.no-more {
  text-align: center;
  padding: 40rpx 0;
}

.no-more-text {
  font-size: 24rpx;
  color: #AAAAAA;
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
  text-align: center;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333333;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #888888;
}

/* ===== 回到顶部 ===== */
.back-top {
  position: fixed;
  right: 32rpx;
  bottom: 120rpx;
  width: 80rpx;
  height: 80rpx;
  background-color: #333333;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.2);
  z-index: 100;
}

.back-top text {
  font-size: 32rpx;
  color: #FFFFFF;
  font-weight: bold;
}

/* ===== 响应式 ===== */
@media screen and (max-width: 375px) {
  .title-text {
    font-size: 36rpx;
  }
  
  .card-header {
    width: 100rpx;
  }
  
  .conference-abbr {
    font-size: 24rpx;
  }
}
