<view class="conference-page">
  <view class="paper-bg"></view>

  <!-- 顶会列表视图 -->
  <view class="conferences-view" wx:if="{{viewMode === 'conferences'}}">
    
    <!-- 页面标题 -->
    <view class="page-header">
      <view class="header-title">
        <text class="title-icon">🏛️</text>
        <text class="title-text">顶会荟萃</text>
      </view>
      <text class="header-subtitle">Top AI Conference Papers</text>
    </view>

    <!-- 方向筛选 -->
    <scroll-view class="area-scroll" scroll-x enable-flex>
      <view class="area-list">
        <view 
          class="area-item {{selectedArea === area.id ? 'active' : ''}}"
          wx:for="{{researchAreas}}"
          wx:key="id"
          data-area="{{item.id}}"
          bindtap="selectArea"
        >
          <text class="area-icon">{{item.icon}}</text>
          <text class="area-name">{{item.name}}</text>
        </view>
      </view>
    </scroll-view>

    <!-- 年份筛选 -->
    <scroll-view class="year-scroll" scroll-x enable-flex>
      <view class="year-list">
        <view 
          class="year-item {{selectedYear === year ? 'active' : ''}}"
          wx:for="{{years}}"
          wx:key="*this"
          data-year="{{item}}"
          bindtap="selectYear"
        >
          {{item}}
        </view>
      </view>
    </scroll-view>

    <!-- 顶会列表 -->
    <view class="conference-grid">
      <view 
        class="conference-card"
        wx:for="{{conferences}}"
        wx:key="id"
        data-conference="{{item}}"
        bindtap="selectConference"
      >
        <view class="card-header" style="background-color: {{item.color}}">
          <text class="conference-abbr">{{item.name}}</text>
        </view>
        <view class="card-body">
          <text class="conference-name">{{item.fullName}}</text>
          <view class="conference-meta">
            <text class="meta-category">{{item.category}}</text>
            <text class="meta-year">{{selectedYear}}</text>
          </view>
        </view>
        <view class="card-arrow">→</view>
      </view>
    </view>

    <!-- 提示 -->
    <view class="tips">
      <text class="tips-text">选择一个顶会，查看该会议在 {{selectedYear}} 年的论文</text>
    </view>
  </view>

  <!-- 论文列表视图 -->
  <view class="papers-view" wx:if="{{viewMode === 'papers'}}">
    
    <!-- 返回按钮和会议信息 -->
    <view class="paper-header">
      <view class="back-btn" bindtap="goBackToList">
        <text class="back-arrow">←</text>
        <text class="back-text">返回</text>
      </view>
      
      <view class="conference-info" wx:if="{{selectedConference}}">
        <view class="info-badge" style="background-color: {{selectedConference.color}}">
          <text class="badge-abbr">{{selectedConference.name}}</text>
        </view>
        <view class="info-text">
          <text class="info-name">{{selectedConference.fullName}}</text>
          <text class="info-year">{{selectedYear}} · {{total || papers.length}} 篇论文</text>
        </view>
      </view>
    </view>

    <!-- 加载中 -->
    <view class="loading-tip" wx:if="{{loading}}">
      <view class="loading-spinner"></view>
      <text class="loading-text">正在检索论文...</text>
    </view>

    <!-- 论文列表 -->
    <view class="paper-list" wx:if="{{!loading && papers.length > 0}}">
      <view 
        class="paper-item"
        wx:for="{{papers}}"
        wx:key="id"
        data-paper="{{item}}"
        bindtap="goToPaper"
      >
        <!-- 期刊色块 -->
        <view class="paper-venue-block" style="background-color: {{item.venueColor}}">
          <text class="venue-letter">{{item.venueLetter}}</text>
        </view>

        <view class="paper-info">
          <!-- 引用量和PDF标记 -->
          <view class="paper-badges">
            <view class="citation-badge">
              <text class="citation-text">{{item.citationText}} 引用</text>
            </view>
            <view class="pdf-badge" wx:if="{{item.hasPdf}}">
              <text class="pdf-text">📄 PDF</text>
            </view>
          </view>

          <!-- 标题 -->
          <text class="paper-title">{{item.title}}</text>

          <!-- 作者 -->
          <text class="paper-authors">{{item.authorsText}}</text>

          <!-- 摘要预览 -->
          <text class="paper-abstract">{{item.abstractShort}}</text>
        </view>
      </view>
    </view>

    <!-- 加载更多 -->
    <view class="load-more" wx:if="{{loadingMore}}">
      <view class="loading-dots">
        <view class="dot"></view>
        <view class="dot"></view>
        <view class="dot"></view>
      </view>
      <text class="loading-text">加载更多论文...</text>
    </view>

    <!-- 没有更多 -->
    <view class="no-more" wx:if="{{!hasMore && papers.length > 0 && !loadingMore}}">
      <text class="no-more-text">— 共 {{papers.length}} 篇论文 —</text>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{!loading && papers.length === 0}}">
      <text class="empty-icon">📭</text>
      <text class="empty-title">暂无论文</text>
      <text class="empty-desc">该顶会暂无数据</text>
    </view>
  </view>

  <!-- 回到顶部 -->
  <view class="back-top" wx:if="{{scrollTop > 300}}" catchtap="scrollToTop">
    <text>↑</text>
  </view>
</view>
