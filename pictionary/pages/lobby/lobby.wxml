<view class="lobby-container">
  <view class="brand-title">你画我猜 · 联机大厅</view>

  <!-- 房主操作区 -->
  <view class="action-area" wx:if="{{!waiting && !isJoiner}}">
    <!-- 轮数选择 -->
    <view class="setting-row">
      <text class="setting-label">游戏轮数</text>
      <view class="round-options">
        <view
          wx:for="{{roundOptions}}"
          wx:key="*this"
          class="round-chip {{selectedRounds === item ? 'round-active' : ''}}"
          bindtap="onSelectRounds"
          data-rounds="{{item}}"
        >{{item}} 轮</view>
      </view>
    </view>
    <button class="btn primary-btn" bindtap="createRoom">创建房间</button>
  </view>

  <!-- 房主等待 & 分享区 -->
  <view class="waiting-area" wx:if="{{waiting}}">
    <view class="radar-spinner"></view>
    <view class="loading-text">房间已建立，等待好友加入...</view>

    <button class="btn share-btn" open-type="share">
      <text class="icon">💬</text> 邀请微信好友
    </button>
    <button class="btn cancel-btn" bindtap="cancelRoom">取消创建</button>
  </view>

  <!-- 好友加入加载区 -->
  <view class="waiting-area" wx:if="{{isJoiner}}">
    <view class="radar-spinner"></view>
    <view class="loading-text">正在进入好友的房间...</view>
  </view>
</view>
