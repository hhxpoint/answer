page {
  background-color: #1a1612;
  color: #e0d7c8;
  font-family: "PingFang SC", "STHeiti", "Microsoft YaHei", sans-serif;
}

.page-container {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
  padding: 40rpx;
}

.glass-card {
  width: 100%;
  background: rgba(44, 37, 31, 0.8);
  border: 1px solid rgba(255, 215, 0, 0.2);
  border-radius: 40rpx;
  padding: 60rpx 40rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.5);
  backdrop-filter: blur(10px);
}

.header {
  text-align: center;
  margin-bottom: 80rpx;
}

.title {
  display: block;
  font-size: 44rpx;
  font-weight: bold;
  color: #ffd700;
  margin-bottom: 16rpx;
  letter-spacing: 4rpx;
}

.subtitle {
  font-size: 26rpx;
  color: #a69b8f;
}

.form-group {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 60rpx;
}

.avatar-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar-btn {
  width: 200rpx;
  height: 200rpx;
  padding: 0;
  margin: 0;
  border-radius: 100rpx;
  background: transparent;
  position: relative;
  overflow: visible;
}

.avatar-img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 100rpx;
  border: 6rpx solid #ffd700;
  box-shadow: 0 0 20rpx rgba(255, 215, 0, 0.3);
}

.edit-badge {
  position: absolute;
  bottom: 10rpx;
  right: 10rpx;
  width: 50rpx;
  height: 50rpx;
  background: #ffd700;
  color: #2c251f;
  border-radius: 50%;
  font-size: 32rpx;
  font-weight: bold;
  display: flex;
  justify-content: center;
  align-items: center;
  border: 4rpx solid #2c251f;
}

.helper-text {
  font-size: 24rpx;
  color: #a69b8f;
  margin-top: 20rpx;
}

.input-wrapper {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.label {
  font-size: 28rpx;
  color: #ffd700;
  margin-left: 10rpx;
}

.nickname-input {
  width: 100%;
  height: 100rpx;
  background: rgba(0, 0, 0, 0.3);
  border: 2rpx solid rgba(255, 215, 0, 0.3);
  border-radius: 20rpx;
  padding: 0 30rpx;
  color: #fff;
  font-size: 32rpx;
  box-sizing: border-box;
}

.submit-btn {
  margin-top: 80rpx;
  width: 100%;
  height: 110rpx;
  background: linear-gradient(135deg, #ffd700, #b8860b);
  color: #2c251f;
  border-radius: 30rpx;
  font-size: 34rpx;
  font-weight: bold;
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0 10rpx 30rpx rgba(255, 215, 0, 0.3);
}