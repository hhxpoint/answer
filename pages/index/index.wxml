<view class="home" style="padding-top: {{statusBarHeight + 52}}px;">
  <view class="grain"></view>

  <!-- 刊头 -->
  <view class="masthead">
    <text class="masthead-brand">ML / NOTES</text>
    <text class="masthead-date">{{dateText}}</text>
  </view>

  <!-- 主标题 -->
  <view class="hero">
    <view class="hero-eyebrow">A QUIET PLACE TO THINK</view>
    <view class="hero-title">机器学习<text class="hero-title-it">问答</text></view>
    <view class="hero-copy">把问题留在这里。<br/>题库、知识点与日常工具，离线优先。</view>
    <view class="hero-meta">
      <text>LOCAL-FIRST</text>
      <text class="hero-meta-dot">·</text>
      <text>NO CLOUD REQUIRED</text>
    </view>
  </view>

  <!-- 两个主入口：留白多，信息少而重 -->
  <view class="feature-row">
    <view class="feature feature-flame" bindtap="goCouple" hover-class="pressed">
      <view class="feature-top">
        <text class="feature-code">A / RELATIONSHIP</text>
        <text class="feature-arrow">↗</text>
      </view>
      <view class="feature-seal seal-flame"><text class="feature-seal-char">火</text></view>
      <view class="feature-title">我们的小火苗</view>
      <view class="feature-copy">和重要的人，一起养一只。</view>
      <view class="feature-foot">每段关系独立空间</view>
    </view>

    <view class="feature feature-recipe" bindtap="goRecipe" hover-class="pressed">
      <view class="feature-top">
        <text class="feature-code">B / DAILY</text>
        <text class="feature-arrow">↗</text>
      </view>
      <view class="feature-seal seal-recipe"><text class="feature-seal-char">食</text></view>
      <view class="feature-title">今天吃什么</view>
      <view class="feature-copy">四十道家常菜，按食材找。</view>
      <view class="feature-foot">离线可用 · 不联网</view>
    </view>
  </view>

  <!-- 01 学习 -->
  <view class="section">
    <view class="section-head">
      <text class="section-no">01</text>
      <view class="section-label">
        <text class="section-title">Study</text>
        <text class="section-cn">学习</text>
      </view>
      <view class="section-rule"></view>
    </view>

    <view class="study-list">
      <view class="study-row" bindtap="goQuiz" hover-class="pressed">
        <text class="row-no">01</text>
        <view class="row-body"><text class="row-title">开始答题</text><text class="row-en">QUIZ / PRACTICE</text></view>
        <text class="row-arrow">↗</text>
      </view>
      <view class="study-row" bindtap="goSearch" hover-class="pressed">
        <text class="row-no">02</text>
        <view class="row-body"><text class="row-title">搜索知识点</text><text class="row-en">SEARCH / NOTES</text></view>
        <text class="row-arrow">↗</text>
      </view>
      <view class="study-row" bindtap="goWords" hover-class="pressed">
        <text class="row-no">03</text>
        <view class="row-body"><text class="row-title">背单词</text><text class="row-en">VOCABULARY</text></view>
        <text class="row-arrow">↗</text>
      </view>
      <view class="study-row" bindtap="goExam" data-type="408" hover-class="pressed">
        <text class="row-no">04</text>
        <view class="row-body"><text class="row-title">408 综合</text><text class="row-en">EXAM / CS</text></view>
        <text class="row-arrow">↗</text>
      </view>
      <view class="study-row" bindtap="goExam" data-type="math1" hover-class="pressed">
        <text class="row-no">05</text>
        <view class="row-body"><text class="row-title">数一客观</text><text class="row-en">EXAM / MATH</text></view>
        <text class="row-arrow">↗</text>
      </view>
      <view class="study-row" bindtap="goScores" hover-class="pressed">
        <text class="row-no">06</text>
        <view class="row-body"><text class="row-title">成绩查询</text><text class="row-en">ACADEMIC / SCORES</text></view>
        <text class="row-arrow">↗</text>
      </view>
      <view class="study-row" bindtap="goJwzxTimetable" hover-class="pressed">
        <text class="row-no">07</text>
        <view class="row-body"><text class="row-title">教务课表</text><text class="row-en">ACADEMIC / SCHEDULE</text></view>
        <text class="row-arrow">↗</text>
      </view>
      <view class="study-row" bindtap="goc" hover-class="pressed">
        <text class="row-no">08</text>
        <view class="row-body"><text class="row-title">课程表</text><text class="row-en">COURSE / PLAN</text></view>
        <text class="row-arrow">↗</text>
      </view>
    </view>
  </view>

  <!-- 02 工具 -->
  <view class="section">
    <view class="section-head">
      <text class="section-no">02</text>
      <view class="section-label">
        <text class="section-title">Tools</text>
        <text class="section-cn">工具</text>
      </view>
      <view class="section-rule"></view>
    </view>

    <view class="tile-grid">
      <view class="tile" bindtap="goCalc" hover-class="pressed">
        <view class="tile-top"><text class="tile-code">CALC</text><text class="tile-arrow">↗</text></view>
        <view class="tile-title">科学计算器</view>
        <view class="tile-copy">表达式与函数</view>
      </view>
      <view class="tile" bindtap="goAlgorithm" hover-class="pressed">
        <view class="tile-top"><text class="tile-code">ALGO</text><text class="tile-arrow">↗</text></view>
        <view class="tile-title">卜神启动</view>
        <view class="tile-copy">算法与网络</view>
      </view>
      <view class="tile" bindtap="goprocess" hover-class="pressed">
        <view class="tile-top"><text class="tile-code">IMG</text><text class="tile-arrow">↗</text></view>
        <view class="tile-title">图像处理</view>
        <view class="tile-copy">像素与滤镜</view>
      </view>
      <view class="tile" bindtap="golab" hover-class="pressed">
        <view class="tile-top"><text class="tile-code">LAB</text><text class="tile-arrow">↗</text></view>
        <view class="tile-title">Butterfly</view>
        <view class="tile-copy">可视化实验</view>
      </view>
      <view class="tile" bindtap="gohash" hover-class="pressed">
        <view class="tile-top"><text class="tile-code">HASH</text><text class="tile-arrow">↗</text></view>
        <view class="tile-title">Hash</view>
        <view class="tile-copy">摘要与校验</view>
      </view>
      <view class="tile" bindtap="gopuzzle" hover-class="pressed">
        <view class="tile-top"><text class="tile-code">PZ</text><text class="tile-arrow">↗</text></view>
        <view class="tile-title">Puzzle</view>
        <view class="tile-copy">拼图与图像</view>
      </view>
      <view class="tile" bindtap="gomemo" hover-class="pressed">
        <view class="tile-top"><text class="tile-code">MEMO</text><text class="tile-arrow">↗</text></view>
        <view class="tile-title">Coconut</view>
        <view class="tile-copy">轻量记事</view>
      </view>
      <view class="tile" bindtap="goimg2pdf" hover-class="pressed">
        <view class="tile-top"><text class="tile-code">PDF</text><text class="tile-arrow">↗</text></view>
        <view class="tile-title">img2pdf</view>
        <view class="tile-copy">图片转文档</view>
      </view>
      <view class="tile" bindtap="got" hover-class="pressed">
        <view class="tile-top"><text class="tile-code">FX</text><text class="tile-arrow">↗</text></view>
        <view class="tile-title">Particle</view>
        <view class="tile-copy">粒子与渲染</view>
      </view>
      <view class="tile" bindtap="goemotion" hover-class="pressed">
        <view class="tile-top"><text class="tile-code">VOICE</text><text class="tile-arrow">↗</text></view>
        <view class="tile-title">语音大师</view>
        <view class="tile-copy">情绪与声音</view>
      </view>
    </view>
  </view>

  <!-- 03 实验室 -->
  <view class="section">
    <view class="section-head">
      <text class="section-no">03</text>
      <view class="section-label">
        <text class="section-title">Labs</text>
        <text class="section-cn">实验室</text>
      </view>
      <view class="section-rule"></view>
    </view>

    <view class="tile-grid">
      <view class="tile tile-soft" bindtap="goWeather" hover-class="pressed">
        <view class="tile-top"><text class="tile-code">WX</text><text class="tile-arrow">↗</text></view>
        <view class="tile-title">天气系统</view>
        <view class="tile-copy">实时天气预报</view>
      </view>
      <view class="tile tile-soft" bindtap="goSport" hover-class="pressed">
        <view class="tile-top"><text class="tile-code">SP</text><text class="tile-arrow">↗</text></view>
        <view class="tile-title">运动系统</view>
        <view class="tile-copy">记录与统计</view>
      </view>
      <view class="tile tile-soft" bindtap="goGithub" hover-class="pressed">
        <view class="tile-top"><text class="tile-code">PG</text><text class="tile-arrow">↗</text></view>
        <view class="tile-title">Paper Geek</view>
        <view class="tile-copy">学术日报与论文</view>
      </view>
      <view class="tile tile-soft" bindtap="goAR" hover-class="pressed">
        <view class="tile-top"><text class="tile-code">AR</text><text class="tile-arrow">↗</text></view>
        <view class="tile-title">AR 空间</view>
        <view class="tile-copy">增强现实与 3D</view>
      </view>
      <view class="tile tile-soft" bindtap="goFinance" hover-class="pressed">
        <view class="tile-top"><text class="tile-code">IDX</text><text class="tile-arrow">↗</text></view>
        <view class="tile-title">指数破壁</view>
        <view class="tile-copy">全球财富监控</view>
      </view>
      <view class="tile tile-soft" bindtap="gob" hover-class="pressed">
        <view class="tile-top"><text class="tile-code">BC</text><text class="tile-arrow">↗</text></view>
        <view class="tile-title">Blockchain</view>
        <view class="tile-copy">多链浏览器</view>
      </view>
      <view class="tile tile-soft" bindtap="gor" hover-class="pressed">
        <view class="tile-top"><text class="tile-code">CV</text><text class="tile-arrow">↗</text></view>
        <view class="tile-title">简历编辑器</view>
        <view class="tile-copy">编辑与预览</view>
      </view>
      <view class="tile tile-soft" bindtap="goDetect" hover-class="pressed">
        <view class="tile-top"><text class="tile-code">DT</text><text class="tile-arrow">↗</text></view>
        <view class="tile-title">目标检测</view>
        <view class="tile-copy">手写数字与物体</view>
      </view>
      <view class="tile tile-soft" bindtap="gochess" hover-class="pressed">
        <view class="tile-top"><text class="tile-code">GM</text><text class="tile-arrow">↗</text></view>
        <view class="tile-title">灯神长街</view>
        <view class="tile-copy">棋盘与对弈</view>
      </view>
    </view>
  </view>

  <!-- 页脚 -->
  <view class="footer">
    <view class="footer-rule"></view>
    <view class="footer-row">
      <text class="footer-note">BUILT SLOWLY · USED DAILY</text>
      <text class="footer-sign">hhxpoint / 2026</text>
    </view>
  </view>
</view>
