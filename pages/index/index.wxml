<swiper class="swiper" autoplay interval="3000" circular>
  <swiper-item>
    <image class="swiper-img" src="/assets/banner1.png"></image>
  </swiper-item>
  <swiper-item>
    <image class="swiper-img" src="/assets/banner2.png"></image>
  </swiper-item>
  
</swiper>



<view class="banner">
  <text class="banner-title">机器学习问答</text>
  
  <text class="banner-sub">轻松掌握核心知识点</text>
</view>

<view class="container">


  
  <view class="card-list">

    <view class="card" bindtap="goQuiz">
      <image class="card-icon" src="/assets/home.png"></image>
      <text class="card-title">开始答题</text>
    </view>

    <view class="card" bindtap="goSearch">
      <image class="card-icon" src="/assets/search.png"></image>
      <text class="card-title">搜索知识点</text>
    </view>

    <view class="card" bindtap="randomQA">
      <image class="card-icon" src="/assets/book.png"></image>
      <text class="card-title">随机知识点</text>
    </view>

    <!-- pages/index/index.wxml 找到 card-list 内部 -->
    <view class="card" bindtap="goWords">
      <image class="card-icon" src="/assets/word.png"></image> <!-- 确保你把图标放到了 assets/word.png -->
      <view class="card-title">背单词</view>
    </view>

    
    <!-- 408综合 按钮 -->
    <view class="card" bindtap="goExam" data-type="408">
      <image class="card-icon" src="/assets/408.png"></image>
      <view class="card-title">408综合</view>
    </view>
    
    <!-- 数一客观 按钮 -->
    <view class="card" bindtap="goExam" data-type="math1">
      <image class="card-icon" src="/assets/math1.png"></image>
      <view class="card-title">数一客观</view>
    </view>

  



    <view class="card" bindtap="goCalc">
      <image class="card-icon" src="/assets/calc.png"></image>
      <text class="card-title">科学计算器</text>
    </view>


    <!-- 原神启动（算法网络）按钮 -->
    <view class="card" bindtap="goAlgorithm">
      <!-- 注意：这里的 src 请换成刚才放进 assets 里的图片名字 -->
      <image class="card-icon" src="/assets/bo.png"></image>
      <view class="card-title">卜神启动</view>
    </view>


      
    <view class="card" bindtap="goprocess">
        <!-- 注意：这里的 src 请换成刚才放进 assets 里的图片名字 -->
        <image class="card-icon" src="/assets/search-active.png"></image>
        <view class="card-title">图像处理</view>
      </view>

      
      <!-- 原神启动（算法网络）按钮 -->
    <view class="card" bindtap="goemotion">
        <!-- 注意：这里的 src 请换成刚才放进 assets 里的图片名字 -->
        <image class="card-icon" src="/assets/home-active.png"></image>
        <view class="card-title">语音大师</view>
      </view>

  </view>

</view>