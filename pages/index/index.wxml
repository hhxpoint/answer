<!-- 我们的小火苗入口 -->
<view class="couple-entry" bindtap="goCouple">
  <view class="couple-entry-glow"></view>
  <view class="couple-entry-flame">
    <view class="mini-flame">
      <view class="mini-flame-inner">
        <view class="mini-flame-core"></view>
      </view>
    </view>
  </view>
  <view class="couple-entry-text">
    <view class="couple-entry-title">我们的小火苗</view>
    <view class="couple-entry-sub">和重要的人，一起养一只 · 每段关系独立空间</view>
  </view>
  <view class="couple-entry-arrow">›</view>
</view>

<!-- 今天吃什么（纯本地菜谱）入口 -->
<view class="recipe-entry" bindtap="goRecipe">
  <view class="recipe-entry-glow"></view>
  <view class="recipe-entry-icon">🍳</view>
  <view class="recipe-entry-text">
    <view class="recipe-entry-title">今天吃什么</view>
    <view class="recipe-entry-sub">40 道家常菜 · 按食材找菜谱 · 离线可用</view>
  </view>
  <view class="recipe-entry-arrow">›</view>
</view>

<swiper class="swiper" autoplay interval="3000" circular>
  <swiper-item>
    <image class="swiper-img" src="/assets/banner1.png"></image>
  </swiper-item>
</swiper>



<view class="banner">
  <text class="banner-title">机器学习问答</text>

  <text class="banner-sub">  轻松掌握核心知识点</text>
</view>



<view class="container">

  <view class="card-list">

    <view class="card" bindtap="goQuiz">
      <image class="card-icon" src="/assets/home-active.png"></image>
      <text class="card-title">开始答题</text>
    </view>



        <!-- 教务在线 - 成绩查询 -->
        <view class="card" bindtap="goScores">
          <image class="card-icon" src="/assets/2.png"></image>
          <view class="card-title">成绩查询</view>
        </view>
        
        <!-- 教务在线 - 教务课表 -->
        <view class="card" bindtap="goJwzxTimetable">
          <image class="card-icon" src="/assets/1.png"></image>
          <view class="card-title">课表</view>
        </view>


    <view class="card" bindtap="goSearch">
      <image class="card-icon" src="/assets/search-active.png"></image>
      <text class="card-title">搜索知识点</text>
    </view>

    <!-- pages/index/index.wxml 找到 card-list 内部 -->
