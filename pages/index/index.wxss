page {
  background: linear-gradient(180deg, #a8c0ff 0%, #fbc2eb 100%);
  min-height: 100%;
}

.container {
  padding: 40rpx;
}

.header {
  text-align: center;
  margin-bottom: 60rpx;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
}

.subtitle {
  font-size: 28rpx;
  color: #888;
  margin-top: 10rpx;
}

.card-list {
  display: flex;
  flex-direction: column;
  gap: 40rpx;
}

.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.05);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.card:active {
  transform: scale(0.96);
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.15);
}

.card-icon {
  width: 80rpx;
  height: 80rpx;
  margin-right: 30rpx;
}

.card-title {
  font-size: 36rpx;
  color: #333;
  font-weight: bold;
}

/* 轻量卡片 — 水果 emoji 系列，与上面图片卡片区分但同样优雅 */
.lite-card {
  padding: 32rpx 36rpx;
  background: rgba(255, 255, 255, 0.82);
  backdrop-filter: blur(12px);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  gap: 24rpx;
}

.lite-emoji {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background: rgba(0, 0, 0, 0.03);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  flex-shrink: 0;
}

.lite-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.lite-title {
  font-size: 32rpx;
  color: #333;
  font-weight: 600;
}

.lite-sub {
  font-size: 24rpx;
  color: #999;
  font-weight: 400;
}

.banner {
  margin: 40rpx;
  padding: 60rpx 40rpx;
  background: linear-gradient(135deg, #6dd5fa, #2980b9);
  border-radius: 30rpx;
  color: white;
  text-align: left;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.1);
}

.banner-title {
  font-size: 48rpx;
  font-weight: bold;
}

.banner-sub {
  margin-top: 10rpx;
  font-size: 28rpx;
  opacity: 0.9;
}

.swiper {
  height: 300rpx;
  border-radius: 20rpx;
  overflow: hidden;
  margin: 20rpx 40rpx;
}

.swiper-img {
  width: 100%;
  height: 100%;
}

page[theme="dark"] {
  background: linear-gradient(180deg, #1e1e1e 0%, #000000 100%);
}

.banner[theme="dark"] {
  background: linear-gradient(135deg, #3a3a3a, #1f1f1f);
}

.card[theme="dark"] {
  background: #2a2a2a;
  color: #eee;
}

.recommend-item[theme="dark"] {
  background: #2a2a2a;
  color: #eee;
}

/* ===== 我们的小火苗 入口 ===== */
.couple-entry {
  position: relative;
  display: flex;
  align-items: center;
  margin: 28rpx 40rpx 4rpx;
  padding: 26rpx 28rpx;
  border-radius: 32rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.88);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  box-shadow: 0 14rpx 34rpx rgba(178, 138, 160, 0.18);
}
.couple-entry:active {
  transform: scale(0.985);
}
.couple-entry-glow {
  position: absolute;
  right: -50rpx;
  top: -80rpx;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: radial-gradient(closest-side, rgba(255, 196, 150, 0.55), rgba(255, 196, 150, 0));
}
.couple-entry-flame {
  position: relative;
  width: 76rpx;
  height: 76rpx;
  margin-right: 20rpx;
  border-radius: 50%;
  background: radial-gradient(90% 90% at 50% 36%, #fff4e2 0%, #ffe2c8 55%, #ffd2bc 100%);
  box-shadow:
    0 8rpx 18rpx rgba(255, 150, 120, 0.26),
    inset 0 2rpx 6rpx rgba(255, 255, 255, 0.85);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
}
.mini-flame {
  position: relative;
  width: 42rpx;
  height: 54rpx;
  animation: couplePulse 2.2s ease-in-out infinite;
}
.mini-flame-inner {
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 34rpx;
  height: 46rpx;
  margin-left: -17rpx;
  border-radius: 50% 50% 45% 45% / 64% 64% 36% 36%;
  background:
    radial-gradient(56% 44% at 35% 25%, rgba(255, 255, 255, 0.85), rgba(255, 255, 255, 0) 65%),
    radial-gradient(130% 110% at 50% 100%, #ffd97a 0%, #ffb15c 45%, #ff7d55 78%, #ef4c5e 100%);
  box-shadow: 0 6rpx 12rpx rgba(255, 120, 80, 0.35);
}
.mini-flame-core {
  position: absolute;
  left: 50%;
  bottom: 8rpx;
  width: 12rpx;
  height: 16rpx;
  margin-left: -6rpx;
  border-radius: 50%;
  background: radial-gradient(closest-side, #fffbe6, rgba(255, 245, 190, 0.2));
}
.couple-entry-text {
  position: relative;
  flex: 1;
}
.couple-entry-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #5a3a4a;
  letter-spacing: 1rpx;
}
.couple-entry-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #9a7f8c;
}
.couple-entry-arrow {
  position: relative;
  font-size: 40rpx;
  color: #c9a9b4;
}
@keyframes couplePulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.08); }
}

/* ===== 今天吃什么 入口 ===== */
.recipe-entry {
  position: relative;
  display: flex;
  align-items: center;
  margin: 20rpx 40rpx 8rpx;
  padding: 24rpx 28rpx;
  border-radius: 32rpx;
  overflow: hidden;
  background: linear-gradient(135deg, rgba(255, 247, 236, 0.98), rgba(255, 236, 214, 0.95));
  border: 1rpx solid rgba(255, 224, 196, 0.9);
  box-shadow: 0 14rpx 34rpx rgba(210, 150, 90, 0.16);
}
.recipe-entry:active { transform: scale(0.985); }
.recipe-entry-glow {
  position: absolute;
  right: -40rpx;
  top: -70rpx;
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: radial-gradient(closest-side, rgba(255, 210, 160, 0.5), rgba(255, 210, 160, 0));
}
.recipe-entry-icon {
  position: relative;
  width: 76rpx;
  height: 76rpx;
  margin-right: 20rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFF9F0, #FFE7C8);
  box-shadow: 0 8rpx 18rpx rgba(220, 150, 80, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  flex-shrink: 0;
}
.recipe-entry-text { position: relative; flex: 1; }
.recipe-entry-title { font-size: 32rpx; font-weight: 700; color: #5A3E2A; letter-spacing: 1rpx; }
.recipe-entry-sub { margin-top: 6rpx; font-size: 22rpx; color: #A08062; }
.recipe-entry-arrow { position: relative; font-size: 40rpx; color: #D2B08E; }

/* ===== 二手估价 入口 ===== */
.trade-entry {
  position: relative;
  display: flex;
  align-items: center;
  margin: 20rpx 40rpx 8rpx;
  padding: 24rpx 28rpx;
  border-radius: 32rpx;
  overflow: hidden;
  background: linear-gradient(135deg, rgba(247, 243, 234, 0.98), rgba(234, 239, 231, 0.96));
  border: 1rpx solid rgba(197, 210, 196, 0.85);
  box-shadow: 0 14rpx 34rpx rgba(96, 114, 96, 0.13);
}
.trade-entry:active { transform: scale(0.985); }
.trade-entry-glow {
  position: absolute;
  right: -40rpx;
  top: -70rpx;
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: radial-gradient(closest-side, rgba(170, 194, 170, 0.44), rgba(170, 194, 170, 0));
}
.trade-entry-icon {
  position: relative;
  width: 76rpx;
  height: 76rpx;
  margin-right: 20rpx;
  border-radius: 50%;
  background: #f8f3e9;
  box-shadow: 0 8rpx 18rpx rgba(96, 114, 96, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.trade-entry-img { width: 58rpx; height: 58rpx; }
.trade-entry-text { position: relative; flex: 1; }
.trade-entry-title { font-size: 32rpx; font-weight: 700; color: #2f3a2e; letter-spacing: 1rpx; }
.trade-entry-sub { margin-top: 6rpx; font-size: 22rpx; color: #71806b; }
.trade-entry-arrow { position: relative; font-size: 40rpx; color: #a1b09b; }
