page {
  background: #f4eee4;
  color: #221d18;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Noto Sans SC", sans-serif;
}

.home {
  position: relative;
  min-height: 100vh;
  padding: 34rpx 38rpx 70rpx;
  box-sizing: border-box;
  background:
    radial-gradient(120% 70% at 105% -8%, rgba(184, 122, 81, 0.14), transparent 58%),
    radial-gradient(80% 54% at -10% 38%, rgba(101, 119, 102, 0.10), transparent 62%),
    #f4eee4;
}

/* 极细纸纹，只做质感，不抢内容 */
.grain {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 0;
  pointer-events: none;
  opacity: 0.42;
  background-image:
    radial-gradient(rgba(72, 53, 37, 0.075) 1rpx, transparent 1rpx),
    radial-gradient(rgba(96, 74, 53, 0.045) 1rpx, transparent 1rpx);
  background-size: 11rpx 11rpx, 17rpx 17rpx;
  background-position: 0 0, 5rpx 7rpx;
}

.masthead,
.hero,
.feature-row,
.section,
.footer {
  position: relative;
  z-index: 1;
}

/* ===== 刊头 ===== */
.masthead {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 4rpx;
}
.masthead-brand,
.masthead-date {
  font-family: "SF Mono", Menlo, Consolas, monospace;
  font-size: 18rpx;
  letter-spacing: 2.4rpx;
  color: #9a8672;
}
.masthead-brand {
  color: #6f5b48;
}

/* ===== 主标题 ===== */
.hero {
  padding: 86rpx 0 54rpx;
}
.hero-eyebrow {
  font-family: "SF Mono", Menlo, Consolas, monospace;
  font-size: 17rpx;
  letter-spacing: 3.6rpx;
  color: #9b8168;
  margin-bottom: 22rpx;
}
.hero-title {
  font-family: "Songti SC", "STSong", "Noto Serif SC", "SimSun", serif;
  font-size: 76rpx;
  line-height: 1.12;
  letter-spacing: -1rpx;
  font-weight: 600;
  color: #211b16;
}
.hero-title-it {
  color: #995c3d;
  font-style: italic;
  margin-left: 4rpx;
}
.hero-copy {
  margin-top: 26rpx;
  max-width: 590rpx;
  font-size: 26rpx;
  line-height: 1.9;
  letter-spacing: 0.4rpx;
  color: #756554;
}
.hero-meta {
  margin-top: 28rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-family: "SF Mono", Menlo, Consolas, monospace;
  font-size: 16rpx;
  letter-spacing: 2rpx;
  color: #a18a74;
}
.hero-meta-dot {
  color: #c1a78e;
}

/* ===== 两个主入口 ===== */
.feature-row {
  display: flex;
  gap: 16rpx;
}
.feature {
  position: relative;
  flex: 1;
  min-width: 0;
  padding: 22rpx 24rpx 24rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(57, 43, 31, 0.12);
  border-radius: 18rpx;
  background: #fbf7f0;
  transition: opacity 0.15s ease, transform 0.15s ease;
}
.feature-flame {
  background: #fbf4ea;
}
.feature-recipe {
  background: #eef1e9;
}
.feature-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.feature-code {
  font-family: "SF Mono", Menlo, Consolas, monospace;
  font-size: 15rpx;
  letter-spacing: 1.6rpx;
  color: #a08a73;
}
.feature-arrow {
  font-size: 27rpx;
  color: #8f7157;
  font-family: Georgia, serif;
}
.feature-seal {
  width: 66rpx;
  height: 66rpx;
  margin: 32rpx 0 22rpx;
  border: 1rpx solid rgba(112, 78, 53, 0.34);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
.seal-flame {
  background: rgba(183, 106, 72, 0.07);
}
.seal-recipe {
  background: rgba(104, 126, 104, 0.07);
  border-color: rgba(83, 107, 86, 0.34);
}
.feature-seal-char {
  font-family: "Songti SC", "STSong", "Noto Serif SC", serif;
  font-size: 30rpx;
  font-weight: 500;
  color: #9a5f42;
  line-height: 1;
}
.seal-recipe .feature-seal-char {
  color: #5f7861;
}
.feature-title {
  font-family: "Songti SC", "STSong", "Noto Serif SC", serif;
  font-size: 30rpx;
  font-weight: 600;
  color: #29211a;
  letter-spacing: 0.4rpx;
}
.feature-copy {
  margin-top: 8rpx;
  font-size: 20rpx;
  line-height: 1.6;
  color: #7b6a58;
}
.feature-foot {
  margin-top: 22rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid rgba(75, 57, 41, 0.10);
  font-family: "SF Mono", Menlo, Consolas, monospace;
  font-size: 14rpx;
  letter-spacing: 0.6rpx;
  color: #a08b75;
}

/* ===== 分组标题 ===== */
.section {
  margin-top: 70rpx;
}
.section-head {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
  margin-bottom: 12rpx;
}
.section-no {
  font-family: "SF Mono", Menlo, Consolas, monospace;
  font-size: 16rpx;
  color: #a98c70;
  letter-spacing: 1rpx;
}
.section-label {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}
.section-title {
  font-family: Georgia, "Times New Roman", "Songti SC", serif;
  font-size: 30rpx;
  font-style: italic;
  color: #30271f;
}
.section-cn {
  font-size: 18rpx;
  color: #9e8872;
  letter-spacing: 2rpx;
}
.section-rule {
  flex: 1;
  height: 1rpx;
  background: rgba(74, 56, 39, 0.16);
  transform: translateY(-5rpx);
}

/* ===== 学习列表 ===== */
.study-list {
  border-top: 1rpx solid rgba(74, 56, 39, 0.14);
}
.study-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 25rpx 2rpx 23rpx;
  border-bottom: 1rpx solid rgba(74, 56, 39, 0.14);
}
.row-no {
  width: 38rpx;
  flex-shrink: 0;
  font-family: "SF Mono", Menlo, Consolas, monospace;
  font-size: 16rpx;
  color: #ad967e;
}
.row-body {
  flex: 1;
  min-width: 0;
}
.row-title {
  display: block;
  font-size: 29rpx;
  font-weight: 500;
  color: #2b231c;
  letter-spacing: 0.6rpx;
}
.row-en {
  display: block;
  margin-top: 5rpx;
  font-family: "SF Mono", Menlo, Consolas, monospace;
  font-size: 15rpx;
  letter-spacing: 1rpx;
  color: #a08a75;
}
.row-arrow {
  font-family: Georgia, serif;
  font-size: 24rpx;
  color: #a98e75;
}

/* ===== 工具/实验室网格 ===== */
.tile-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}
.tile {
  width: calc(50% - 7rpx);
  min-height: 156rpx;
  padding: 20rpx 22rpx 18rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(74, 56, 39, 0.12);
  border-radius: 14rpx;
  background: rgba(255, 251, 245, 0.66);
}
.tile-soft {
  background: rgba(239, 234, 224, 0.72);
}
.tile-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.tile-code {
  font-family: "SF Mono", Menlo, Consolas, monospace;
  font-size: 14rpx;
  letter-spacing: 1.6rpx;
  color: #a18b74;
}
.tile-arrow {
  font-family: Georgia, serif;
  font-size: 22rpx;
  color: #a78d73;
}
.tile-title {
  margin-top: 24rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: #2a221b;
  letter-spacing: 0.4rpx;
}
.tile-copy {
  margin-top: 5rpx;
  font-size: 18rpx;
  color: #98836f;
}

/* ===== 页脚 ===== */
.footer {
  margin-top: 78rpx;
}
.footer-rule {
  height: 1rpx;
  background: rgba(74, 56, 39, 0.16);
  margin-bottom: 18rpx;
}
.footer-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.footer-note,
.footer-sign {
  font-family: "SF Mono", Menlo, Consolas, monospace;
  font-size: 14rpx;
  letter-spacing: 1.2rpx;
  color: #a28a73;
}

.pressed {
  opacity: 0.64;
  transform: translateY(1rpx);
}
