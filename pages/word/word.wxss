/* pages/word/word.wxss */
.page-container {
  min-height: 100vh;
  background-color: #f0f3ff;
  display: flex;
  flex-direction: column;
  padding: 40rpx;
  box-sizing: border-box;
}

/* 进度条样式 */
.progress-section {
  margin-bottom: 40rpx;
}

.progress-text {
  font-size: 24rpx;
  color: #8a96c1;
  margin-bottom: 12rpx;
  text-align: center;
}

.progress-bar-bg {
  height: 8rpx;
  background: #e0e6ff;
  border-radius: 4rpx;
  overflow: hidden;
}

.progress-bar-fill {
  height: 100%;
  background: linear-gradient(to right, #7d88e7, #a287f4);
  transition: width 0.3s ease;
}

/* 卡片主样式 */
.main-card {
  flex: 1;
  background: #ffffff;
  border-radius: 40rpx;
  box-shadow: 0 20rpx 60rpx rgba(125, 136, 231, 0.12);
  padding: 60rpx 40rpx;
  position: relative;
  transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
}

.card-active {
  transform: scale(1.02);
  box-shadow: 0 30rpx 80rpx rgba(125, 136, 231, 0.2);
}

.word-header {
  margin-bottom: 50rpx;
  text-align: center;
}

.word-text {
  font-size: 64rpx;
  font-weight: 800;
  color: #2d3436;
  letter-spacing: -1rpx;
}

.phonetic-container {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: 10rpx;
}

.phonetic-text {
  font-size: 32rpx;
  color: #7d88e7;
  font-family: 'Times New Roman', Times, serif;
}

.speaker-icon {
  margin-left: 15rpx;
  font-size: 30rpx;
  opacity: 0.6;
}

.info-section {
  margin-top: 40rpx;
}

.section-label {
  font-size: 20rpx;
  color: #bcc4eb;
  font-weight: bold;
  letter-spacing: 3rpx;
  margin-bottom: 16rpx;
}

.en-box {
  font-size: 32rpx;
  color: #636e72;
  line-height: 1.6;
  font-style: italic;
}

.zh-box {
  font-size: 36rpx;
  color: #2d3436;
  font-weight: 600;
}

.example-box {
  background: #f8faff;
  padding: 30rpx;
  border-radius: 20rpx;
  border-left: 8rpx solid #7d88e7;
}

.example-text {
  font-size: 30rpx;
  color: #555;
  line-height: 1.5;
}

/* 隐藏内容的动画 */
.hidden-content {
  opacity: 0;
  transform: translateY(20rpx);
  transition: all 0.3s ease;
  display: none;
}

.hidden-content.show {
  display: block;
  opacity: 1;
  transform: translateY(0);
}

.click-hint {
  position: absolute;
  bottom: 60rpx;
  left: 0;
  right: 0;
  text-align: center;
  color: #7d88e7;
  font-size: 28rpx;
  font-weight: 500;
}

/* 底部操作按钮 */
.footer-btns {
  display: flex;
  justify-content: space-around;
  padding: 60rpx 0;
}

.btn-circle {
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: all 0.2s;
}

.btn-circle:active {
  transform: scale(0.9);
}

.btn-icon {
  width: 100rpx;
  height: 100rpx;
  background: white;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 40rpx;
  color: #7d88e7;
  box-shadow: 0 10rpx 30rpx rgba(125, 136, 231, 0.15);
  margin-bottom: 15rpx;
}

.next .btn-icon {
  background: linear-gradient(135deg, #7d88e7, #a287f4);
  color: white;
}

.btn-text {
  font-size: 24rpx;
  color: #8a96c1;
}

.disabled {
  opacity: 0.3;
}