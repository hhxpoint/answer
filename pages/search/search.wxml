<view class="sky-container">
  <!-- 1. 搜索框：云朵造型 -->
  <view class="search-header">
    <view class="search-bar">
      <icon type="search" size="18" color="#A8C0FF"></icon>
      <input class="sky-input" placeholder="搜索知识点..." placeholder-class="placeholder-style" value="{{keyword}}"
        bindinput="onSearchInput" />
    </view>
  </view>

  <!-- 2. 默认状态：显示推荐词 -->
  <view class="hot-section" wx:if="{{!isSearching}}">
    <view class="section-title">☁️ 推荐搜索</view>
    <view class="tag-group">
      <view class="sky-tag" wx:for="{{hotKeywords}}" wx:key="*this" bindtap="onTagTap" data-word="{{item}}">{{item}}
      </view>
    </view>
  </view>

  <!-- 3. 搜索结果：卡片展示 -->
  <scroll-view scroll-y class="result-list" wx:if="{{isSearching}}">
    <view class="result-info">已为你匹配到 {{searchResult.length}} 条云端知识</view>

    <view class="card-item" wx:for="{{searchResult}}" wx:key="id">
      <qa-card title="{{item.question}}" content="{{item.answer}}"></qa-card>
    </view>

    <!-- 空状态 -->
    <view class="empty-box" wx:if="{{searchResult.length === 0}}">
      <image class="empty-img" src="/assets/search.png" mode="aspectFit"></image>
      <text>这片云朵里还没有你要找的内容哦~</text>
    </view>
  </scroll-view>
</view>