page {
  background: linear-gradient(180deg, #e3f2fd 0%, #ffffff 100%);
  min-height: 100vh;
}

.sky-container {
  padding: 30rpx 40rpx;
  display: flex;
  flex-direction: column;
}

/* 云朵搜索框 */
.search-bar {
  background: rgba(255, 255, 255, 0.9);
  height: 90rpx;
  border-radius: 45rpx;
  display: flex;
  align-items: center;
  padding: 0 40rpx;
  box-shadow: 0 15rpx 40rpx rgba(168, 192, 255, 0.1);
  margin-bottom: 50rpx;
}

.sky-input {
  flex: 1;
  margin-left: 20rpx;
  font-size: 30rpx;
  color: #5a7d9a;
}

.placeholder-style {
  color: #b0c4de;
}

/* 推荐标签区 */
.section-title {
  font-size: 28rpx;
  color: #8da9c4;
  margin-bottom: 30rpx;
  margin-left: 10rpx;
}

.tag-group {
  display: flex;
  flex-wrap: wrap;
}

.sky-tag {
  background: #fff;
  color: #7da9c4;
  padding: 12rpx 35rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  margin-right: 20rpx;
  margin-bottom: 25rpx;
  box-shadow: 0 5rpx 15rpx rgba(168, 192, 255, 0.05);
  border: 1rpx solid rgba(168, 192, 255, 0.1);
}

/* 结果列表 */
.result-info {
  text-align: center;
  font-size: 24rpx;
  color: #b0c4de;
  margin-bottom: 40rpx;
}

.card-item {
  margin-bottom: 40rpx;
  animation: slideIn 0.5s ease-out both;
}

@keyframes slideIn {
  from {
    opacity: 0;
    transform: translateY(30rpx);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.empty-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 150rpx;
  color: #b0c4de;
}

.empty-img {
  width: 160rpx;
  height: 160rpx;
  opacity: 0.3;
  margin-bottom: 20rpx;
}