page {
  background: #fff9f4;
  min-height: 100%;
}

.welcome {
  position: relative;
  min-height: 100vh;
  padding: 120rpx 48rpx 60rpx;
  box-sizing: border-box;
  overflow: hidden;
}

.glow {
  position: absolute;
  border-radius: 50%;
  filter: blur(60rpx);
  opacity: 0.55;
  pointer-events: none;
}
.glow-a {
  width: 460rpx;
  height: 460rpx;
  background: rgba(247, 168, 122, 0.35);
  top: -160rpx;
  right: -140rpx;
}
.glow-b {
  width: 380rpx;
  height: 380rpx;
  background: rgba(201, 162, 39, 0.18);
  bottom: -120rpx;
  left: -120rpx;
}

.head {
  position: relative;
  text-align: center;
}
.head .eyebrow {
  font-size: 20rpx;
  letter-spacing: 6rpx;
  color: #b08a76;
}
.head .title {
  margin-top: 18rpx;
  font-family: "Songti SC", "STSong", serif;
  font-size: 54rpx;
  font-weight: 600;
  color: #3d2b22;
  letter-spacing: 4rpx;
}
.head .sub {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #a08b80;
  letter-spacing: 1rpx;
}

.card {
  position: relative;
  margin-top: 56rpx;
  background: rgba(255, 253, 251, 0.92);
  border: 1rpx solid #f0e2d8;
  border-radius: 32rpx;
  padding: 48rpx 40rpx 44rpx;
  box-shadow: 0 30rpx 80rpx -50rpx rgba(96, 60, 40, 0.45);
}

.avatar-row {
  display: flex;
  justify-content: center;
}
.avatar-btn {
  width: 180rpx;
  height: 180rpx;
  padding: 0;
  margin: 0;
  border-radius: 50%;
  background: #fdf3ec;
  border: 2rpx dashed #ecd3c4;
  overflow: hidden;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}
.avatar-btn::after { border: 0; }
.avatar-img { width: 180rpx; height: 180rpx; border-radius: 50%; }
.avatar-empty { display: flex; flex-direction: column; align-items: center; }
.avatar-empty .plus { font-size: 54rpx; color: #e08a5f; line-height: 1; }
.avatar-empty .hint { margin-top: 8rpx; font-size: 20rpx; color: #b08a76; }

.field { margin-top: 44rpx; }
.field .label {
  font-size: 22rpx;
  letter-spacing: 3rpx;
  color: #a08b80;
  margin-bottom: 12rpx;
}
.field .input {
  height: 94rpx;
  padding: 0 26rpx;
  background: #fdf6f1;
  border: 1rpx solid #f0e2d8;
  border-radius: 22rpx;
  font-size: 30rpx;
  color: #3d2b22;
}

.tip {
  margin-top: 18rpx;
  font-size: 22rpx;
  color: #d9584a;
  text-align: center;
}

.save-btn {
  margin-top: 40rpx;
  height: 94rpx;
  line-height: 94rpx;
  text-align: center;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #f7a072, #f2795b);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  box-shadow: 0 16rpx 36rpx -18rpx rgba(242, 121, 91, 0.8);
}
.save-btn.disabled { opacity: 0.65; }

.foot {
  position: relative;
  margin-top: 48rpx;
  text-align: center;
  font-size: 20rpx;
  line-height: 1.9;
  color: #b6a196;
}
