page {
  background: linear-gradient(180deg, #a8c0ff 0%, #fbc2eb 100%);
  min-height: 100vh;
}

.detail-container {
  padding: 40rpx 50rpx;
  /* 左右边距稍微收一点，让卡片更宽 */
  min-height: 100vh;
  box-sizing: border-box;
}

.card-wrapper {
  width: 100%;
  margin-top: 20rpx;
  margin-bottom: 80rpx;
  /* 与按钮拉开距离 */
}







/* 整个标签的容器 */
.header-tag {
  display: inline-flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.25);
  /* 半透明白色 */
  backdrop-filter: blur(10px);
  /* 背景模糊，营造磨砂玻璃感 */
  -webkit-backdrop-filter: blur(10px);
  border: 1rpx solid rgba(255, 255, 255, 0.4);
  /* 极细的亮色边框 */
  padding: 12rpx 36rpx;
  border-radius: 100rpx;
  /* 胶囊形状 */
  box-shadow: 0 8rpx 32rpx rgba(168, 192, 255, 0.15);
  /* 淡淡的蓝紫色阴影 */
  margin-bottom: 60rpx;
  margin-top: 20rpx;
  animation: float 3s ease-in-out infinite;
  /* 增加一个微弱的漂浮动画 */
}

/* 星星图标 */
.tag-star {
  font-size: 24rpx;
  margin-right: 12rpx;
  filter: drop-shadow(0 0 4rpx rgba(255, 255, 255, 0.8));
}

/* 文字样式 */
.tag-text {
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 500;
  letter-spacing: 4rpx;
  /* 字间距拉开，更显高级 */
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.05);
}

/* 漂浮动画：让标签看起来更轻盈 */
@keyframes float {

  0%,
  100% {
    transform: translateY(0);
  }

  50% {
    transform: translateY(-8rpx);
  }
}











/* 按钮区域 - 核心：横向排列 */
.action-bar {
  width: 100%;
  display: flex;
  justify-content: space-between;
  padding: 0 10rpx;
  box-sizing: border-box;
}

/* 按钮通用样式 */
.btn-next,
.btn-share {
  height: 90rpx;
  line-height: 90rpx;
  font-size: 32rpx;
  border-radius: 45rpx;
  margin: 0 !important;
  /* 去除默认margin */
  font-weight: normal;
  display: flex;
  justify-content: center;
  align-items: center;
}

.btn-next {
  width: 60% !important;
  /* “换一个”占大头 */
  background: linear-gradient(135deg, #a8c0ff 0%, #7d96ff 100%) !important;
  color: #fff !important;
  box-shadow: 0 10rpx 30rpx rgba(168, 192, 255, 0.3);
}

.btn-share {
  width: 35% !important;
  /* “分享”占小头 */
  background: rgba(255, 255, 255, 0.6) !important;
  color: #666 !important;
}