<view class="quiz-container">
  <!-- 1. 顶部进度区域 -->
  <view class="progress-section">
    <view class="progress-text">
      <text class="current-num">Q {{currentIndex + 1}}</text>
      <text class="total-num">/ {{totalCount}}</text>
    </view>
    <view class="progress-bar">
      <view class="progress-inner" style="width: {{(currentIndex + 1) / totalCount * 100}}%"></view>
    </view>
  </view>

  <!-- 2. 题目卡片区 -->
  <view class="card-wrapper">
    <!-- 仅传入问题，答案根据 showAnswer 决定是否显示 -->
    <qa-card title="{{currentQA.question}}" content="{{showAnswer ? currentQA.answer : '点击下方按钮查看解析...'}}"></qa-card>
  </view>

  <!-- 3. 底部悬浮控制台 -->
  <view class="control-panel">
    <button class="btn-main {{showAnswer ? 'btn-disabled' : ''}}" bindtap="toggleAnswer">
      <text>显示答案</text>
    </button>
    <button class="btn-sub" bindtap="nextQuestion">
      <text>下一题</text>
      <text class="arrow"> →</text>
    </button>
  </view>
</view>