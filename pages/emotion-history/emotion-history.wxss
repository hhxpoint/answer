page {
  background-color: #F3F6F8;
}

.page-container {
  padding: 40rpx 32rpx;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.header {
  margin-bottom: 40rpx;
  margin-top: 20rpx;
}

.title {
  font-size: 56rpx;
  font-weight: 900;
  color: #111827;
  display: block;
  margin-bottom: 8rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #6B7280;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-top: 200rpx;
  opacity: 0.6;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
  filter: grayscale(1);
}

.empty-text {
  font-size: 30rpx;
  color: #9CA3AF;
}

.history-card {
  background: rgba(255, 255, 255, 0.9);
  border-radius: 36rpx;
  padding: 40rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 16rpx 32rpx -12rpx rgba(0, 0, 0, 0.05);
  border: 2rpx solid rgba(255, 255, 255, 1);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.date-text {
  font-size: 26rpx;
  color: #9CA3AF;
  font-weight: 500;
}

.emotion-badge {
  background: #EEF2FF;
  border-radius: 100rpx;
  padding: 8rpx 20rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #4F46E5;
}

.confidence-text {
  font-weight: 500;
  opacity: 0.7;
  font-size: 22rpx;
}

.text-content {
  background: #F9FAFB;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 32rpx;
  position: relative;
}

.quote-mark {
  color: #D1D5DB;
  font-size: 40rpx;
  font-family: Georgia, serif;
  font-weight: bold;
  line-height: 0;
}

.transcribed-text {
  font-size: 28rpx;
  color: #4B5563;
  line-height: 1.6;
  margin: 0 12rpx;
  display: inline;
}

/* 迷你播放器 */
.audio-player {
  background: #F3F4F6;
  border-radius: 100rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  padding: 0 16rpx;
  transition: all 0.3s;
  cursor: pointer;
}

.audio-player.playing {
  background: #E0E7FF;
}

.play-btn {
  width: 60rpx;
  height: 60rpx;
  background: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.05);
}

.play-icon {
  font-size: 24rpx;
  color: #4F46E5;
  margin-left: 4rpx;
}

.audio-player.playing .play-icon {
  margin-left: 0;
}

.wave-container {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 0 24rpx;
  height: 40rpx;
}

.mini-wave {
  width: 6rpx;
  height: 8rpx;
  background: #9CA3AF;
  border-radius: 6rpx;
  transition: height 0.2s;
}

.audio-player.playing .mini-wave {
  background: #6366F1;
  animation: mini-sound 1s infinite alternate ease-in-out;
}

.audio-player.playing .mini-wave:nth-child(2n) {
  animation-delay: 0.2s;
}

.audio-player.playing .mini-wave:nth-child(3n) {
  animation-delay: 0.4s;
}

.play-status {
  font-size: 24rpx;
  color: #6B7280;
  font-weight: 500;
  margin-right: 16rpx;
  min-width: 100rpx;
  text-align: right;
}

.audio-player.playing .play-status {
  color: #4F46E5;
}

@keyframes mini-sound {
  0% {
    height: 8rpx;
  }

  100% {
    height: 32rpx;
  }
}