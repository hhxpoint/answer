/* ================= 核心容器基调 ================= */
.cabin-galaxy-container {
  width: 100vw;
  height: 100vh;
  background: #15100f;
  position: relative;
  overflow: hidden;
}

.vignette-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: radial-gradient(circle at 50% 50%, transparent 35%, rgba(8, 5, 5, 0.85) 100%);
  z-index: 10;
  pointer-events: none;
}

/* ================= 梦幻极光层 ================= */
.aurora-container {
  position: absolute;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 1;
  pointer-events: none;
  overflow: hidden;
  mix-blend-mode: screen;
  opacity: 0.9;
}

.aurora {
  position: absolute;
  border-radius: 50%;
  filter: blur(70px);
  animation: auroraMorph 25s infinite alternate ease-in-out;
}

.aurora-1 {
  bottom: -20%;
  right: -20%;
  width: 140vw;
  height: 100vh;
  background: radial-gradient(circle, rgba(16, 185, 129, 0.12) 0%, transparent 60%);
  animation-duration: 32s;
}

.aurora-2 {
  top: -10%;
  left: -30%;
  width: 150vw;
  height: 90vh;
  background: radial-gradient(circle, rgba(14, 165, 233, 0.15) 0%, transparent 65%);
  animation-duration: 28s;
  animation-delay: -5s;
}

.aurora-3 {
  top: 30%;
  left: 20%;
  width: 120vw;
  height: 80vh;
  background: radial-gradient(circle, rgba(139, 92, 246, 0.08) 0%, transparent 60%);
  animation-duration: 38s;
  animation-delay: -12s;
}

@keyframes auroraMorph {
  0% {
    transform: scale(1) translate(0, 0) rotate(0deg);
    opacity: 0.7;
  }

  50% {
    transform: scale(1.15) translate(8%, -4%) rotate(5deg);
    opacity: 1;
  }

  100% {
    transform: scale(0.9) translate(-4%, 6%) rotate(-5deg);
    opacity: 0.6;
  }
}

/* ================= 深空流星 ================= */
.shooting-stars {
  position: absolute;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 1;
  pointer-events: none;
  overflow: hidden;
}

.shooting-star {
  position: absolute;
  width: 180rpx;
  height: 1px;
  background: linear-gradient(90deg, rgba(255, 255, 255, 0.9), rgba(255, 255, 255, 0.2) 40%, transparent);
  border-radius: 50%;
  transform: rotate(-35deg) translateX(0);
  opacity: 0;
}

.s-1 {
  top: 15%;
  left: 80%;
  animation: shootingAnim 12s infinite linear 3s;
}

.s-2 {
  top: 40%;
  left: 90%;
  animation: shootingAnim 18s infinite linear 8s;
  width: 120rpx;
  opacity: 0.5;
}

.s-3 {
  top: -5%;
  left: 50%;
  animation: shootingAnim 25s infinite linear 1s;
  width: 220rpx;
}

@keyframes shootingAnim {
  0% {
    transform: rotate(-35deg) translateX(0);
    opacity: 1;
    filter: drop-shadow(0 0 4px #fff);
  }

  4% {
    transform: rotate(-35deg) translateX(-120vw);
    opacity: 0;
  }

  100% {
    transform: rotate(-35deg) translateX(-120vw);
    opacity: 0;
  }
}

/* ================= 丁达尔暖阳柔光束 ================= */
.god-ray {
  position: absolute;
  top: -20%;
  left: -20%;
  width: 200vw;
  height: 40vh;
  background: linear-gradient(to bottom, rgba(253, 230, 138, 0.08) 0%, rgba(253, 230, 138, 0.02) 50%, transparent 100%);
  transform: rotate(-35deg);
  transform-origin: top left;
  z-index: 1;
  pointer-events: none;
  filter: blur(40px);
  animation: raySweep 15s infinite alternate ease-in-out;
}

.ray-2 {
  top: -10%;
  left: 30%;
  width: 150vw;
  height: 30vh;
  background: linear-gradient(to bottom, rgba(243, 244, 246, 0.05) 0%, transparent 100%);
  transform: rotate(-45deg);
  animation: raySweep 20s infinite alternate-reverse ease-in-out;
}

@keyframes raySweep {
  0% {
    transform: rotate(-35deg) translateY(0);
    opacity: 0.5;
  }

  100% {
    transform: rotate(-25deg) translateY(60rpx);
    opacity: 1;
    filter: blur(50px);
  }
}

/* ================= 冷暖交织浮尘/星尘 ================= */
.dust-container {
  position: absolute;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 2;
  pointer-events: none;
}

.dust {
  position: absolute;
  bottom: -10px;
  width: 4px;
  height: 4px;
  border-radius: 50%;
  background: rgba(253, 230, 138, 0.8);
  box-shadow: 0 0 10px 2px rgba(253, 230, 138, 0.5);
  opacity: 0;
}

.d-1 {
  left: 20%;
  animation: floatDust 12s infinite linear;
}

.d-2 {
  left: 45%;
  width: 6px;
  height: 6px;
  animation: floatDust 18s infinite linear 3s;
}

.d-3 {
  left: 70%;
  background: rgba(255, 255, 255, 0.6);
  animation: floatDust 15s infinite linear 7s;
}

.d-4 {
  left: 10%;
  width: 3px;
  height: 3px;
  animation: floatDust 20s infinite linear 1s;
}

.d-5 {
  left: 85%;
  animation: floatDust 14s infinite linear 5s;
}

.d-6 {
  left: 55%;
  background: rgba(255, 255, 255, 0.8);
  animation: floatDust 16s infinite linear 9s;
}

.dust-cold {
  background: rgba(167, 243, 208, 0.85);
  box-shadow: 0 0 8px 1px rgba(167, 243, 208, 0.5);
}

.dust-cold-blue {
  background: rgba(186, 230, 253, 0.9);
  box-shadow: 0 0 10px 2px rgba(186, 230, 253, 0.6);
}

.d-7 {
  left: 15%;
  width: 3px;
  height: 3px;
  animation: floatDust 17s infinite linear 2s;
}

.d-8 {
  left: 38%;
  width: 5px;
  height: 5px;
  animation: floatDust 24s infinite linear 11s;
}

.d-9 {
  left: 75%;
  animation: floatDust 13s infinite linear 4s;
}

.d-10 {
  left: 62%;
  width: 7px;
  height: 7px;
  animation: floatDust 22s infinite linear 1s;
  filter: blur(1px);
}

.d-11 {
  left: 28%;
  width: 2px;
  height: 2px;
  animation: floatDust 19s infinite linear 6s;
}

.d-12 {
  left: 88%;
  animation: floatDust 15s infinite linear 8s;
}

.d-13 {
  left: 50%;
  width: 4px;
  height: 4px;
  animation: floatDust 28s infinite linear 14s;
}

.d-14 {
  left: 5%;
  animation: floatDust 11s infinite linear 5s;
}

.d-15 {
  left: 95%;
  width: 5px;
  height: 5px;
  animation: floatDust 20s infinite linear 10s;
}

@keyframes floatDust {
  0% {
    transform: translateY(0) translateX(0) scale(0.8);
    opacity: 0;
  }

  15% {
    opacity: 1;
  }

  85% {
    opacity: 1;
  }

  100% {
    transform: translateY(-100vh) translateX(120rpx) scale(0.3);
    opacity: 0;
  }
}

/* ================= 繁星底纹 ================= */
.stars-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
  background-image: radial-gradient(1px 1px at 15% 25%, rgba(253, 230, 138, 0.3) 100%, transparent), radial-gradient(1.5px 1.5px at 85% 15%, rgba(255, 255, 255, 0.25) 100%, transparent);
  background-size: 150px 150px;
  animation: starlight 8s ease-in-out infinite alternate;
}

@keyframes starlight {
  0% {
    opacity: 0.4;
  }

  100% {
    opacity: 0.9;
  }
}

/* ================= 顶部 UI ================= */
.hud-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  pointer-events: none;
}

.hud-top-left {
  position: absolute;
  top: 80rpx;
  left: 40rpx;
}

.hud-text {
  font-family: 'Times New Roman', serif;
  color: rgba(212, 175, 55, 0.8);
  font-size: 22rpx;
  letter-spacing: 6rpx;
  margin-bottom: 8rpx;
  font-weight: bold;
}

.hud-line {
  width: 120rpx;
  height: 1px;
  background: linear-gradient(90deg, rgba(212, 175, 55, 0.8), transparent);
}

.hud-top-right {
  position: absolute;
  top: 70rpx;
  right: 40rpx;
  width: 60rpx;
  height: 60rpx;
  border: 1px solid rgba(212, 175, 55, 0.3);
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
}

.hud-compass {
  width: 40rpx;
  height: 40rpx;
  border: 1px dashed rgba(212, 175, 55, 0.6);
  border-radius: 50%;
  animation: spin 20s linear infinite;
}

/* ================= 网络节点与动态牵制核心 ================= */
.universe-scroll {
  position: absolute;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 2;
  overflow: hidden;
}

/* 去掉原有画布 relative 限制，交由 padding 撑开空间 */
.universe-canvas {
  position: absolute;
  top: 0;
  left: 0;
}

.energy-line {
  position: absolute;
  height: 1px;
  background: rgba(253, 230, 138, 0.12);
  transform-origin: 0 50%;
  z-index: 2;
  overflow: hidden;
}

/* 能量线呼吸脉动，增加牵引感 */
.pulse-line {
  animation: linePulse 4s infinite alternate ease-in-out;
}

@keyframes linePulse {
  0% {
    opacity: 0.5;
    filter: drop-shadow(0 0 0 transparent);
  }

  100% {
    opacity: 1;
    filter: drop-shadow(0 0 4px rgba(251, 191, 36, 0.4));
  }
}

.data-flow {
  position: absolute;
  top: -1px;
  left: 0;
  width: 100rpx;
  height: 2px;
  background: linear-gradient(90deg, transparent, rgba(251, 191, 36, 0.8), #fff);
  box-shadow: 0 0 10px rgba(251, 191, 36, 0.5);
  border-radius: 50%;
  animation: dataFlowAnim 4s infinite cubic-bezier(0.4, 0, 0.2, 1);
}

@keyframes dataFlowAnim {
  0% {
    left: -100rpx;
    opacity: 0;
  }

  30% {
    opacity: 1;
  }

  70% {
    opacity: 1;
  }

  100% {
    left: 100%;
    opacity: 0;
  }
}

/* 星球节点基础容器 */
.star-node {
  position: absolute;
  width: 200rpx;
  height: 200rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 3;
}

/* 🌟 量子浮动引擎：让节点像果冻一样互相牵引微动，注意结合原有的 translate(-50%, -50%) 偏移 */
.quantum-float {
  animation: qFloat 10s infinite ease-in-out;
}

.star-node:nth-child(3n) {
  animation-duration: 8s;
  animation-direction: reverse;
}

.star-node:nth-child(3n+1) {
  animation-duration: 12s;
  animation-delay: -3s;
}

.star-node:nth-child(3n+2) {
  animation-duration: 15s;
  animation-delay: -7s;
}

@keyframes qFloat {
  0% {
    transform: translate(-50%, -50%) translate(0, 0);
  }

  33% {
    transform: translate(-50%, -50%) translate(5rpx, -4rpx);
  }

  66% {
    transform: translate(-50%, -50%) translate(-3rpx, 6rpx);
  }

  100% {
    transform: translate(-50%, -50%) translate(0, 0);
  }
}

/* 扩大光晕环 (羁绊感增强) */
.orbit-ring {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 120rpx;
  height: 120rpx;
  margin-top: -60rpx;
  margin-left: -60rpx;
  border-radius: 50%;
  border: 1px dashed rgba(253, 230, 138, 0.15);
  box-sizing: border-box;
  animation: spin 20s linear infinite;
  pointer-events: none;
}

.grand-ring {
  width: 160rpx;
  height: 160rpx;
  margin-top: -80rpx;
  margin-left: -80rpx;
  border: 1px dotted rgba(253, 230, 138, 0.25);
}

.star-node:nth-child(even) .orbit-ring {
  animation-direction: reverse;
}

@keyframes spin {
  100% {
    transform: rotate(360deg);
  }
}

.planet {
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  transition: all 0.5s;
  cursor: pointer;
  position: relative;
  z-index: 2;
  animation: lanternBreathe 3s infinite alternate;
}

.planet-core {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 0 20px 8px rgba(255, 255, 255, 0.8);
}

.core .planet {
  background: radial-gradient(circle, rgba(245, 158, 11, 0.6) 0%, transparent 70%);
  box-shadow: 0 0 60px rgba(245, 158, 11, 0.5);
}

.core .planet-core {
  background: #fef3c7;
  box-shadow: 0 0 25px #fef3c7;
}

.main .planet {
  background: radial-gradient(circle, rgba(226, 232, 240, 0.5) 0%, transparent 70%);
  box-shadow: 0 0 50px rgba(226, 232, 240, 0.3);
}

.leaf .planet {
  background: radial-gradient(circle, rgba(217, 119, 6, 0.5) 0%, transparent 70%);
  box-shadow: 0 0 50px rgba(217, 119, 6, 0.3);
}

.hidden .planet {
  background: radial-gradient(circle, rgba(159, 18, 57, 0.5) 0%, transparent 70%);
  box-shadow: 0 0 50px rgba(159, 18, 57, 0.3);
}

@keyframes lanternBreathe {
  0% {
    transform: scale(0.95);
    opacity: 0.85;
  }

  100% {
    transform: scale(1.05);
    opacity: 1;
    filter: brightness(1.2);
  }
}

.star-node:active .planet {
  transform: scale(0.85);
  filter: brightness(1.5);
  transition: 0.2s;
}

.star-name {
  margin-top: 50rpx;
  color: #fef3c7;
  font-size: 26rpx;
  font-weight: 300;
  letter-spacing: 4rpx;
  text-shadow: 0 4px 10px #000;
  background: rgba(41, 37, 36, 0.6);
  padding: 6rpx 20rpx;
  border-radius: 30rpx;
  border: 1px solid rgba(253, 230, 138, 0.15);
  backdrop-filter: blur(4px);
  position: relative;
  z-index: 2;
  font-family: serif;
}

/* ================= 底部茶色大屏弹窗 ================= */
.popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(10, 8, 7, 0.88);
  backdrop-filter: blur(12px);
  z-index: 1000;
  opacity: 0;
  visibility: hidden;
  transition: all 0.5s;
}

.popup-mask.show {
  opacity: 1;
  visibility: visible;
}

.code-popup {
  bottom: calc(40rpx + env(safe-area-inset-bottom));
  left: 30rpx;
  right: 30rpx;
  height: 88vh;
  background: linear-gradient(135deg, rgba(41, 37, 36, 0.95), rgba(28, 25, 23, 0.98));
  backdrop-filter: blur(20px);
  border-radius: 32rpx;
  z-index: 1001;
  transform: translateY(120%);
  opacity: 0;
  transition: all 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
  display: flex;
  flex-direction: column;
  border: 1px solid rgba(212, 175, 55, 0.2);
  box-shadow: 0 -10px 50px rgba(0, 0, 0, 0.9), 0 0 30px rgba(212, 175, 55, 0.05);
  position: fixed;
}

.code-popup.show {
  transform: translateY(0);
  opacity: 1;
}

.popup-header {
  padding: 40rpx 40rpx 30rpx 40rpx;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  border-bottom: 1px dashed rgba(212, 175, 55, 0.2);
}

.popup-subtitle {
  font-family: serif;
  color: #d4af37;
  font-size: 20rpx;
  letter-spacing: 4rpx;
  margin-bottom: 12rpx;
  font-style: italic;
}

.popup-title {
  font-size: 46rpx;
  font-family: serif;
  font-weight: bold;
  letter-spacing: 2rpx;
  color: #fef3c7;
  text-shadow: 0 2px 10px rgba(0, 0, 0, 0.5);
}

.popup-desc {
  font-size: 26rpx;
  color: #a8a29e;
  margin-top: 16rpx;
  line-height: 1.6;
  font-weight: 300;
}

.close-btn {
  font-family: serif;
  font-size: 26rpx;
  color: #d4af37;
  padding: 10rpx 30rpx;
  background: rgba(212, 175, 55, 0.05);
  border-radius: 40rpx;
  border: 1px solid rgba(212, 175, 55, 0.3);
}

.code-scroll {
  height: 0;
  flex: 1;
  background: rgba(12, 10, 9, 0.6);
  margin: 30rpx;
  margin-bottom: 40rpx;
  border-radius: 20rpx;
  box-sizing: border-box;
  border: 1px solid rgba(255, 255, 255, 0.03);
  box-shadow: inset 0 0 20px rgba(0, 0, 0, 0.8);
}

.code-content {
  font-family: 'Consolas', monospace;
  font-size: 28rpx;
  color: #fbbf24;
  line-height: 1.8;
  white-space: pre;
  font-weight: 300;
  text-shadow: 0 0 2px rgba(251, 191, 36, 0.2);
}

.code-content-wrapper {
  display: inline-block;
  min-width: 100%;
  padding: 40rpx;
  padding-bottom: 60rpx;
  box-sizing: border-box;
}

.hl-keyword {
  color: #fbbf24;
  font-weight: bold;
  text-shadow: 0 0 4px rgba(251, 191, 36, 0.4);
}

.hl-function {
  color: #93c5fd;
  font-weight: 600;
}

.hl-variable {
  color: #e2e8f0;
}

.hl-string {
  color: #a7f3d0;
  opacity: 0.95;
}

.hl-comment {
  color: #78716c;
  font-style: italic;
  background: rgba(120, 113, 108, 0.08);
  padding: 2rpx 6rpx;
  border-radius: 4rpx;
}

.hl-number {
  color: #fdba74;
}

.hl-operator {
  color: #c4b5fd;
  font-weight: 500;
}

.hl-bracket {
  color: #fde68a;
  font-weight: bold;
}

/* ================= 粒子水墨烟花 ================= */
.ink-fireworks-container {
  position: absolute;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  pointer-events: none;
  z-index: 1;
  mix-blend-mode: color-dodge;
  overflow: hidden;
}

.ink-burst {
  position: absolute;
  width: 2rpx;
  height: 2rpx;
}

.ink-drop {
  position: absolute;
  border-radius: 50%;
  filter: blur(25px);
  opacity: 0;
  animation: inkBloom 15s infinite ease-out;
  transform-origin: center;
}

.color-magenta {
  background: #f43f5e;
  box-shadow: 0 0 50px 20px #f43f5e;
}

.color-cyan {
  background: #06b6d4;
  box-shadow: 0 0 60px 30px #06b6d4;
}

.color-gold {
  background: #fbbf24;
  box-shadow: 0 0 40px 15px #fbbf24;
}

.color-purple {
  background: #a855f7;
  box-shadow: 0 0 70px 25px #a855f7;
}

.color-teal {
  background: #14b8a6;
  box-shadow: 0 0 55px 20px #14b8a6;
}

.burst-1 {
  top: 30%;
  left: 20%;
  animation-delay: 2s;
}

.burst-1 .color-magenta {
  animation-delay: 2s;
  width: 60rpx;
  height: 60rpx;
}

.burst-1 .color-cyan {
  animation-delay: 2.2s;
  width: 80rpx;
  height: 80rpx;
  transform: translate(30rpx, -20rpx);
}

.burst-1 .color-gold {
  animation-delay: 2.5s;
  width: 40rpx;
  height: 40rpx;
  transform: translate(-20rpx, 30rpx);
}

.burst-2 {
  top: 60%;
  right: 25%;
  animation-delay: 8s;
}

.burst-2 .color-purple {
  animation-delay: 8s;
  width: 90rpx;
  height: 90rpx;
}

.burst-2 .color-magenta {
  animation-delay: 8.3s;
  width: 50rpx;
  height: 50rpx;
  transform: translate(-40rpx, 10rpx);
}

.burst-3 {
  top: 15%;
  right: 40%;
  animation-delay: 14s;
}

.burst-3 .color-teal {
  animation-delay: 14s;
  width: 70rpx;
  height: 70rpx;
}

.burst-3 .color-gold {
  animation-delay: 14.4s;
  width: 45rpx;
  height: 45rpx;
  transform: translate(20rpx, -30rpx);
}

@keyframes inkBloom {
  0% {
    transform: scale(0.1);
    opacity: 0;
  }

  10% {
    transform: scale(1.5);
    opacity: 0.8;
  }

  60% {
    transform: scale(3.5);
    opacity: 0.3;
  }

  100% {
    transform: scale(4.5);
    opacity: 0;
  }
}

/* ================= 灵动水母 ================= */
.jellyfish-container {
  position: absolute;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  pointer-events: none;
  z-index: 2;
  overflow: hidden;
}

.jellyfish {
  position: absolute;
  display: flex;
  flex-direction: column;
  align-items: center;
  opacity: 0;
}

.j-head {
  width: 50rpx;
  height: 30rpx;
  background: radial-gradient(ellipse at top, rgba(167, 243, 208, 0.9) 0%, rgba(14, 165, 233, 0.4) 70%, transparent 100%);
  border-radius: 50rpx 50rpx 10rpx 10rpx;
  box-shadow: 0 -5px 15px rgba(56, 189, 248, 0.5), inset 0 2px 4px rgba(255, 255, 255, 0.8);
  animation: jellyPulse 3s infinite alternate ease-in-out;
}

.j-tentacles {
  width: 35rpx;
  height: 80rpx;
  background: repeating-linear-gradient(90deg, transparent, transparent 4rpx, rgba(56, 189, 248, 0.35) 5rpx, rgba(56, 189, 248, 0.35) 6rpx);
  filter: blur(1px);
  border-radius: 0 0 15rpx 15rpx;
  animation: jellySway 4s infinite alternate ease-in-out;
  transform-origin: top center;
  margin-top: -5rpx;
}

.jelly-1 {
  left: 15%;
  animation: swimUp 25s infinite linear;
}

.jelly-2 {
  left: 80%;
  transform: scale(0.7);
  animation: swimUp 35s infinite linear 12s;
}

.jelly-3 {
  left: 45%;
  transform: scale(1.2);
  animation: swimUp 40s infinite linear 5s;
}

@keyframes swimUp {
  0% {
    transform: translateY(110vh) translateX(0) rotate(-10deg) scale(var(--s, 1));
    opacity: 0;
  }

  10% {
    opacity: 0.8;
  }

  80% {
    opacity: 0.8;
  }

  100% {
    transform: translateY(-20vh) translateX(60rpx) rotate(15deg) scale(var(--s, 1));
    opacity: 0;
  }
}

@keyframes jellyPulse {
  0% {
    transform: scaleY(1) scaleX(1);
  }

  100% {
    transform: scaleY(0.85) scaleX(1.1);
    filter: brightness(1.3);
  }
}

@keyframes jellySway {
  0% {
    transform: skewX(-15deg);
  }

  100% {
    transform: skewX(15deg);
  }
}

/* ================= 提灯鱼 ================= */
.lantern-fish-container {
  position: absolute;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  pointer-events: none;
  z-index: 2;
  overflow: hidden;
}

.lantern-fish {
  position: absolute;
  display: flex;
  align-items: center;
  transform: translateX(-30vw);
}

.lf-sway {
  display: flex;
  align-items: center;
  position: relative;
  animation: fishBob 6s infinite alternate ease-in-out;
}

.lf-body {
  width: 50rpx;
  height: 26rpx;
  background: rgba(15, 23, 42, 0.7);
  border-radius: 50% 40% 30% 50%;
  box-shadow: inset 2px 2px 4px rgba(255, 255, 255, 0.05);
  z-index: 2;
  position: relative;
}

.lf-tail {
  width: 0;
  height: 0;
  border-top: 10rpx solid transparent;
  border-bottom: 10rpx solid transparent;
  border-left: 20rpx solid rgba(15, 23, 42, 0.5);
  margin-left: -4rpx;
  animation: tailWiggle 1.5s infinite alternate ease-in-out;
  transform-origin: left center;
  z-index: 1;
}

.lf-antenna {
  position: absolute;
  top: -14rpx;
  left: -16rpx;
  width: 30rpx;
  height: 20rpx;
  border-top: 2rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  z-index: 3;
}

.lf-light {
  position: absolute;
  top: 10rpx;
  left: -8rpx;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #fef08a;
  box-shadow: 0 0 8rpx 2rpx rgba(253, 224, 71, 1), 0 0 20rpx 6rpx rgba(234, 179, 8, 0.6), 0 0 40rpx 12rpx rgba(202, 138, 4, 0.3);
  animation: lanternBlink 3s infinite alternate;
}

.lf-glow {
  position: absolute;
  top: -20rpx;
  left: -30rpx;
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(250, 204, 21, 0.1) 0%, transparent 70%);
  filter: blur(10px);
  pointer-events: none;
  z-index: 0;
}

.f-1 {
  top: 65%;
  transform: scale(1.2);
  animation: swimAcross 45s infinite linear;
}

.f-1 .lf-sway {
  animation-duration: 7s;
}

.f-2 {
  top: 25%;
  transform: scale(0.8);
  animation: swimAcross 38s infinite linear 12s;
  opacity: 0.8;
}

.f-2 .lf-sway {
  animation-duration: 5s;
  animation-delay: 1s;
}

.f-3 {
  top: 85%;
  transform: scale(0.9);
  animation: swimAcross 55s infinite linear 25s;
  filter: blur(2px);
  opacity: 0.6;
}

.f-3 .lf-sway {
  animation-duration: 8s;
  animation-delay: 2s;
}

@keyframes swimAcross {
  0% {
    transform: translateX(-30vw) scale(var(--s, 1));
  }

  100% {
    transform: translateX(120vw) scale(var(--s, 1));
  }
}

@keyframes fishBob {
  0% {
    transform: translateY(15rpx) rotate(-2deg);
  }

  100% {
    transform: translateY(-15rpx) rotate(2deg);
  }
}

@keyframes lanternBlink {
  0% {
    opacity: 0.7;
    transform: scale(0.9);
  }

  100% {
    opacity: 1;
    transform: scale(1.1);
    filter: brightness(1.2);
  }
}

@keyframes tailWiggle {
  0% {
    transform: rotate(-15deg);
  }

  100% {
    transform: rotate(15deg);
  }
}