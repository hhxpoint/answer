<!-- pages/about/about.wxml -->
<view class="container">
  <!-- 动态流光背景 -->
  <view class="animated-bg"></view>

  <!-- 毛玻璃主卡片 -->
  <view class="glass-card">

    <!-- 1. 个人资料 (头像带光晕) -->
    <view class="profile-section">
      <view class="avatar-wrapper">
        <image class="avatar" src="/assets/banner2.png" mode="aspectFill"></image>
      </view>
      <text class="name">主轩次瀚</text>
      <text class="bio">Please don't cry, keep shining.</text>
    </view>

    <!-- 2. 内容列表区 -->
    <view class="list-section">

      <!-- 博客项 -->
      <view class="list-item" bindtap="copyBlogUrl">
        <view class="item-left">
          <view class="icon-box icon-blog">🌐</view>
          <view class="item-info">
            <text class="item-title">个人博客</text>
            <text class="item-desc">hhxpoint.github.io</text>
          </view>
        </view>
        <view class="item-arrow">
          <text>复制</text> ➜
        </view>
      </view>

      <!-- 公众号二维码展示区 -->
      <view class="qr-container">
        <view class="qr-header">
          <view class="icon-box icon-qr">📱</view>
          <text class="qr-title">关注公众号</text>
        </view>
        <view class="qr-wrapper">
          <image class="qr-image" src="{{qrCodeUrl}}" mode="aspectFit" bindtap="previewQRCode"></image>
          <text class="qr-hint">点击图片放大 · 长按识别</text>
        </view>
      </view>

    </view>

    <!-- 3. 底部客服 (悬浮胶囊按钮) -->
    <view class="footer-section">
      <button class="contact-btn" open-type="contact" bindcontact="handleContact">
        <text class="btn-icon">💬</text>
        <text>联系作者 / 在线咨询</text>
      </button>
      <text class="footer-text">Designed with ❤️ by point_xuan</text>
    </view>

  </view>
</view>