/* 页面基础底色 */
page {
  background-color: #f4f6f9;
}

.page-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

/* 顶部现代感渐变背景 */
.header-bg {
  width: 100%;
  height: 350rpx;
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
  border-bottom-left-radius: 40rpx;
  border-bottom-right-radius: 40rpx;
  position: absolute;
  top: 0;
  left: 0;
  z-index: 1;
}

/* 悬浮卡片主体 */
.main-card {
  width: 88%;
  background-color: #ffffff;
  border-radius: 30rpx;
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.06);
  margin-top: 100rpx;
  /* 向上偏移盖住一部分背景 */
  z-index: 2;
  padding: 50rpx 40rpx;
  box-sizing: border-box;
}

/* 个人信息 */
.profile-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 30rpx;
}

.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 6rpx solid #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.1);
  margin-bottom: 20rpx;
  background-color: #eeeeee;
  /* 图片加载前的占位色 */
}

.name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 10rpx;
}

.bio {
  font-size: 26rpx;
  color: #888888;
}

/* 分割线 */
.divider {
  width: 100%;
  height: 1px;
  background-color: #f0f0f0;
  margin: 40rpx 0;
}

/* 信息区块通用样式 */
.info-section {
  display: flex;
  flex-direction: column;
}

.info-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 20rpx;
  display: block;
}

/* 博客链接样式 */
.blog-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background-color: #f8f9fa;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
}

.blog-url {
  font-size: 26rpx;
  color: #555555;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.copy-btn {
  font-size: 24rpx;
  color: #4facfe;
  background-color: rgba(79, 172, 254, 0.1);
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
  margin-left: 20rpx;
  font-weight: 500;
}

.copy-btn:active {
  opacity: 0.7;
}

/* 二维码样式 */
.qr-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 10rpx;
}

.qr-code {
  width: 320rpx;
  height: 320rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  background-color: #fafafa;
  margin-bottom: 20rpx;
  /* ⚠️ 提示：在没放图片前，这里会显示一个灰底色 */
}

.qr-tip {
  font-size: 24rpx;
  color: #aaaaaa;
}

/* 底部留白 */
.footer {
  margin-top: 60rpx;
  margin-bottom: 40rpx;
  font-size: 24rpx;
  color: #cccccc;
}