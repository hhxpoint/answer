<!-- pages/exam/exam.wxml -->
<view class="page-container">
  <view class="progress-bar-area">
    <view class="pb-bg">
      <view class="pb-inner" style="width: {{(index + 1) / list.length * 100}}%"></view>
    </view>
    <text class="count-txt">{{index + 1}}/{{list.length}}</text>
  </view>

  <view class="main-card">
    <view class="tag-bar">
      <view class="q-tag">{{currentQuestion.type === 'choice' ? '单选题' : '填空题'}}</view>
      <view class="q-tag subject-tag" wx:if="{{currentQuestion.subject}}">{{currentQuestion.subject}}</view>
    </view>

    <!-- 题目内容：完美嵌入 -->
    <view class="q-title">
      <rich-text nodes="{{richTitle}}"></rich-text>
    </view>

    <!-- 选择题 -->
    <block wx:if="{{currentQuestion.type === 'choice'}}">
      <view class="options-list">
        <view wx:for="{{richOptions}}" wx:key="label"
          class="opt-item {{selected === item.label ? 'active' : ''}} {{isSubmitted && item.label === currentQuestion.answer ? 'success' : ''}} {{isSubmitted && selected === item.label && selected !== currentQuestion.answer ? 'error' : ''}}"
          bindtap="onSelect" data-label="{{item.label}}">
          <text class="opt-idx">{{item.label}}</text>

          <!-- 选项内容：完美嵌入 -->
          <view class="opt-val">
            <rich-text nodes="{{item.richContent}}"></rich-text>
          </view>
        </view>
      </view>
    </block>

    <!-- 填空题 -->
    <block wx:else>
      <view class="input-section">
        <input class="underline-input {{isSubmitted ? (isCorrect ? 'input-success' : 'input-error') : ''}}"
          placeholder="点击此处输入答案" bindinput="onInput" value="{{inputValue}}" disabled="{{isSubmitted}}" />
      </view>
    </block>

    <view class="action-btn-box">
      <button class="primary-btn" bindtap="checkAnswer" wx:if="{{!isSubmitted}}">提交答案</button>
      <button class="next-btn" bindtap="nextQuestion" wx:else>进入下一题</button>
    </view>

    <view class="result-analysis" wx:if="{{isSubmitted}}">
      <view class="status-banner {{isCorrect ? 'banner-success' : 'banner-error'}}">
        <text>{{isCorrect ? '答对了！太棒了' : '答错了，再接再厉'}}</text>
        <text class="correct-ans">正确答案：{{currentQuestion.answer}}</text>
      </view>
      <view class="analysis-body">
        <view class="ana-title">【题目解析】</view>
        <!-- 解析内容：完美嵌入 -->
        <view class="ana-text">
          <rich-text nodes="{{richAnalysis}}"></rich-text>
        </view>
      </view>
    </view>
  </view>
</view>