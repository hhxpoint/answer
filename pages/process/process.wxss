/* --- 基础配置与变量 --- */
page {
  /* 奶油暖木色调 */
  --bg-color: #f6efe8;
  --wood-light: #e6d5c3;
  --wood-dark: #8c7361;
  --fire-glow: #e89f71;
  --text-main: #5c4b3c;
  --text-sub: #9e8a79;

  background-color: var(--bg-color);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
}

.page-container {
  min-height: 100vh;
  position: relative;
  overflow: hidden;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 30rpx;
  box-sizing: border-box;
}

/* --- 背景氛围光影 --- */
.ambient-bookshelf {
  position: absolute;
  top: 10%;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  opacity: 0.3;
}

.ambient-bookshelf .line {
  width: 100%;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, var(--wood-dark), transparent);
  margin-bottom: 300rpx;
  box-shadow: 0 10rpx 20rpx rgba(140, 115, 97, 0.4);
}

.ambient-fire {
  position: absolute;
  bottom: -50rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 100%;
  height: 300rpx;
  pointer-events: none;
  z-index: 0;
  display: flex;
  justify-content: center;
  align-items: flex-end;
  filter: blur(40rpx);
  /* 极其柔和的失焦火焰光 */
}

.glow {
  border-radius: 50%;
  background: radial-gradient(circle, var(--fire-glow) 0%, transparent 70%);
  animation: breathe 4s infinite alternate ease-in-out;
  opacity: 0.6;
}

.glow-1 {
  width: 400rpx;
  height: 300rpx;
  animation-duration: 3s;
}

.glow-2 {
  width: 300rpx;
  height: 250rpx;
  background: radial-gradient(circle, #f4a261 0%, transparent 70%);
  animation-duration: 4.5s;
  animation-delay: 1s;
}

.glow-3 {
  width: 350rpx;
  height: 280rpx;
  background: radial-gradient(circle, #e76f51 0%, transparent 70%);
  animation-duration: 5s;
  animation-delay: 0.5s;
}

@keyframes breathe {
  0% {
    transform: scale(0.9) translateY(20rpx);
    opacity: 0.4;
  }

  100% {
    transform: scale(1.1) translateY(0);
    opacity: 0.8;
  }
}

/* --- 核心毛玻璃面板 --- */
.glass-board {
  position: relative;
  z-index: 10;
  width: 100%;
  max-width: 800rpx;
  background: rgba(255, 255, 255, 0.65);
  backdrop-filter: blur(25px);
  -webkit-backdrop-filter: blur(25px);
  border-radius: 48rpx;
  border: 1px solid rgba(255, 255, 255, 0.8);
  box-shadow:
    0 30rpx 60rpx -10rpx rgba(140, 115, 97, 0.15),
    inset 0 0 0 1px rgba(255, 255, 255, 0.5);
  padding: 40rpx 30rpx;
  box-sizing: border-box;
}

/* --- 头部 --- */
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40rpx;
  padding: 0 10rpx;
}

.title-box {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.title-box .emoji {
  font-size: 40rpx;
}

.title-box .title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-main);
  letter-spacing: 2rpx;
}

.btn-save {
  padding: 12rpx 30rpx;
  background: rgba(212, 163, 115, 0.15);
  color: #c48b5d;
  font-size: 26rpx;
  font-weight: 500;
  border-radius: 100rpx;
  border: 1px solid rgba(212, 163, 115, 0.3);
  transition: all 0.2s ease;
}

.btn-save:active {
  background: rgba(212, 163, 115, 0.3);
  transform: scale(0.95);
}

/* --- 画布/画架区 --- */
.canvas-frame {
  position: relative;
  width: 100%;
  height: 0;
  padding-bottom: 75%;
  /* 4:3 比例 */
  background: #eae2d8;
  border-radius: 32rpx;
  box-shadow:
    inset 0 10rpx 20rpx rgba(140, 115, 97, 0.1),
    0 2rpx 0 rgba(255, 255, 255, 0.8);
  overflow: hidden;
  margin-bottom: 40rpx;
}

.main-canvas {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

/* 加载动画 */
.loading-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(246, 239, 232, 0.85);
  backdrop-filter: blur(10px);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  z-index: 20;
}

.loader {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid var(--wood-light);
  border-top-color: var(--wood-dark);
  border-radius: 50%;
  animation: spin 1s infinite cubic-bezier(0.68, -0.55, 0.265, 1.55);
}

.loader-text {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: var(--text-sub);
  letter-spacing: 2rpx;
}

@keyframes spin {
  100% {
    transform: rotate(360deg);
  }
}

/* --- 控制面板区 --- */
.control-panel {
  display: flex;
  flex-direction: column;
  gap: 40rpx;
}

/* 药丸模式切换器 */
.mode-switcher {
  position: relative;
  display: flex;
  background: rgba(140, 115, 97, 0.08);
  border-radius: 100rpx;
  padding: 8rpx;
  box-shadow: inset 0 4rpx 10rpx rgba(0, 0, 0, 0.03);
}

.switch-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-sub);
  z-index: 2;
  transition: color 0.3s ease;
}

.switch-item.active {
  color: var(--text-main);
  font-weight: 600;
}

.switch-slider {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  width: calc(50% - 8rpx);
  height: calc(100% - 16rpx);
  background: #ffffff;
  border-radius: 100rpx;
  box-shadow: 0 4rpx 12rpx rgba(140, 115, 97, 0.15);
  z-index: 1;
  transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  /* 带有弹性的滑动 */
}

.switch-slider.slide-right {
  transform: translateX(100%);
}

/* 工具容器渐显动画 */
.tools-container {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
  animation: fadeIn 0.4s ease-out;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(10rpx);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 快捷操作区 (气泡按钮) */
.quick-actions {
  display: flex;
  justify-content: space-around;
}

.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  transition: transform 0.2s ease;
}

.action-btn:active {
  transform: translateY(4rpx) scale(0.95);
}

.icon-circle {
  width: 90rpx;
  height: 90rpx;
  background: #ffffff;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 36rpx;
  box-shadow: 0 8rpx 20rpx rgba(140, 115, 97, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.9);
}

.action-btn text {
  font-size: 24rpx;
  color: var(--text-main);
  font-weight: 500;
}

/* 滑块区域 */
.slider-box {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.5);
  padding: 10rpx 30rpx;
  border-radius: 40rpx;
  box-shadow: inset 0 2rpx 8rpx rgba(0, 0, 0, 0.02);
}

.slider-label {
  font-size: 26rpx;
  color: var(--text-sub);
  min-width: 120rpx;
}

.custom-slider {
  flex: 1;
  margin: 0 20rpx;
}

.slider-value {
  font-size: 26rpx;
  color: var(--text-main);
  font-weight: 600;
  width: 60rpx;
  text-align: right;
}

/* 主操作按钮 */
.primary-btn {
  width: 100% !important;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
  background: linear-gradient(135deg, #d4a373 0%, #bc8a5f 100%);
  box-shadow: 0 12rpx 30rpx -8rpx rgba(188, 138, 95, 0.6);
  border: none;
  margin-top: 10rpx;
  transition: all 0.2s ease;
}

.primary-btn:active {
  transform: translateY(4rpx);
  box-shadow: 0 4rpx 10rpx -4rpx rgba(188, 138, 95, 0.6);
  opacity: 0.9;
}