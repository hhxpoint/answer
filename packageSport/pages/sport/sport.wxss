page {
  height: 100%;
  box-sizing: border-box;
}

.page {
  height: 100%;
  display: flex;
  flex-direction: column;
  background: #080810;
  overflow: hidden;
}

/* 地图区域 */
.map-container {
  position: relative;
  height: 42vh;
  min-height: 320rpx;
}

.sport-map {
  width: 100%;
  height: 100%;
}

.map-mask {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 160rpx;
  background: linear-gradient(transparent, #080810);
  pointer-events: none;
}

/* 顶部导航 */
.header {
  position: absolute;
  top: 100rpx;
  left: 36rpx;
  right: 36rpx;
  z-index: 10;
}

.header-left {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  background: rgba(8,8,16,0.55);
  backdrop-filter: blur(20px);
  padding: 16rpx 24rpx;
  border-radius: 40rpx;
  border: 1rpx solid rgba(255,255,255,0.05);
}

.brand-icon {
  font-size: 30rpx;
}

.brand-name {
  font-size: 26rpx;
  color: #fff;
  font-weight: 600;
  letter-spacing: 1rpx;
}

/* 运行指示器 */
.running-indicator {
  position: absolute;
  top: 185rpx;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: linear-gradient(135deg, #6366f1, #8b5cf6);
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
  z-index: 10;
  box-shadow: 0 6rpx 20rpx rgba(99,102,241,0.25);
}

.pulse-dot {
  width: 14rpx;
  height: 14rpx;
  background: #fff;
  border-radius: 50%;
  animation: pulse 1.5s ease infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.4; transform: scale(0.7); }
}

.indicator-text {
  font-size: 22rpx;
  color: #fff;
  font-weight: 500;
}

/* 主数据面板 */
.data-panel {
  flex: 1;
  background: linear-gradient(180deg, #0e0e1a 0%, #080810 100%);
  border-radius: 44rpx 44rpx 0 0;
  margin-top: -44rpx;
  padding: 0 32rpx 40rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow-y: auto;
}

.panel-handle {
  width: 44rpx;
  height: 5rpx;
  background: rgba(255,255,255,0.1);
  border-radius: 3rpx;
  margin: 18rpx auto 24rpx;
}

/* 运动类型显示（运动中） */
.type-running {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.type-running-badge {
  width: 44rpx;
  height: 44rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.type-running-badge.RUN {
  background: linear-gradient(135deg, #6366f1, #8b5cf6);
}

.type-running-badge.WALK {
  background: linear-gradient(135deg, #10b981, #06b6d4);
}

.type-running-badge.CYCLE {
  background: linear-gradient(135deg, #f59e0b, #ef4444);
}

.type-running-icon {
  font-size: 24rpx;
}

.type-running-name {
  font-size: 26rpx;
  color: rgba(255,255,255,0.6);
  font-weight: 500;
}

/* 核心数据 */
.core-data {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 28rpx;
  padding: 12rpx 0;
}

.distance-display {
  display: flex;
  align-items: flex-end;
  gap: 6rpx;
  margin-bottom: 16rpx;
}

.distance-value {
  font-size: 116rpx;
  color: #fff;
  font-weight: 200;
  line-height: 1;
  letter-spacing: -3rpx;
}

.distance-unit {
  font-size: 28rpx;
  color: rgba(255,255,255,0.35);
  margin-bottom: 12rpx;
}

.distance-bar {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.bar-track {
  width: 75%;
  height: 5rpx;
  background: rgba(255,255,255,0.05);
  border-radius: 3rpx;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #6366f1, #8b5cf6, #a855f7);
  border-radius: 3rpx;
  transition: width 0.3s ease;
}

.distance-label {
  font-size: 20rpx;
  color: rgba(255,255,255,0.25);
}

/* 数据网格 */
.data-grid {
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: rgba(255,255,255,0.015);
  border-radius: 24rpx;
  padding: 24rpx 12rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid rgba(255,255,255,0.025);
}

.grid-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
  justify-content: center;
}

.grid-icon-wrap {
  width: 52rpx;
  height: 52rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.grid-icon-wrap.time {
  background: linear-gradient(135deg, rgba(99,102,241,0.12), rgba(139,92,246,0.12));
}

.grid-icon-wrap.pace {
  background: linear-gradient(135deg, rgba(16,185,129,0.12), rgba(6,182,212,0.12));
}

.grid-icon-wrap.cal {
  background: linear-gradient(135deg, rgba(245,158,11,0.12), rgba(239,68,68,0.12));
}

.grid-icon {
  font-size: 24rpx;
}

.grid-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.grid-value {
  font-size: 30rpx;
  color: #fff;
  font-weight: 600;
}

.grid-label {
  font-size: 20rpx;
  color: rgba(255,255,255,0.3);
}

.grid-divider {
  width: 1rpx;
  height: 44rpx;
  background: rgba(255,255,255,0.04);
}

/* 实时数据 */
.realtime-data {
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding: 20rpx 0;
  margin-bottom: 16rpx;
  background: rgba(255,255,255,0.015);
  border-radius: 20rpx;
  border: 1rpx solid rgba(255,255,255,0.025);
}

.realtime-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  flex: 1;
}

.realtime-value {
  font-size: 28rpx;
  color: #8b5cf6;
  font-weight: 600;
}

.realtime-label {
  font-size: 20rpx;
  color: rgba(255,255,255,0.3);
}

.realtime-divider {
  width: 1rpx;
  height: 40rpx;
  background: rgba(255,255,255,0.04);
}

/* 操作按钮 */
.action-area {
  display: flex;
  justify-content: center;
  padding: 16rpx 0;
}

/* 暂停/继续 按钮 */
.running-btns {
  display: flex;
  align-items: center;
  gap: 56rpx;
}

.pause-btn {
  width: 140rpx;
  height: 140rpx;
  background: linear-gradient(135deg, #f59e0b, #ef4444);
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 40rpx rgba(245,158,11,0.25);
  transition: all 0.3s ease;
}

.pause-btn:active {
  transform: scale(0.95);
}

.pause-icon {
  font-size: 44rpx;
  color: #fff;
}

.pause-text {
  font-size: 22rpx;
  color: rgba(255,255,255,0.85);
  margin-top: 4rpx;
}

.stop-btn {
  width: 92rpx;
  height: 92rpx;
  background: rgba(255,255,255,0.05);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(255,255,255,0.08);
}

.stop-icon {
  font-size: 30rpx;
  color: rgba(255,255,255,0.55);
}

/* 准备状态内容 */
.ready-content {
  display: flex;
  flex-direction: column;
  flex: 1;
}

/* 运动类型选择 */
.type-bar {
  display: flex;
  justify-content: center;
  gap: 40rpx;
  margin-bottom: 36rpx;
}

.type-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 8rpx;
  transition: all 0.3s ease;
}

.type-item.active {
  transform: scale(1.05);
}

.type-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
}

.type-icon-wrap.run {
  background: linear-gradient(135deg, rgba(99,102,241,0.12), rgba(139,92,246,0.12));
}

.type-icon-wrap.walk {
  background: linear-gradient(135deg, rgba(16,185,129,0.12), rgba(6,182,212,0.12));
}

.type-icon-wrap.cycle {
  background: linear-gradient(135deg, rgba(245,158,11,0.12), rgba(239,68,68,0.12));
}

.type-item.active .type-icon-wrap.run {
  background: linear-gradient(135deg, rgba(99,102,241,0.2), rgba(139,92,246,0.2));
  border-color: rgba(99,102,241,0.35);
  box-shadow: 0 6rpx 20rpx rgba(99,102,241,0.15);
}

.type-item.active .type-icon-wrap.walk {
  background: linear-gradient(135deg, rgba(16,185,129,0.2), rgba(6,182,212,0.2));
  border-color: rgba(16,185,129,0.35);
  box-shadow: 0 6rpx 20rpx rgba(16,185,129,0.15);
}

.type-item.active .type-icon-wrap.cycle {
  background: linear-gradient(135deg, rgba(245,158,11,0.2), rgba(239,68,68,0.2));
  border-color: rgba(245,158,11,0.35);
  box-shadow: 0 6rpx 20rpx rgba(245,158,11,0.15);
}

.type-emoji {
  font-size: 40rpx;
}

.type-text {
  font-size: 22rpx;
  color: rgba(255,255,255,0.4);
  font-weight: 500;
}

.type-item.active .type-text {
  color: #fff;
}

/* 开始按钮 */
.start-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  position: relative;
  margin-bottom: 36rpx;
}

.start-btn-ring {
  position: absolute;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(99,102,241,0.15);
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  animation: ring-pulse 2s ease infinite;
}

@keyframes ring-pulse {
  0%, 100% { transform: translateX(-50%) scale(1); opacity: 1; }
  50% { transform: translateX(-50%) scale(1.12); opacity: 0; }
}

.start-btn-inner {
  width: 136rpx;
  height: 136rpx;
  background: linear-gradient(135deg, #6366f1, #8b5cf6, #a855f7);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 14rpx 44rpx rgba(99,102,241,0.3);
  transition: all 0.3s ease;
  position: relative;
  z-index: 1;
}

.start-btn-inner:active {
  transform: scale(0.95);
}

.start-icon {
  font-size: 48rpx;
  color: #fff;
  margin-left: 6rpx;
}

.start-text {
  font-size: 24rpx;
  color: rgba(255,255,255,0.4);
  letter-spacing: 2rpx;
}

/* 今日概览 */
.today-overview {
  background: rgba(255,255,255,0.015);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(255,255,255,0.025);
}

.today-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.today-title {
  font-size: 26rpx;
  color: #fff;
  font-weight: 600;
}

.today-date {
  font-size: 22rpx;
  color: rgba(255,255,255,0.28);
}

.today-stats {
  display: flex;
  justify-content: space-around;
  align-items: center;
}

.today-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.stat-num {
  font-size: 32rpx;
  color: #fff;
  font-weight: 600;
  margin-bottom: 6rpx;
}

.stat-name {
  font-size: 20rpx;
  color: rgba(255,255,255,0.3);
}

.stat-sep {
  width: 1rpx;
  height: 36rpx;
  background: rgba(255,255,255,0.04);
}

/* 底部导航 */
.bottom-nav {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 20rpx 0;
  margin-top: auto;
}

.nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  flex: 1;
  padding: 10rpx 0;
}

.nav-item:active {
  opacity: 0.7;
}

.nav-icon-wrap {
  width: 56rpx;
  height: 56rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-icon-wrap.history {
  background: linear-gradient(135deg, rgba(99,102,241,0.12), rgba(139,92,246,0.12));
}

.nav-icon-wrap.goal {
  background: linear-gradient(135deg, rgba(16,185,129,0.12), rgba(6,182,212,0.12));
}

.nav-icon-wrap.achieve {
  background: linear-gradient(135deg, rgba(245,158,11,0.12), rgba(239,68,68,0.12));
}

.nav-icon {
  font-size: 26rpx;
}

.nav-text {
  font-size: 20rpx;
  color: rgba(255,255,255,0.4);
}

/* 目标设置弹窗 */
.goal-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  animation: fadeIn 0.25s ease;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  backdrop-filter: blur(8px);
}

.modal-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(180deg, #141420, #0e0e1a);
  border-radius: 40rpx 40rpx 0 0;
  padding: 24rpx 36rpx 60rpx;
  animation: slideUp 0.3s ease;
}

.modal-handle {
  width: 44rpx;
  height: 5rpx;
  background: rgba(255,255,255,0.1);
  border-radius: 3rpx;
  margin: 0 auto 28rpx;
}

.modal-title {
  font-size: 30rpx;
  color: #fff;
  font-weight: 600;
  text-align: center;
  margin-bottom: 36rpx;
  display: block;
}

.goal-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  justify-content: center;
}

.goal-option {
  width: calc(33.33% - 12rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 28rpx 20rpx;
  background: rgba(255,255,255,0.02);
  border-radius: 20rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.goal-option.active {
  background: linear-gradient(135deg, rgba(99,102,241,0.15), rgba(139,92,246,0.15));
  border-color: rgba(99,102,241,0.4);
}

.goal-option:active {
  transform: scale(0.95);
}

.goal-value {
  font-size: 36rpx;
  color: #fff;
  font-weight: 600;
}

.goal-unit {
  font-size: 20rpx;
  color: rgba(255,255,255,0.35);
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes slideUp {
  from { opacity: 0; transform: translateY(100%); }
  to { opacity: 1; transform: translateY(0); }
}
