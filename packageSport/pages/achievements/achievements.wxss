page {
  min-height: 100%;
  background: #080810;
}

.page {
  min-height: 100%;
  padding-bottom: 60rpx;
}

/* 顶部导航 */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 140rpx 32rpx 32rpx;
}

.back-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255,255,255,0.04);
  border-radius: 50%;
  border: 1rpx solid rgba(255,255,255,0.06);
}

.back-icon {
  font-size: 30rpx;
  color: #fff;
}

.header-title {
  font-size: 32rpx;
  color: #fff;
  font-weight: 600;
}

.header-placeholder {
  width: 60rpx;
}

/* 成就统计卡片 */
.stats-card {
  margin: 0 32rpx 28rpx;
  padding: 32rpx 24rpx;
  background: linear-gradient(135deg, #f59e0b, #ef4444);
  border-radius: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  overflow: hidden;
  transform: translateY(15rpx);
    /* 正值向下移，负值向上移 */
}

.stats-card::before {
  content: '';
  position: absolute;
  top: -50rpx;
  right: -50rpx;
  width: 160rpx;
  height: 160rpx;
  background: rgba(255,255,255,0.08);
  border-radius: 50%;
}

.trophy-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.stats-info {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
  margin-bottom: 8rpx;
}

.stats-num {
  font-size: 48rpx;
  color: #fff;
  font-weight: 700;
}

.stats-sep {
  font-size: 28rpx;
  color: rgba(255,255,255,0.6);
}

.stats-total {
  font-size: 28rpx;
  color: rgba(255,255,255,0.6);
}

.stats-label {
  font-size: 22rpx;
  color: rgba(255,255,255,0.7);
  margin-bottom: 16rpx;
}

.stats-card .progress-bar {
  width: 55%;
  height: 6rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 3rpx;
  overflow: hidden;
}

.stats-card .progress-fill {
  height: 100%;
  background: #fff;
  border-radius: 3rpx;
}

/* 分类标签 */
.category-scroll {
  margin-bottom: 24rpx;
}

.category-list {
  display: inline-flex;
  gap: 14rpx;
  padding: 0 32rpx;
}

.category-item {
  padding: 16rpx 28rpx;
  background: rgba(255,255,255,0.04);
  border-radius: 26rpx;
  font-size: 24rpx;
  color: rgba(255,255,255,0.45);
  border: 1rpx solid rgba(255,255,255,0.06);
  white-space: nowrap;
}

.category-item.active {
  background: linear-gradient(135deg, rgba(99,102,241,0.2), rgba(139,92,246,0.2));
  color: #fff;
  border-color: rgba(99,102,241,0.3);
}

/* 成就列表 */
.achievement-list {
  padding: 0 32rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.achievement-item {
  display: flex;
  align-items: center;
  padding: 26rpx 22rpx;
  background: linear-gradient(135deg, rgba(255,255,255,0.03), rgba(255,255,255,0.015));
  border-radius: 24rpx;
  border: 1rpx solid rgba(255,255,255,0.05);
}

.achievement-item.locked {
  opacity: 0.55;
}

/* 左侧图标 */
.achievement-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  background: rgba(255,255,255,0.04);
  margin-right: 20rpx;
  flex-shrink: 0;
  position: relative;
}

.achievement-icon.active {
  background: linear-gradient(135deg, rgba(245,158,11,0.18), rgba(239,68,68,0.18));
  box-shadow: 0 6rpx 16rpx rgba(245,158,11,0.2);
}

/* 中间信息 */
.achievement-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-right: 16rpx;
}

.info-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.achievement-name {
  font-size: 28rpx;
  color: #fff;
  font-weight: 500;
  flex: 1;
}

.achievement-desc {
  font-size: 22rpx;
  color: rgba(255,255,255,0.35);
}

/* 百分比显示 */
.progress-percent {
  font-size: 28rpx;
  color: #8b5cf6;
  font-weight: 700;
  flex-shrink: 0;
}

.progress-percent.done {
  color: #10b981;
  font-size: 22rpx;
}

/* 进度条 */
.achievement-progress {
  margin-top: 4rpx;
}

.progress-track {
  width: 100%;
  height: 8rpx;
  background: rgba(255,255,255,0.06);
  border-radius: 4rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #6366f1, #8b5cf6);
  border-radius: 4rpx;
  transition: width 0.5s ease;
}

.progress-fill.done {
  background: linear-gradient(90deg, #10b981, #06b6d4);
}
