page {
  min-height: 100%;
  background: #080810;
}

.page {
  min-height: 100%;
  display: flex;
  flex-direction: column;
}

/* 未找到 */
.not-found {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 60rpx;
}

.not-found-icon-wrap {
  width: 120rpx;
  height: 120rpx;
  background: linear-gradient(135deg, rgba(99,102,241,0.1), rgba(139,92,246,0.1));
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
  border: 1rpx solid rgba(99,102,241,0.15);
}

.not-found-icon {
  font-size: 52rpx;
}

.not-found-text {
  font-size: 30rpx;
  color: rgba(255,255,255,0.6);
  margin-bottom: 36rpx;
}

.not-found-btn {
  padding: 20rpx 48rpx;
  background: linear-gradient(135deg, #6366f1, #8b5cf6);
  border-radius: 30rpx;
  color: #fff;
  font-size: 28rpx;
}

/* 顶部导航 */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 140rpx 32rpx 24rpx;
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 10;
}

.back-btn, .share-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(8,8,16,0.55);
  backdrop-filter: blur(20px);
  border-radius: 50%;
  border: 1rpx solid rgba(255,255,255,0.08);
}

.back-icon, .share-icon {
  font-size: 30rpx;
  color: #fff;
}

.header-title {
  font-size: 32rpx;
  color: #fff;
  font-weight: 600;
}

/* 地图区域 */
.map-container {
  position: relative;
  height: 36vh;
  min-height: 280rpx;
}

.detail-map {
  width: 100%;
  height: 100%;
}

.map-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  background: linear-gradient(transparent, #080810);
  pointer-events: none;
}

/* 数据卡片 */
.data-card {
  flex: 1;
  background: linear-gradient(180deg, #0e0e1a, #080810);
  border-radius: 44rpx 44rpx 0 0;
  margin-top: -44rpx;
  padding: 32rpx;
  box-sizing: border-box;
}

/* 头部信息 */
.card-header {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
  transform: translateY(25rpx);
    /* 正值向下移，负值向上移 */
}

.header-left {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.sport-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 15rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.2);
  transform: translateY(20rpx);
    /* 正值向下移，负值向上移 */
}

.sport-icon.RUN {
  background: linear-gradient(135deg, #6366f1, #8b5cf6);
}

.sport-icon.WALK {
  background: linear-gradient(135deg, #10b981, #06b6d4);
}

.sport-icon.CYCLE {
  background: linear-gradient(135deg, #f59e0b, #ef4444);
}

.header-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.sport-type {
  font-size: 30rpx;
  color: #fff;
  font-weight: 600;
  transform: translateY(20rpx);
    /* 正值向下移，负值向上移 */
}

.sport-date {
  font-size: 22rpx;
  color: rgba(255,255,255,0.3);
  transform: translateY(20rpx);
    /* 正值向下移，负值向上移 */
}

/* 核心数据 */
.core-stats {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 36rpx;
}

.core-distance {
  display: flex;
  align-items: flex-end;
  gap: 8rpx;
}

.distance-value {
  font-size: 100rpx;
  color: #fff;
  font-weight: 200;
  line-height: 1;
  letter-spacing: -3rpx;
}

.distance-unit {
  font-size: 30rpx;
  color: rgba(255,255,255,0.4);
  margin-bottom: 14rpx;
}

/* 数据网格 */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
  margin-bottom: 32rpx;
}

.stat-item {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, rgba(255,255,255,0.02), rgba(255,255,255,0.01));
  border-radius: 20rpx;
  border: 1rpx solid rgba(255,255,255,0.03);
}

.stat-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

.stat-icon.time {
  background: linear-gradient(135deg, rgba(99,102,241,0.15), rgba(139,92,246,0.15));
}

.stat-icon.pace {
  background: linear-gradient(135deg, rgba(16,185,129,0.15), rgba(6,182,212,0.15));
}

.stat-icon.cal {
  background: linear-gradient(135deg, rgba(245,158,11,0.15), rgba(239,68,68,0.15));
}

.stat-icon.point {
  background: linear-gradient(135deg, rgba(236,72,153,0.15), rgba(244,114,182,0.15));
}

.stat-content {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.stat-value {
  font-size: 30rpx;
  color: #fff;
  font-weight: 600;
}

.stat-label {
  font-size: 20rpx;
  color: rgba(255,255,255,0.3);
}

/* 底部 */
.card-footer {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(255,255,255,0.04);
}

.footer-icon {
  font-size: 22rpx;
}

.footer-text {
  font-size: 22rpx;
  color: rgba(255,255,255,0.2);
}
