page {
  min-height: 100%;
  background: #080810;
}

.page {
  min-height: 100%;
  padding-bottom: 60rpx;
}

/* 顶部导航 */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 140rpx 32rpx 32rpx;
}

.back-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255,255,255,0.04);
  border-radius: 50%;
  border: 1rpx solid rgba(255,255,255,0.06);
}

.back-icon {
  font-size: 30rpx;
  color: #fff;
}

.header-title {
  font-size: 32rpx;
  color: #fff;
  font-weight: 600;
}

.header-placeholder {
  width: 60rpx;
}

/* 月度统计卡片 */
.monthly-card {
  margin: 0 32rpx 28rpx;
  padding: 32rpx 24rpx;
  background: linear-gradient(135deg, #6366f1, #8b5cf6);
  border-radius: 28rpx;
  position: relative;
  overflow: hidden;
  transform: translateY(17rpx);
    /* 正值向下移，负值向上移 */
}

.monthly-card::before {
  content: '';
  position: absolute;
  top: -50rpx;
  right: -50rpx;
  width: 160rpx;
  height: 160rpx;
  background: rgba(255,255,255,0.08);
  border-radius: 50%;
}

.monthly-card::after {
  content: '';
  position: absolute;
  bottom: -30rpx;
  left: -30rpx;
  width: 100rpx;
  height: 100rpx;
  background: rgba(255,255,255,0.06);
  border-radius: 50%;
}

.monthly-grid {
  display: flex;
  align-items: center;
  justify-content: space-around;
  position: relative;
  z-index: 1;
}

.monthly-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  gap: 8rpx;
}

.monthly-value {
  font-size: 42rpx;
  color: #fff;
  font-weight: 700;
}

.monthly-label {
  font-size: 22rpx;
  color: rgba(255,255,255,0.65);
}

.monthly-divider {
  width: 1rpx;
  height: 40rpx;
  background: rgba(255,255,255,0.18);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon-wrap {
  width: 120rpx;
  height: 120rpx;
  background: linear-gradient(135deg, rgba(99,102,241,0.1), rgba(139,92,246,0.1));
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(99,102,241,0.15);
}

.empty-icon {
  font-size: 52rpx;
}

.empty-text {
  font-size: 28rpx;
  color: rgba(255,255,255,0.5);
  margin-bottom: 10rpx;
}

.empty-hint {
  font-size: 22rpx;
  color: rgba(255,255,255,0.25);
}

/* 历史记录列表 */
.history-list {
  padding: 0 32rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.history-item-wrap {
  position: relative;
  border-radius: 24rpx;
  overflow: hidden;
}

.history-item {
  display: flex;
  align-items: center;
  padding: 26rpx 24rpx;
  background: linear-gradient(135deg, rgba(255,255,255,0.025), rgba(255,255,255,0.015));
  border: 1rpx solid rgba(255,255,255,0.04);
  border-radius: 24rpx;
  position: relative;
  z-index: 1;
}

.history-item:active {
  background: rgba(255,255,255,0.05);
}

.item-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
}

.item-icon {
  width: 60rpx;
  height: 60rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.2);
}

.item-icon.RUN {
  background: linear-gradient(135deg, #6366f1, #8b5cf6);
}

.item-icon.WALK {
  background: linear-gradient(135deg, #10b981, #06b6d4);
}

.item-icon.CYCLE {
  background: linear-gradient(135deg, #f59e0b, #ef4444);
}

.item-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.item-type {
  font-size: 28rpx;
  color: #fff;
  font-weight: 500;
}

.item-date {
  font-size: 20rpx;
  color: rgba(255,255,255,0.3);
}

.item-center {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
  margin-right: 20rpx;
}

.distance-value {
  font-size: 36rpx;
  color: #fff;
  font-weight: 600;
}

.distance-unit {
  font-size: 20rpx;
  color: rgba(255,255,255,0.4);
}

.item-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6rpx;
  min-width: 80rpx;
}

.meta-text {
  font-size: 20rpx;
  color: rgba(255,255,255,0.3);
}

/* 删除按钮 */
.delete-action {
  position: absolute;
  right: 12rpx;
  top: 12rpx;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
  background: rgba(255,255,255,0.03);
  border-radius: 50%;
}

.delete-icon {
  font-size: 26rpx;
  color: rgba(255,255,255,0.2);
  font-weight: 300;
}

.delete-action:active .delete-icon {
  color: #ef4444;
}
