/* pages/hash/hash.wxss */
page {
  background-color: #f4f6f9;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

.container {
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 顶部信息栏 */
.top-bar {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 20rpx;
}

.header {
  display: flex;
  width: 90%;
  justify-content: space-around;
  margin-bottom: 20rpx;
}

.diff-btn {
  padding: 10rpx 40rpx;
  border-radius: 30rpx;
  background: #e0e0e0;
  color: #555;
  font-size: 28rpx;
}

.diff-btn.active {
  background: #4A90E2;
  color: #fff;
  font-weight: bold;
}

/* 计时器样式 */
.timer-box {
  background: #fff;
  padding: 8rpx 30rpx;
  border-radius: 40rpx;
  box-shadow: inset 0 2rpx 6rpx rgba(0, 0, 0, 0.1);
  display: flex;
  align-items: center;
  border: 2rpx solid #ddd;
}

.timer-icon {
  margin-right: 10rpx;
  font-size: 32rpx;
}

.timer-text {
  font-family: monospace;
  font-size: 36rpx;
  color: #333;
  font-weight: bold;
  letter-spacing: 2rpx;
}

/* 数独盘面 */
.board {
  display: grid;
  grid-template-columns: repeat(9, 1fr);
  width: 95vw;
  height: 95vw;
  border: 4rpx solid #333;
  background: #fff;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
}

.cell {
  border-right: 1rpx solid #ccc;
  border-bottom: 1rpx solid #ccc;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 44rpx;
  font-weight: 500;
  color: #333;
}

.cell.border-right {
  border-right: 3rpx solid #333;
}

.cell.border-bottom {
  border-bottom: 3rpx solid #333;
}

.cell.fixed {
  color: #000;
  font-weight: bold;
  background: #fafafa;
}

.cell.user {
  color: #4A90E2;
  font-weight: bold;
}

.cell.ai {
  color: #F5A623;
  font-weight: bold;
  animation: popIn 0.3s ease;
}

/* 错误格子加上明显的动画提醒 */
.cell.error {
  color: #D0021B;
  background: #ffe6e6;
  animation: shake 0.3s;
}

.cell.selected {
  background: #E1F5FE;
  border: 2rpx solid #03A9F4;
  box-sizing: border-box;
}

/* AI讲解框 */
.ai-panel {
  width: 90%;
  margin: 20rpx 0;
  padding: 20rpx;
  background: #fff;
  border-radius: 12rpx;
  border-left: 8rpx solid #F5A623;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  min-height: 100rpx;
}

.ai-title {
  display: block;
  font-size: 26rpx;
  color: #888;
  margin-bottom: 10rpx;
}

.ai-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
  font-weight: bold;
}

/* 自定义键盘 */
.keyboard {
  width: 100%;
  margin-bottom: 30rpx;
}

.key-row {
  display: flex;
  justify-content: center;
  margin-bottom: 15rpx;
}

.key {
  width: 80rpx;
  height: 80rpx;
  background: #fff;
  margin: 0 10rpx;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 0 #ccc;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 40rpx;
  font-weight: bold;
}

.key:active {
  transform: translateY(4rpx);
  box-shadow: none;
}

.btn-clear {
  width: 120rpx;
  font-size: 30rpx;
  color: #D0021B;
}

/* 底部 AI 开关按钮 */
.ai-btn {
  border-radius: 40rpx;
  width: 80%;
  color: #fff;
  font-weight: bold;
  transition: all 0.3s ease;
}

.ai-btn.start {
  background: #F5A623;
  box-shadow: 0 6rpx 12rpx rgba(245, 166, 35, 0.4);
}

.ai-btn.stop {
  background: #D0021B;
  box-shadow: 0 6rpx 12rpx rgba(208, 2, 27, 0.4);
}

@keyframes popIn {
  0% {
    transform: scale(0.5);
    opacity: 0;
  }

  80% {
    transform: scale(1.2);
  }

  100% {
    transform: scale(1);
    opacity: 1;
  }
}

@keyframes shake {

  0%,
  100% {
    transform: translateX(0);
  }

  25% {
    transform: translateX(-5rpx);
  }

  75% {
    transform: translateX(5rpx);
  }
}

/* ====== 仅展示需要【新增】在文件末尾的代码，其余原代码保留 ====== */

/* ✨ 新增：草稿笔记文字的容器 */
.notes-wrap {
  width: 100%;
  height: 100%;
  display: flex;
  flex-wrap: wrap;
  align-content: flex-start;
  padding: 2rpx;
  box-sizing: border-box;
}

/* ✨ 新增：草稿笔记小字体的样式 */
.note-text {
  width: 33.3%;
  /* 每行最多放3个小数字 */
  height: 33.3%;
  font-size: 20rpx;
  /* 小号字体 */
  color: #888;
  /* 灰色表示待选 */
  display: flex;
  justify-content: center;
  align-items: center;
  line-height: 1;
}

/* ✨ 新增：模式切换按钮的特殊样式 */
.mode-btn {
  font-size: 28rpx;
  color: #333;
  width: 120rpx;
  /* 给文字留出空间 */
  transition: all 0.2s;
}

/* ✨ 新增：处于草稿模式时，按钮变色高亮提醒 */
.mode-btn.draft-active {
  background-color: #4A90E2;
  color: #fff;
}