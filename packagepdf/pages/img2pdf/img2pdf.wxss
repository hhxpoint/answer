/* 全局背景色 */
page {
  background-color: #f5f7fa;
  box-sizing: border-box;
}

.page-container {
  padding: 30rpx 30rpx 200rpx 30rpx;
  /* 底部留白给吸底菜单 */
}

/* 顶部引导栏 */
.header-section {
  margin-bottom: 40rpx;
}

.step-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.step-desc {
  font-size: 26rpx;
  color: #888;
}

/* 空状态：虚线框 */
.empty-state {
  margin-top: 40rpx;
  height: 400rpx;
  border: 4rpx dashed #d0d3d8;
  border-radius: 24rpx;
  background-color: #ffffff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
}

.empty-state:active {
  background-color: #f0f2f5;
}

.upload-icon {
  font-size: 80rpx;
  color: #07c160;
  margin-bottom: 20rpx;
}

.upload-text {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.upload-subtext {
  font-size: 24rpx;
  color: #999;
}

/* 九宫格网格布局 */
.image-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24rpx;
}

/* 卡片整体 */
.image-card {
  position: relative;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

/* 缩略图：接近A4比例 */
.img-thumb {
  width: 100%;
  height: 260rpx;
  background-color: #e8e8e8;
}

/* ================= 新增：增强魔棒小按钮 ================= */
.btn-enhance {
  position: absolute;
  top: 10rpx;
  left: 10rpx;
  width: 44rpx;
  height: 44rpx;
  background: rgba(7, 193, 96, 0.85);
  /* 采用你主题的绿色 */
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  z-index: 10;
}

/* 删除小按钮 */
.btn-delete {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 44rpx;
  height: 44rpx;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  z-index: 10;
}

/* 底部排序控制条 */
.control-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 60rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
  padding: 0 10rpx;
}

.ctrl-btn {
  font-size: 28rpx;
  color: #07c160;
  padding: 10rpx;
}

.ctrl-btn.disabled {
  color: #ccc;
}

.page-num {
  font-size: 24rpx;
  color: #666;
  font-weight: bold;
}

/* 继续添加按钮卡片 */
.add-more-card {
  height: 320rpx;
  border: 2rpx dashed #c0c4cc;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #666;
  font-size: 26rpx;
}

.add-more-card:active {
  background-color: #ebeef5;
}

.add-more-icon {
  font-size: 40rpx;
  color: #999;
  margin-bottom: 10rpx;
}

/* 吸底操作栏 */
.bottom-action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #ffffff;
  padding: 20rpx 40rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
}

.info-area {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.count-text {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.clear-text {
  font-size: 28rpx;
  color: #576b95;
}

.btn-submit {
  width: 100% !important;
  height: 88rpx;
  border-radius: 44rpx;
  line-height: 88rpx;
  padding: 0;
  font-size: 32rpx;
  font-weight: bold;
  background-color: #07c160;
}

/* 弹窗样式 (共用) */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: fadeIn 0.2s ease;
}

.modal-box {
  width: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx;
  box-sizing: border-box;
}

.modal-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
  margin-bottom: 40rpx;
}

.input-wrapper {
  display: flex;
  align-items: center;
  background: #f5f7fa;
  border-radius: 12rpx;
  padding: 0 20rpx;
  height: 88rpx;
  margin-bottom: 50rpx;
  border: 2rpx solid #e4e7ed;
}

.modal-input {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

.suffix {
  font-size: 30rpx;
  color: #999;
  margin-left: 10rpx;
}

.modal-footer {
  display: flex;
  justify-content: space-between;
}

.btn-cancel,
.btn-confirm {
  width: 46% !important;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0;
  font-size: 30rpx;
  border-radius: 40rpx;
  margin: 0;
}

.btn-cancel {
  background: #f0f2f5;
  color: #606266;
}

.btn-confirm {
  background: #07c160;
  color: #fff;
  font-weight: bold;
}

/* ================= 新增：扫描增强预览弹窗专用样式 ================= */
.scan-modal {
  padding-bottom: 30rpx;
}

.scan-preview-wrapper {
  width: 100%;
  height: 500rpx;
  background: #f5f7fa;
  border-radius: 12rpx;
  margin-bottom: 40rpx;
  border: 2rpx solid #e4e7ed;
  display: flex;
  justify-content: center;
  align-items: center;
  position: relative;
  overflow: hidden;
}

.scan-preview-img {
  width: 100%;
  height: 100%;
}

.preview-hint {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  background: rgba(0, 0, 0, 0.4);
  color: #fff;
  font-size: 24rpx;
  text-align: center;
  padding: 8rpx 0;
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }

  to {
    opacity: 1;
  }
}