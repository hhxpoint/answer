page {
  background-color: #F5F2EB;
  color: #4A4036;
}

.container {
  display: block;
  min-height: 100vh;
  box-sizing: border-box;
  position: relative;
  padding-top: 0;
}

.top-dashboard {
  background-color: #F5F2EB;
  padding: 20rpx 30rpx 10rpx;
  position: sticky;
  top: 0;
  z-index: 10;
  box-shadow: 0 4rpx 10rpx rgba(245, 242, 235, 0.9);
}

.storage-info {
  background: linear-gradient(135deg, #FDEB71, #F8D800);
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  box-shadow: 0 8rpx 20rpx rgba(248, 216, 0, 0.2);
  border: 2rpx solid rgba(255, 255, 255, 0.6);
  margin-bottom: 20rpx;
}

.storage-text {
  display: flex;
  justify-content: space-between;
  margin-bottom: 10rpx;
  font-size: 26rpx;
  color: #3E2723;
  font-weight: 900;
}

.progress-bar {
  height: 10rpx;
  background: rgba(62, 39, 35, 0.1);
  border-radius: 6rpx;
  margin-bottom: 10rpx;
}

.progress-inner {
  height: 100%;
  border-radius: 6rpx;
  transition: width 0.5s;
}

.storage-estimate {
  font-size: 22rpx;
  color: #5D4037;
  text-align: right;
  font-weight: 500;
}

.highlight {
  color: #D35400;
  font-weight: 900;
  font-size: 26rpx;
}

.calendar-card {
  display: flex;
  background: #FEFCF8;
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
  box-shadow: inset 0 0 0 2rpx #EFEAE1, 0 4rpx 10rpx rgba(141, 123, 104, 0.05);
  align-items: center;
  transition: all 0.2s;
}

.calendar-card:active {
  transform: scale(0.98);
  background: #F8F5EF;
}

.calendar-left {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-right: 24rpx;
  border-right: 2rpx dashed #E2C2A4;
  min-width: 80rpx;
}

.cal-month {
  font-size: 22rpx;
  color: #D35400;
  font-weight: bold;
}

.cal-day {
  font-size: 40rpx;
  font-weight: 900;
  color: #3E2723;
  font-family: Georgia, serif;
}

.calendar-right {
  flex: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-left: 24rpx;
}

.cal-desc-box {
  display: flex;
  align-items: baseline;
}

.cal-desc {
  font-size: 24rpx;
  color: #796A59;
}

.cal-highlight {
  color: #D35400;
  font-weight: bold;
  font-size: 32rpx;
  margin: 0 8rpx;
  font-family: Georgia, serif;
}

.btn-checkin {
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  font-weight: bold;
  color: #FEFCF8;
  background: #3E2723;
  transition: all 0.3s;
  z-index: 2;
}

.btn-checkin.checked {
  background: transparent;
  color: #A69B8D;
  border: 2rpx solid #EFEAE1;
}

.memo-list {
  padding: 10rpx 30rpx 0;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 150rpx;
  opacity: 0.6;
}

.empty-text {
  color: #8D7B68;
  font-size: 28rpx;
  letter-spacing: 4rpx;
  margin-top: 20rpx;
}

.memo-card {
  display: flex;
  background: #FEFCF8;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 16rpx rgba(141, 123, 104, 0.08);
  border: 1px solid #EFEAE1;
  transition: transform 0.2s;
}

.memo-card:active {
  transform: scale(0.97);
  background: #F8F5EF;
}

.card-color-bar {
  width: 14rpx;
  flex-shrink: 0;
}

.card-content {
  padding: 24rpx;
  flex: 1;
  display: flex;
  flex-direction: column;
}

.card-header {
  margin-bottom: 10rpx;
}

.memo-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #3E2723;
  line-height: 1.4;
}

.memo-desc {
  font-size: 26rpx;
  color: #796A59;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: auto;
}

.memo-date {
  font-size: 22rpx;
  color: #A69B8D;
  font-family: monospace;
}

.delete-btn {
  font-size: 22rpx;
  color: #D35400;
  padding: 6rpx 16rpx;
  background: rgba(211, 84, 0, 0.08);
  border-radius: 8rpx;
  font-weight: bold;
}

.bottom-space {
  height: 180rpx;
}

.fab-btn {
  position: fixed;
  right: 40rpx;
  bottom: 80rpx;
  width: 110rpx;
  height: 110rpx;
  background: #3E2723;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0 10rpx 25rpx rgba(62, 39, 35, 0.3);
  z-index: 20;
  border: 4rpx solid #F5F2EB;
}

.fab-icon {
  color: #F8D800;
  font-size: 44rpx;
  font-family: "楷体", "KaiTi", serif;
}

.editor-page {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: #FEFCF8;
  z-index: 100;
  display: flex;
  flex-direction: column;
  transform: translateY(100%);
  transition: transform 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
}

.editor-page.show {
  transform: translateY(0);
}

/* 【修改点】：将 padding 顶部的 100rpx 改为了 30rpx，顶部组件上移 */
.editor-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 40rpx 20rpx;
  background: rgba(254, 252, 248, 0.95);
  backdrop-filter: blur(10px);
  border-bottom: 1px solid #EFEAE1;
  z-index: 101;
}

.btn-cancel {
  font-size: 30rpx;
  color: #8D7B68;
  padding: 10rpx 0;
}

.editor-status {
  font-size: 24rpx;
  color: #C1B4A4;
  font-family: monospace;
}

.btn-save {
  font-size: 30rpx;
  font-weight: bold;
  color: #C1B4A4;
  padding: 12rpx 30rpx;
  border-radius: 30rpx;
  background: #F0ECE3;
  transition: all 0.3s;
}

.btn-save.active {
  color: #3E2723;
  background: #F8D800;
  box-shadow: 0 4rpx 12rpx rgba(248, 216, 0, 0.4);
}

.editor-body {
  flex: 1;
  padding: 40rpx;
  box-sizing: border-box;
  height: 0;
}

.editor-title-input {
  width: 100%;
  height: 80rpx;
  font-size: 44rpx;
  font-weight: bold;
  color: #3E2723;
  margin-bottom: 20rpx;
}

.divider {
  width: 100rpx;
  height: 6rpx;
  background: #EFEAE1;
  border-radius: 3rpx;
  margin-bottom: 40rpx;
}

.editor-textarea {
  width: 100%;
  min-height: 50vh;
  font-size: 32rpx;
  line-height: 1.8;
  color: #4A4036;
}

.keyboard-spacer {
  height: 60vh;
}

.quote-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(62, 39, 35, 0.5);
  z-index: 200;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.4s;
}

.quote-mask.show {
  opacity: 1;
  pointer-events: auto;
}

.quote-modal {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -40%) scale(0.9);
  width: 80%;
  background: #FEFCF8;
  border-radius: 20rpx;
  padding: 60rpx 40rpx;
  box-shadow: 0 20rpx 50rpx rgba(0, 0, 0, 0.2);
  z-index: 201;
  opacity: 0;
  pointer-events: none;
  transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  text-align: center;
  border: 2rpx solid #EFEAE1;
}

.quote-modal.show {
  transform: translate(-50%, -50%) scale(1);
  opacity: 1;
  pointer-events: auto;
}

.quote-content {
  position: relative;
  margin-bottom: 40rpx;
}

.quote-mark {
  font-family: Georgia, serif;
  font-size: 80rpx;
  color: #E2C2A4;
  position: absolute;
  top: -30rpx;
  left: -20rpx;
  opacity: 0.5;
  line-height: 1;
}

.quote-mark.right {
  left: auto;
  right: -20rpx;
  top: auto;
  bottom: -60rpx;
}

.quote-text {
  font-size: 32rpx;
  color: #3E2723;
  line-height: 1.8;
  font-family: "楷体", "KaiTi", serif;
  position: relative;
  z-index: 2;
  font-weight: bold;
}

.quote-footer {
  font-size: 24rpx;
  color: #A69B8D;
  letter-spacing: 4rpx;
}

.calendar-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: #F5F2EB;
  z-index: 150;
  display: flex;
  flex-direction: column;
  transform: translateY(100%);
  transition: transform 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
}

.calendar-modal.show {
  transform: translateY(0);
}

.cal-modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 100rpx 40rpx 30rpx;
  background: #F5F2EB;
  border-bottom: 2rpx dashed #E2C2A4;
}

.cal-modal-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #3E2723;
  font-family: "楷体", "KaiTi", serif;
  letter-spacing: 2rpx;
}

.cal-modal-close {
  font-size: 30rpx;
  color: #D35400;
  padding: 10rpx 0;
  font-weight: bold;
}

.cal-modal-body {
  flex: 1;
  padding: 30rpx;
  height: 0;
  box-sizing: border-box;
}

.month-block {
  background: #FEFCF8;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 15rpx rgba(141, 123, 104, 0.08);
  border: 1px solid #EFEAE1;
}

.month-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #3E2723;
  margin-bottom: 20rpx;
  border-left: 8rpx solid #D35400;
  padding-left: 16rpx;
}

.week-header {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  text-align: center;
  font-size: 24rpx;
  color: #A69B8D;
  margin-bottom: 16rpx;
}

.days-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 10rpx;
}

.day-cell {
  aspect-ratio: 1;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 26rpx;
  color: #796A59;
  border-radius: 8rpx;
  background: rgba(239, 234, 225, 0.3);
  font-family: Georgia, serif;
  position: relative;
}

.day-cell.empty {
  background: transparent;
  border: none;
}

.day-cell.today {
  border: 3rpx solid #D35400;
  color: #D35400;
  font-weight: bold;
  box-sizing: border-box;
}

.day-cell.checked {
  background: #D35400;
  color: #FEFCF8;
  font-weight: bold;
  box-shadow: 0 4rpx 8rpx rgba(211, 84, 0, 0.3);
  border: none;
}

.day-cell.today.checked {
  border: 3rpx solid #F8D800;
}

.day-num {
  z-index: 1;
  position: relative;
}

.check-mark {
  position: absolute;
  bottom: 2rpx;
  right: 6rpx;
  font-size: 20rpx;
  color: #FFFFFF;
  font-weight: 900;
  z-index: 2;
}