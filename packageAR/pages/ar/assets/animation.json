{
  "keyframe": {
    "bounce": {
      "0": { "scale": [0, 0, 0], "rotation.y": 0 },
      "50": { "scale": [1.2, 1.2, 1.2], "rotation.y": 180 },
      "100": { "scale": [1, 1, 1], "rotation.y": 360 }
    },
    "float": {
      "0": { "position.y": 0 },
      "50": { "position.y": 0.05 },
      "100": { "position.y": 0 }
    }
  },
  "animation": {
    "appear": { "keyframe": "bounce", "duration": 0.6, "ease": "ease-out" },
    "idle": { "keyframe": "float", "duration": 2, "ease": "ease-in-out", "loop": -1 }
  }
}