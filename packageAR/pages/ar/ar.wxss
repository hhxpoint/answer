/* packageAR/pages/ar/ar.wxss */
.page { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: #000; }

/* 摄像头：全屏可见 */
.camera-view {
  position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 0;
}

/* 2D Canvas：透明叠加在 camera 上面 */
.overlay-canvas {
  position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 1;
  pointer-events: none;
}

/* 触摸层：透明，在 canvas 上面，捕获点击 */
.touch-layer {
  position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 2;
  pointer-events: auto;
}

/* HUD */
.hud {
  position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 10; pointer-events: none;
}

.top-bar {
  position: absolute; top: 0; left: 0; right: 0;
  padding: calc(env(safe-area-inset-top) + 16rpx) 24rpx;
  display: flex; gap: 12rpx;
  background: linear-gradient(180deg, rgba(0,0,0,0.6) 0%, transparent 100%);
  pointer-events: auto;
}

.pill {
  display: flex; align-items: center; gap: 8rpx;
  background: rgba(15,15,25,0.85); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
  border-radius: 40rpx; padding: 10rpx 22rpx;
  border: 1rpx solid rgba(255,255,255,0.08); transition: all 0.3s;
}
.pill.active { border-color: #22c55e; }
.pill text { font-size: 22rpx; color: rgba(255,255,255,0.85); }
.dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: rgba(255,255,255,0.3); }
.dot.active { background: #22c55e; box-shadow: 0 0 10rpx #22c55e; animation: pulse 2s ease-in-out infinite; }
@keyframes pulse { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:0.6;transform:scale(0.8)} }

.gesture-card {
  position: absolute; top: 30%; left: 50%; transform: translate(-50%,-50%);
  background: linear-gradient(135deg, rgba(99,102,241,0.92), rgba(139,92,246,0.88));
  border-radius: 32rpx; padding: 40rpx 56rpx; text-align: center;
  pointer-events: none; box-shadow: 0 16rpx 48rpx rgba(99,102,241,0.5);
}
.gc-icon { display: block; font-size: 72rpx; margin-bottom: 12rpx; }
.gc-label { font-size: 32rpx; font-weight: 700; color: #fff; }
.gc-hint { display: block; font-size: 20rpx; color: rgba(255,255,255,0.6); margin-top: 16rpx; }

.toast {
  position: absolute; top: 240rpx; left: 50%; transform: translateX(-50%);
  background: rgba(15,15,25,0.92); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
  border-radius: 20rpx; padding: 20rpx 36rpx; max-width: 80%; pointer-events: none;
}
.toast text { font-size: 26rpx; color: rgba(255,255,255,0.9); }

.side-panel {
  position: absolute; right: 20rpx; top: 50%; transform: translateY(-50%);
  display: flex; flex-direction: column; gap: 6rpx;
  background: rgba(15,15,25,0.88); backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px);
  border-radius: 24rpx; padding: 16rpx; pointer-events: auto;
  border: 1rpx solid rgba(255,255,255,0.06);
}
.sp-item { display: flex; align-items: center; gap: 12rpx; padding: 12rpx 16rpx; border-radius: 14rpx; }
.sp-item.on { background: rgba(99,102,241,0.4); }
.sp-item text:first-child { font-size: 32rpx; }
.sp-item text:last-child { font-size: 22rpx; color: rgba(255,255,255,0.8); }

.bottom-bar {
  position: absolute; bottom: 0; left: 0; right: 0;
  padding: 24rpx 40rpx; padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  display: flex; justify-content: space-around; align-items: center;
  background: linear-gradient(0deg, rgba(0,0,0,0.7), transparent);
  pointer-events: auto;
}
.bbtn {
  display: flex; flex-direction: column; align-items: center; gap: 6rpx;
  width: 100rpx; height: 100rpx;
  background: rgba(255,255,255,0.12); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
  border-radius: 24rpx; justify-content: center;
}
.bbtn:active { transform: scale(0.88); }
.bbtn text:first-child { font-size: 36rpx; }
.bbtn text:last-child { font-size: 18rpx; color: rgba(255,255,255,0.8); }
.bbtn.main {
  width: 140rpx; height: 140rpx; border-radius: 50%;
  background: linear-gradient(145deg, #6366f1, #8b5cf6);
  box-shadow: 0 8rpx 32rpx rgba(99,102,241,0.6);
}
.bbtn.main text:first-child { font-size: 44rpx; }
.bbtn.main text:last-child { font-size: 22rpx; color: #fff; font-weight: 600; }

.loading {
  position: fixed; top: 0; left: 0; width: 100%; height: 100%;
  background: #0a0a1a; display: flex; flex-direction: column;
  align-items: center; justify-content: center; z-index: 999;
}
.spinner {
  width: 80rpx; height: 80rpx;
  border: 4rpx solid rgba(99,102,241,0.2); border-top-color: #6366f1;
  border-radius: 50%; animation: spin 1s linear infinite; margin-bottom: 32rpx;
}
@keyframes spin { to { transform: rotate(360deg); } }
.lt { font-size: 28rpx; color: rgba(255,255,255,0.6); }
