@import "../../common.wxss";

.group { margin: 28rpx 40rpx 8rpx; }
.group-head {
  font-size: 22rpx;
  color: #8a8578;
  line-height: 1.6;
  margin-bottom: 12rpx;
  padding-left: 4rpx;
}
.row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 12rpx;
  border-radius: 20rpx;
  background: #fffefb;
  border: 1rpx solid #e6e0d4;
}
.row:active { background: #faf8f3; }
.row .no {
  font-family: "Songti SC", serif;
  font-size: 26rpx;
  font-weight: 600;
  color: #1d2530;
}
.row .tp {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: #fbeee9;
  color: #b5442c;
}
.row .go {
  margin-left: auto;
  font-size: 22rpx;
  color: #2b4a8b;
}
