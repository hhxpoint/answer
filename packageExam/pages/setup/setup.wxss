@import "../../common.wxss";

.setup-card {
  margin: 28rpx 40rpx 0;
  padding: 34rpx 32rpx 36rpx;
  background: #fffefb;
  border: 1rpx solid #e6e0d4;
  border-radius: 28rpx;
  box-shadow: 0 20rpx 50rpx -40rpx rgba(29, 37, 48, 0.5);
}

.avatar-row {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.avatar-btn {
  width: 176rpx;
  height: 176rpx;
  padding: 0;
  margin: 0;
  border-radius: 50%;
  background: #faf8f4;
  border: 2rpx dashed #d9d2c4;
  overflow: hidden;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}
.avatar-btn::after { border: 0; }
.avatar-img { width: 176rpx; height: 176rpx; border-radius: 50%; }
.avatar-empty { display: flex; flex-direction: column; align-items: center; }
.avatar-empty .plus { font-size: 52rpx; color: #b8892f; line-height: 1; }
.avatar-empty .hint { margin-top: 8rpx; font-size: 20rpx; color: #a9a294; }
.avatar-tip { margin-top: 16rpx; font-size: 20rpx; color: #a9a294; }

.field { margin-top: 36rpx; }
.field .label {
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: #8a8578;
  margin-bottom: 12rpx;
}
.field .input {
  height: 92rpx;
  padding: 0 24rpx;
  background: #faf8f4;
  border: 1rpx solid #ece6da;
  border-radius: 20rpx;
  font-size: 30rpx;
  color: #1d2530;
}

.tip {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #b5442c;
}

.save-btn {
  margin-top: 36rpx;
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  border-radius: 22rpx;
  background: #2b4a8b;
  color: #fff;
  font-size: 30rpx;
  letter-spacing: 2rpx;
}
.save-btn.disabled { opacity: 0.6; }

.skip-link {
  margin-top: 22rpx;
  text-align: center;
  font-size: 22rpx;
  color: #8a8578;
  text-decoration: underline;
  text-underline-offset: 6rpx;
}
