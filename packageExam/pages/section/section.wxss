@import "../../common.wxss";

.type-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin: 24rpx 40rpx 8rpx;
}
.type-card {
  padding: 26rpx 24rpx 22rpx;
  border-radius: 24rpx;
  background: #fffefb;
  border: 1rpx solid #e6e0d4;
  box-shadow: 0 10rpx 30rpx -26rpx rgba(29, 37, 48, 0.45);
}
.type-card:active { transform: scale(0.98); }
.type-name {
  font-family: "Songti SC", serif;
  font-size: 30rpx;
  font-weight: 700;
  color: #1d2530;
}
.type-desc {
  margin-top: 10rpx;
  font-size: 20rpx;
  line-height: 1.6;
  color: #8a8578;
  min-height: 64rpx;
}
.type-count {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #2b4a8b;
}
