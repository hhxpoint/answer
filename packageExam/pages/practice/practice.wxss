@import "../../common.wxss";

.practice {
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

/* 顶部进度 */
.pbar {
  position: sticky;
  top: 0;
  z-index: 9;
  background: rgba(246, 244, 239, 0.96);
  padding: 18rpx 40rpx 14rpx;
  border-bottom: 1rpx solid #ece6da;
}
.pbar-line {
  height: 4rpx;
  border-radius: 4rpx;
  background: #e8e2d6;
  overflow: hidden;
}
.pbar-fill {
  height: 100%;
  background: linear-gradient(90deg, #2b4a8b, #4d6cab);
  border-radius: 4rpx;
  transition: width .25s ease;
}
.pbar-info {
  margin-top: 10rpx;
  font-size: 20rpx;
  color: #a9a294;
  letter-spacing: 1rpx;
}
.pbar-info .cur {
  font-family: "Songti SC", serif;
  font-size: 26rpx;
  color: #2b4a8b;
  font-weight: 700;
}
.pbar-info .sep { margin: 0 4rpx; }
.pbar-info .ok { margin-left: 20rpx; color: #8a8578; }

/* 题目卡 */
.qcard {
  margin: 24rpx 32rpx 0;
  padding: 32rpx 32rpx 36rpx;
  background: #fffefb;
  border: 1rpx solid #e6e0d4;
  border-radius: 28rpx;
  box-shadow: 0 1rpx 0 rgba(29, 37, 48, 0.02), 0 20rpx 50rpx -40rpx rgba(29, 37, 48, 0.5);
}
.qhead {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 22rpx;
}
.qno {
  font-family: "Songti SC", "STSong", serif;
  font-size: 30rpx;
  font-weight: 700;
  color: #2b4a8b;
}
.chip {
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: #eef1f8;
  color: #2b4a8b;
}
.chip.gold { background: #fbf4e3; color: #b8892f; }

/* 材料 */
.mat {
  border: 1rpx dashed #ddd5c4;
  border-radius: 20rpx;
  background: #fbf9f3;
  padding: 22rpx 24rpx;
  margin-bottom: 24rpx;
}
.mat-cap {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 20rpx;
  letter-spacing: 3rpx;
  color: #b8892f;
  margin-bottom: 12rpx;
}
.mat-cap .toggle {
  color: #2b4a8b;
  letter-spacing: 0;
  font-size: 20rpx;
}
.mat-body { font-size: 27rpx; line-height: 1.85; color: #4a5568; }

/* 图文块 */
.stem { font-size: 31rpx; line-height: 1.88; color: #1d2530; }
.blk { margin-bottom: 8rpx; }
.qimg {
  display: block;
  max-width: 100%;
  margin: 18rpx auto;
  border: 1rpx solid #eee8dc;
  border-radius: 12rpx;
  background: #fff;
  padding: 6rpx;
  box-sizing: border-box;
}
.qimg.tex {
  display: inline-block;
  max-height: 44rpx;
  width: auto;
  margin: 0 2rpx;
  padding: 0;
  border: 0;
  vertical-align: -6rpx;
}

/* 选项 */
.opts {
  margin-top: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}
.opt {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid #e6e0d4;
  border-radius: 22rpx;
  background: #fff;
  transition: background .15s, border-color .15s;
}
.opt:active { background: #faf8f3; }
.opt .k {
  flex: 0 0 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  border-radius: 50%;
  border: 1rpx solid #e0d9cb;
  font-size: 22rpx;
  font-weight: 600;
  color: #6b6558;
  background: #faf8f4;
}
.opt .v { flex: 1; min-width: 0; font-size: 29rpx; line-height: 1.7; color: #2b3038; }
.opt .see { color: #a9a294; font-size: 26rpx; }

.opt.pick {
  border-color: #b9c6e2;
  background: #eef1f8;
}
.opt.pick .k { background: #2b4a8b; border-color: #2b4a8b; color: #fff; }

.opt.ok {
  border-color: #e8c9c0;
  background: #fbeee9;
}
.opt.ok .k { background: #b5442c; border-color: #b5442c; color: #fff; }

.opt.bad {
  border-color: #e0b7ae;
  border-style: dashed;
  background: #fffdfc;
}
.opt.bad .k { background: #f3e3de; border-color: #e0b7ae; color: #b5442c; }

/* 答案与解析 */
.ans {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx dashed #e6e0d4;
}
.ans-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}
.ans-row .lab { font-size: 22rpx; color: #8a8578; letter-spacing: 2rpx; }
.ans-row .val {
  font-family: "Songti SC", serif;
  font-size: 34rpx;
  font-weight: 700;
  color: #b5442c;
}
.ans-row .res {
  margin-left: auto;
  font-size: 21rpx;
  padding: 3rpx 14rpx;
  border-radius: 999rpx;
}
.ans-row .res.right { background: #e8f0e8; color: #4a7a4a; }
.ans-row .res.wrong { background: #fbeee9; color: #b5442c; }

.analysis { margin-top: 12rpx; font-size: 27rpx; line-height: 1.85; color: #4a5568; }
.ana-cap {
  font-size: 20rpx;
  letter-spacing: 3rpx;
  color: #b8892f;
  margin-bottom: 10rpx;
}
.no-ana { color: #a9a294; }

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 16rpx;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 254, 251, 0.97);
  border-top: 1rpx solid #ece6da;
  backdrop-filter: blur(10rpx);
}
.bbtn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 20rpx;
  border: 1rpx solid #e0d9cb;
  background: #fff;
  font-size: 26rpx;
  color: #4a5568;
}
.bbtn:active { background: #f6f4ef; }
.bbtn.mid { flex: 1.2; }
.bbtn.mid .mid-n {
  font-family: "Songti SC", serif;
  font-size: 30rpx;
  font-weight: 700;
  color: #2b4a8b;
}
.bbtn.mid .mid-d { font-size: 22rpx; color: #8a8578; }
.bbtn.primary {
  background: #2b4a8b;
  border-color: #2b4a8b;
  color: #fff;
}
.bbtn.primary:active { background: #24407a; }
