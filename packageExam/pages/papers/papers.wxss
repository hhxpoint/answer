@import "../../common.wxss";

.year-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 40rpx 40rpx 16rpx;
}
.year-head .year {
  font-family: "Songti SC", serif;
  font-size: 36rpx;
  font-weight: 700;
  color: #2b4a8b;
  letter-spacing: 1rpx;
}
.year-head .line {
  flex: 1;
  height: 1rpx;
  background: #e6e0d4;
}
.year-head .count {
  font-size: 20rpx;
  color: #a9a294;
}

.paper-card {
  display: flex;
  align-items: center;
  margin: 0 40rpx 16rpx;
  padding: 28rpx 30rpx;
  border-radius: 28rpx;
  background: #fffefb;
  border: 1rpx solid #e6e0d4;
  box-shadow: 0 10rpx 30rpx -24rpx rgba(29, 37, 48, 0.45);
}
.paper-card:active { transform: scale(0.988); }

.paper-main { flex: 1; min-width: 0; }
.paper-title {
  font-size: 28rpx;
  line-height: 1.5;
  color: #1d2530;
  font-weight: 500;
}
.paper-meta {
  margin-top: 10rpx;
  font-size: 21rpx;
  color: #a9a294;
}
.paper-meta .done { color: #2b4a8b; margin-left: 18rpx; }
.paper-meta .fresh { color: #b8892f; margin-left: 18rpx; }
.paper-go {
  flex-shrink: 0;
  margin-left: 20rpx;
  font-size: 22rpx;
  color: #2b4a8b;
}
