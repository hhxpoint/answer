/* 公考题库 · 设计令牌与共用样式
   基调：纸感米色 + 墨色文字 + 靛蓝主色 + 朱砂批注色 */
page {
  --paper: #f6f4ef;
  --card: #fffefb;
  --ink: #1d2530;
  --ink2: #4a5568;
  --ink3: #8a8578;
  --line: #e6e0d4;
  --indigo: #2b4a8b;
  --indigo-soft: #eef1f8;
  --vermilion: #b5442c;
  --vermilion-soft: #fbeee9;
  --gold: #b8892f;
  background: #f6f4ef;
  color: #1d2530;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
}

.ex-page {
  min-height: 100vh;
  padding-bottom: 60rpx;
}

/* 顶部标题区 */
.ex-hero {
  padding: 40rpx 40rpx 8rpx;
}
.ex-hero .eyebrow {
  font-size: 20rpx;
  letter-spacing: 6rpx;
  color: #8a8578;
}
.ex-hero .title {
  margin-top: 12rpx;
  font-family: "Songti SC", "STSong", serif;
  font-size: 64rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: #1d2530;
}
.ex-hero .title-it {
  color: #2b4a8b;
  font-style: italic;
}
.ex-hero .sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #8a8578;
  letter-spacing: 1rpx;
}

/* 统计条 */
.stat-row {
  display: flex;
  margin: 28rpx 40rpx 8rpx;
  border-radius: 28rpx;
  background: #fffefb;
  border: 1rpx solid #e6e0d4;
  overflow: hidden;
}
.stat-row .stat {
  flex: 1;
  padding: 24rpx 0;
  text-align: center;
}
.stat-row .stat + .stat {
  border-left: 1rpx solid #f0ebe1;
}
.stat-row .n {
  display: block;
  font-family: "Songti SC", serif;
  font-size: 40rpx;
  font-weight: 700;
  color: #1d2530;
  line-height: 1.2;
}
.stat-row .l {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #a9a294;
  letter-spacing: 1rpx;
}

/* 分区标题 */
.sec-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin: 40rpx 40rpx 16rpx;
}
.sec-head .bar {
  width: 6rpx;
  height: 26rpx;
  border-radius: 4rpx;
  background: #2b4a8b;
}
.sec-head .t {
  font-size: 24rpx;
  letter-spacing: 3rpx;
  color: #4a5568;
}
.sec-head .line {
  flex: 1;
  height: 1rpx;
  background: #e6e0d4;
}

/* 功能卡 */
.fn-card {
  position: relative;
  display: flex;
  align-items: center;
  margin: 0 40rpx 16rpx;
  padding: 30rpx 30rpx;
  border-radius: 28rpx;
  background: #fffefb;
  border: 1rpx solid #e6e0d4;
  box-shadow: 0 10rpx 30rpx -22rpx rgba(29, 37, 48, 0.4);
}
.fn-card:active {
  transform: scale(0.988);
}
.fn-card .ico {
  width: 76rpx;
  height: 76rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.fn-card .ico.indigo { background: #eef1f8; color: #2b4a8b; }
.fn-card .ico.gold { background: #fbf4e3; color: #b8892f; }
.fn-card .ico.ink { background: #f1efe9; color: #6b6558; }
.fn-card .body { flex: 1; min-width: 0; }
.fn-card .ttl {
  font-size: 30rpx;
  font-weight: 600;
  color: #1d2530;
}
.fn-card .desc {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8a8578;
  line-height: 1.5;
}
.fn-card .arrow {
  font-size: 34rpx;
  color: #c9c2b4;
  margin-left: 16rpx;
}
.fn-card .tag {
  position: absolute;
  right: 28rpx;
  top: 24rpx;
  font-size: 18rpx;
  padding: 3rpx 12rpx;
  border-radius: 999rpx;
  background: #f1efe9;
  color: #8a8578;
}
.fn-card.disabled { opacity: .55; }

/* 说明脚注 */
.foot-note {
  margin: 44rpx 44rpx 0;
  font-size: 20rpx;
  line-height: 1.9;
  color: #a9a294;
}

/* 通用按钮 */
.btn-primary {
  margin: 0 40rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 24rpx;
  background: #2b4a8b;
  color: #fff;
  font-size: 28rpx;
  letter-spacing: 2rpx;
}
.btn-primary:active { background: #24407a; }

/* 空态 / 错误 */
.ex-empty {
  padding: 90rpx 40rpx;
  text-align: center;
}
.ex-empty .t {
  font-family: "Songti SC", serif;
  font-size: 34rpx;
  color: #4a5568;
}
.ex-empty .d {
  margin-top: 14rpx;
  font-size: 22rpx;
  line-height: 1.8;
  color: #a9a294;
}
