.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #0a0a0a;
}

/* 模式切换 Tab */
.mode-tabs {
  display: flex;
  background: #1a1a2e;
  padding: 16rpx 24rpx;
  gap: 16rpx;
}

.tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 20rpx 0;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.05);
  transition: all 0.2s;
}

.tab.active {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.4);
}

.tab-icon {
  font-size: 28rpx;
  font-weight: bold;
  color: rgba(255, 255, 255, 0.6);
}

.tab.active .tab-icon {
  color: #ffffff;
}

.tab-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.6);
  font-weight: 500;
}

.tab.active .tab-text {
  color: #ffffff;
}

/* 摄像头区域 */
.camera-wrap {
  position: relative;
  flex: 1;
  min-height: 0;
  background: #000000;
  overflow: hidden;
}

.camera {
  width: 100%;
  height: 100%;
}

.canvas-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 2;
}

/* 加载遮罩 */
.loading-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 3;
  background: rgba(0, 0, 0, 0.75);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.2);
  border-top: 4rpx solid #667eea;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  color: rgba(255, 255, 255, 0.7);
  font-size: 28rpx;
}

/* 控制栏 */
.controls {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 32rpx;
  background: #1a1a2e;
}

.btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 26rpx 0;
  border-radius: 18rpx;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

.btn:active {
  transform: scale(0.95);
  filter: brightness(0.9);
}

.btn-primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #ffffff;
  box-shadow: 0 6rpx 24rpx rgba(102, 126, 234, 0.35);
}

.btn-secondary {
  background: rgba(255, 255, 255, 0.08);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  color: #ffffff;
  border: 1rpx solid rgba(255, 255, 255, 0.15);
}

.btn-danger {
  background: linear-gradient(135deg, #ff6b6b 0%, #ee5a24 100%);
  color: #ffffff;
  box-shadow: 0 6rpx 24rpx rgba(255, 107, 107, 0.35);
}

/* 结果面板 */
.result-panel {
  background: #1a1a2e;
  padding: 24rpx 32rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.05);
}

.result-title {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.5);
  margin-bottom: 16rpx;
  font-weight: 500;
}

.result-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.result-label {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.6);
}

.result-value {
  font-size: 36rpx;
  color: #00ff88;
  font-weight: bold;
}

.result-value.big {
  font-size: 56rpx;
}

.result-conf {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.4);
  margin-left: auto;
}

.result-empty {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.4);
}

.result-time {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.3);
  margin-top: 8rpx;
}

/* 统计栏 */
.stats-bar {
  display: flex;
  justify-content: space-around;
  padding: 20rpx 32rpx;
  background: #1a1a2e;
  border-top: 1rpx solid rgba(255, 255, 255, 0.05);
}

.stats-item {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
}

/* 中药识别结果列表 */
.herb-list {
  padding: 8rpx 0;
}

.herb-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 12rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
}

.herb-item:last-child {
  border-bottom: none;
}

.herb-name {
  font-size: 32rpx;
  color: #ffffff;
  font-weight: 600;
}

.herb-conf {
  font-size: 28rpx;
  color: #00ff88;
  font-weight: 500;
}

/* ==================== 冻结指示器 ==================== */

.freeze-indicator {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  right: 20rpx;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.freeze-badge {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 24rpx;
  background: rgba(0, 0, 0, 0.55);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 40rpx;
}

.freeze-dot {
  display: inline-block;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #ff6b6b;
  box-shadow: 0 0 8rpx rgba(255, 107, 107, 0.6);
  animation: freeze-pulse 1.5s ease-in-out infinite;
}

@keyframes freeze-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.4; }
}

.freeze-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  font-weight: 500;
  letter-spacing: 2rpx;
}

.freeze-action {
  padding: 10rpx 28rpx;
  background: rgba(255, 255, 255, 0.12);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 40rpx;
  transition: all 0.2s;
}

.freeze-action:active {
  background: rgba(255, 255, 255, 0.25);
  transform: scale(0.95);
}

.freeze-action text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  font-weight: 500;
}

/* ==================== 按钮增强 ==================== */

.btn-accent {
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
  color: #ffffff;
  box-shadow: 0 4rpx 20rpx rgba(245, 87, 108, 0.35);
}

.btn-accent:active {
  box-shadow: 0 2rpx 8rpx rgba(245, 87, 108, 0.2);
}

/* ==================== 推理动画覆盖层 ==================== */

.infer-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 8;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  pointer-events: none;
  opacity: 0;
  transition: opacity 0.6s cubic-bezier(0.22, 1, 0.36, 1);
}

.infer-overlay.infer-show {
  opacity: 1;
}

/* 柔光底色 - 整屏微暗 */
.infer-backdrop {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: radial-gradient(ellipse 70% 60% at 50% 50%,
    rgba(30, 28, 40, 0.35) 0%,
    rgba(10, 10, 15, 0.15) 100%);
}

/* 全宽扫描光带 */
.infer-scan-bar {
  position: absolute;
  top: 0;
  left: -20%;
  width: 140%;
  height: 3rpx;
  background: linear-gradient(90deg,
    transparent 0%,
    rgba(200, 190, 220, 0) 15%,
    rgba(200, 190, 220, 0.12) 30%,
    rgba(210, 195, 230, 0.28) 45%,
    rgba(220, 200, 235, 0.4) 50%,
    rgba(210, 195, 230, 0.28) 55%,
    rgba(200, 190, 220, 0.12) 70%,
    rgba(200, 190, 220, 0) 85%,
    transparent 100%);
  box-shadow:
    0 0 40rpx rgba(200, 190, 220, 0.15),
    0 0 120rpx rgba(200, 190, 220, 0.06);
  animation: infer-sweep 3.5s cubic-bezier(0.22, 1, 0.36, 1) infinite;
}

@keyframes infer-sweep {
  0%   { transform: translateY(-120%); opacity: 0; }
  8%   { opacity: 1; }
  92%  { opacity: 1; }
  100% { transform: translateY(120%); opacity: 0; }
}

/* 中心内容区 */
.infer-content {
  position: relative;
  width: 300rpx;
  height: 300rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ---------- 轨道环 ---------- */

.infer-orbit {
  position: absolute;
  border-radius: 50%;
  border-style: solid;
  border-color: transparent;
}

/* 外环 */
.infer-orbit-outer {
  width: 260rpx;
  height: 260rpx;
  border-width: 1rpx;
  border-top-color: rgba(195, 185, 215, 0.22);
  border-right-color: rgba(195, 185, 215, 0.08);
  animation: infer-spin 8s linear infinite;
}

/* 中环 */
.infer-orbit-mid {
  width: 190rpx;
  height: 190rpx;
  border-width: 1rpx;
  border-bottom-color: rgba(185, 195, 210, 0.2);
  border-left-color: rgba(185, 195, 210, 0.06);
  animation: infer-spin 12s linear infinite reverse;
}

/* 内环 */
.infer-orbit-inner {
  width: 120rpx;
  height: 120rpx;
  border-width: 1rpx;
  border-top-color: rgba(200, 185, 200, 0.18);
  border-right-color: rgba(200, 185, 200, 0.06);
  animation: infer-spin 6s linear infinite;
}

@keyframes infer-spin {
  to { transform: rotate(360deg); }
}

/* ---------- 轨道光点 ---------- */

.infer-dot {
  position: absolute;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(220, 210, 235, 0.6) 0%, rgba(200, 190, 215, 0) 70%);
}

.infer-dot-1 {
  width: 8rpx;
  height: 8rpx;
  animation: infer-orbit-1 8s linear infinite;
}

.infer-dot-2 {
  width: 6rpx;
  height: 6rpx;
  animation: infer-orbit-2 12s linear infinite;
}

@keyframes infer-orbit-1 {
  0%   { transform: rotate(0deg)   translateX(130rpx) rotate(0deg); }
  100% { transform: rotate(360deg) translateX(130rpx) rotate(-360deg); }
}

@keyframes infer-orbit-2 {
  0%   { transform: rotate(180deg) translateX(95rpx) rotate(-180deg); }
  100% { transform: rotate(540deg) translateX(95rpx) rotate(-540deg); }
}

/* ---------- 中心柔光 ---------- */

.infer-glow {
  position: absolute;
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: radial-gradient(circle,
    rgba(215, 205, 230, 0.18) 0%,
    rgba(200, 190, 215, 0.08) 40%,
    transparent 70%);
  animation: infer-glow-breathe 3s ease-in-out infinite;
}

.infer-glow::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 10rpx;
  height: 10rpx;
  margin: -5rpx 0 0 -5rpx;
  border-radius: 50%;
  background: radial-gradient(circle,
    rgba(230, 220, 240, 0.5) 0%,
    rgba(210, 200, 225, 0.2) 60%,
    transparent 100%);
  box-shadow:
    0 0 15rpx rgba(210, 200, 225, 0.25),
    0 0 40rpx rgba(200, 190, 215, 0.1);
  animation: infer-glow-breathe 3s ease-in-out infinite 0.3s;
}

@keyframes infer-glow-breathe {
  0%, 100% { transform: scale(1);   opacity: 0.7; }
  50%      { transform: scale(1.25); opacity: 1; }
}

/* ---------- 文字 ---------- */

.infer-label {
  margin-top: 60rpx;
  display: flex;
  align-items: baseline;
  white-space: nowrap;
}

.infer-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.45);
  font-weight: 400;
  letter-spacing: 8rpx;
}

.infer-dots {
  font-size: 28rpx;
  color: rgba(210, 200, 225, 0.5);
  font-weight: 300;
  display: inline-block;
  overflow: hidden;
  vertical-align: bottom;
  letter-spacing: 4rpx;
  animation: infer-dots-fade 2.2s ease-in-out infinite;
}

@keyframes infer-dots-fade {
  0%, 100% { opacity: 0.2; }
  50%      { opacity: 0.7; }
}
