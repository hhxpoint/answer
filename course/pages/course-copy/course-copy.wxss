/* course/pages/course-copy/course.wxss */

/* 全局容器 */
.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

/* 头部 */
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 40rpx;
  background-color: #4A90E2;
  color: #ffffff;
}

.header-left {
  width: 80rpx;
}

.back-icon {
  font-size: 40rpx;
  color: #ffffff;
}

.header-title {
  flex: 1;
  text-align: center;
  font-size: 36rpx;
  font-weight: bold;
}

.header-right {
  width: 80rpx;
}

/* 源课程信息 */
.source-info {
  background-color: #ffffff;
  margin: 20rpx;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.info-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 20rpx;
}

.info-content {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.info-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.info-label {
  font-size: 28rpx;
  color: #666666;
}

.info-value {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
}

/* 源课程列表 */
.source-courses {
  max-height: 300rpx;
}

.course-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  background-color: #f8f8f8;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  border-left: 8rpx solid #4A90E2;
}

.course-name {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
}

.course-time {
  font-size: 24rpx;
  color: #666666;
}

/* 快速选择 */
.quick-select {
  background-color: #ffffff;
  margin: 20rpx;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.select-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 20rpx;
}

.select-options {
  display: flex;
  gap: 20rpx;
}

.select-option {
  flex: 1;
  padding: 20rpx;
  background-color: #f8f8f8;
  border-radius: 12rpx;
  text-align: center;
  font-size: 28rpx;
  color: #4A90E2;
  cursor: pointer;
}

/* 日历选择 */
.calendar-section {
  background-color: #ffffff;
  margin: 20rpx;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 30rpx;
}

/* 月份导航 */
.month-nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.nav-btn {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: #f8f8f8;
  border-radius: 50%;
}

.nav-icon {
  font-size: 40rpx;
  color: #666666;
}

.month-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
}

/* 星期标题 */
.weekdays {
  display: flex;
  margin-bottom: 20rpx;
}

.weekday {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #999999;
  font-weight: 500;
}

/* 日期网格 */
.calendar-grid {
  display: flex;
  flex-wrap: wrap;
}

.calendar-day {
  width: calc(100% / 7);
  aspect-ratio: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  position: relative;
  cursor: pointer;
}

.day-number {
  font-size: 32rpx;
  color: #333333;
  font-weight: 500;
}

.calendar-day.other-month .day-number {
  color: #cccccc;
}

.calendar-day.not-selectable {
  opacity: 0.5;
  cursor: not-allowed;
}

.calendar-day.selected {
  background-color: #4A90E2;
  border-radius: 50%;
}

.calendar-day.selected .day-number {
  color: #ffffff;
}

.select-indicator {
  position: absolute;
  bottom: 8rpx;
  width: 30rpx;
  height: 30rpx;
  background-color: #50C878;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  color: #ffffff;
  font-size: 20rpx;
}

/* 已选择日期 */
.selected-dates {
  background-color: #ffffff;
  margin: 20rpx;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.clear-btn {
  padding: 12rpx 24rpx;
  background-color: #FF6B6B;
  color: #ffffff;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.dates-list {
  max-height: 200rpx;
}

.date-item {
  display: inline-block;
  padding: 12rpx 24rpx;
  background-color: #f8f8f8;
  border-radius: 8rpx;
  margin: 8rpx;
  font-size: 28rpx;
  color: #333333;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 40rpx;
  background-color: #ffffff;
  border-top: 1rpx solid #e8e8e8;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.selection-info {
  font-size: 28rpx;
  color: #666666;
}

.copy-btn {
  padding: 20rpx 60rpx;
  background-color: #4A90E2;
  color: #ffffff;
  border-radius: 12rpx;
  font-size: 32rpx;
  border: none;
}

.copy-btn[disabled] {
  background-color: #cccccc;
  color: #999999;
}

/* 加载遮罩 */
.loading-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1000;
}

.loading-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  background-color: #ffffff;
  padding: 60rpx;
  border-radius: 20rpx;
}

.loading-spinner {
  width: 80rpx;
  height: 80rpx;
  border: 4rpx solid #f8f8f8;
  border-top: 4rpx solid #4A90E2;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 30rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  font-size: 32rpx;
  color: #333333;
}

/* 成功提示 */
.success-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1000;
}

.success-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  background-color: #ffffff;
  padding: 80rpx;
  border-radius: 20rpx;
}

.success-icon {
  width: 120rpx;
  height: 120rpx;
  background-color: #50C878;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  color: #ffffff;
  font-size: 60rpx;
  margin-bottom: 30rpx;
}

.success-text {
  font-size: 36rpx;
  color: #333333;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.success-sub {
  font-size: 28rpx;
  color: #666666;
}