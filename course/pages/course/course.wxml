<!-- course/pages/course/course.wxml -->
<view class="container">
  <view class="top-panel">
    <view class="week-banner" bindtap="showWeekEdit">
      <view class="banner-main">
        <text class="banner-kicker">课程总览</text>
        <text class="banner-week">第 {{currentWeek}} 周（当前）</text>
        <text class="banner-meta">{{grade}} {{semester}}</text>
      </view>
      <view class="banner-side">
        <text class="banner-range">{{weekRange}}</text>
        <text class="banner-action">编辑</text>
      </view>
    </view>

    <view class="top-actions">
      <view class="stat-chip">
        <text class="chip-label">本周课程</text>
        <text class="chip-value">{{weekCourseList.length}}</text>
      </view>
      <view class="action-chip" bindtap="showAddCourseModal">
        <text class="chip-icon">+</text>
        <text class="chip-text">添加课程</text>
      </view>
      <view class="action-chip" bindtap="showMoreOptions">
        <text class="chip-icon">···</text>
        <text class="chip-text">更多</text>
      </view>
    </view>
  </view>

  <block wx:if="{{viewMode === 'week'}}">
    <!-- 课程表主体 -->
    <view class="schedule-container">
      <!-- 星期和日期头部 -->
      <view class="schedule-header">
        <view class="month-column">
          <text class="month-number">{{currentMonth}}</text>
          <text class="month-text">月</text>
        </view>
        
        <block wx:for="{{weekDates}}" wx:key="date">
          <view class="day-column {{item.isToday ? 'today-column' : ''}}">
            <text class="weekday-text">{{item.weekday}}</text>
            <view class="day-circle {{item.isToday ? 'today-circle' : ''}}">
              <text class="day-number {{item.isToday ? 'today-number' : ''}}">{{item.day}}</text>
            </view>
          </view>
        </block>
      </view>

      <!-- 课程时间段 -->
      <view class="schedule-body">
        <block wx:for="{{scheduleGrid}}" wx:key="slotIndex">
          <view class="time-row">
            <!-- 时间列 -->
            <view class="time-column">
              <text class="time-label">{{item.label}}</text>
              <view class="time-range">
                <text class="time-start">{{item.start}}</text>
                <text class="time-dash">-</text>
                <text class="time-end">{{item.end}}</text>
              </view>
            </view>

            <!-- 周一到周日的课程格子 -->
            <block wx:for="{{item.cells}}" wx:key="date">
              <view class="course-column" bindtap="onCellTap" data-date="{{item.date}}" data-slot="{{item.slotIndex}}" data-has-course="{{item.hasCourse}}">
                <view 
                  class="course-card"
                  wx:if="{{item.hasCourse}}"
                  style="background-color: {{item.course.color || '#7D78F2'}};"
                  bindtap="onCourseTap"
                  catchtap="stopPropagation"
                  data-course="{{item.course}}"
                  data-date="{{item.date}}"
                >
                  <text class="course-name">{{item.course.name}}</text>
                  <text class="course-loc">{{item.course.location || '待定地点'}}</text>
                </view>
                <view class="course-placeholder" wx:else>
                  <text class="placeholder-plus">+</text>
                </view>
              </view>
            </block>
          </view>
        </block>
      </view>
    </view>
  </block>

  <block wx:else>
    <view class="list-container">
      <view class="list-header">
        <text class="list-title">本周课程清单</text>
        <text class="list-count">共 {{weekCourseList.length}} 门</text>
      </view>

      <scroll-view class="list-scroll" scroll-y="true" enhanced="true" show-scrollbar="false">
        <view class="list-empty" wx:if="{{weekCourseList.length === 0}}">
          <text class="list-empty-title">这一周还没有课程</text>
          <text class="list-empty-tip">点击下方 + 按钮，快速添加课程</text>
        </view>

        <block wx:for="{{weekCourseList}}" wx:key="id">
          <view class="list-course-card" bindtap="onCourseTap" data-course="{{item}}" data-date="{{item.date}}">
            <view class="list-course-date">
              <text class="list-weekday">{{item.weekday}}</text>
              <text class="list-day">{{item.day}}</text>
            </view>
            <view class="list-course-main">
              <view class="list-course-top">
                <text class="list-course-name">{{item.name}}</text>
                <view class="list-course-color" style="background: {{item.color || '#7D78F2'}};"></view>
              </view>
              <text class="list-course-time">{{item.startTime}} - {{item.endTime}}</text>
              <text class="list-course-location">{{item.location || '地点待定'}} {{item.teacher ? (' · ' + item.teacher) : ''}}</text>
            </view>
          </view>
        </block>
      </scroll-view>
    </view>
  </block>

  <!-- 底部浮动按钮组 -->
  <view class="floating-btn-group">
    <view class="float-btn week-btn" bindtap="switchView" data-view="week">
      <text class="float-btn-text {{viewMode === 'week' ? 'active' : ''}}">周</text>
      <text class="float-btn-label">周视图</text>
    </view>
    
    <view class="float-btn add-btn" bindtap="showAddCourseModal">
      <text class="add-icon">+</text>
    </view>
    
    <view class="float-btn list-btn" bindtap="switchView" data-view="list">
      <text class="float-btn-icon {{viewMode === 'list' ? 'active' : ''}}">≡</text>
      <text class="float-btn-label">清单</text>
    </view>
  </view>

  <!-- 课程详情弹窗 -->
  <view class="course-detail-popup" wx:if="{{selectedCourse}}" bindtap="closeCourseDetail">
    <view class="detail-card" catchtap="stopPropagation">
      <view class="detail-header" style="background: linear-gradient(135deg, {{selectedCourse.color}} 0%, {{selectedCourse.color}}dd 100%);">
        <view class="detail-title-row">
          <text class="detail-course-name">{{selectedCourse.name}}</text>
          <view class="detail-close" bindtap="closeCourseDetail">×</view>
        </view>
        <text class="detail-teacher">{{selectedCourse.teacher || '未知教师'}}</text>
      </view>
      
      <view class="detail-body">
        <view class="detail-item">
          <text class="detail-icon-text">📅</text>
          <text class="detail-label">上课周次</text>
          <text class="detail-value">{{selectedCourse.weeks || '1-16周'}}</text>
        </view>
        <view class="detail-item">
          <text class="detail-icon-text">⏰</text>
          <text class="detail-label">上课时间</text>
          <text class="detail-value">{{selectedCourse.startTime}} - {{selectedCourse.endTime}}</text>
        </view>
        <view class="detail-item">
          <text class="detail-icon-text">📍</text>
          <text class="detail-label">上课地点</text>
          <text class="detail-value">{{selectedCourse.location || '待定'}}</text>
        </view>
        <view class="detail-item" wx:if="{{selectedCourse.notes}}">
          <text class="detail-icon-text">📝</text>
          <text class="detail-label">备注信息</text>
          <text class="detail-value">{{selectedCourse.notes}}</text>
        </view>
      </view>
      
      <view class="detail-footer">
        <view class="detail-action-btn edit" bindtap="editCourse">
          <text class="action-text">编辑</text>
        </view>
        <view class="detail-action-btn delete" bindtap="deleteSelectedCourse">
          <text class="action-text">删除</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 周数/学期设置弹窗 -->
  <view class="week-edit-popup" wx:if="{{showWeekEditModal}}">
    <view class="week-edit-mask" bindtap="hideWeekEdit"></view>
    <view class="week-edit-card">
      <view class="week-edit-header">
        <text class="week-edit-title">课程表设置</text>
        <view class="week-edit-close" bindtap="hideWeekEdit">×</view>
      </view>
      
      <view class="week-edit-body">
        <view class="edit-item">
          <text class="edit-label">当前周数</text>
          <view class="edit-stepper">
            <view class="stepper-btn" bindtap="decreaseWeek">-</view>
            <text class="stepper-value">{{currentWeek}}</text>
            <view class="stepper-btn" bindtap="increaseWeek">+</view>
          </view>
        </view>
        
        <view class="edit-item">
          <text class="edit-label">学期周数</text>
          <picker mode="selector" range="{{totalWeekOptions}}" bindchange="onTotalWeekChange">
            <view class="edit-picker">
              <text>{{totalWeeks}}周</text>
              <text class="picker-arrow">▼</text>
            </view>
          </picker>
        </view>
        
        <view class="edit-item">
          <text class="edit-label">年级</text>
          <picker mode="selector" range="{{gradeOptions}}" bindchange="onGradeChange">
            <view class="edit-picker">
              <text>{{grade}}</text>
              <text class="picker-arrow">▼</text>
            </view>
          </picker>
        </view>
        
        <view class="edit-item">
          <text class="edit-label">学期</text>
          <picker mode="selector" range="{{semesterOptions}}" bindchange="onSemesterChange">
            <view class="edit-picker">
              <text>{{semester}}</text>
              <text class="picker-arrow">▼</text>
            </view>
          </picker>
        </view>
      </view>
      
      <view class="week-edit-footer">
        <view class="edit-btn cancel" bindtap="hideWeekEdit">取消</view>
        <view class="edit-btn confirm" bindtap="saveWeekSettings">保存</view>
      </view>
    </view>
  </view>

  <!-- 更多选项弹窗 -->
  <view class="more-options-popup" wx:if="{{showMoreOptions}}">
    <view class="more-options-mask" bindtap="hideMoreOptions"></view>
    <view class="more-options-card">
      <view class="option-item" bindtap="copyWeekCourses">
        <text class="option-icon">📋</text>
        <text class="option-text">复制本周课程</text>
      </view>
      <view class="option-item" bindtap="clearAllCourses">
        <text class="option-icon">🗑️</text>
        <text class="option-text">清空所有课程</text>
      </view>
      <view class="option-item" bindtap="exportCourses">
        <text class="option-icon">📤</text>
        <text class="option-text">导出课程表</text>
      </view>
    </view>
  </view>

  <!-- 添加/编辑课程弹窗 -->
  <view class="add-course-popup" wx:if="{{showCourseModal}}">
    <view class="add-course-mask" bindtap="hideCourseModal"></view>
    <view class="add-course-card">
      <view class="add-course-header">
        <text class="add-course-title">{{isEditing ? '编辑课程' : '添加课程'}}</text>
        <view class="add-course-close" bindtap="hideCourseModal">×</view>
      </view>
      
      <view class="add-course-scroll-wrap">
        <scroll-view class="add-course-body" scroll-y="true" enhanced="true" show-scrollbar="true">
          <view class="form-item">
            <text class="form-label">课程名称 *</text>
            <input class="form-input" placeholder="请输入课程名称" placeholder-class="input-placeholder" value="{{courseForm.name}}" bindinput="onFormInput" data-field="name"/>
          </view>
          
          <view class="form-item">
            <text class="form-label">上课日期 *</text>
            <picker mode="date" value="{{courseForm.date}}" bindchange="onDateChange">
              <view class="form-picker">
                <text class="{{courseForm.date ? 'picker-value' : 'input-placeholder'}}">{{courseForm.date || '请选择日期'}}</text>
                <text class="picker-icon">▼</text>
              </view>
            </picker>
          </view>
          
          <view class="form-item">
            <text class="form-label">任课教师</text>
            <input class="form-input" placeholder="请输入教师姓名" placeholder-class="input-placeholder" value="{{courseForm.teacher}}" bindinput="onFormInput" data-field="teacher"/>
          </view>
          
          <view class="form-item">
            <text class="form-label">上课地点</text>
            <input class="form-input" placeholder="请输入教室位置" placeholder-class="input-placeholder" value="{{courseForm.location}}" bindinput="onFormInput" data-field="location"/>
          </view>
          
          <view class="form-row">
            <view class="form-item half">
              <text class="form-label">开始时间 *</text>
              <picker mode="time" value="{{courseForm.startTime}}" bindchange="onTimeChange" data-field="startTime">
                <view class="form-picker">
                  <text class="{{courseForm.startTime ? 'picker-value' : 'input-placeholder'}}">{{courseForm.startTime || '选择时间'}}</text>
                  <text class="picker-icon">▼</text>
                </view>
              </picker>
            </view>
            <view class="form-item half">
              <text class="form-label">结束时间 *</text>
              <picker mode="time" value="{{courseForm.endTime}}" bindchange="onTimeChange" data-field="endTime">
                <view class="form-picker">
                  <text class="{{courseForm.endTime ? 'picker-value' : 'input-placeholder'}}">{{courseForm.endTime || '选择时间'}}</text>
                  <text class="picker-icon">▼</text>
                </view>
              </picker>
            </view>
          </view>
          
          <view class="form-item">
            <text class="form-label">上课周次</text>
            <input class="form-input" placeholder="例如：1-16周" placeholder-class="input-placeholder" value="{{courseForm.weeks}}" bindinput="onFormInput" data-field="weeks"/>
          </view>
          
          <view class="form-item">
            <text class="form-label">课程颜色</text>
            <view class="color-grid">
              <block wx:for="{{colorOptions}}" wx:key="*this">
                <view class="color-item {{courseForm.color === item ? 'color-selected' : ''}}" style="background-color: {{item}};" bindtap="onColorSelect" data-color="{{item}}">
                  <text class="color-check" wx:if="{{courseForm.color === item}}">✓</text>
                </view>
              </block>
            </view>
          </view>
          
          <view class="form-item form-item-last">
            <text class="form-label">备注信息</text>
            <textarea class="form-textarea" placeholder="选填，可添加课程备注" placeholder-class="input-placeholder" value="{{courseForm.notes}}" bindinput="onFormInput" data-field="notes"></textarea>
          </view>
        </scroll-view>
      </view>
      
      <view class="add-course-footer">
        <view class="footer-btn cancel" bindtap="hideCourseModal">取消</view>
        <view class="footer-btn save" bindtap="saveCourse">{{isEditing ? '保存' : '添加'}}</view>
      </view>
    </view>
  </view>
</view>