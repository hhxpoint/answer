.card-container {
  background: rgba(255, 255, 255, 0.8);
  /* 半透明奶白色 */
  backdrop-filter: blur(10px);
  /* 磨砂玻璃效果 */
  border-radius: 40rpx;
  /* 圆润的云朵边角 */
  padding: 45rpx;
  box-shadow: 0 15rpx 40rpx rgba(168, 192, 255, 0.1);
  /* 极淡的蓝紫色投影 */
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  box-sizing: border-box;
}

/* 问题部分 */
.q-header {
  display: flex;
  margin-bottom: 30rpx;
}

.q-icon {
  background: #A8C0FF;
  color: #fff;
  width: 40rpx;
  height: 40rpx;
  border-radius: 12rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 24rpx;
  font-weight: bold;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.q-text {
  font-size: 34rpx;
  font-weight: 600;
  color: #445a78;
  line-height: 1.4;
}

/* 分割线 */
.divider {
  height: 2rpx;
  background: linear-gradient(90deg, transparent, #f0f4f8, transparent);
  margin: 30rpx 0;
}

/* 答案部分 */
.a-body {
  margin-top: 20rpx;
}

.a-label {
  color: #FBC2EB;
  /* 温柔的粉色 */
  font-size: 26rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
  display: block;
}

.a-content {
  font-size: 30rpx;
  color: #667c99;
  line-height: 1.6;
  text-align: justify;
}