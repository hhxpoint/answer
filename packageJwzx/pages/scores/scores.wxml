<!-- 成绩查询页 -->
<view class="page">
  <view class="bg-orb bg-orb-1"></view>
  <view class="bg-orb bg-orb-2"></view>

  <!-- 未登录状态 -->
  <view class="login-prompt" wx:if="{{!isLoggedIn}}">
    <view class="prompt-icon-wrap">
      <text class="prompt-icon">S</text>
    </view>
    <text class="prompt-title">尚未登录</text>
    <text class="prompt-desc">请先登录系统以查看成绩</text>
    <view class="prompt-btn" bindtap="goLogin">
      <text class="prompt-btn-text">前往登录</text>
    </view>
  </view>

  <!-- 已登录状态 -->
  <view class="content" wx:if="{{isLoggedIn}}">
    <!-- 顶部信息栏 -->
    <view class="top-bar">
      <view class="student-info">
        <text class="student-name">{{studentName || '同学'}}</text>
        <text class="student-id">{{studentId}}</text>
      </view>
      <view class="top-actions">
        <view class="icon-btn" bindtap="doLogout">
          <text class="icon-btn-text">退出</text>
        </view>
      </view>
    </view>

    <!-- 学期选择器 -->
    <view class="semester-picker">
      <view class="picker-item" bindtap="onYearChange">
        <picker mode="selector" range="{{years}}" range-key="label" value="{{yearIndex}}" bindchange="onYearChange">
          <view class="picker-display">
            <text class="picker-label">学年</text>
            <text class="picker-value">{{years[yearIndex].label || '选择学年'}}</text>
            <text class="picker-arrow">▾</text>
          </view>
        </picker>
      </view>
      <view class="picker-divider"></view>
      <view class="picker-item" bindtap="onTermChange">
        <picker mode="selector" range="{{terms}}" range-key="label" value="{{termIndex}}" bindchange="onTermChange">
          <view class="picker-display">
            <text class="picker-label">学期</text>
            <text class="picker-value">{{terms[termIndex].label || '选择学期'}}</text>
            <text class="picker-arrow">▾</text>
          </view>
        </picker>
      </view>
    </view>

    <!-- GPA 统计卡片 -->
    <view class="stats-card" wx:if="{{hasLoaded && scores.length > 0}}">
      <view class="stat-main">
        <text class="stat-gpa-num">{{semesterGPA}}</text>
        <text class="stat-gpa-label">平均学分绩</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-items">
        <view class="stat-item">
          <text class="stat-num">{{requiredGPA}}</text>
          <text class="stat-label">必修学分绩</text>
        </view>
        <view class="stat-item">
          <text class="stat-num">{{semesterCredits}}</text>
          <text class="stat-label">总学分</text>
        </view>
        <view class="stat-item">
          <text class="stat-num">{{passedCourses}}/{{totalCourses}}</text>
          <text class="stat-label">通过/总门</text>
        </view>
      </view>
    </view>

    <!-- 工具栏 -->
    <view class="toolbar" wx:if="{{hasLoaded && scores.length > 0}}">
      <view class="tool-btn" bindtap="switchSort">
        <text class="tool-icon">↕</text>
        <text class="tool-text">{{sortBy === 'default' ? '默认' : sortBy === 'score-desc' ? '高→低' : sortBy === 'score-asc' ? '低→高' : '学分↓'}}</text>
      </view>
      <view class="tool-btn" bindtap="switchView" data-mode="list">
        <text class="tool-icon {{viewMode === 'list' ? 'active' : ''}}">☰</text>
      </view>
      <view class="tool-btn" bindtap="switchView" data-mode="grid">
        <text class="tool-icon {{viewMode === 'grid' ? 'active' : ''}}">▦</text>
      </view>
      <view class="tool-spacer"></view>
      <view class="tool-count">
        <text class="count-text">{{scores.length}} 门课程</text>
      </view>
    </view>

    <!-- 全部成绩查询按钮 -->
    <view class="all-scores-btn" bindtap="loadAllScores" wx:if="{{!loadingAll}}">
      <text class="all-scores-text">查询全部学期成绩</text>
    </view>
    <view class="all-scores-btn loading" wx:if="{{loadingAll}}">
      <view class="mini-spinner"></view>
      <!-- <text class="all-scores-text">{{loadProgress || '查询中...'}}</text> -->
    </view>

    <!-- 加载状态 -->
    <view class="loading-wrap" wx:if="{{loading}}">
      <view class="spinner"></view>
      <text class="loading-text">正在加载成绩...</text>
    </view>

    <!-- 空状态 -->
    <view class="empty-wrap" wx:if="{{hasLoaded && scores.length === 0 && !loading}}">
      <text class="empty-icon">📋</text>
      <text class="empty-title">暂无成绩</text>
      <text class="empty-desc">该学期可能尚未发布成绩，请尝试切换其他学年或学期</text>
      <view class="retry-btn" bindtap="loadScores">
        <text class="retry-text">重新查询</text>
      </view>
    </view>

    <!-- 调试信息 -->
    <view class="debug-bar" wx:if="{{debugMsg}}">
      <text class="debug-text">{{debugMsg}}</text>
    </view>

    <!-- 列表视图 -->
    <view class="score-list" wx:if="{{viewMode === 'list' && scores.length > 0}}">
      <view
        class="score-item"
        wx:for="{{scores}}"
        wx:key="code"
        bindtap="toggleExpand"
        data-index="{{index}}"
      >
        <view class="score-main-row">
          <view class="score-left">
            <text class="score-name">{{item.name}}</text>
            <view class="score-meta">
              <text class="meta-tag {{item.isRequired ? 'required' : 'elective'}}">{{item.elective}}</text>
              <text class="meta-credit">{{item.credit}} 学分</text>
            </view>
          </view>
          <view class="score-right">
            <text class="score-value" style="color: {{item._passed ? '#2d8a56' : '#c75050'}}">{{item.score}}</text>
            <text class="gpa-value" wx:if="{{item.gpa !== null}}">{{item.gpa.toFixed(1)}}</text>
          </view>
        </view>
        <!-- 展开详情 -->
        <view class="score-detail" wx:if="{{expandedIndex === index}}">
          <view class="detail-grid">
            <view class="detail-cell">
              <text class="detail-key">课程号</text>
              <text class="detail-val">{{item.code}}</text>
            </view>
            <view class="detail-cell">
              <text class="detail-key">课序号</text>
              <text class="detail-val">{{item.seq}}</text>
            </view>
            <view class="detail-cell">
              <text class="detail-key">学时</text>
              <text class="detail-val">{{item.hours}}</text>
            </view>
            <view class="detail-cell">
              <text class="detail-key">考核方式</text>
              <text class="detail-val">{{item.exam_type}}</text>
            </view>
            <view class="detail-cell">
              <text class="detail-key">状态</text>
              <text class="detail-val {{item._passed ? 'pass' : 'fail'}}">{{item.passed}}</text>
            </view>
            <view class="detail-cell" wx:if="{{item.remark}}">
              <text class="detail-key">备注</text>
              <text class="detail-val">{{item.remark}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 网格视图 -->
    <view class="score-grid" wx:if="{{viewMode === 'grid' && scores.length > 0}}">
      <view
        class="grid-item"
        wx:for="{{scores}}"
        wx:key="code"
        bindtap="toggleExpand"
        data-index="{{index}}"
      >
        <text class="grid-score" style="color: {{item._passed ? '#2d8a56' : '#c75050'}}">{{item.score}}</text>
        <text class="grid-name">{{item.name}}</text>
        <text class="grid-credit">{{item.credit}}学分</text>
      </view>
    </view>
  </view>
</view>
