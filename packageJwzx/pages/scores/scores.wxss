/* 成绩查询页 — Claude 暖色调审美 */

.page {
  min-height: 100vh;
  background: #faf8f5;
  position: relative;
}

.bg-orb {
  position: fixed;
  border-radius: 50%;
  filter: blur(100rpx);
  pointer-events: none;
  z-index: 0;
}

.bg-orb-1 {
  width: 400rpx;
  height: 400rpx;
  background: radial-gradient(circle, rgba(45, 138, 86, 0.06) 0%, transparent 70%);
  top: -80rpx;
  left: -80rpx;
}

.bg-orb-2 {
  width: 500rpx;
  height: 500rpx;
  background: radial-gradient(circle, rgba(212, 163, 115, 0.06) 0%, transparent 70%);
  bottom: -100rpx;
  right: -100rpx;
}

.content {
  position: relative;
  z-index: 1;
  padding: 24rpx 32rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

/* 未登录提示 */
.login-prompt {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 80vh;
  padding: 80rpx;
}

.prompt-icon-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #d4a373 0%, #c4956a 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
  box-shadow: 0 12rpx 32rpx rgba(212, 163, 115, 0.3);
}

.prompt-icon {
  font-size: 56rpx;
  font-weight: 700;
  color: #fff;
  font-family: "SF Pro Display", -apple-system, BlinkMacSystemFont, sans-serif;
}

.prompt-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 16rpx;
  font-family: "SF Pro Display", -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

.prompt-desc {
  font-size: 28rpx;
  color: #8a8580;
  margin-bottom: 56rpx;
  font-family: "SF Pro Text", -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

.prompt-btn {
  width: 360rpx;
  height: 92rpx;
  border-radius: 20rpx;
  background: #1a1a1a;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.12);
}

.prompt-btn:active {
  transform: scale(0.97);
  opacity: 0.9;
}

.prompt-btn-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
  font-family: "SF Pro Text", -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

/* 顶部栏 */
.top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.student-info {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.student-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a1a;
  font-family: "SF Pro Display", -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

.student-id {
  font-size: 24rpx;
  color: #8a8580;
  font-family: "SF Pro Text", -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

.icon-btn {
  padding: 12rpx 24rpx;
  border-radius: 12rpx;
  background: rgba(0, 0, 0, 0.04);
}

.icon-btn:active {
  background: rgba(0, 0, 0, 0.08);
}

.icon-btn-text {
  font-size: 24rpx;
  color: #8a8580;
  font-family: "SF Pro Text", -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

/* 学期选择器 */
.semester-picker {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.04), 0 4rpx 12rpx rgba(0, 0, 0, 0.03);
  border: 1rpx solid rgba(0, 0, 0, 0.04);
}

.picker-item {
  flex: 1;
}

.picker-display {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 16rpx;
  gap: 6rpx;
}

.picker-label {
  font-size: 20rpx;
  color: #8a8580;
  font-family: "SF Pro Text", -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  letter-spacing: 1rpx;
  text-transform: uppercase;
}

.picker-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
  font-family: "SF Pro Text", -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

.picker-arrow {
  font-size: 20rpx;
  color: #b5b0a8;
}

.picker-divider {
  width: 1rpx;
  height: 48rpx;
  background: #ebe8e3;
}

/* GPA 统计卡片 */
.stats-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.04), 0 8rpx 24rpx rgba(0, 0, 0, 0.03);
  border: 1rpx solid rgba(0, 0, 0, 0.04);
  display: flex;
  align-items: center;
}

.stat-main {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 32rpx;
  min-width: 160rpx;
}

.stat-gpa-num {
  font-size: 56rpx;
  font-weight: 700;
  color: #1a1a1a;
  font-family: "SF Pro Display", -apple-system, BlinkMacSystemFont, sans-serif;
  line-height: 1;
}

.stat-gpa-label {
  font-size: 20rpx;
  color: #8a8580;
  margin-top: 8rpx;
  font-family: "SF Pro Text", -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

.stat-divider {
  width: 1rpx;
  height: 80rpx;
  background: #ebe8e3;
  margin: 0 16rpx;
}

.stat-items {
  flex: 1;
  display: flex;
  justify-content: space-around;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.stat-num {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1a1a;
  font-family: "SF Pro Display", -apple-system, BlinkMacSystemFont, sans-serif;
}

.stat-label {
  font-size: 18rpx;
  color: #8a8580;
  font-family: "SF Pro Text", -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

/* 工具栏 */
.toolbar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.tool-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 20rpx;
  border-radius: 12rpx;
  background: rgba(0, 0, 0, 0.03);
}

.tool-btn:active {
  background: rgba(0, 0, 0, 0.06);
}

.tool-icon {
  font-size: 24rpx;
  color: #8a8580;
}

.tool-icon.active {
  color: #d4a373;
}

.tool-text {
  font-size: 22rpx;
  color: #8a8580;
  font-family: "SF Pro Text", -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

.tool-spacer {
  flex: 1;
}

.count-text {
  font-size: 22rpx;
  color: #b5b0a8;
  font-family: "SF Pro Text", -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

/* 全部成绩按钮 */
.all-scores-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: rgba(212, 163, 115, 0.06);
  border: 1rpx solid rgba(212, 163, 115, 0.12);
  margin-bottom: 24rpx;
}

.all-scores-btn:active {
  background: rgba(212, 163, 115, 0.12);
}

.all-scores-text {
  font-size: 26rpx;
  color: #a07850;
  font-weight: 500;
  font-family: "SF Pro Text", -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

.mini-spinner {
  width: 24rpx;
  height: 24rpx;
  border: 3rpx solid rgba(212, 163, 115, 0.2);
  border-top-color: #d4a373;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

/* 加载状态 */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
  gap: 24rpx;
}

.spinner {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid rgba(0, 0, 0, 0.06);
  border-top-color: #d4a373;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.loading-text {
  font-size: 26rpx;
  color: #8a8580;
  font-family: "SF Pro Text", -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

/* 空状态 */
.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}

.empty-icon {
  font-size: 64rpx;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 8rpx;
  font-family: "SF Pro Display", -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

.empty-desc {
  font-size: 26rpx;
  color: #8a8580;
  font-family: "SF Pro Text", -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

/* 成绩列表 */
.score-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.score-item {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  box-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.03), 0 4rpx 12rpx rgba(0, 0, 0, 0.02);
  border: 1rpx solid rgba(0, 0, 0, 0.04);
  transition: box-shadow 0.2s;
}

.score-item:active {
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.score-main-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.score-left {
  flex: 1;
  min-width: 0;
  padding-right: 20rpx;
}

.score-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
  font-family: "SF Pro Text", -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  display: block;
}

.score-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 10rpx;
}

.meta-tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-family: "SF Pro Text", -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

.meta-tag.required {
  background: rgba(45, 138, 86, 0.08);
  color: #2d8a56;
}

.meta-tag.elective {
  background: rgba(212, 163, 115, 0.1);
  color: #a07850;
}

.meta-credit {
  font-size: 22rpx;
  color: #8a8580;
  font-family: "SF Pro Text", -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

.score-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
}

.score-value {
  font-size: 40rpx;
  font-weight: 700;
  font-family: "SF Pro Display", -apple-system, BlinkMacSystemFont, sans-serif;
  line-height: 1;
}

.gpa-value {
  font-size: 22rpx;
  color: #8a8580;
  font-family: "SF Pro Text", -apple-system, BlinkMacSystemFont, sans-serif;
}

/* 展开详情 */
.score-detail {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0ede8;
}

.detail-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx 0;
}

.detail-cell {
  width: 33.33%;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.detail-key {
  font-size: 20rpx;
  color: #b5b0a8;
  font-family: "SF Pro Text", -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

.detail-val {
  font-size: 24rpx;
  color: #1a1a1a;
  font-family: "SF Pro Text", -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

.detail-val.pass {
  color: #2d8a56;
}

.detail-val.fail {
  color: #c75050;
}

/* 网格视图 */
.score-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.grid-item {
  width: calc(33.33% - 8rpx);
  background: #ffffff;
  border-radius: 18rpx;
  padding: 20rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  box-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.03), 0 4rpx 12rpx rgba(0, 0, 0, 0.02);
  border: 1rpx solid rgba(0, 0, 0, 0.04);
}

.grid-item:active {
  transform: scale(0.97);
}

.grid-score {
  font-size: 40rpx;
  font-weight: 700;
  font-family: "SF Pro Display", -apple-system, BlinkMacSystemFont, sans-serif;
  line-height: 1;
}

.grid-name {
  font-size: 20rpx;
  color: #1a1a1a;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  width: 100%;
  font-family: "SF Pro Text", -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

.grid-credit {
  font-size: 18rpx;
  color: #b5b0a8;
  font-family: "SF Pro Text", -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* 骨架屏加载动画 */
.skeleton-wrap {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.skeleton-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.03), 0 4rpx 12rpx rgba(0, 0, 0, 0.02);
  border: 1rpx solid rgba(0, 0, 0, 0.04);
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.skeleton-line {
  height: 24rpx;
  border-radius: 8rpx;
  background: linear-gradient(90deg, #f0ede8 25%, #e8e4de 37%, #f0ede8 63%);
  background-size: 400% 100%;
  animation: shimmer 1.4s ease infinite;
}

.skeleton-line.long {
  width: 75%;
}

.skeleton-line.short {
  width: 40%;
}

@keyframes shimmer {
  0% { background-position: 100% 50%; }
  100% { background-position: 0 50%; }
}

/* 调试信息 */
.debug-bar {
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  background: rgba(212, 163, 115, 0.06);
  border-radius: 12rpx;
  border: 1rpx dashed rgba(212, 163, 115, 0.2);
}

.debug-text {
  font-size: 22rpx;
  color: #a07850;
  font-family: "SF Pro Text", -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  word-break: break-all;
}

/* 重试按钮 */
.retry-btn {
  margin-top: 32rpx;
  padding: 16rpx 40rpx;
  border-radius: 14rpx;
  background: rgba(0, 0, 0, 0.04);
  display: inline-flex;
}

.retry-btn:active {
  background: rgba(0, 0, 0, 0.08);
}

.retry-text {
  font-size: 26rpx;
  color: #8a8580;
  font-family: "SF Pro Text", -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}
