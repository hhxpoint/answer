/* 教务在线登录页 — Claude 暖色调审美 */

.page {
  min-height: 100vh;
  background: #faf8f5;
  position: relative;
  overflow: hidden;
}

/* 背景装饰光斑 */
.bg-orb {
  position: fixed;
  border-radius: 50%;
  filter: blur(100rpx);
  pointer-events: none;
  z-index: 0;
}

.bg-orb-1 {
  width: 500rpx;
  height: 500rpx;
  background: radial-gradient(circle, rgba(212, 163, 115, 0.12) 0%, transparent 70%);
  top: -100rpx;
  right: -100rpx;
}

.bg-orb-2 {
  width: 600rpx;
  height: 600rpx;
  background: radial-gradient(circle, rgba(168, 192, 255, 0.08) 0%, transparent 70%);
  bottom: -200rpx;
  left: -150rpx;
}

.content {
  position: relative;
  z-index: 1;
  padding: 60rpx 48rpx;
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
}

/* 头部 */
.header {
  margin-bottom: 64rpx;
}

.logo-mark {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #d4a373 0%, #c4956a 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(212, 163, 115, 0.25);
}

.logo-icon {
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
  font-family: "SF Pro Display", -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

.title {
  display: block;
  font-size: 52rpx;
  font-weight: 700;
  color: #1a1a1a;
  letter-spacing: -0.5rpx;
  font-family: "SF Pro Display", -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  line-height: 1.2;
}

.subtitle {
  display: block;
  margin-top: 12rpx;
  font-size: 28rpx;
  color: #8a8580;
  font-family: "SF Pro Text", -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

/* 自动登录提示 */
.auto-login-bar {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 20rpx 24rpx;
  background: rgba(212, 163, 115, 0.08);
  border-radius: 16rpx;
  margin-bottom: 32rpx;
  border: 1rpx solid rgba(212, 163, 115, 0.15);
}

.auto-spinner {
  width: 28rpx;
  height: 28rpx;
  border: 3rpx solid rgba(212, 163, 115, 0.2);
  border-top-color: #d4a373;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.auto-text {
  font-size: 24rpx;
  color: #8a7560;
  font-family: "SF Pro Text", -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

/* 表单卡片 */
.form-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 8rpx 0;
  box-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.04), 0 8rpx 24rpx rgba(0, 0, 0, 0.03);
  border: 1rpx solid rgba(0, 0, 0, 0.04);
  margin-bottom: 40rpx;
}

.field-group {
  padding: 28rpx 32rpx;
}

.field-group + .field-group {
  border-top: 1rpx solid #f0ede8;
}

.field-label {
  display: block;
  font-size: 22rpx;
  font-weight: 600;
  color: #8a8580;
  margin-bottom: 12rpx;
  text-transform: uppercase;
  letter-spacing: 1rpx;
  font-family: "SF Pro Text", -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

.input-wrap {
  display: flex;
  align-items: center;
  background: #faf8f5;
  border-radius: 14rpx;
  border: 1.5rpx solid #ebe8e3;
  padding: 0 24rpx;
  height: 88rpx;
  transition: border-color 0.2s, box-shadow 0.2s;
}

.input-wrap:focus-within {
  border-color: #d4a373;
  box-shadow: 0 0 0 3rpx rgba(212, 163, 115, 0.1);
}

.field-input {
  flex: 1;
  height: 88rpx;
  font-size: 30rpx;
  color: #1a1a1a;
  font-family: "SF Pro Text", -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  background: transparent;
}

.placeholder {
  color: #c5c0b8;
  font-size: 28rpx;
}

.eye-btn {
  padding: 10rpx;
  margin-right: -10rpx;
}

.eye-icon {
  font-size: 32rpx;
}

/* 获取验证码触发按钮 */
.captcha-trigger {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-top: 1rpx solid #f0ede8;
}

.trigger-text {
  font-size: 28rpx;
  color: #d4a373;
  font-weight: 600;
  font-family: "SF Pro Text", -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

.trigger-arrow {
  font-size: 28rpx;
  color: #d4a373;
}

.captcha-trigger:active {
  background: rgba(212, 163, 115, 0.04);
}

/* 验证码区域 */
.captcha-section .field-group {
  border-top: 1rpx solid #f0ede8;
}

.captcha-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.captcha-input-wrap {
  flex: 1;
}

.captcha-img-wrap {
  width: 220rpx;
  height: 88rpx;
  border-radius: 14rpx;
  overflow: hidden;
  background: #f5f2ed;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1.5rpx solid #ebe8e3;
  position: relative;
  flex-shrink: 0;
}

.captcha-img {
  width: 100%;
  height: 100%;
}

.captcha-refresh {
  position: absolute;
  inset: 0;
  background: rgba(250, 248, 245, 0.85);
  display: flex;
  align-items: center;
  justify-content: center;
}

.mini-spinner {
  width: 28rpx;
  height: 28rpx;
  border: 3rpx solid rgba(212, 163, 115, 0.2);
  border-top-color: #d4a373;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.captcha-hint {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #b5b0a8;
  font-family: "SF Pro Text", -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

/* 登录按钮 */
.submit-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 96rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #1a1a1a 0%, #333333 100%);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
  margin-bottom: 40rpx;
  transition: transform 0.15s, opacity 0.15s;
}

.submit-btn:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.submit-btn.disabled {
  opacity: 0.6;
  pointer-events: none;
}

.submit-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
  font-family: "SF Pro Display", -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  letter-spacing: 1rpx;
}

.btn-spinner {
  width: 28rpx;
  height: 28rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: #ffffff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

/* 底部 */
.footer {
  text-align: center;
  padding: 0 20rpx;
}

.footer-text {
  display: block;
  font-size: 22rpx;
  color: #b5b0a8;
  line-height: 1.8;
  font-family: "SF Pro Text", -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

/* 动画 */
@keyframes spin {
  to { transform: rotate(360deg); }
}
