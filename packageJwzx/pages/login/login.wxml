<!-- 教务在线登录页 -->
<view class="page">
  <!-- 背景装饰 -->
  <view class="bg-orb bg-orb-1"></view>
  <view class="bg-orb bg-orb-2"></view>

  <view class="content">
    <!-- 头部 -->
    <view class="header">
      <view class="logo-mark">
        <text class="logo-icon">S</text>
      </view>
      <text class="title">具身胶囊</text>
      <text class="subtitle">登录你的系统</text>
    </view>

    <!-- 自动登录提示 -->
    <view class="auto-login-bar" wx:if="{{autoLoginLoading}}">
      <view class="auto-spinner"></view>
      <text class="auto-text">正在自动登录...</text>
    </view>

    <!-- 登录表单卡片 -->
    <view class="form-card">
      <!-- 用户名 -->
      <view class="field-group">
        <text class="field-label">学号</text>
        <view class="input-wrap">
          <input
            class="field-input"
            type="number"
            placeholder="请输入学号"
            placeholder-class="placeholder"
            value="{{username}}"
            bindinput="onUsernameInput"
            maxlength="12"
          />
        </view>
      </view>

      <!-- 密码 -->
      <view class="field-group">
        <text class="field-label">密码</text>
        <view class="input-wrap">
          <input
            class="field-input"
            type="{{showPassword ? 'text' : 'password'}}"
            placeholder="请输入教务系统密码"
            placeholder-class="placeholder"
            value="{{password}}"
            bindinput="onPasswordInput"
            maxlength="32"
          />
          <view class="eye-btn" bindtap="togglePassword">
            <text class="eye-icon">{{showPassword ? '🙈' : '👁'}}</text>
          </view>
        </view>
      </view>

      <!-- 获取验证码按钮 -->
      <view class="captcha-trigger" wx:if="{{!captchaImage}}" bindtap="getCaptchaFresh">
        <text class="trigger-text">{{captchaLoading ? '获取中...' : '获取验证码'}}</text>
        <text class="trigger-arrow">→</text>
      </view>

      <!-- 验证码区域 -->
      <view class="captcha-section" wx:if="{{captchaImage}}">
        <view class="field-group">
          <text class="field-label">验证码</text>
          <view class="captcha-row">
            <view class="input-wrap captcha-input-wrap">
              <input
                class="field-input"
                type="number"
                placeholder="输入验证码"
                placeholder-class="placeholder"
                value="{{captchaInput}}"
                bindinput="onCaptchaInput"
                maxlength="4"
                focus="{{captchaImage !== ''}}"
              />
            </view>
            <view class="captcha-img-wrap" bindtap="refreshCaptcha">
              <image
                class="captcha-img"
                src="{{captchaImage}}"
                mode="aspectFit"
                wx:if="{{captchaImage}}"
              />
              <view class="captcha-refresh" wx:if="{{captchaLoading}}">
                <view class="mini-spinner"></view>
              </view>
            </view>
          </view>
          <text class="captcha-hint">点击图片刷新验证码</text>
        </view>
      </view>
    </view>

    <!-- 登录按钮 -->
    <view class="submit-btn {{loading ? 'disabled' : ''}}" bindtap="doLogin">
      <view class="btn-spinner" wx:if="{{loading}}"></view>
      <text class="submit-text">{{loading ? '登录中...' : '登录'}}</text>
    </view>

    <!-- 底部信息 -->
    <view class="footer">
      <!-- <text class="footer-text">登录即表示你同意使用数据查询服务</text> -->
      <text class="footer-text">Token 有效期 30 分钟，过期需重新登录</text>
    </view>
  </view>
</view>
