<view class="lobby-container">
  <view class="brand-title">棋弈 · 联机大厅</view>

  <!-- 设置区域 -->
  <view class="settings-panel" wx:if="{{!waiting && !isJoiner}}">
    <view class="setting-item">
      <view class="setting-info">
        <text class="setting-name">开启实时语音</text>
        <text class="setting-desc">使用 LiveKit 引擎进行对局内语音交流</text>
      </view>
      <switch checked="{{enableVoice}}" bindchange="onVoiceChange" color="#d4af37" />
    </view>
    <!-- 这里以后可以无缝增加更多设置，如：选择黑白方、残局模式等 -->
  </view>

  <!-- 房主操作区 -->
  <view class="action-area" wx:if="{{!waiting && !isJoiner}}">
    <button class="btn primary-btn" bindtap="createRoom">创建对局房间</button>
  </view>

  <!-- 房主等待 & 分享区 -->
  <view class="waiting-area" wx:if="{{waiting}}">
    <view class="radar-spinner"></view>
    <view class="loading-text">房间已建立，等待好友加入...</view>

    <!-- 关键：微信原生分享按钮 -->
    <button class="btn share-btn" open-type="share">
      <text class="icon">💬</text> 邀请微信好友
    </button>
    <button class="btn cancel-btn" bindtap="cancelRoom">取消创建</button>
  </view>

  <!-- 好友加入加载区 -->
  <view class="waiting-area" wx:if="{{isJoiner}}">
    <view class="radar-spinner"></view>
    <view class="loading-text">正在进入好友的对局...</view>
  </view>
</view>