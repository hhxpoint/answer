page {
  background-color: #0d1117;
  background-image: radial-gradient(ellipse at 50% 20%, rgba(180, 148, 80, 0.08) 0%, transparent 60%);
  height: 100vh;
  color: #f0eee6;
}

.lobby-container {
  padding: 60rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.brand-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #f0d78c;
  letter-spacing: 4rpx;
  margin-bottom: 80rpx;
}

.settings-panel {
  width: 100%;
  background: rgba(22, 26, 35, 0.8);
  border: 1px solid rgba(212, 175, 55, 0.2);
  border-radius: 24rpx;
  padding: 30rpx;
  box-sizing: border-box;
  margin-bottom: 60rpx;
}

.setting-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.setting-info {
  display: flex;
  flex-direction: column;
}

.setting-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #d4af37;
}

.setting-desc {
  font-size: 24rpx;
  color: #7a766e;
  margin-top: 8rpx;
}

.action-area,
.waiting-area {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.btn {
  width: 100%;
  border-radius: 20rpx;
  font-size: 32rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 30rpx;
}

.primary-btn {
  background: linear-gradient(135deg, #d4af37, #b08968);
  color: #111;
  padding: 24rpx 0;
}

.share-btn {
  background: #238636;
  color: white;
  padding: 24rpx 0;
  box-shadow: 0 8rpx 20rpx rgba(35, 134, 54, 0.4);
}

.cancel-btn {
  background: transparent;
  border: 1px solid rgba(255, 255, 255, 0.2);
  color: #b9b3a8;
  padding: 20rpx 0;
}

.loading-text {
  color: #d4af37;
  font-size: 30rpx;
  margin: 40rpx 0;
  animation: pulse 1.5s infinite;
}

.radar-spinner {
  width: 80rpx;
  height: 80rpx;
  border: 4rpx solid rgba(212, 175, 55, 0.3);
  border-top-color: #d4af37;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  100% {
    transform: rotate(360deg);
  }
}

@keyframes pulse {
  50% {
    opacity: 0.5;
  }
}