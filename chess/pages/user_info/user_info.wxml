<view class="page-container">
  <view class="glass-card">
    <view class="header">
      <text class="title">身份设置</text>
      <text class="subtitle">请设定你在对局中的显示名称和头像</text>
    </view>

    <view class="form-group">
      <!-- 头像选择区 -->
      <view class="avatar-wrapper">
        <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
          <image 
            class="avatar-img" 
            src="{{avatar || 'https://cdn-icons-png.flaticon.com/512/149/149071.png'}}" 
            mode="aspectFill"
          ></image>
          <view class="edit-badge">+</view>
        </button>
        <text class="helper-text">点击选择微信头像</text>
      </view>

      <!-- 昵称输入区 -->
      <view class="input-wrapper">
        <text class="label">对局昵称</text>
        <input 
          type="nickname" 
          open-type="nickname" 
          class="nickname-input" 
          placeholder="点击快速填充微信昵称" 
          value="{{nickname}}"
          bindblur="onInputNickname" 
        />
      </view>
    </view>

    <!-- 提交按钮：必须放在 glass-card 内部 -->
    <button class="submit-btn" bindtap="submitInfo">确认进入对局</button>
  </view>
</view>