/* 新闻详情页样式 */
.detail-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #0d1117 0%, #161b22 50%, #0d1117 100%);
  padding: 30rpx;
  padding-bottom: 200rpx;
  box-sizing: border-box;
}

/* 加载态 */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.spinner {
  width: 80rpx;
  height: 80rpx;
  border: 4rpx solid rgba(88, 166, 255, 0.2);
  border-top-color: #58a6ff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.mini-spinner {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid rgba(247, 147, 26, 0.2);
  border-top-color: #F7931A;
  border-radius: 50%;
  animation: spin 0.6s linear infinite;
  margin-right: 12rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  color: #8b949e;
  font-size: 28rpx;
  margin-top: 30rpx;
}

/* 错误态 */
.error-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 40rpx;
}

.error-icon {
  font-size: 80rpx;
  color: #f85149;
}

.error-text {
  color: #8b949e;
  font-size: 28rpx;
  margin-top: 20rpx;
  text-align: center;
}

.retry-btn {
  margin-top: 40rpx;
  padding: 20rpx 60rpx;
  background: linear-gradient(135deg, #238636 0%, #2ea043 100%);
  border-radius: 12rpx;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}

/* 内容区域 */
.content-wrap {
  padding-bottom: 20rpx;
}

/* 标题 */
.title-section {
  margin-bottom: 24rpx;
}

.news-title {
  color: #f0f6fc;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.4;
  display: block;
}

.title-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
}

.action-icon {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  background: rgba(88, 166, 255, 0.1);
  border-radius: 12rpx;
  font-size: 24rpx;
}

.icon-label {
  color: #58a6ff;
  font-size: 22rpx;
}

/* 翻译后的标题 */
.translated-title {
  background: linear-gradient(135deg, rgba(247, 147, 26, 0.15) 0%, rgba(247, 147, 26, 0.08) 100%);
  border: 1rpx solid rgba(247, 147, 26, 0.25);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}

.translated-label {
  display: block;
  color: #F7931A;
  font-size: 22rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.translated-text {
  display: block;
  color: #c9d1d9;
  font-size: 32rpx;
  line-height: 1.5;
}

/* 元信息 */
.meta-section {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(48, 54, 61, 0.8);
  margin-bottom: 24rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.meta-label {
  color: #8b949e;
  font-size: 24rpx;
}

.meta-value {
  color: #c9d1d9;
  font-size: 24rpx;
}

.meta-value.source {
  color: #58a6ff;
  font-weight: 500;
}

/* 标签 */
.tags-section {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.tag {
  padding: 10rpx 20rpx;
  background: rgba(56, 139, 253, 0.15);
  border: 1rpx solid rgba(56, 139, 253, 0.3);
  border-radius: 8rpx;
  color: #58a6ff;
  font-size: 22rpx;
}

/* 相关币种 */
.related-section {
  margin-bottom: 24rpx;
  padding: 20rpx 24rpx;
  background: rgba(48, 54, 61, 0.3);
  border-radius: 16rpx;
}

.related-title {
  display: block;
  color: #8b949e;
  font-size: 24rpx;
  margin-bottom: 16rpx;
}

.coin-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.coin-tag {
  padding: 12rpx 24rpx;
  background: linear-gradient(135deg, rgba(247, 147, 26, 0.2) 0%, rgba(247, 147, 26, 0.1) 100%);
  border: 1rpx solid rgba(247, 147, 26, 0.3);
  border-radius: 20rpx;
  color: #F7931A;
  font-size: 24rpx;
  font-weight: 500;
}

/* 摘要 */
.summary-section {
  background: linear-gradient(135deg, rgba(247, 147, 26, 0.1) 0%, rgba(247, 147, 26, 0.05) 100%);
  border: 1rpx solid rgba(247, 147, 26, 0.2);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 30rpx;
}

.summary-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.summary-label {
  color: #F7931A;
  font-size: 26rpx;
  font-weight: 600;
}

.summary-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.api-note {
  color: #8b949e;
  font-size: 22rpx;
}

.translate-btn {
  padding: 8rpx 20rpx;
  background: rgba(88, 166, 255, 0.2);
  border-radius: 8rpx;
  color: #58a6ff;
  font-size: 22rpx;
  font-weight: 500;
}

.summary-text {
  color: #c9d1d9;
  font-size: 30rpx;
  line-height: 1.8;
  display: block;
  word-break: break-all;
}

.summary-text.translated {
  color: #e6edf3;
}

/* 翻译中 */
.translating-wrap {
  display: flex;
  align-items: center;
  color: #8b949e;
  font-size: 26rpx;
  padding: 20rpx 0;
}

/* 翻译结果 */
.translated-wrap {
  margin-top: 20rpx;
}

.translated-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.translated-tag {
  color: #3fb950;
  font-size: 22rpx;
  font-weight: 500;
  background: rgba(63, 185, 80, 0.15);
  padding: 6rpx 16rpx;
  border-radius: 6rpx;
}

.toggle-btn {
  color: #58a6ff;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  background: rgba(88, 166, 255, 0.1);
  border-radius: 6rpx;
}

/* 操作栏 */
.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  justify-content: space-around;
  padding: 24rpx 30rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(13, 17, 23, 0) 0%, #0d1117 20%);
  box-sizing: border-box;
}

.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 40rpx;
  border-radius: 16rpx;
  transition: all 0.2s;
}

.action-btn:active {
  transform: scale(0.95);
  opacity: 0.8;
}

.btn-icon {
  font-size: 40rpx;
}

.btn-text {
  color: #8b949e;
  font-size: 22rpx;
}

.copy-btn {
  background: rgba(35, 134, 54, 0.15);
}

.share-btn {
  background: rgba(56, 139, 253, 0.15);
}

.trans-btn {
  background: rgba(247, 147, 26, 0.15);
}
