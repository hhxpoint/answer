/* ========== Blockchain Explorer - Premium Dark Theme ========== */

page {
  background: #0d1117;
  color: #e6edf3;
  font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Helvetica Neue', sans-serif;
}

/* ===== Page Background ===== */
.page-bg {
  min-height: 100vh;
  background:
    radial-gradient(ellipse at 20% 0%, rgba(247, 147, 26, 0.06) 0%, transparent 50%),
    radial-gradient(ellipse at 80% 100%, rgba(98, 126, 234, 0.05) 0%, transparent 50%),
    radial-gradient(ellipse at 50% 50%, rgba(12, 17, 23, 1) 0%, #0d1117 100%);
  background-attachment: fixed;
}

/* ===== Header ===== */
.header {
  position: relative;
  padding: 60rpx 40rpx 40rpx;
  overflow: hidden;
}

.header-glow {
  position: absolute;
  top: -80rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 500rpx;
  height: 300rpx;
  background: radial-gradient(ellipse, rgba(247, 147, 26, 0.15) 0%, rgba(98, 126, 234, 0.08) 40%, transparent 70%);
  filter: blur(40rpx);
  animation: glowPulse 4s ease-in-out infinite alternate;
}

@keyframes glowPulse {
  0% { opacity: 0.6; transform: translateX(-50%) scale(1); }
  100% { opacity: 1; transform: translateX(-50%) scale(1.1); }
}

.header-content {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.header-logo {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.logo-icon {
  font-size: 48rpx;
  color: #F7931A;
  filter: drop-shadow(0 0 8rpx rgba(247, 147, 26, 0.6));
  animation: logoSpin 12s linear infinite;
}

@keyframes logoSpin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.logo-text {
  font-size: 44rpx;
  font-weight: 800;
  letter-spacing: 8rpx;
  background: linear-gradient(135deg, #F7931A, #627EEA);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.header-sub {
  font-size: 22rpx;
  color: #8b949e;
  letter-spacing: 4rpx;
  margin-bottom: 8rpx;
  text-transform: uppercase;
}

.header-time {
  font-size: 20rpx;
  color: #484f58;
  background: rgba(255, 255, 255, 0.04);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}

/* Header Decorations */
.header-deco {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
  z-index: 0;
}

.dc {
  position: absolute;
  border-radius: 50%;
  animation: decoFloat 6s ease-in-out infinite;
}

.dc1 {
  width: 12rpx; height: 12rpx;
  background: rgba(247, 147, 26, 0.4);
  top: 40rpx; left: 60rpx;
  box-shadow: 0 0 12rpx rgba(247, 147, 26, 0.3);
  animation-delay: 0s;
}

.dc2 {
  width: 8rpx; height: 8rpx;
  background: rgba(98, 126, 234, 0.4);
  top: 80rpx; right: 80rpx;
  box-shadow: 0 0 12rpx rgba(98, 126, 234, 0.3);
  animation-delay: 2s;
}

.dc3 {
  width: 6rpx; height: 6rpx;
  background: rgba(141, 195, 81, 0.5);
  bottom: 30rpx; left: 40%;
  box-shadow: 0 0 10rpx rgba(141, 195, 81, 0.3);
  animation-delay: 4s;
}

@keyframes decoFloat {
  0%, 100% { transform: translateY(0) scale(1); opacity: 0.5; }
  50% { transform: translateY(-16rpx) scale(1.3); opacity: 1; }
}

/* ===== Tab Bar ===== */
.tab-bar {
  display: flex;
  margin: 0 30rpx 24rpx;
  background: rgba(255, 255, 255, 0.03);
  border-radius: 20rpx;
  padding: 6rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}

.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 18rpx 0;
  position: relative;
  border-radius: 16rpx;
  transition: all 0.3s ease;
}

.tab text {
  font-size: 26rpx;
  color: #8b949e;
  font-weight: 500;
  transition: all 0.3s ease;
}

.tab.on {
  background: rgba(247, 147, 26, 0.1);
}

.tab.on text {
  color: #F7931A;
  font-weight: 600;
}

.tab-line {
  position: absolute;
  bottom: 8rpx;
  width: 32rpx;
  height: 4rpx;
  background: linear-gradient(90deg, #F7931A, #627EEA);
  border-radius: 2rpx;
  animation: tabLineIn 0.3s ease;
}

@keyframes tabLineIn {
  from { width: 0; opacity: 0; }
  to { width: 32rpx; opacity: 1; }
}

/* ===== Tab Content ===== */
.tab-content {
  padding: 0 24rpx 40rpx;
  animation: fadeIn 0.35s ease;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(12rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* ===== Skeleton Loading ===== */
.sk-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.sk-card {
  background: rgba(255, 255, 255, 0.03);
  border-radius: 20rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.04);
}

.sk-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.sk-row:last-child { margin-bottom: 0; }

.sk-dot {
  width: 32rpx; height: 32rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
  animation: skPulse 1.5s ease-in-out infinite;
}

.sk-l {
  height: 24rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.06);
  animation: skPulse 1.5s ease-in-out infinite;
}

.sk-l.lg { width: 160rpx; }
.sk-l.md { width: 200rpx; }
.sk-l.sm { flex: 1; }

@keyframes skPulse {
  0%, 100% { opacity: 0.4; }
  50% { opacity: 1; }
}

/* ===== Chain Card Grid ===== */
.chain-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.c-card {
  position: relative;
  background: linear-gradient(145deg, rgba(22, 27, 34, 0.95), rgba(13, 17, 23, 0.95));
  border-radius: 20rpx;
  padding: 28rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  transition: all 0.3s ease;
  animation: cardIn 0.4s ease backwards;
}

.c-card:nth-child(1) { animation-delay: 0.02s; }
.c-card:nth-child(2) { animation-delay: 0.06s; }
.c-card:nth-child(3) { animation-delay: 0.1s; }
.c-card:nth-child(4) { animation-delay: 0.14s; }
.c-card:nth-child(5) { animation-delay: 0.18s; }
.c-card:nth-child(6) { animation-delay: 0.22s; }
.c-card:nth-child(7) { animation-delay: 0.26s; }
.c-card:nth-child(8) { animation-delay: 0.3s; }
.c-card:nth-child(9) { animation-delay: 0.34s; }
.c-card:nth-child(10) { animation-delay: 0.38s; }

@keyframes cardIn {
  from { opacity: 0; transform: translateY(20rpx) scale(0.96); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

.c-card::before {
  content: '';
  position: absolute;
  inset: 0;
  background: radial-gradient(circle at 100% 0%, rgba(255,255,255,0.03) 0%, transparent 50%);
  pointer-events: none;
}

.c-accent {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  border-radius: 0 0 4rpx 4rpx;
}

.c-top {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 16rpx;
}

.c-dot {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  flex-shrink: 0;
  animation: dotPulse 3s ease-in-out infinite;
}

@keyframes dotPulse {
  0%, 100% { opacity: 0.8; }
  50% { opacity: 1; box-shadow: 0 0 16rpx currentColor; }
}

.c-name {
  font-size: 24rpx;
  font-weight: 600;
  color: #e6edf3;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.c-sym {
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  flex-shrink: 0;
}

.c-price {
  font-size: 32rpx;
  font-weight: 800;
  color: #e6edf3;
  margin-bottom: 6rpx;
  display: block;
  font-family: 'SF Mono', 'Menlo', 'Monaco', monospace;
}

.c-change {
  font-size: 22rpx;
  font-weight: 600;
  margin-bottom: 14rpx;
  display: inline-block;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
}

.c-change.up {
  color: #3fb950;
  background: rgba(63, 185, 80, 0.1);
}

.c-change.down {
  color: #f85149;
  background: rgba(248, 81, 73, 0.1);
}

.c-metrics {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 14rpx;
}

.m {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.m-l {
  font-size: 20rpx;
  color: #8b949e;
}

.m-v {
  font-size: 20rpx;
  color: #c9d1d9;
  font-weight: 500;
  font-family: 'SF Mono', 'Menlo', monospace;
}

.c-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.c-tag {
  font-size: 18rpx;
  color: #8b949e;
  background: rgba(255, 255, 255, 0.04);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.05);
}

/* ===== Empty State ===== */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}

.empty-i {
  font-size: 80rpx;
  margin-bottom: 20rpx;
  animation: emptyBounce 2s ease-in-out infinite;
}

@keyframes emptyBounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-16rpx); }
}

.empty-t {
  font-size: 26rpx;
  color: #8b949e;
}

.credit {
  display: block;
  text-align: center;
  font-size: 20rpx;
  color: #30363d;
  margin-top: 40rpx;
  letter-spacing: 1rpx;
}

/* ===== Chain Picker ===== */
.chain-picker {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 0 6rpx 24rpx;
  padding: 20rpx 24rpx;
  background: rgba(255, 255, 255, 0.04);
  border-radius: 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.cp-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.chain-picker text {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  color: #e6edf3;
}

.cp-arrow {
  flex: none !important;
  color: #8b949e !important;
  font-size: 24rpx !important;
}

/* ===== Search Box ===== */
.search-box {
  display: flex;
  gap: 12rpx;
  margin-bottom: 28rpx;
  align-items: stretch;
}

.s-input {
  flex: 1;
  height: 80rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
  color: #e6edf3;
  transition: border-color 0.3s ease;
}

.s-input:focus {
  border-color: rgba(247, 147, 26, 0.4);
  background: rgba(255, 255, 255, 0.06);
}

.s-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 32rpx;
  background: linear-gradient(135deg, #F7931A, #E8850F);
  border-radius: 16rpx;
  flex-shrink: 0;
  transition: all 0.3s ease;
  box-shadow: 0 4rpx 16rpx rgba(247, 147, 26, 0.25);
}

.s-btn:active {
  transform: scale(0.96);
  box-shadow: 0 2rpx 8rpx rgba(247, 147, 26, 0.2);
}

.s-btn-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #fff;
  letter-spacing: 2rpx;
}

/* ===== Spinner ===== */
.ex-loading, .news-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
  gap: 20rpx;
}

.spinner {
  width: 56rpx;
  height: 56rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.08);
  border-top-color: #F7931A;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.spin-text {
  font-size: 24rpx;
  color: #8b949e;
}

/* ===== Explorer Error ===== */
.ex-error, .news-error {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx;
  gap: 16rpx;
}

.ex-error-i {
  font-size: 56rpx;
}

.ex-error-t, .news-error text:first-child {
  font-size: 24rpx;
  color: #8b949e;
  text-align: center;
}

.ex-retry {
  margin-top: 12rpx;
  padding: 12rpx 36rpx;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  transition: all 0.3s ease;
}

.ex-retry:active {
  background: rgba(255, 255, 255, 0.1);
}

.ex-retry text {
  font-size: 24rpx;
  color: #e6edf3;
  font-weight: 500;
}

/* ===== Explorer Result ===== */
.ex-result {
  background: rgba(22, 27, 34, 0.9);
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  overflow: hidden;
  animation: resultIn 0.4s ease;
}

@keyframes resultIn {
  from { opacity: 0; transform: translateY(16rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.res-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 28rpx;
  background: rgba(255, 255, 255, 0.03);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

.res-type {
  font-size: 28rpx;
  font-weight: 700;
  color: #e6edf3;
}

.res-chain {
  font-size: 22rpx;
  font-weight: 600;
}

.res-fields {
  padding: 8rpx 0;
}

.f-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 16rpx 28rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.03);
  transition: background 0.2s ease;
}

.f-row:active {
  background: rgba(255, 255, 255, 0.03);
}

.f-row:last-child {
  border-bottom: none;
}

.f-key {
  font-size: 22rpx;
  color: #8b949e;
  flex-shrink: 0;
  margin-right: 20rpx;
  font-family: 'SF Mono', 'Menlo', monospace;
  max-width: 200rpx;
  word-break: break-all;
}

.f-val {
  font-size: 22rpx;
  color: #c9d1d9;
  text-align: right;
  word-break: break-all;
  font-family: 'SF Mono', 'Menlo', monospace;
  line-height: 1.5;
}

/* ===== Raw JSON Toggle ===== */
.raw-toggle {
  padding: 24rpx 28rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.05);
  cursor: pointer;
}

.raw-toggle text {
  font-size: 22rpx;
  color: #58a6ff;
  font-weight: 500;
}

.raw-block {
  padding: 20rpx 28rpx;
  background: rgba(0, 0, 0, 0.3);
  border-top: 1rpx solid rgba(255, 255, 255, 0.04);
  max-height: 600rpx;
  overflow-y: auto;
}

.raw-text {
  font-size: 18rpx;
  color: #8b949e;
  font-family: 'SF Mono', 'Menlo', monospace;
  word-break: break-all;
  line-height: 1.6;
  white-space: pre-wrap;
}

/* ===== News List ===== */
.news-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.n-card {
  background: linear-gradient(145deg, rgba(22, 27, 34, 0.9), rgba(13, 17, 23, 0.9));
  border-radius: 20rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  transition: all 0.3s ease;
  animation: cardIn 0.4s ease backwards;
}

.n-card:nth-child(1) { animation-delay: 0.02s; }
.n-card:nth-child(2) { animation-delay: 0.05s; }
.n-card:nth-child(3) { animation-delay: 0.08s; }
.n-card:nth-child(4) { animation-delay: 0.11s; }
.n-card:nth-child(5) { animation-delay: 0.14s; }
.n-card:nth-child(6) { animation-delay: 0.17s; }

.n-card:active {
  transform: scale(0.98);
  border-color: rgba(247, 147, 26, 0.2);
}

.n-source {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.n-src {
  font-size: 20rpx;
  color: #F7931A;
  font-weight: 600;
  letter-spacing: 1rpx;
  text-transform: uppercase;
}

.n-time {
  font-size: 20rpx;
  color: #484f58;
}

.n-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #e6edf3;
  line-height: 1.5;
  margin-bottom: 12rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.n-desc {
  display: block;
  font-size: 22rpx;
  color: #8b949e;
  line-height: 1.6;
  margin-bottom: 16rpx;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.n-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.n-tag {
  font-size: 18rpx;
  color: #58a6ff;
  background: rgba(88, 166, 255, 0.08);
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  border: 1rpx solid rgba(88, 166, 255, 0.12);
}

/* ===== Sort Bar ===== */
.sort-bar {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
  flex-wrap: wrap;
}

.sort-btn {
  padding: 8rpx 20rpx;
  background: rgba(255, 255, 255, 0.04);
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  font-size: 22rpx;
  color: #8b949e;
  transition: all 0.3s ease;
}

.sort-btn.on {
  background: rgba(247, 147, 26, 0.12);
  border-color: rgba(247, 147, 26, 0.3);
  color: #F7931A;
}

/* ===== Stats Summary ===== */
.stats-summary {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.stat-pill {
  flex: 1;
  background: rgba(255, 255, 255, 0.03);
  border-radius: 16rpx;
  padding: 20rpx 16rpx;
  text-align: center;
  border: 1rpx solid rgba(255, 255, 255, 0.05);
}

.stat-val {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #e6edf3;
  margin-bottom: 4rpx;
  font-family: 'SF Mono', 'Menlo', monospace;
}

.stat-label {
  font-size: 18rpx;
  color: #8b949e;
}

/* ===== Search History ===== */
.search-history {
  margin-bottom: 24rpx;
}

.sh-title {
  font-size: 22rpx;
  color: #484f58;
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.sh-list {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.sh-item {
  padding: 8rpx 20rpx;
  background: rgba(255, 255, 255, 0.04);
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  font-size: 22rpx;
  color: #8b949e;
  transition: all 0.3s ease;
}

.sh-item:active {
  background: rgba(255, 255, 255, 0.08);
  color: #e6edf3;
}

/* ===== Network Status ===== */
.net-status {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 12rpx;
  margin-bottom: 20rpx;
}

.net-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #3fb950;
  box-shadow: 0 0 8rpx rgba(63, 185, 80, 0.5);
  animation: netPulse 2s ease-in-out infinite;
}

.net-dot.error {
  background: #f85149;
  box-shadow: 0 0 8rpx rgba(248, 81, 73, 0.5);
}

@keyframes netPulse {
  0%, 100% { opacity: 0.6; }
  50% { opacity: 1; }
}

.net-text {
  font-size: 20rpx;
  color: #484f58;
}

/* ===== Scrollbar ===== */
::-webkit-scrollbar {
  width: 0;
  height: 0;
}
