.loader-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.loader-card {
  background: rgba(255, 255, 255, 0.08);
  backdrop-filter: blur(20px);
  border-radius: 32rpx;
  padding: 60rpx 40rpx;
  width: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.loader-icon {
  margin-bottom: 30rpx;
}

.loader-emoji {
  font-size: 80rpx;
}

.loader-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 12rpx;
}

.loader-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-bottom: 50rpx;
  text-align: center;
}

.course-list {
  width: 100%;
  margin-bottom: 40rpx;
}

.course-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.course-item.active {
  border-color: #00d2ff;
  background: rgba(0, 210, 255, 0.15);
}

.course-emoji {
  font-size: 48rpx;
  margin-right: 24rpx;
}

.course-info {
  flex: 1;
}

.course-name {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #fff;
}

.course-desc {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
  margin-top: 6rpx;
}

.start-btn {
  width: 80%;
  height: 90rpx;
  line-height: 90rpx;
  background: linear-gradient(90deg, #00d2ff, #3a7bd5);
  color: #fff;
  border-radius: 45rpx;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
  box-shadow: 0 8rpx 30rpx rgba(0, 210, 255, 0.3);
}

.hint-text {
  display: block;
  margin-top: 24rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.35);
  text-align: center;
}
