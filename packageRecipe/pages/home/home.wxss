page { background: #FBF6EF; }

.page {
  min-height: 100vh;
  padding-bottom: 60rpx;
  color: #3A2E27;
  background:
    radial-gradient(circle at 8% 0%, rgba(255, 214, 170, 0.35), transparent 38%),
    radial-gradient(circle at 96% 12%, rgba(255, 232, 205, 0.5), transparent 42%),
    #FBF6EF;
}

/* 顶部 */
.hero {
  padding: 36rpx 36rpx 28rpx;
}
.hero-badge {
  display: inline-block;
  font-size: 22rpx;
  color: #B2622F;
  background: rgba(255, 236, 214, 0.9);
  border: 1rpx solid rgba(240, 138, 75, 0.22);
  border-radius: 999rpx;
  padding: 8rpx 18rpx;
  margin-bottom: 18rpx;
}
.hero-title {
  font-size: 58rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: #33251D;
}
.hero-sub {
  margin-top: 10rpx;
  font-size: 25rpx;
  color: #9B897B;
}

.search-box {
  display: flex;
  align-items: center;
  margin-top: 28rpx;
  padding: 12rpx 12rpx 12rpx 24rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 999rpx;
  box-shadow: 0 14rpx 34rpx rgba(169, 122, 80, 0.12);
}
.search-icon {
  font-size: 38rpx;
  color: #C9A98D;
  margin-right: 10rpx;
  line-height: 1;
}
.search-input {
  flex: 1;
  font-size: 27rpx;
  color: #3A2E27;
  height: 54rpx;
}
.search-clear {
  width: 46rpx;
  text-align: center;
  color: #B9A697;
  font-size: 36rpx;
  line-height: 1;
}
.search-btn {
  flex-shrink: 0;
  padding: 18rpx 30rpx;
  border-radius: 999rpx;
  font-size: 25rpx;
  font-weight: 600;
  color: #FFF;
  background: linear-gradient(135deg, #F5A05F, #E97B3E);
  box-shadow: 0 8rpx 18rpx rgba(233, 123, 62, 0.25);
}

.quick-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 22rpx;
}
.quick-tag {
  font-size: 23rpx;
  color: #8C7460;
  background: rgba(255, 255, 255, 0.65);
  border: 1rpx solid rgba(196, 160, 125, 0.22);
  border-radius: 999rpx;
  padding: 9rpx 20rpx;
}

/* 入口卡 */
.entry-row {
  display: flex;
  gap: 20rpx;
  padding: 0 36rpx;
}
.entry-card {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 22rpx;
  border-radius: 28rpx;
  box-shadow: 0 10rpx 26rpx rgba(160, 120, 84, 0.1);
}
.entry-fridge { background: linear-gradient(135deg, #EAF4FF, #F7FBFF); }
.entry-fav { background: linear-gradient(135deg, #FFF0F1, #FFF9F8); }
.entry-emoji { font-size: 40rpx; }
.entry-title { font-size: 27rpx; font-weight: 600; }
.entry-desc { font-size: 21rpx; color: #9B897B; margin-top: 4rpx; }

/* 区块 */
.section { padding: 32rpx 36rpx 0; }
.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.section-title { font-size: 32rpx; font-weight: 700; color: #33251D; }
.section-action { font-size: 24rpx; color: #D1793E; }
.section-count { font-size: 23rpx; color: #B4A294; }
.intro {
  font-size: 24rpx;
  color: #9B897B;
  line-height: 1.6;
  margin-bottom: 22rpx;
}

/* 今晚 */
.tonight-card {
  position: relative;
  height: 300rpx;
  border-radius: 30rpx;
  overflow: hidden;
  box-shadow: 0 16rpx 36rpx rgba(150, 100, 60, 0.16);
}
.tonight-img { width: 100%; height: 100%; }
.tonight-cover {
  width: 100%; height: 100%;
  display: flex; align-items: center; justify-content: center;
}
.cover-emoji { font-size: 120rpx; opacity: 0.9; }
.tonight-mask {
  position: absolute; left: 0; right: 0; bottom: 0;
  padding: 46rpx 28rpx 22rpx;
  background: linear-gradient(transparent, rgba(38, 25, 16, 0.72));
}
.tonight-title { font-size: 34rpx; font-weight: 700; color: #FFF; }
.tonight-sub { font-size: 22rpx; color: rgba(255, 255, 255, 0.85); margin-top: 6rpx; }

/* 分类 */
.cat-bar {
  display: flex;
  white-space: nowrap;
  padding: 30rpx 36rpx 4rpx;
  box-sizing: border-box;
}
.cat-chip {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #8C7460;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  margin-right: 14rpx;
  background: rgba(255, 255, 255, 0.7);
  border: 1rpx solid rgba(196, 160, 125, 0.18);
}
.cat-on {
  color: #FFF;
  background: linear-gradient(135deg, #F5A05F, #E97B3E);
  border-color: transparent;
  font-weight: 600;
}

/* 最近搜索 */
.recent { padding: 24rpx 36rpx 0; }
.recent-label { font-size: 22rpx; color: #B4A294; }
.recent-list { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 12rpx; }
.recent-chip {
  font-size: 22rpx; color: #8C7460;
  background: rgba(255, 255, 255, 0.6);
  border-radius: 999rpx;
  padding: 8rpx 18rpx;
}

/* 菜谱卡 */
.card {
  display: flex;
  background: rgba(255, 255, 255, 0.94);
  border-radius: 28rpx;
  padding: 16rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 10rpx 26rpx rgba(160, 120, 84, 0.09);
}
.card-img, .card-cover {
  width: 196rpx;
  height: 196rpx;
  border-radius: 22rpx;
  flex-shrink: 0;
  background: #F1E3D3;
}
.card-cover { display: flex; align-items: center; justify-content: center; }
.card-cover .cover-emoji { font-size: 72rpx; }
.card-body { flex: 1; padding: 6rpx 8rpx 4rpx 20rpx; min-width: 0; }
.card-title { font-size: 30rpx; font-weight: 700; color: #33251D; }
.card-meta { font-size: 22rpx; color: #A08C7C; margin-top: 6rpx; }
.card-tags { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 12rpx; }
.tag {
  font-size: 20rpx;
  color: #C06A34;
  background: #FFF1E4;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
}
.tag-soft { color: #8B9A7A; background: #F1F5EC; }
.card-ing {
  font-size: 21rpx; color: #B0A093; margin-top: 12rpx;
  overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
}

/* 封面配色 */
.cover-c1 { background: linear-gradient(135deg, #FFE3C7, #FFD2A8); }
.cover-c2 { background: linear-gradient(135deg, #FFE9CF, #FCD9A8); }
.cover-c3 { background: linear-gradient(135deg, #E4F1E0, #CBE6C6); }
.cover-c4 { background: linear-gradient(135deg, #FFF0D6, #F6DEB4); }
.cover-c5 { background: linear-gradient(135deg, #FFF3DC, #FFE1BD); }
.cover-c6 { background: linear-gradient(135deg, #F8DED0, #F0C3AE); }

/* 空状态 */
.empty { text-align: center; padding: 50rpx 0 30rpx; }
.empty-emoji { font-size: 72rpx; }
.empty-title { font-size: 28rpx; font-weight: 600; margin-top: 12rpx; }
.empty-desc { font-size: 23rpx; color: #A08C7C; margin-top: 8rpx; }
.empty-btn {
  display: inline-block; margin-top: 24rpx;
  padding: 14rpx 34rpx; border-radius: 999rpx;
  font-size: 24rpx; color: #FFF;
  background: linear-gradient(135deg, #F5A05F, #E97B3E);
}

/* 底部 */
.footer { text-align: center; padding: 40rpx 40rpx 20rpx; }
.footer-link { font-size: 22rpx; color: #C08A5E; }
.footer-text { font-size: 20rpx; color: #C4B4A6; margin-top: 10rpx; }
