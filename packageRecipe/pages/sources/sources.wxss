page { background: #FBF6EF; }
.page { min-height: 100vh; padding: 0 36rpx 60rpx; color: #3A2E27; }

.head { padding: 36rpx 0 22rpx; }
.head-title { font-size: 46rpx; font-weight: 700; color: #33251D; }
.head-sub { font-size: 23rpx; color: #9B897B; margin-top: 10rpx; line-height: 1.6; }

.note {
  font-size: 22rpx; color: #8C7460; line-height: 1.7;
  background: #FFF6E8;
  border: 1rpx solid rgba(240,160,95,0.2);
  border-radius: 20rpx;
  padding: 22rpx;
  margin-bottom: 24rpx;
}

.item {
  background: rgba(255,255,255,0.92);
  border-radius: 22rpx;
  padding: 22rpx;
  margin-bottom: 14rpx;
  box-shadow: 0 8rpx 20rpx rgba(160,120,84,0.06);
}
.item-title { font-size: 26rpx; font-weight: 600; }
.item-meta { font-size: 21rpx; color: #C08A5E; margin-top: 6rpx; }
.item-artist { font-size: 20rpx; color: #A08C7C; margin-top: 6rpx; }
.item-link { font-size: 18rpx; color: #B4A294; margin-top: 8rpx; word-break: break-all; }

.foot { text-align: center; font-size: 20rpx; color: #C4B4A6; margin-top: 36rpx; line-height: 1.6; }
