page {
  background-color: #F5F6F8;
}

.page-container {
  min-height: 100vh;
  background-color: #F5F6F8;
  position: relative;
}

.content-scroll {
  padding: 16rpx 32rpx;
  padding-top: 24rpx;
}

/* ========== Cards ========== */
.card {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  margin-bottom: 32rpx;
  padding: 32rpx;
  position: relative;
  overflow: hidden;
}

/* ========== Accent Bar ========== */
.accent-bar {
  width: 6rpx;
  height: 28rpx;
  background-color: #142345;
  border-radius: 3rpx;
  flex-shrink: 0;
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.card-header-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #222222;
}

.card-header-arrow {
  padding: 8rpx;
}

.arrow-icon {
  font-size: 36rpx;
  color: #CCCCCC;
  line-height: 1;
}

.card-header-edit {
  padding: 8rpx;
}

/* ========== Pencil Icon (CSS) ========== */
.edit-pencil {
  width: 32rpx;
  height: 32rpx;
  position: relative;
}

.edit-pencil::before {
  content: '';
  position: absolute;
  width: 20rpx;
  height: 20rpx;
  border: 3rpx solid #999999;
  border-radius: 4rpx;
  top: 2rpx;
  left: 2rpx;
  transform: rotate(45deg);
}

.edit-pencil::after {
  content: '';
  position: absolute;
  width: 0;
  height: 0;
  border-left: 6rpx solid transparent;
  border-right: 6rpx solid transparent;
  border-bottom: 10rpx solid #999999;
  bottom: 0;
  right: 0;
  transform: rotate(45deg);
}

.edit-pencil-small {
  width: 28rpx;
  height: 28rpx;
  position: relative;
}

.edit-pencil-small::before {
  content: '';
  position: absolute;
  width: 16rpx;
  height: 16rpx;
  border: 3rpx solid #999999;
  border-radius: 3rpx;
  top: 2rpx;
  left: 2rpx;
  transform: rotate(45deg);
}

.edit-pencil-small::after {
  content: '';
  position: absolute;
  width: 0;
  height: 0;
  border-left: 5rpx solid transparent;
  border-right: 5rpx solid transparent;
  border-bottom: 8rpx solid #999999;
  bottom: 0;
  right: 0;
  transform: rotate(45deg);
}

/* ========== Card A: Profile ========== */
.card-profile {
  padding: 32rpx;
  display: flex;
  align-items: center;
}

.card-profile-inner {
  display: flex;
  align-items: center;
  gap: 24rpx;
  flex: 1;
}

.card-profile-avatar {
  width: 128rpx;
  height: 160rpx;
  border-radius: 16rpx;
  border: 2rpx solid #E8E8EE;
  overflow: hidden;
  flex-shrink: 0;
  background-color: #F5F6F8;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 14rpx;
}

.card-profile-info {
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.profile-name {
  font-size: 44rpx;
  font-weight: bold;
  color: #222222;
  line-height: 1.2;
}

.profile-city {
  font-size: 26rpx;
  color: #999999;
  margin-top: 16rpx;
}

.card-edit-icon {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  padding: 8rpx;
}

/* ========== Card B: Education ========== */
.edu-block {
  padding: 16rpx 0;
}

.edu-block-divider {
  border-top: 1rpx solid #F0F0F4;
  margin-top: 16rpx;
  padding-top: 24rpx;
}

.edu-school {
  font-size: 28rpx;
  color: #555555;
  font-weight: 500;
  display: block;
  margin-bottom: 8rpx;
}

.edu-time {
  font-size: 24rpx;
  color: #999999;
  display: block;
}

.edu-major {
  font-size: 26rpx;
  color: #555555;
  display: block;
  margin-top: 8rpx;
}

.edu-courses {
  font-size: 26rpx;
  color: #888888;
  display: block;
  margin-top: 12rpx;
  line-height: 1.6;
}

/* ========== Card Footer ========== */
.card-footer {
  margin-top: 16rpx;
}

.divider-line {
  height: 1rpx;
  background-color: #F0F0F4;
  margin-bottom: 16rpx;
}

.add-btn-area {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 0;
}

.add-icon {
  font-size: 36rpx;
  color: #CCCCCC;
  font-weight: 300;
  line-height: 1;
}

/* ========== Card C: Skills ========== */
.skills-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.skill-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.skill-dot {
  width: 10rpx;
  height: 10rpx;
  background-color: #CCCCCC;
  border-radius: 50%;
  margin-top: 10rpx;
  flex-shrink: 0;
}

.skill-text {
  font-size: 26rpx;
  color: #777777;
  line-height: 1.7;
  flex: 1;
}

/* ========== Card D: Experience ========== */
.exp-block {
  padding: 16rpx 0;
}

.exp-block-divider {
  border-top: 1rpx solid #F0F0F4;
  margin-top: 16rpx;
  padding-top: 24rpx;
}

.exp-header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.exp-company {
  font-size: 28rpx;
  color: #555555;
  font-weight: 500;
}

.exp-time {
  font-size: 24rpx;
  color: #999999;
  flex-shrink: 0;
}

.exp-position {
  font-size: 26rpx;
  color: #666666;
  display: block;
  margin-bottom: 8rpx;
}

.exp-desc {
  font-size: 26rpx;
  color: #888888;
  line-height: 1.6;
  display: block;
}

/* ========== Card E: Evaluation ========== */
.evaluation-text {
  font-size: 26rpx;
  color: #777777;
  line-height: 1.7;
  display: block;
}

/* ========== Bottom Bar ========== */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #FFFFFF;
  border-top: 1rpx solid #EEEEEE;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  z-index: 100;
}

.btn-secondary {
  flex: 0 0 38%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: transparent;
  border: 2rpx solid #E0E0E8;
  border-radius: 16rpx;
}

.btn-secondary-text {
  font-size: 28rpx;
  color: #555555;
  font-weight: 400;
}

.btn-primary {
  flex: 0 0 56%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #142345;
  border-radius: 16rpx;
}

.btn-primary-text {
  font-size: 30rpx;
  color: #FFFFFF;
  font-weight: bold;
}

/* ========== Modals ========== */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.45);
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-content {
  width: 85%;
  max-width: 640rpx;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
}

.modal-content-large {
  max-height: 80vh;
  overflow-y: auto;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #222222;
  text-align: center;
  margin-bottom: 32rpx;
}

.modal-form {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.form-row {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.form-label {
  font-size: 26rpx;
  color: #999999;
}

.form-input {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  background-color: #F5F6F8;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #222222;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  min-height: 120rpx;
  padding: 20rpx 24rpx;
  background-color: #F5F6F8;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #222222;
  box-sizing: border-box;
  line-height: 1.6;
}

.form-textarea-large {
  min-height: 240rpx;
}

.modal-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
}

.modal-btn-cancel {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #F5F6F8;
  border-radius: 16rpx;
  font-size: 30rpx;
  color: #555555;
}

.modal-btn-confirm {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #142345;
  border-radius: 16rpx;
  font-size: 30rpx;
  color: #FFFFFF;
  font-weight: bold;
}

.modal-btn-full {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #142345;
  border-radius: 16rpx;
  font-size: 30rpx;
  color: #FFFFFF;
  font-weight: bold;
}

/* ========== Module Management ========== */
.module-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.module-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  background-color: #F5F6F8;
  border-radius: 16rpx;
}

.module-item-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.drag-handle {
  font-size: 24rpx;
  color: #CCCCCC;
  letter-spacing: -2rpx;
}

.module-item-name {
  font-size: 28rpx;
  color: #222222;
  font-weight: 500;
}

.module-item-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.module-visibility {
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  background-color: #E8E8EE;
  font-size: 24rpx;
  color: #999999;
}

.module-visibility.visible {
  background-color: #142345;
  color: #FFFFFF;
}

.module-move {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #E8E8EE;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #666666;
}
