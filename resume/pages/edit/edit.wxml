<view class="page-container">
  <view class="content-scroll" style="padding-bottom: {{safeBottom + 140}}rpx;">

    <!-- Card A: Personal Info -->
    <view class="card card-profile">
      <view class="card-profile-inner">
        <view class="card-profile-avatar" bindtap="chooseAvatar">
          <image class="avatar-img" src="{{avatarUrl}}" mode="aspectFill" />
        </view>
        <view class="card-profile-info">
          <text class="profile-name">{{resumeData.basicInfo.name}}</text>
          <text class="profile-city">期望城市: {{resumeData.basicInfo.location}}</text>
        </view>
      </view>
      <view class="card-edit-icon" bindtap="editProfile">
        <view class="edit-pencil"></view>
      </view>
    </view>

    <!-- Card B: Education -->
    <view class="card card-education">
      <view class="card-header">
        <view class="card-header-left">
          <view class="accent-bar"></view>
          <text class="card-title">教育背景</text>
        </view>
        <view class="card-header-arrow">
          <text class="arrow-icon">›</text>
        </view>
      </view>
      <view class="card-body" wx:for="{{resumeData.education}}" wx:key="index" wx:for-item="edu">
        <view class="edu-block {{index > 0 ? 'edu-block-divider' : ''}}">
          <text class="edu-school">{{edu.school}}</text>
          <text class="edu-time">{{edu.time}}</text>
          <text class="edu-major">{{edu.major}}-{{edu.degree}}</text>
          <text class="edu-courses" wx:if="{{edu.courses}}">主修课程：{{edu.courses}}</text>
        </view>
      </view>
      <view class="card-footer">
        <view class="divider-line"></view>
        <view class="add-btn-area" bindtap="addEducation">
          <text class="add-icon">+</text>
        </view>
      </view>
    </view>

    <!-- Card C: Professional Skills -->
    <view class="card card-skills">
      <view class="card-header">
        <view class="card-header-left">
          <view class="accent-bar"></view>
          <text class="card-title">专业技能</text>
        </view>
        <view class="card-header-edit" bindtap="editSkills">
          <view class="edit-pencil-small"></view>
        </view>
      </view>
      <view class="card-body">
        <view class="skills-list">
          <view class="skill-item" wx:if="{{resumeData.skills.certificates}}">
            <view class="skill-dot"></view>
            <text class="skill-text">获得证书：{{resumeData.skills.certificates}}</text>
          </view>
          <view class="skill-item" wx:if="{{resumeData.skills.languages}}">
            <view class="skill-dot"></view>
            <text class="skill-text">语言能力：{{resumeData.skills.languages}}</text>
          </view>
          <view class="skill-item" wx:if="{{resumeData.skills.office}}">
            <view class="skill-dot"></view>
            <text class="skill-text">办公技能：{{resumeData.skills.office}}</text>
          </view>
          <view class="skill-item" wx:if="{{resumeData.skills.professional}}">
            <view class="skill-dot"></view>
            <text class="skill-text">专业技能：{{resumeData.skills.professional}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- Card D: Work Experience -->
    <view class="card card-experience">
      <view class="card-header">
        <view class="card-header-left">
          <view class="accent-bar"></view>
          <text class="card-title">实践经历</text>
        </view>
        <view class="card-header-arrow">
          <text class="arrow-icon">›</text>
        </view>
      </view>
      <view class="card-body" wx:for="{{resumeData.experience}}" wx:key="index" wx:for-item="exp">
        <view class="exp-block {{index > 0 ? 'exp-block-divider' : ''}}">
          <view class="exp-header-row">
            <text class="exp-company">{{exp.company}}</text>
            <text class="exp-time">{{exp.time}}</text>
          </view>
          <text class="exp-position" wx:if="{{exp.position}}">{{exp.position}}</text>
          <text class="exp-desc" wx:if="{{exp.description}}">{{exp.description}}</text>
        </view>
      </view>
      <view class="card-footer">
        <view class="divider-line"></view>
        <view class="add-btn-area" bindtap="addExperience">
          <text class="add-icon">+</text>
        </view>
      </view>
    </view>

    <!-- Card E: Self Evaluation -->
    <view class="card card-evaluation">
      <view class="card-header">
        <view class="card-header-left">
          <view class="accent-bar"></view>
          <text class="card-title">自我评价</text>
        </view>
        <view class="card-header-edit" bindtap="editEvaluation">
          <view class="edit-pencil-small"></view>
        </view>
      </view>
      <view class="card-body">
        <text class="evaluation-text">{{resumeData.selfEvaluation}}</text>
      </view>
    </view>

  </view>

  <!-- Fixed Bottom Bar -->
  <view class="bottom-bar" style="padding-bottom: env(safe-area-inset-bottom);">
    <view class="btn-secondary" bindtap="moduleManage">
      <text class="btn-secondary-text">模块编辑</text>
    </view>
    <view class="btn-primary" bindtap="generateResume">
      <text class="btn-primary-text">生成简历</text>
    </view>
  </view>

  <!-- Profile Edit Modal -->
  <view class="modal-overlay" wx:if="{{showProfileModal}}" bindtap="closeProfileModal">
    <view class="modal-content" catchtap="noop">
      <view class="modal-title">编辑个人信息</view>
      <view class="modal-form">
        <view class="form-row">
          <text class="form-label">姓名</text>
          <input class="form-input" value="{{resumeData.basicInfo.name}}" bindinput="onProfileInput" data-field="name" placeholder="请输入姓名" />
        </view>
        <view class="form-row">
          <text class="form-label">期望城市</text>
          <input class="form-input" value="{{resumeData.basicInfo.location}}" bindinput="onProfileInput" data-field="location" placeholder="如：北京" />
        </view>
        <view class="form-row">
          <text class="form-label">求职意向</text>
          <input class="form-input" value="{{resumeData.basicInfo.intention}}" bindinput="onProfileInput" data-field="intention" placeholder="如：新媒体运营" />
        </view>
        <view class="form-row">
          <text class="form-label">手机号</text>
          <input class="form-input" value="{{resumeData.basicInfo.phone}}" bindinput="onProfileInput" data-field="phone" placeholder="请输入手机号" />
        </view>
        <view class="form-row">
          <text class="form-label">邮箱</text>
          <input class="form-input" value="{{resumeData.basicInfo.email}}" bindinput="onProfileInput" data-field="email" placeholder="请输入邮箱" />
        </view>
      </view>
      <view class="modal-actions">
        <view class="modal-btn-cancel" bindtap="closeProfileModal">
          <text>取消</text>
        </view>
        <view class="modal-btn-confirm" bindtap="saveProfile">
          <text>保存</text>
        </view>
      </view>
    </view>
  </view>

  <!-- Education Edit Modal -->
  <view class="modal-overlay" wx:if="{{showEduModal}}" bindtap="closeEduModal">
    <view class="modal-content modal-content-large" catchtap="noop">
      <view class="modal-title">{{editingEduIndex >= 0 ? '编辑' : '添加'}}教育经历</view>
      <view class="modal-form">
        <view class="form-row">
          <text class="form-label">学校</text>
          <input class="form-input" value="{{eduForm.school}}" bindinput="onEduFormInput" data-field="school" placeholder="学校名称" />
        </view>
        <view class="form-row">
          <text class="form-label">时间</text>
          <input class="form-input" value="{{eduForm.time}}" bindinput="onEduFormInput" data-field="time" placeholder="如：2018-9 ~ 2021-6" />
        </view>
        <view class="form-row">
          <text class="form-label">专业</text>
          <input class="form-input" value="{{eduForm.major}}" bindinput="onEduFormInput" data-field="major" placeholder="专业名称" />
        </view>
        <view class="form-row">
          <text class="form-label">学历</text>
          <input class="form-input" value="{{eduForm.degree}}" bindinput="onEduFormInput" data-field="degree" placeholder="如：本科" />
        </view>
        <view class="form-row">
          <text class="form-label">主修课程</text>
          <textarea class="form-textarea" value="{{eduForm.courses}}" bindinput="onEduFormInput" data-field="courses" placeholder="主修课程" />
        </view>
      </view>
      <view class="modal-actions">
        <view class="modal-btn-cancel" bindtap="closeEduModal">
          <text>取消</text>
        </view>
        <view class="modal-btn-confirm" bindtap="saveEdu">
          <text>保存</text>
        </view>
      </view>
    </view>
  </view>

  <!-- Skills Edit Modal -->
  <view class="modal-overlay" wx:if="{{showSkillsModal}}" bindtap="closeSkillsModal">
    <view class="modal-content modal-content-large" catchtap="noop">
      <view class="modal-title">编辑专业技能</view>
      <view class="modal-form">
        <view class="form-row">
          <text class="form-label">获得证书</text>
          <textarea class="form-textarea" value="{{skillsForm.certificates}}" bindinput="onSkillsFormInput" data-field="certificates" placeholder="如：人力资源管理师四级" />
        </view>
        <view class="form-row">
          <text class="form-label">语言能力</text>
          <textarea class="form-textarea" value="{{skillsForm.languages}}" bindinput="onSkillsFormInput" data-field="languages" placeholder="如：英语 CET-6" />
        </view>
        <view class="form-row">
          <text class="form-label">办公技能</text>
          <textarea class="form-textarea" value="{{skillsForm.office}}" bindinput="onSkillsFormInput" data-field="office" placeholder="如：熟练使用 Office 办公软件" />
        </view>
        <view class="form-row">
          <text class="form-label">专业技能</text>
          <textarea class="form-textarea" value="{{skillsForm.professional}}" bindinput="onSkillsFormInput" data-field="professional" placeholder="专业技能描述" />
        </view>
      </view>
      <view class="modal-actions">
        <view class="modal-btn-cancel" bindtap="closeSkillsModal">
          <text>取消</text>
        </view>
        <view class="modal-btn-confirm" bindtap="saveSkills">
          <text>保存</text>
        </view>
      </view>
    </view>
  </view>

  <!-- Evaluation Edit Modal -->
  <view class="modal-overlay" wx:if="{{showEvalModal}}" bindtap="closeEvalModal">
    <view class="modal-content modal-content-large" catchtap="noop">
      <view class="modal-title">编辑自我评价</view>
      <view class="modal-form">
        <view class="form-row">
          <textarea class="form-textarea form-textarea-large" value="{{evalForm.text}}" bindinput="onEvalFormInput" placeholder="请输入自我评价" />
        </view>
      </view>
      <view class="modal-actions">
        <view class="modal-btn-cancel" bindtap="closeEvalModal">
          <text>取消</text>
        </view>
        <view class="modal-btn-confirm" bindtap="saveEval">
          <text>保存</text>
        </view>
      </view>
    </view>
  </view>

  <!-- Module Management Modal -->
  <view class="modal-overlay" wx:if="{{showModuleModal}}" bindtap="closeModuleModal">
    <view class="modal-content modal-content-large" catchtap="noop">
      <view class="modal-title">模块管理</view>
      <view class="module-list">
        <view class="module-item" wx:for="{{moduleOrder}}" wx:key="key">
          <view class="module-item-info">
            <view class="drag-handle">⋮⋮</view>
            <text class="module-item-name">{{item.label}}</text>
          </view>
          <view class="module-item-actions">
            <view class="module-visibility {{moduleVisibility[item.key] ? 'visible' : ''}}" bindtap="toggleModuleVisibility" data-key="{{item.key}}">
              <text>{{moduleVisibility[item.key] ? '显示' : '隐藏'}}</text>
            </view>
            <view class="module-move" bindtap="moveModuleUp" data-index="{{index}}" wx:if="{{index > 0}}">↑</view>
            <view class="module-move" bindtap="moveModuleDown" data-index="{{index}}" wx:if="{{index < moduleOrder.length - 1}}">↓</view>
          </view>
        </view>
      </view>
      <view class="modal-actions">
        <view class="modal-btn-full" bindtap="closeModuleModal">
          <text>完成</text>
        </view>
      </view>
    </view>
  </view>

</view>
