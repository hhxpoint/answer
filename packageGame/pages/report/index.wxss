.report-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #0f0c29, #302b63, #24243e);
  padding: 120rpx 40rpx 60rpx;
  box-sizing: border-box;
}

.report-header {
  text-align: center;
  margin-bottom: 50rpx;
}

.report-title {
  display: block;
  font-size: 42rpx;
  font-weight: bold;
  color: #fff;
}

.report-time {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.4);
  margin-top: 10rpx;
}

.score-ring {
  display: flex;
  justify-content: center;
  margin-bottom: 50rpx;
}

.ring-bg {
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.05);
  border: 4rpx solid rgba(0, 210, 255, 0.3);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.ring-score {
  font-size: 80rpx;
  font-weight: bold;
  color: #00d2ff;
  line-height: 1;
}

.ring-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.5);
  margin-top: 8rpx;
}

.stats-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 50rpx;
}

.stat-card {
  flex: 1;
  min-width: 30%;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 20rpx;
  padding: 28rpx 16rpx;
  text-align: center;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.stat-value {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
}

.stat-name {
  display: block;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.4);
  margin-top: 8rpx;
}

.section {
  margin-bottom: 40rpx;
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 20rpx;
}

.joint-list {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 20rpx;
  padding: 16rpx;
}

.joint-item {
  display: flex;
  align-items: center;
  padding: 16rpx 12rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

.joint-item:last-child {
  border-bottom: none;
}

.joint-rank {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(255, 68, 68, 0.2);
  color: #ff6666;
  font-size: 24rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
}

.joint-info {
  flex: 1;
}

.joint-name {
  display: block;
  font-size: 26rpx;
  color: #fff;
  margin-bottom: 8rpx;
}

.joint-bar-bg {
  height: 8rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 4rpx;
  overflow: hidden;
}

.joint-bar {
  height: 100%;
  background: linear-gradient(90deg, #00d2ff, #4ade80);
  border-radius: 4rpx;
  transition: width 0.5s ease;
}

.joint-pct {
  font-size: 24rpx;
  color: #ff6666;
  margin-left: 16rpx;
}

.timeline {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 20rpx;
  padding: 16rpx;
  max-height: 400rpx;
  overflow-y: auto;
}

.timeline-item {
  display: flex;
  align-items: center;
  padding: 8rpx 0;
}

.tl-time {
  width: 60rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.4);
}

.tl-bar-bg {
  flex: 1;
  height: 14rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 7rpx;
  overflow: hidden;
  margin: 0 12rpx;
}

.tl-bar {
  height: 100%;
  border-radius: 7rpx;
  transition: width 0.3s ease;
}

.tl-score {
  width: 40rpx;
  text-align: right;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.6);
}

.actions {
  margin-top: 50rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.action-btn {
  width: 100%;
  height: 85rpx;
  line-height: 85rpx;
  border-radius: 42rpx;
  font-size: 30rpx;
  font-weight: bold;
  border: none;
}

.action-btn.primary {
  background: linear-gradient(90deg, #00d2ff, #3a7bd5);
  color: #fff;
}

.action-btn.secondary {
  background: rgba(255, 255, 255, 0.1);
  color: rgba(255, 255, 255, 0.7);
}
