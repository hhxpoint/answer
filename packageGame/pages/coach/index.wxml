<!-- packageGame/pages/coach/index.wxml -->
<view class="coach-page">
  <!-- 摄像头预览 -->
  <camera
    class="camera"
    device-position="front"
    flash="off"
    resolution="medium"
    binderror="onCameraError"
  />

  <!-- 骨骼绘制Canvas -->
  <canvas
    class="overlay-canvas"
    type="2d"
    id="poseCanvas"
  />

  <!-- 顶部状态栏 -->
  <view class="status-bar">
    <view class="status-item" bindtap="togglePause" wx:if="{{status === 'running' || status === 'paused'}}">
      <text class="status-icon">{{status === 'paused' ? '▶️' : '⏸️'}}</text>
    </view>
    <view class="timer">{{formatTime(elapsed)}}</view>
    <view class="status-item" bindtap="stopPractice">
      <text class="status-icon">⏹️</text>
    </view>
  </view>

  <!-- 课程选择（未开始时显示） -->
  <view class="course-panel" wx:if="{{status === 'idle'}}">
    <view class="panel-bg" />
    <view class="panel-content">
      <text class="panel-title">选择练习课程</text>
      <view class="course-list">
        <view
          class="course-item {{selectedCourse === index ? 'active' : ''}}"
          wx:for="{{courses}}"
          wx:key="name"
          bindtap="selectCourse"
          data-index="{{index}}"
        >
          <text class="course-emoji">{{item.icon}}</text>
          <view class="course-info">
            <text class="course-name">{{item.name}}</text>
            <text class="course-desc">{{item.description}}</text>
          </view>
        </view>
      </view>
      <button class="start-btn" bindtap="startPractice" wx:if="{{aiReady}}">
        开始练习
      </button>
      <text class="ai-hint" wx:if="{{!aiReady}}">{{loadingText || 'AI引擎加载中...'}}</text>
    </view>
  </view>

  <!-- 底部提示 -->
  <view class="hint-bar" wx:if="{{status === 'running'}}">
    <text class="hint-text" wx:if="{{currentWarning}}">{{currentWarning}}</text>
    <text class="hint-text" wx:else>请调整姿势，跟随蓝色虚线轮廓</text>
  </view>

  <!-- 练习结束结果面板 -->
  <view class="result-panel" wx:if="{{status === 'finished'}}">
    <view class="panel-bg" />
    <view class="panel-content result-content">
      <text class="result-title">练习完成</text>
      <view class="result-score">
        <text class="score-number">{{report.avgScore}}</text>
        <text class="score-unit">分</text>
      </view>
      <text class="result-label">平均匹配度</text>

      <view class="result-stats">
        <view class="stat-item">
          <text class="stat-value">{{report.passRate}}%</text>
          <text class="stat-label">达标率</text>
        </view>
        <view class="stat-item">
          <text class="stat-value">{{report.maxScore}}</text>
          <text class="stat-label">最高分</text>
        </view>
        <view class="stat-item">
          <text class="stat-value">{{frameCount}}</text>
          <text class="stat-label">总帧数</text>
        </view>
      </view>

      <view class="weak-joints" wx:if="{{report.weakestJoints.length > 0}}">
        <text class="weak-title">需要改进</text>
        <view class="weak-list">
          <view class="weak-item" wx:for="{{report.weakestJoints}}" wx:key="name">
            <text class="weak-name">{{item.label}}</text>
            <text class="weak-pct">{{item.frequency}}%偏差</text>
          </view>
        </view>
      </view>

      <button class="retry-btn" bindtap="resetPractice">再练一次</button>
      <button class="back-btn" bindtap="goBack">返回首页</button>
    </view>
  </view>
</view>
