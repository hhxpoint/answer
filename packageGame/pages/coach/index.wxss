.coach-page {
  width: 100vw;
  height: 100vh;
  position: relative;
  overflow: hidden;
  background: #000;
}

/* 摄像头 */
.camera {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
}

/* Canvas覆盖层 */
.overlay-canvas {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 2;
}

/* 顶部状态栏 */
.status-bar {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 100rpx 40rpx 20rpx;
  background: linear-gradient(180deg, rgba(0,0,0,0.6) 0%, transparent 100%);
}

.status-item {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.status-icon {
  font-size: 36rpx;
}

.timer {
  font-size: 44rpx;
  font-weight: bold;
  color: #fff;
  font-variant-numeric: tabular-nums;
}

/* 课程选择面板 */
.course-panel {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: center;
}

.panel-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.75);
  backdrop-filter: blur(10px);
}

.panel-content {
  position: relative;
  z-index: 21;
  width: 85%;
  max-height: 80vh;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 32rpx;
  padding: 50rpx 40rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.15);
}

.panel-title {
  display: block;
  text-align: center;
  font-size: 38rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 40rpx;
}

.course-list {
  margin-bottom: 40rpx;
}

.course-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.course-item.active {
  border-color: #00d2ff;
  background: rgba(0, 210, 255, 0.15);
}

.course-emoji {
  font-size: 48rpx;
  margin-right: 24rpx;
}

.course-info {
  flex: 1;
}

.course-name {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #fff;
}

.course-desc {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
  margin-top: 6rpx;
}

.start-btn {
  width: 100%;
  height: 90rpx;
  line-height: 90rpx;
  background: linear-gradient(90deg, #00d2ff, #3a7bd5);
  color: #fff;
  border-radius: 45rpx;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
  box-shadow: 0 8rpx 30rpx rgba(0, 210, 255, 0.3);
}

.ai-hint {
  display: block;
  text-align: center;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.4);
}

/* 底部提示栏 */
.hint-bar {
  position: absolute;
  bottom: 80rpx;
  left: 40rpx;
  right: 40rpx;
  z-index: 10;
  display: flex;
  justify-content: center;
}

.hint-text {
  padding: 16rpx 40rpx;
  background: rgba(0, 0, 0, 0.6);
  border-radius: 40rpx;
  color: #fff;
  font-size: 26rpx;
  backdrop-filter: blur(8px);
}

/* 结果面板 */
.result-panel {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
  display: flex;
  align-items: center;
  justify-content: center;
}

.result-content {
  width: 85%;
  max-height: 85vh;
  overflow-y: auto;
}

.result-title {
  display: block;
  text-align: center;
  font-size: 38rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 30rpx;
}

.result-score {
  display: flex;
  align-items: baseline;
  justify-content: center;
  margin-bottom: 10rpx;
}

.score-number {
  font-size: 100rpx;
  font-weight: bold;
  color: #00d2ff;
  line-height: 1;
}

.score-unit {
  font-size: 36rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-left: 8rpx;
}

.result-label {
  display: block;
  text-align: center;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.5);
  margin-bottom: 40rpx;
}

.result-stats {
  display: flex;
  justify-content: space-around;
  margin-bottom: 40rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
}

.stat-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.4);
  margin-top: 6rpx;
}

.weak-joints {
  margin-bottom: 40rpx;
}

.weak-title {
  display: block;
  font-size: 28rpx;
  color: #ffcc00;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.weak-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.weak-item {
  display: flex;
  align-items: center;
  padding: 10rpx 20rpx;
  background: rgba(255, 68, 68, 0.15);
  border-radius: 16rpx;
  border: 1rpx solid rgba(255, 68, 68, 0.3);
}

.weak-name {
  font-size: 24rpx;
  color: #fff;
  margin-right: 10rpx;
}

.weak-pct {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.5);
}

.retry-btn {
  width: 100%;
  height: 85rpx;
  line-height: 85rpx;
  background: linear-gradient(90deg, #00d2ff, #3a7bd5);
  color: #fff;
  border-radius: 42rpx;
  font-size: 30rpx;
  font-weight: bold;
  border: none;
  margin-bottom: 20rpx;
}

.back-btn {
  width: 100%;
  height: 85rpx;
  line-height: 85rpx;
  background: rgba(255, 255, 255, 0.1);
  color: rgba(255, 255, 255, 0.7);
  border-radius: 42rpx;
  font-size: 30rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.15);
}
